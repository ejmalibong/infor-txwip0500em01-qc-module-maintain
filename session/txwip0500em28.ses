/><constantValueForYes>0</constantValueForYes><viewField>false</viewField><displayHeight>1</displayHeight><columnID>1</columnID><endXPosition>43</endXPosition><parentField>0</parentField><labelHeightOverview>1</labelHeightOverview><labelLengthOverview>999</labelLengthOverview><labelHeightDetail>1</labelHeightDetail><labelLengthDetail>20</labelLengthDetail><labelPosition>1</labelPosition><dependentOnParentField>false</dependentOnParentField><xPositionLabel>1</xPositionLabel><followUpField>0</followUpField><labelAlignment>2</labelAlignment><windowsControl>0</windowsControl><fieldBelowGrid>false</fieldBelowGrid><overviewSession>true</overviewSession><detailsSession>true</detailsSession><childFieldsBehind>false</childFieldsBehind><followUp>false</followUp><nextField>130</nextField><groupID>3</groupID><synchronizedField>false</synchronizedField><defaultValue/><inputReferenceExpression>1</inputReferenceExpression><fieldLabel>txwip042.dcdt</fieldLabel><languageUnitExpression/><mandatoryInput>false</mandatoryInput><sequenceMode>120</sequenceMode><fieldLength>16</fieldLength><echoField>true</echoField><message/><defaultExpression>false</defaultExpression><zoomReturnField/><zoomProgram/><zoomType>1</zoomType><startPositionString>1</startPositionString><linkInputDigitsBefore>true</linkInputDigitsBefore><inputDigitsBefore>22</inputDigitsBefore><linkDisplayDigitsBefore>true</linkDisplayDigitsBefore><displayDigitsBefore>22</displayDigitsBefore><minimumInputLength>0</minimumInputLength><displayFormatLinked>true</displayFormatLinked><displayFormat>%u002 %U002</displayFormat><fieldType>1</fieldType><domain/><element>1</element><fieldName>txwip042.dcdt</fieldName><rowScreenPosition>1</rowScreenPosition><columnScreenPosition>22</columnScreenPosition><sequenceNumber>12</sequenceNumber></FormField><FormField><uuid>c6f6969d-dbe5-483b-9a7c-2d7138b495ea</uuid><textDirection>10</textDirection><fieldAlignment>5</fieldAlignment><indexZoomSession>0</indexZoomSession><iconName/><additionalProperties2>0</additionalProperties2><additionalProperties1>1</additionalProperties1><autoEnableDisable>false</autoEnableDisable><behindEnumConstant>0</behindEnumConstant><hyperlink>false</hyperlink><searchDescription/><constantValueForYes>0</constantValueForYes><viewField>false</viewField><displayHeight>1</displayHeight><columnID>1</columnID><endXPosition>43</endXPosition><parentField>0</parentField><labelHeightOverview>1</labelHeightOverview><labelLengthOverview>999</labelLengthOverview><labelHeightDetail>1</labelHeightDetail><labelLengthDetail>20</labelLengthDetail><labelPosition>1</labelPosition><dependentOnParentField>false</dependentOnParentField><xPositionLabel>1</xPositionLabel><followUpField>0</followUpField><labelAlignment>2</labelAlignment><windowsControl>0</windowsControl><fieldBelowGrid>false</fieldBelowGrid><overviewSession>true</overviewSession><detailsSession>true</detailsSession><childFieldsBehind>false</childFieldsBehind><followUp>false</followUp><nextField>0</nextField><groupID>3</groupID><synchronizedField>false</synchronizedField><defaultValue/><inputReferenceExpression>1</inputReferenceExpression><fieldLabel>txwip042.dmdt</fieldLabel><languageUnitExpression/><mandatoryInput>false</mandatoryInput><sequenceMode>130</sequenceMode><fieldLength>16</fieldLength><echoField>true</echoField><message/><defaultExpression>false</defaultExpression><zoomReturnField/><zoomProgram/><zoomType>1</zoomType><startPositionString>1</startPositionString><linkInputDigitsBefore>true</linkInputDigitsBefore><inputDigitsBefore>22</inputDigitsBefore><linkDisplayDigitsBefore>true</linkDisplayDigitsBefore><displayDigitsBefore>22</displayDigitsBefore><minimumInputLength>0</minimumInputLength><displayFormatLinked>true</displayFormatLinked><displayFormat>%u002 %U002</displayFormat><fieldType>1</fieldType><domain/><element>1</element><fieldName>txwip042.dmdt</fieldName><rowScreenPosition>1</rowScreenPosition><columnScreenPosition>22</columnScreenPosition><sequenceNumber>13</sequenceNumber></FormField><FormField><uuid>66d0e9bf-13e5-45d9-8d32-61642c1f45a4</uuid><textDirection>10</textDirection><fieldAlignment>2</fieldAlignment><indexZoomSession>0</indexZoomSession><iconName/><additionalProperties2>0</additionalProperties2><additionalProperties1>1</additionalProperties1><autoEnableDisable>false</autoEnableDisable><behindEnumConstant>0</behindEnumConstant><hyperlink>false</hyperlink><searchDescription/><constantValueForYes>0</constantValueForYes><viewField>false</viewField><displayHeight>1</displayHeight><columnID>1</columnID><endXPosition>36</endXPosition><parentField>0</parentField><labelHeightOverview>1</labelHeightOverview><labelLengthOverview>999</labelLengthOverview><labelHeightDetail>1</labelHeightDetail><labelLengthDetail>20</labelLengthDetail><labelPosition>1</labelPosition><dependentOnParentField>false</dependentOnParentField><xPositionLabel>1</xPositionLabel><followUpField>0</followUpField><labelAlignment>2</labelAlignment><windowsControl>0</windowsControl><fieldBelowGrid>false</fieldBelowGrid><overviewSession>true</overviewSession><detailsSession>true</detailsSession><childFieldsBehind>false</childFieldsBehind><followUp>false</followUp><nextField>120</nextField><groupID>3</groupID><synchronizedField>false</synchronizedField><defaultValue/><inputReferenceExpression>1</inputReferenceExpression><fieldLabel>txwip042.mcst</fieldLabel><languageUnitExpression/><mandatoryInput>false</mandatoryInput><sequenceMode>110</sequenceMode><fieldLength>14</fieldLength><echoField>true</echoField><message/><defaultExpression>false</defaultExpression><zoomReturnField/><zoomProgram/><zoomType>1</zoomType><startPositionString>1</startPositionString><linkInputDigitsBefore>true</linkInputDigitsBefore><inputDigitsBefore>4</inputDigitsBefore><linkDisplayDigitsBefore>true</linkDisplayDigitsBefore><displayDigitsBefore>15</displayDigitsBefore><minimumInputLength>0</minimumInputLength><displayFormatLinked>true</displayFormatLinked><displayFormat>%AQ20</displayFormat><fieldType>1</fieldType><domain/><element>1</element><fieldName>txwip042.mcst</fieldName><rowScreenPosition>1</rowScreenPosition><columnScreenPosition>22</columnScreenPosition><sequenceNumber>14</sequenceNumber></FormField><FormGroup><selectionGroup>false</selectionGroup><parentTable/><miscellaneous>0</miscellaneous><nextToOtherGroup>false</nextToOtherGroup><checkBoxesOnly>false</checkBoxesOnly><formFormat>13</formFormat><subGroupOnNewPage>false</subGroupOnNewPage><nrSubGroups>1</nrSubGroups><firstChildGroup>3</firstChildGroup><virtualGroup>true</virtualGroup><groupAlignment>1</groupAlignment><firstField>0</firstField><nextGroup>0</nextGroup><previousGroup>0</previousGroup><parentGroup>0</parentGroup><overviewSession>true</overviewSession><detailsSession>true</detailsSession><showGroupBox>false</showGroupBox><groupHeader/><level>0</level><repeating>false</repeating><groupID>1</groupID></FormGroup><FormGroup><selectionGroup>false</selectionGroup><parentTable/><miscellaneous>0</miscellaneous><nextToOtherGroup>false</nextToOtherGroup><checkBoxesOnly>false</checkBoxesOnly><formFormat>13</formFormat><subGroupOnNewPage>false</subGroupOnNewPage><nrSubGroups>1</nrSubGroups><firstChildGroup>0</firstChildGroup><virtualGroup>false</virtualGroup><groupAlignment>-3</groupAlignment><firstField>10</firstField><nextGroup>0</nextGroup><previousGroup>0</previousGroup><parentGroup>1</parentGroup><overviewSession>true</overviewSession><detailsSession>true</detailsSession><showGroupBox>false</showGroupBox><groupHeader/><level>1</level><repeating>false</repeating><groupID>3</groupID></FormGroup></PhysicalFormLayout><FormCommand><descriptionReference>txsetmaterials</descriptionReference><description>Set Materials</description><suppressDialogAllowed>false</suppressDialogAllowed><defaultSpecialCommand>true</defaultSpecialCommand><category>20</category><kindOfSession>9</kindOfSession><startModeSession>9</startModeSession><refreshParent>true</refreshParent><saveBeforeExecution>false</saveBeforeExecution><multipleExecution>false</multipleExecution><questionAnswer>0</questionAnswer><question><name/></question><commandAvailability>2</commandAvailability><authorizationGroup>9</authorizationGroup><initiallyHidden>false</initiallyHidden><initialHidden>false</initialHidden><showOnMenu>true</showOnMenu><showAsButton>false</showAsButton><separator>false</separator><shortcut>1</shortcut><addEllipsesToLabel>false</addEllipsesToLabel><groupFieldNr>0</groupFieldNr><parent>0</parent><activationName>load_materials</activationName><activationType>5</activationType><defaultcommand>false</defaultcommand><sequence>1</sequence><position>1</position><type>1</type><shortDescription>Set Materials</shortDescription><name>load_materials</name></FormCommand><FormCommand><descriptionReference>txsetreagents</descriptionReference><description>Set Reagents</description><suppressDialogAllowed>false</suppressDialogAllowed><defaultSpecialCommand>true</defaultSpecialCommand><category>25</category><kindOfSession>9</kindOfSession><startModeSession>9</startModeSession><refreshParent>false</refreshParent><saveBeforeExecution>false</saveBeforeExecution><multipleExecution>false</multipleExecution><questionAnswer>0</questionAnswer><question><name/></question><commandAvailability>2</commandAvailability><authorizationGroup>9</authorizationGroup><initiallyHidden>false</initiallyHidden><initialHidden>false</initialHidden><showOnMenu>true</showOnMenu><showAsButton>false</showAsButton><separator>false</separator><shortcut>1</shortcut><addEllipsesToLabel>false</addEllipsesToLabel><groupFieldNr>0</groupFieldNr><parent>0</parent><activationName>load_reagents</activationName><activationType>5</activationType><defaultcommand>false</defaultcommand><sequence>2</sequence><position>2</position><type>1</type><shortDescription>Set Reagents</shortDescription><name>load_reagents</name></FormCommand><description>Micro Retest Details</description><name>txwip0500em28d</name><horizontal>true</horizontal><custProhibited>false</custProhibited><additionalConstraints>1</additionalConstraints><documentation/><application>EXTce01107</application></Form><DR_Module><description>Micro Retest Details</description><versionID>B61O_a_ext</versionID><type>library</type><name>txwip0500em28</name><Version><ObjectID/><classID/><checkInLabel/><documentation/><isExpired>no</isExpired><isCheckedOutParallel>no</isCheckedOutParallel><isCheckedOut>no</isCheckedOut><modificationDateTime>2026-10-21T23:51:58Z</modificationDateTime><modifiedBy>ict004</modifiedBy><creationDateTime>2026-10-06T06:28:38Z</creationDateTime><createdBy>ict004</createdBy></Version><Source><sourceVersion><ObjectID/><classID/><checkInLabel/><documentation/><isExpired>no</isExpired><isCheckedOutParallel>no</isCheckedOutParallel><isCheckedOut>no</isCheckedOut><modificationDateTime>2026-10-21T23:51:58Z</modificationDateTime><modifiedBy>ict004</modifiedBy><creationDateTime>2026-10-06T06:28:38Z</creationDateTime><createdBy>ict004</createdBy></sourceVersion><sourceVersionID>B61O_a_ext</sourceVersionID><sourceObjectID>1</sourceObjectID><expression>|*******************************************************************************
|* txwip0500em28  B61O_a_ext
|* Micro Retest Details
|* ict004
|* 2026-08-13 [09:23]
|*******************************************************************************
|* Script Type: 123
|*******************************************************************************

|*************************** declaration section *******************************
declaration:

	table	ttxwip020		|* QC Costs
	table	ttxwip021		|* Reagents	
	table	ttxwip022		|* Reagents Details
	table	ttxwip024		|* Micro Tests
	table	ttxwip025		|* Micro Test Details
	table	ttxwip026		|* QC Personnels
	table	ttxwip027		|* Micro Test Materials
	table	ttxwip028		|* Micro Test Reagents
	table	ttxwip030		|* Pychem Tests
	table	ttxwip031		|* Pychem Test Details
	table	ttxwip033		|* Third Party Tests
	table	ttxwip034		|* Third Party Test Details
	table	ttxwip035 		|* QC Items
	table	ttxwip036		|* Item Testing Costs
	table	ttxwip037		|* Item Testing Cost Details
	table	ttxwip038		|* Inline &amp; Documentation Costs
	table	ttxwip039		|* Micro Test Materials Reference
	table	ttxwip040		|* QC Cost Simulations
	table	ttxwip041		|* Micro Retests
	table	ttxwip042		|* Micro Retest Details
	table	ttxwip043		|* Micro Retest Materials
	table	ttxwip044		|* Micro Retest Reagents
	table	ttxwip045		|* Pychem Retests
	table	ttxwip046		|* Pychem Retest Details
	table	ttxwip047		|* QC Cost Retest
	table	ttxwip048		|* QC Cost Simulation Retests	
	
	table	ttcibd001		|* Items
	table	ttcibd003		|* Conversion Factors
	table	ttdipu001		|* Item - Purchase
	table	ttcmcs003		|* Warehouses
	table	ttcmcs012		|* Units by Unit Set
	table	twhltc100		|* Lots
	table	twhltc101		|* Lot Cost Details
	table	twhltc105		|* Lots by Warehouse
	table	ttccom100		|* Business Partners
	table	ttisfc001		|* Production Orders
	table	tticpr007		|* Items - Costing
	
	extern domain tcnama		parm.desc
	extern domain tcmcs.str50	prid.desc
	extern domain tccwar		zoom.cwar
	extern domain tcorno		zoom.code
	extern long			temp.id, save.id, current.mtid.rt

|****************************** program section ********************************

before.program:
	| Initialize MTID tracking variables.
	| temp.id = temporary negative MTID for unsaved rows.
	| save.id = highest existing MTID used as the base during save.
	temp.id = 0
	save.id = 0
	import("txwip041.anly", zoom.code)
	
before.new.object:
	txwip042.prtm = 1
	txwip042.prid = 1
	
main.table.io:
before.write:
	| Convert temporary negative MTID to permanent positive MTID
	| immediately before the new record is written to the database.
	if txwip042.mtid &lt; 0 then
		save.id = save.id + 1
		txwip042.mtid = save.id
	endif
	
	if txwip042.dcdt = 0 then
		txwip042.dcdt = utc.num()
	endif
	
	if etol(txwip042.prmt) = 2 and trim$(txwip042.parm) &lt;&gt; ""
		and txwip042.mtid &gt; 0 then
		save_micro_test_materials(txwip042.parm, txwip042.mtid)
		txwip042.mcst = compute_total_material_cost(txwip042.mtid)
	endif
	
before.rewrite:
	txwip042.dmdt = utc.num()
	
before.delete:
	delete_details_references(txwip042.mtid)

|****************************** choice section *********************************

choice.add.set:
after.choice:
	| Handle rows created using the toolbar New button.
	| Assign a temporary negative MTID to the new occurrence.
	if txwip042.mtid = 0 then
		set_temp_id()
	endif
	
choice.update.db:
before.choice:
	| Before saving, get the latest highest persisted MTID.
	| This becomes the starting point for permanent MTID assignment.
	save.id = 0

	select max(txwip042.mtid):save.id
	from txwip042
	selectdo
	endselect
	
|****************************** field section **********************************
	
field.txwip042.prmt:
before.display:
	if trim$(zoom.code) &lt;&gt; "" then
		disable_fields()
	endif
	
before.field:
	| Handle rows automatically created by TAB navigation.
	| The new occurrence initially has MTID = 0, so assign
	| a temporary negative MTID when PRMT becomes active.
	if txwip042.mtid = 0 then
		set_temp_id()
	endif
	
when.field.changes:
	if txwip042.prmt = ltoe(0) then
		txwip042.parm = ""
		parm.desc = ""
		txwip042.prtm = 0
		txwip042.lbhr = 0
		txwip042.lbst = 0
	endif
	
	if txwip042.prmt = ltoe(1) then
		disable.zoom.buttons("txwip042.parm")
	endif
	
	display("parm.desc")
	display("txwip042.prtm")
	display("txwip042.lbhr")
	display("txwip042.lbst")

field.txwip042.parm:
selection.filter:
	if etol(txwip042.prmt) = 2 then
		query.extend.where.in.zoom("tcibd001.citg = '600'")
	endif
	
before.zoom:
	update_parameter_zoom(txwip042.prmt)

after.zoom:
	if etol(txwip042.prmt) = 2 then
		txwip042.parm = trim$(txwip042.parm)
	endif
	
when.field.changes:
	update_parameter_desc(txwip042.parm)
	
check.input:
	if etol(txwip042.prmt) = 2 and trim$(txwip042.parm) &lt;&gt; "" then
		select tcibd001.item
		from tcibd001
		where tcibd001.item = "         " &amp; :txwip042.parm
		and tcibd001.citg = '600'
		selectdo
			break
		selectempty
			message("Please select a valid item.")
			set.input.error("")
		endselect
	endif
	
field.parm.desc:
before.display:
	update_parameter_desc(txwip042.parm)
	
field.txwip042.prtm:
when.field.changes:
	update_labor_hours()
	update_labor_cost()
	
field.txwip042.prid:
when.field.changes:
	update_labor_hours()
	update_labor_cost()
	
field.prid.desc:
before.display:
	update_personnel_desc()
	
|****************************** function section *******************************

functions:

function void set_temp_id(){
	temp.id = temp.id - 1
	txwip042.mtid = temp.id
}

function void update_parameter_zoom(domain txprm.types prmt){
	on case etol(prmt)
		case 0:
			disable.zoom.buttons("txwip042.parm")
			attr.zoomcode = 0
			break
		case 1:
			disable.zoom.buttons("txwip042.parm")
			attr.zoomcode = 0
			break
		case 2:
			enable.zoom.buttons("txwip042.parm")
			attr.zoomcode = 2
			attr.zoomsession$ = "tcibd0501m000"
			attr.zoomreturn$ = "tcibd001.item"
			break
		default:
			disable.fields("txwip042.parm")
	endcase
}

function void update_parameter_desc(domain tcmcs.str100 parm){
	domain tcmcs.str100 format.item
	
	format.item = trim$(parm)
	parm.desc = ""
	
	on case etol(txwip042.prmt)
		case 0:
			parm.desc = ""
			break
		case 1:
			parm.desc = ""
			break
		case 2:
			select tcibd001.dsca
			from tcibd001
			where tcibd001.item = "         " &amp; :format.item
			selectdo
				parm.desc = tcibd001.dsca
			endselect
			break
		default:
			parm.desc = ""
	endcase
}

function void update_personnel_desc(){
	prid.desc = ""
	
	select txwip026.dscr
	from txwip026
	where txwip026.prid = :txwip042.prid
	selectdo
		prid.desc = txwip026.dscr
	endselect
}

function void update_labor_hours(){
	txwip042.lbhr = compute_labor_hours(txwip042.prtm)
}

function domain tcqiv1 compute_labor_hours(domain tcqiv1 process.time){
	domain tcqiv1 labor.hours, mins
	
	labor.hours = 0
	mins = 60
	
	if process.time = 0 then
		labor.hours = 0
	else
		labor.hours = process.time / mins
	endif
	
	return(labor.hours)
}

function void update_labor_cost(){
	txwip042.lbst = compute_labor_cost(txwip042.prid, txwip042.lbhr)
}

function domain tcqiv1 compute_labor_cost(domain tcmcs.long person.id, domain tcqiv1 labor.hours){
	domain tcqiv1 labor.cost, rate.hr
	
	labor.cost = 0
	rate.hr = 0
	
	if labor.hours = 0 then
		rate.hr = 0
		return(rate.hr)
	endif
	
	select txwip026.rthr
	from txwip026
	where txwip026.prid = :person.id
	as set with 1 rows
	selectdo
		rate.hr = labor.hours * txwip026.rthr
	selectempty
		rate.hr = 0
	endselect
	
	return(rate.hr)
}

function extern void load_materials(){
	if trim$(zoom.code) = "" then
		start.session(MODAL_OVERVIEW, "txwip0500em29",  "txwip0500em28", "")
	endif
}

function extern void load_reagents(){
	if trim$(zoom.code) = "" then
		start.session(MODAL_OVERVIEW, "txwip0500em30",  "txwip0500em28", "")
	endif		
}

function save_micro_test_materials(domain tcmcs.str100 parm, domain tcmcs.long mtid){
	domain tcitem format.item
	
	format.item = "         " &amp; trim$(parm)
	
	select txwip043.item
	from txwip043
	where txwip043.mtid = :mtid
		and txwip043.item = :format.item
	as set with 1 rows
	selectdo
		return
	selectempty
		select txwip039.*
		from txwip039
		where txwip039.item = :format.item
		as set with 1 rows
		selectdo
			txwip043.mtid = mtid
			txwip043.item = format.item
			txwip043.freq = txwip039.freq
			txwip043.tsmm = txwip039.tsmm
			txwip043.cuni = txwip039.cuni
			txwip043.prip = txwip039.prip
			txwip043.csst = txwip039.csst
			db.insert(ttxwip043, db.retry)	
		endselect
	endselect
}

function domain tcqiv1 compute_total_material_cost(domain tcmcs.long mtid){
	domain tcqiv1 total.mat.cost, total.rgt.cost, total
	long ret
	
	total.mat.cost = 0
	total.rgt.cost = 0
	total = 0

	select sum(txwip043.csst):total.mat.cost
	from txwip043
	where txwip043.mtid = :mtid
	selectdo
	endselect
	
	select txwip021.rgnt, txwip021.cssm
	from txwip021
	where exists
		(select txwip044.*
		 from txwip044
		 where txwip044.mtid = :mtid
		 and txwip044.rgnt = txwip021.rgnt)
	selectdo
		total.rgt.cost = total.rgt.cost + txwip021.cssm
	endselect
	
	total = total.mat.cost + total.rgt.cost
	
	return(total)
}

function delete_details_references(domain tcmcs.long mtid){
	select txwip043.*
	from txwip043 for update
	where txwip043.mtid = :mtid
	selectdo
		db.delete(ttxwip043, db.retry)
	endselect
		
	select txwip044.*
	from txwip044 for update
	where txwip044.mtid = :mtid
	selectdo
		db.delete(ttxwip044, db.retry)
	endselect
}

function disable_fields(){
	disable.fields("txwip042.prmt")
	disable.fields("txwip042.parm")
	disable.fields("txwip042.prtm")
	disable.fields("txwip042.prid")
