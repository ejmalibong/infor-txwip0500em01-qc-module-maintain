dardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>41</position><description/><name>global.delete</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>42</position><description/><name>global.copy</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>43</position><description/><name>save.defaults</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>44</position><description/><name>get.defaults</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>45</position><description/><name>start.chart</name></StandardCommand><StandardCommand><active>true</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>46</position><description/><name>start.query</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>47</position><description/><name>select.all</name></StandardCommand><defaultStartCommand>false</defaultStartCommand><DR_Module><description>Third Party Test</description><versionID>B61O_a_ext</versionID><type>library</type><name>txwip0500em19</name><Version><ObjectID/><classID/><checkInLabel/><documentation/><isExpired>no</isExpired><isCheckedOutParallel>no</isCheckedOutParallel><isCheckedOut>no</isCheckedOut><modificationDateTime>2026-10-01T02:38:46Z</modificationDateTime><modifiedBy>ict004</modifiedBy><creationDateTime>2026-08-27T07:46:53Z</creationDateTime><createdBy>ict004</createdBy></Version><Source><sourceVersion><ObjectID/><classID/><checkInLabel/><documentation/><isExpired>no</isExpired><isCheckedOutParallel>no</isCheckedOutParallel><isCheckedOut>no</isCheckedOut><modificationDateTime>2026-10-01T02:38:46Z</modificationDateTime><modifiedBy>ict004</modifiedBy><creationDateTime>2026-08-27T07:46:53Z</creationDateTime><createdBy>ict004</createdBy></sourceVersion><sourceVersionID>B61O_a_ext</sourceVersionID><sourceObjectID>1</sourceObjectID><expression>|*******************************************************************************
|* txwip0500em19  B61O_a_ext
|* Third Party Test
|* ict004
|* 2026-08-11 [10:55]
|*******************************************************************************
|* Script Type: 123
|*******************************************************************************

|*************************** declaration section *******************************
declaration:

	table	ttxwip020		|* QC Cost Summary
	table	ttxwip021		|* Reagents Header	
	table	ttxwip022		|* Reagents Details
	table	ttxwip024		|* Micro Test Header
	table	ttxwip025		|* Micro Test Details
	table	ttxwip026		|* QC Personnel
	table	ttxwip027		|* Micro Test Materials
	table	ttxwip028		|* Micro Test Reagents
	table	ttxwip030		|* Pychem Test Header
	table	ttxwip031		|* Pychem Test Details
	table	ttxwip033		|* Third Party Test Header
	table	ttxwip034		|* Third Party Test Details
	table	ttxwip035 		|* QC Items
	table	ttxwip036		|* QC Cost Master Data
	table	ttxwip037		|* QC Cost Details
	table	ttxwip038		|* Inline &amp; Documentation Costs
	table	ttxwip039		|* Micro Test Materials Reference

	table	ttcibd001		|* Items
	table	ttcibd003		|* Conversion Factors
	table	ttdipu001		|* Item - Purchase
	table	ttcmcs012		|* Units by Unit Set
	table	twhltc100		|* Lots
	table	twhltc101		|* Lot Cost Details
	table	twhltc105		|* Lots by Warehouse
	table	ttccom100		|* Business Partners
	table	ttisfc001		|* Production Orders
	table	ttcmcs003		|* Warehouses
	
	extern domain tcorno		test.code
	extern domain tcdsca		cwar.desc
	extern domain tccwar		cwar

|****************************** program section ********************************

zoom.from.all:
on.entry:
	import("txwip033.tpid", test.code)

	if not isspace(test.code) then
		select txwip033.*
		from txwip033
		where txwip033.tpid = :test.code
		as set with 1 rows
		selectdo
		endselect

		execute(find.data)
	endif
	
after.form.read:
	add.sync.fields("txwip0500em20", "txwip033.cwar", "cwar")

main.table.io:
before.write:
	if txwip033.dcdt = 0 then
		txwip033.dcdt = utc.num()
	endif

before.rewrite:
	txwip033.dmdt = utc.num()

|****************************** field section **********************************

field.txwip033.tpid:
before.display:
	if trim$(txwip033.tpid) = "" then
		txwip033.tpid = set_tp_test_code()
		txwip033.cwar = "1CS001"
		update_cwar.desc(txwip033.cwar)
	endif
	
field.txwip033.cwar:
before.display:
	update_cwar.desc(txwip033.cwar)
	
selection.filter:
	query.extend.where.in.zoom("tcmcs003.cwar IN (""1CS001"",""1PS001"")")
	
when.field.changes:
	update_cwar.desc(txwip033.cwar)
	
after.zoom:
	update_cwar.desc(txwip033.cwar)
	
field.cwar.desc:
before.display:
	update_cwar.desc(txwip033.cwar)
	
|****************************** function section *******************************

functions:

function domain tcorno set_tp_test_code(){
	long cnt, next.id
	domain tcmcs.str10 next.code, last.code
	
	cnt = 0
	last.code = ""
	next.code = ""
	
	select count(txwip033.tpid):cnt
	from txwip033
	where txwip033.tpid &lt;&gt; ""
	selectdo
	endselect
	
	if cnt &gt; 0 then
		select txwip033.tpid
		from txwip033
		order by txwip033.tpid desc
		as set with 1 rows
		selectdo
			last.code = txwip033.tpid(len(trim$(txwip033.tpid))-1;3)
			next.id = val(last.code) + 1
			next.code = "T" &amp; sprintf$("%03d", trim$(str$(next.id)))
		endselect
	else
		next.code = "T001"
	endif
	
	return(next.code)
}

function extern void compute_tp_test_cost(){
	domain tcqiv1 total.test.cost
	long ret
	
	execute(15)

	total.test.cost = 0

	select sum(txwip034.tpst):total.test.cost
	from txwip034
	where txwip034.tpid = :txwip033.tpid
	selectdo
	endselect
	
	select txwip033.*
	from txwip033 for update
	where txwip033.tpid = :txwip033.tpid
	selectdo
		txwip033.tpst = total.test.cost
		if db.update(ttxwip033, db.retry) &lt;&gt; 0 then
			message("Error " &amp; str$(e) &amp; " occurred while updating the record.")
			abort.transaction()
		endif
	endselect
	
	commit.transaction()
	execute(find.data)
	ret = refresh.parent(-1)
	synchronize.satellite("txwip0500em20")
}

function update_cwar.desc(domain tccwar cwar){
	domain tcdsca desc
	desc = ""
	
	select tcmcs003.dsca
	from tcmcs003
	where tcmcs003.cwar = :cwar
	as set with 1 rows
	selectdo
		desc = tcmcs003.dsca 
	endselect
	
	cwar.desc = desc
}</expression><expressionLanguageType>Baan4C</expressionLanguageType><sourceType>1</sourceType><sourceDescription>Third Party Test</sourceDescription><sourceName>txwip0500em19</sourceName></Source><documentation/><Attachment><type>relnotes</type><name>txwip0500em19</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em19</name></Attachment><additionalConstraints>2590</additionalConstraints><additionalInstructions/><keyword>||</keyword><application>EXTce01106</application></DR_Module><startInCompanyZero>false</startInCompanyZero><repSevLang>false</repSevLang><mainSession>true</mainSession><moduleType>1</moduleType><windowType>15</windowType><subType>1</subType><status>1</status><documentation/><objectLabel/><application>EXTce01106</application><sessionReferenceDescriptionReference>txwip0500em19</sessionReferenceDescriptionReference><sessionReferenceDescription>Third Party Test</sessionReferenceDescription><sessionReference>txwip0500em19</sessionReference><UIScript>txwip0500em19</UIScript></DR_Controller>