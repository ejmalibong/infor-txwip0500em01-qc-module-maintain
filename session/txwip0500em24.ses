|* txwip0500em24  B61O_a_ext
|* QC Costs Simulation
|* ict004
|* 2026-08-06 [09:48]
|*******************************************************************************
|* Script Type: 123
|*******************************************************************************

|*************************** declaration section *******************************
declaration:

	table	ttxwip020		|* QC Costs
	table	ttxwip021		|* Reagents	
	table	ttxwip022		|* Reagents Details
	table	ttxwip024		|* Micro Tests
	table	ttxwip025		|* Micro Test Details
	table	ttxwip026		|* QC Personnels
	table	ttxwip027		|* Micro Test Materials
	table	ttxwip028		|* Micro Test Reagents
	table	ttxwip030		|* Pychem Tests
	table	ttxwip031		|* Pychem Test Details
	table	ttxwip033		|* Third Party Tests
	table	ttxwip034		|* Third Party Test Details
	table	ttxwip035 		|* QC Items
	table	ttxwip036		|* Item Testing Costs
	table	ttxwip037		|* Item Testing Cost Details
	table	ttxwip038		|* Inline &amp; Documentation Costs
	table	ttxwip039		|* Micro Test Materials Reference
	table	ttxwip040		|* QC Cost Simulations
	table	ttxwip041		|* Micro Retests
	table	ttxwip042		|* Micro Retest Details
	table	ttxwip043		|* Micro Retest Materials
	table	ttxwip044		|* Micro Retest Reagents
	table	ttxwip045		|* Pychem Retests
	table	ttxwip046		|* Pychem Retest Details
	table	ttxwip047		|* QC Cost Retest
	table	ttxwip048		|* QC Cost Simulation Retests	
	
	table	ttcibd001		|* Items
	table	ttcibd003		|* Conversion Factors
	table	ttdipu001		|* Item - Purchase
	table	ttcmcs003		|* Warehouses
	table	ttcmcs012		|* Units by Unit Set
	table	twhltc100		|* Lots
	table	twhltc101		|* Lot Cost Details
	table	twhltc105		|* Lots by Warehouse
	table	ttccom100		|* Business Partners
	table	ttisfc001		|* Production Orders
	table	tticpr007		|* Items - Costing

	extern domain tcdsca		cwar.desc
	extern domain tcitm.dscr	item.desc
	extern domain tcmcs.long	sel.count

|****************************** program section ********************************

before.program:
	sel.count = 0

field.item.desc:
before.display:
	item.desc = ""
	
	select tcibd001.dsca
	from tcibd001
	where tcibd001.item = :txwip040.item
	as set with 1 rows
	selectdo
		item.desc = tcibd001.dsca
	endselect
	
field.cwar.desc:
before.display:
	cwar.desc = ""
	
	select tcmcs003.dsca
	from tcmcs003
	where tcmcs003.cwar = :txwip040.cwar
	as set with 1 rows
	selectdo
		cwar.desc = tcmcs003.dsca
	endselect
	
|****************************** function section *******************************

choice.cont.process:
on.choice:
	execute(print.data)
	
choice.print.data:
on.choice:
	sel.count = 0
		
	do.selection(true, count_selected)
		
	if sel.count &lt;&gt; 1 then
		message("Select one record only to print.")
		choice.again()
	endif
		
	if rprt_open() then
	
		on case spool.report
		
			case "rtxwip0500ejm01":
|				print_cost_breakdown()
				break
				
			default:
						
		endcase
		
		rprt_close()
	else
		choice.again()
	endif
	
|****************************** function section *******************************

functions:

function extern get_test_cost(){
	do.selection(true, get_testing_cost)
}

function void get_testing_cost(){
	start.session(MODELESS, "txwip0500em14", "txwip0500em01", "")
}

function extern get_reagents(){
	start.session(MODELESS, "txwip0500em03", "txwip0500em01", "")
}

function extern get_qc_items(){
	start.session(MODELESS, "txwip0500em06", "txwip0500em01", "")
}

function extern get_micro_tests(){
	start.session(MODELESS, "txwip0500em08", "txwip0500em01", "")
}

function extern get_pychem_tests(){
	start.session(MODELESS, "txwip0500em15", "txwip0500em01", "")
}

function extern get_tp_tests(){
	start.session(MODELESS, "txwip0500em18", "txwip0500em01", "")
}

|function extern void print_cost_breakdown(){
|	| Reset selection counter
|	sel.count = 0
|	
|	| Count all selected rows
|	do.selection(true, count_selected)
|	
|	| Print only when exactly one row is selected
|	if sel.count = 1 then
|		do.selection(true, get_cost_breakdown)
|	endif
|}

function void count_selected(){
	sel.count = sel.count + 1
}

|function void get_cost_breakdown(){
|	message(txwip020.pdno)
|}</expression><expressionLanguageType>Baan4C</expressionLanguageType><sourceType>1</sourceType><sourceDescription>QC Costs Simulation</sourceDescription><sourceName>txwip0500em24</sourceName></Source><documentation/><Attachment><type>relnotes</type><name>txwip0500em24</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em24</name></Attachment><additionalConstraints>2590</additionalConstraints><additionalInstructions/><keyword>||</keyword><application>EXTce01107</application></DR_Module><startInCompanyZero>false</startInCompanyZero><repSevLang>false</repSevLang><mainSession>true</mainSession><moduleType>1</moduleType><windowType>6</windowType><subType>5</subType><status>1</status><documentation/><objectLabel/><application>EXTce01107</application><sessionReferenceDescriptionReference>txwip0500em24</sessionReferenceDescriptionReference><sessionReferenceDescription>QC Cost Simulations</sessionReferenceDescription><sessionReference>txwip0500em24</sessionReference><UIScript>txwip0500em24</UIScript></DR_Controller>