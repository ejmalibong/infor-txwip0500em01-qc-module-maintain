heckedOutParallel>no</isCheckedOutParallel><isCheckedOut>no</isCheckedOut><modificationDateTime>2026-09-06T03:47:55Z</modificationDateTime><modifiedBy>ict004</modifiedBy><creationDateTime>2026-08-26T13:19:41Z</creationDateTime><createdBy>ict004</createdBy></sourceVersion><sourceVersionID>B61O_a_ext</sourceVersionID><sourceObjectID>1</sourceObjectID><expression>|*******************************************************************************
|* txwip0500em10  B61O_a_ext
|* Micro Test Details
|* ict004
|* 2026-08-13 [09:23]
|*******************************************************************************
|* Script Type: 123
|*******************************************************************************

|*************************** declaration section *******************************
declaration:

	table	ttxwip020		|* QC Cost Summary
	table	ttxwip021		|* Reagents Header	
	table	ttxwip022		|* Reagents Details
	table	ttxwip024		|* Micro Test Header
	table	ttxwip031		|* Micro Test Details
	table	ttxwip026		|* QC Personnel
	table	ttxwip027		|* Micro Test Materials
	table	ttxwip028		|* Micro Test Reagents
	table	ttxwip030		|* Pychem Test Header
	table	ttxwip031		|* Pychem Test Details
	table	ttxwip033		|* Third Party Test Header
	table	ttxwip034		|* Third Party Test Details
	table	ttxwip035 		|* QC Items
	table	ttxwip036		|* QC Cost Master Data
	table	ttxwip037		|* QC Cost Details
	table	ttcibd001		|* Items
	table	ttcibd003		|* Conversion Factors
	table	ttdipu001		|* Item - Purchase
	table	ttcmcs012		|* Units by Unit Set
	
	extern long			temp.ptid, save.ptid, current.ptid
	extern domain tcmcs.str50	mtrl.desc

|****************************** program section ********************************

before.program:
	| Initialize MTID tracking variables.
	| temp.ptid = temporary negative MTID for unsaved rows.
	| save.ptid = highest existing MTID used as the base during Save.
	temp.ptid = 0
	save.ptid = 0
	
main.table.io:
before.write:
	| Convert temporary negative MTID to permanent positive MTID
	| immediately before the new record is written to the database.
	disable.fields("txwip031.mttp")
	
	if txwip031.pdid &lt; 0 then
		save.ptid = save.ptid + 1
		txwip031.pdid = save.ptid
	endif
	
	if txwip031.dcdt = 0 then
		txwip031.dcdt = utc.num()
	endif
	
before.rewrite:
	txwip031.dmdt = utc.num()
	
|before.new.object:
|	txwip031.mttp = ltoe(2)
|	disable.fields("txwip031.mttp")

|****************************** choice section *********************************

choice.add.set:
after.choice:
	| Handle rows created using the toolbar New button.
	| Assign a temporary negative MTID to the new occurrence.
|	disable.fields("txwip031.mttp")
	
	if txwip031.pdid = 0 then
		set_temp_mtid()
	endif
	
choice.update.db:
before.choice:
	| Before saving, get the latest highest persisted MTID.
	| This becomes the starting point for permanent MTID assignment.
	save.ptid = 0

	select max(txwip031.pdid):save.ptid
	from txwip031
	selectdo
	endselect
	
|****************************** field section **********************************
	
field.txwip031.mttp:
before.field:
	| Handle rows automatically created by TAB navigation.
	| The new occurrence initially has MTID = 0, so assign
	| a temporary negative MTID when PRMT becomes active.
	disable.fields("txwip031.prtm")
	
	if txwip031.pdid = 0 then
		set_temp_mtid()
	endif

field.txwip031.mtrl:
before.zoom:
	update_parameter_zoom()	
	
|selection.filter:
|	if etol(txwip031.mttp) = 1 then
|		query.extend.where.in.zoom("tcibd001.citg = '600'")
|	endif

after.zoom:
	txwip031.mtrl = trim$(txwip031.mtrl)
	
when.field.changes:
	if trim$(txwip031.mtrl) &lt;&gt; "" then
		update_material_desc(trim$(txwip031.mtrl))
	endif
	
field.mtrl.desc:
before.display:
	update_material_desc(trim$(txwip031.mtrl))
	
check.input:
	if trim$(txwip031.mtrl) &lt;&gt; "" then
		on case etol(txwip031.mttp)
			case 1:
				select tcibd001.item
				from tcibd001
				where tcibd001.item = "         " &amp; :txwip031.mtrl
				and tcibd001.citg = '600'
				as set with 1 rows
				selectdo
					break
				selectempty
					message("Please select a valid item.")
					set.input.error("")
				endselect
				break
			case 2:
				select txwip021.rgnt
				from txwip021
				where txwip021.rgnt = :txwip031.mtrl
				as set with 1 rows
				selectdo
					break
				selectempty
					message("Please select a valid reagent.")
					set.input.error("")
				endselect
				break			
			case 3:
				select txwip035.dscr
				from txwip035
				where txwip035.qitm = :txwip031.mtrl
				as set with 1 rows
				selectdo
					break
				selectempty
					message("Please select a valid item.")
					set.input.error("")
				endselect
				break	
			default:
		endcase
	endif
	
|field.txwip031.aqsm:
|when.field.changes:
|	update_material_cost(trim$(txwip031.mtrl), txwip031.aqsm)
	
|****************************** function section *******************************

functions:

function void set_temp_mtid(){
	temp.ptid = temp.ptid - 1
	txwip031.pdid = temp.ptid
}

function void update_parameter_zoom(){
	on case etol(txwip031.mttp)
		case 1:
			attr.zoomcode = 2
			attr.zoomsession$ = "tcibd0501m000"
			attr.zoomreturn$ = "tcibd001.item"
			break
		case 2:
			attr.zoomcode = 2
			attr.zoomsession$ = "txwip0500em03"
			attr.zoomreturn$ = "txwip021.rgnt"
			break
		case 3:
			attr.zoomcode = 2
			attr.zoomsession$ = "txwip0500em06"
			attr.zoomreturn$ = "txwip035.qitm"
			break
		default:
			disable.fields("txwip031.mtrl")
	endcase
}

|function void update_material_cost(domain tcmcs.str50 mtrl, domain tcqiv1 approx){
|	txwip031.mcst = compute_material_cost(mtrl, approx)
|}
|
|function domain tcqiv1 compute_material_cost(domain tcmcs.str50 rgnt, domain tcqiv1 approx){
|	domain tcqiv1 total.cost
|	
|	total.cost = 0
|	
|	on case etol(txwip031.mttp)
|		case 1:
|			break
|		case 2:
|			select txwip021.csst
|			from txwip021
|			where txwip021.rgnt = :rgnt
|			as set with 1 rows
|			selectdo
|				total.cost = approx * txwip021.csst
|			endselect
|			break
|		case 3:
|			break
|		default:
|			total.cost = 0
|	endcase
|	
|	return(total.cost)
|}

function void update_material_desc(domain tcmcs.str50 mtrl){
	mtrl.desc = ""
	
	on case etol(txwip031.mttp)
		case 1:
			select tcibd001.dsca
			from tcibd001
			where tcibd001.item = "         " &amp; :mtrl
			selectdo
				mtrl.desc = tcibd001.dsca
			endselect
			break
		case 2:
			select txwip021.dscr
			from txwip021
			where txwip021.rgnt = :mtrl
			selectdo
				mtrl.desc = txwip021.dscr
			endselect
			break
		case 3:
			select txwip035.dscr
			from txwip035
			where txwip035.qitm = :mtrl
			as set with 1 rows
			selectdo
				mtrl.desc = txwip035.dscr
			endselect
			break
		default:
			mtrl.desc = ""
	endcase
}</expression><expressionLanguageType>Baan4C</expressionLanguageType><sourceType>1</sourceType><sourceDescription>Pychem Test Details</sourceDescription><sourceName>txwip0500em17</sourceName></Source><documentation/><Attachment><type>relnotes</type><name>txwip0500em17</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em17</name></Attachment><additionalConstraints>2590</additionalConstraints><additionalInstructions/><keyword>||</keyword><application>EXTce01106</application></DR_Module><startInCompanyZero>false</startInCompanyZero><repSevLang>false</repSevLang><mainSession>true</mainSession><moduleType>1</moduleType><windowType>6</windowType><subType>1</subType><status>1</status><documentation/><objectLabel/><application>EXTce01106</application><sessionReferenceDescriptionReference>txwip0500em17</sessionReferenceDescriptionReference><sessionReferenceDescription>Pychem Test Details</sessionReferenceDescription><sessionReference>txwip0500em17</sessionReference><UIScript>txwip0500em17</UIScript></DR_Controller>