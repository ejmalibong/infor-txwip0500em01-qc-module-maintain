	ret = refresh.parent(-1)
	end()
}

| Get the sum of ALL micro test costs
function domain tcqiv1 compute_total_micro_test_cost(domain tcitem item){
	domain tcqiv1 total.cost
	
	total.cost = 0
	
	| M003
	select txwip037.code
	from txwip037
	where txwip037.item = :item
		and txwip037.code like "M.*"
		and exists
			(select txwip024.anly
			from txwip024
			where txwip024.freq = 2			| Per Batch
			and txwip024.anly = txwip037.code)
	selectdo
		total.cost = total.cost + compute_micro_test_cost(txwip037.code)
	endselect
	
	return(total.cost)
}

| Get the cost of EACH micro test (Material Cost, Reagent Cost, Labor Cost)
function domain tcqiv1 compute_micro_test_cost(domain tcorno anly){
	domain tcqiv1 sub.total, total.micro.test.cost, mtrl.cost, rgnt.cost
	domain tcorno code
	
	total.micro.test.cost = 0
	code = trim$(anly)
	
	| M003
	select txwip025.mtid, txwip025.lbst
	from txwip025
	where txwip025.anly = :code
	selectdo
		mtrl.cost = 0
		rgnt.cost = 0
		sub.total = 0
		
		| Material Costs + Reagents Cost + Labor Cost
		mtrl.cost = compute_materials_cost(txwip025.mtid)
		rgnt.cost = compute_reagents_cost(txwip025.mtid)
		
|		message("mtid: " &amp; str$(txwip025.mtid) &amp;
|			"mtrl.cost: " &amp;  str$(mtrl.cost) &amp;
|			"rgnt.cost: " &amp; str$(rgnt.cost) &amp;
|			"lbr.cost: " &amp; str$(txwip025.lbst))
			
		sub.total = mtrl.cost + rgnt.cost + txwip025.lbst

		total.micro.test.cost = total.micro.test.cost + sub.total
	endselect
		
	return(total.micro.test.cost)
}

| Get the total material cost of EACH micro test activities
function domain tcqiv1 compute_materials_cost(domain tcmcs.long mtid){
	domain tcqiv1 sub.total, total.material.cost, cost.per.testing
	domain tccopr lot.price
	domain tcconv conversion.value
	
	sub.total = 0
	total.material.cost = 0

	select txwip027.item, txwip027.cuni, txwip027.tsmm
	from txwip027
	where txwip027.mtid = :mtid
	selectdo
		lot.price = 0
		conversion.value = 0
		cost.per.testing = 0
		
		lot.price = get_lot_price(trim$(txwip027.item))
		conversion.value = get_conversion_value(trim$(txwip027.item), txwip027.cuni)
		
		if conversion.value = 0 then
			cost.per.testing = 0
			sub.total = 0
		else
			cost.per.testing = lot.price / conversion.value
			sub.total = cost.per.testing * txwip027.tsmm
		endif
		
		total.material.cost = total.material.cost + sub.total
	endselect
	
	return(total.material.cost)
}

| Get the total reagent cost of EACH micro test activities
function domain tcqiv1 compute_reagents_cost(domain tcmcs.long mtid){
	domain tcqiv1 total.reagent.cost
	
	total.reagent.cost = 0
	
	select txwip028.rgnt
	from txwip028
	where txwip028.mtid = :mtid
	selectdo
		| Sum up cost per sample of RGN000003 and RGN000004
		total.reagent.cost = total.reagent.cost + get_cost_per_sample(trim$(txwip028.rgnt))		
	endselect
	
	return(total.reagent.cost)
}

| Get the reagent cost of EACH reagents (Reagent + Solvent)
function domain tcqiv1 get_cost_per_sample(domain tcmcs.str50 rgnt){
	domain tcqiv1 sub.total, cost.per.sample, reagent.cost, solvent.cost
	domain tcqiv1 cssm, aqsm, mult
	domain tcmcs.str10 rgnt.code
	
	domain txmat.types r.mat.types, s.mat.types
	domain tcmcs.str50 r.item, s.item
	domain tiqcp1 r.volume, s.volume
	domain tccuni r.unit, s.unit
	
	cost.per.sample = 0
	sub.total = 0
	aqsm = 0
	cssm = 0
	mult = 0
	
	select txwip021.*
	from txwip021
	where txwip021.rgnt = :rgnt
	as set with 1 rows
	selectdo
		rgnt.code = txwip021.rgnt
		aqsm = txwip021.aqsm
		mult = txwip021.mult
		
		r.mat.types = ltoe(0)
		s.mat.types = ltoe(0)
		r.item = ""
		s.item = ""
		r.volume = 0
		s.volume = 0
		r.unit = ""
		s.unit = ""
				
		select txwip022.*
		from txwip022
		where txwip022.rgnt = :rgnt.code
		selectdo
			reagent.cost = 0
			solvent.cost = 0
			
			r.mat.types = txwip022.rgtp
			s.mat.types = txwip022.sltp
			r.item = trim$(txwip022.item)
			s.item = trim$(txwip022.slvn)
			r.volume = txwip022.rvol
			s.volume = txwip022.svol
			r.unit = txwip022.rgni
			s.unit = txwip022.slni
			
			reagent.cost = compute_param_cost(r.mat.types, r.item, r.volume, r.unit)
			solvent.cost = compute_param_cost(s.mat.types, s.item, s.volume, s.unit)
			sub.total = sub.total + reagent.cost + solvent.cost
		selectempty
			reagent.cost = 0
			solvent.cost = 0
		endselect
		
		if aqsm = 0 then
			cssm = 0
		else
			cssm = (sub.total / aqsm) * mult
		endif
		
		cost.per.sample = cost.per.sample + cssm
	endselect
	
	return(cost.per.sample)
}

| Get the parameter cost of EACH components of reagent on level 1
function domain tcqiv1 compute_param_cost(domain txmat.types type, domain tcmcs.str50 param, domain tiqcp1 vol, domain tccuni unit){
	domain tcqiv1 sub.total, total, cost.per.testing, reagent.cost, solvent.cost
	domain tcqiv1 cssm, aqsm, mult
	domain tccopr lot.price
	domain tcconv conversion.value
	domain tcmcs.str10 rgnt
	
	domain txmat.types r.mat.types, s.mat.types
	domain tcmcs.str50 r.item, s.item
	domain tiqcp1 r.volume, s.volume
	domain tccuni r.unit, s.unit
	
	total = 0
	
	on case etol(type)
		case 1:	| Get cost per UOM
			lot.price = 0
			conversion.value = 0
			cost.per.testing = 0
			
			lot.price = get_lot_price(trim$(param))
			conversion.value = get_conversion_value(trim$(param), unit)
			
			if conversion.value = 0 then
				cost.per.testing = 0
				total = 0
			else
				cost.per.testing = lot.price / conversion.value
				total = cost.per.testing * vol
			endif			
			break
		case 2:	| Get cost per mL
			sub.total = 0
			aqsm = 0
			cssm = 0
			mult = 0

			select txwip021.*
			from txwip021
			where txwip021.rgnt = :param
			as set with 1 rows
			selectdo
				rgnt = txwip021.rgnt
				aqsm = txwip021.aqsm
				mult = txwip021.mult
				
				r.mat.types = ltoe(0)
				s.mat.types = ltoe(0)
				r.item = ""
				s.item = ""
				r.volume = 0
				s.volume = 0
				r.unit = ""
				s.unit = ""
				
				select txwip022.*
				from txwip022
				where txwip022.rgnt = :rgnt
				selectdo
					reagent.cost = 0
					solvent.cost = 0
							
					r.mat.types = txwip022.rgtp
					s.mat.types = txwip022.sltp
					r.item = trim$(txwip022.item)
					s.item = trim$(txwip022.slvn)
					r.volume = txwip022.rvol
					s.volume = txwip022.svol
					r.unit = txwip022.rgni
					s.unit = txwip022.slni

					reagent.cost = compute_param_cost_level2(r.mat.types, r.item, r.volume, r.unit)
					solvent.cost = compute_param_cost_level2(s.mat.types, s.item, s.volume, s.unit)
					sub.total = sub.total + reagent.cost + solvent.cost
				selectempty				
					reagent.cost = 0
					solvent.cost = 0
				endselect
				
				if aqsm = 0 then
					cssm = 0
				else
					cssm = (sub.total / aqsm) * vol
				endif
				
				total = total + cssm
			endselect
			break
		case 3:	| Get cost of QC Items
			total = 0
			break
		default:
			total = 0
	endcase
	
	return(total)
}

| Get the parameter cost of EACH components of reagent on level 2
function domain tcqiv1 compute_param_cost_level2(domain txmat.types type, domain tcmcs.str50 param, domain tiqcp1 vol, domain tccuni unit){
	domain tcqiv1 sub.total, total, cost.per.testing, reagent.cost, solvent.cost
	domain tcqiv1 cssm, aqsm, mult
	domain tccopr lot.price
	domain tcconv conversion.value
	domain tcmcs.str10 rgnt
	
	domain txmat.types r.mat.types, s.mat.types
	domain tcmcs.str50 r.item, s.item
	domain tiqcp1 r.volume, s.volume
	domain tccuni r.unit, s.unit

	total = 0
	
	on case etol(type)
		case 1:	| Get cost per UOM
			lot.price = 0
			conversion.value = 0
			cost.per.testing = 0
			
			lot.price = get_lot_price(trim$(param))
			conversion.value = get_conversion_value(trim$(param), unit)
			
			if conversion.value = 0 then
				cost.per.testing = 0
				total = 0
			else
				cost.per.testing = lot.price / conversion.value
				total = cost.per.testing * vol
			endif			
			break
		case 2:	| Get cost per sample
			sub.total = 0
			aqsm = 0
			cssm = 0
			mult = 0
			
			select txwip021.*
			from txwip021
			where txwip021.rgnt = :param
			as set with 1 rows
			selectdo
				rgnt = txwip021.rgnt
				aqsm = txwip021.aqsm
				mult = txwip021.mult
				
				r.mat.types = ltoe(0)
				s.mat.types = ltoe(0)
				r.item = ""
				s.item = ""
				r.volume = 0
				s.volume = 0
				r.unit = ""
				s.unit = ""
				
				select txwip022.*
				from txwip022
				where txwip022.rgnt = :rgnt
				selectdo
					reagent.cost = 0
					solvent.cost = 0
					
					r.mat.types = txwip022.rgtp
					s.mat.types = txwip022.sltp
					r.item = trim$(txwip022.item)
					s.item = trim$(txwip022.slvn)
					r.volume = txwip022.rvol
					s.volume = txwip022.svol
					r.unit = txwip022.rgni
					s.unit = txwip022.slni
					
					reagent.cost = compute_param_cost_level3(r.mat.types, r.item, r.volume, r.unit)
					solvent.cost = compute_param_cost_level3(s.mat.types, s.item, s.volume, s.unit)
					sub.total = sub.total + reagent.cost + solvent.cost
				selectempty				
					reagent.cost = 0
					solvent.cost = 0
				endselect
				
				if aqsm = 0 then
					cssm = 0
				else
					cssm = (sub.total / aqsm) * mult
				endif
				
				total = total + cssm
			endselect
			break
		case 3:	| Get cost of QC Items
			total = 0
			break
		default:
			total = 0
	endcase
	
	return(total)	
}

| Get the parameter cost of EACH components of reagent on level 3
function domain tcqiv1 compute_param_cost_level3(domain txmat.types type, domain tcmcs.str50 param, domain tiqcp1 vol, domain tccuni unit){
	domain tcqiv1 sub.total, total, cost.per.testing, reagent.cost, solvent.cost
	domain tccopr lot.price
	domain tcconv conversion.value

	total = 0
	
	on case etol(type)
		case 1:	| Get cost per UOM
			lot.price = 0
			conversion.value = 0
			cost.per.testing = 0
			
			lot.price = get_lot_price(trim$(param))
			conversion.value = get_conversion_value(trim$(param), unit)
			
			if conversion.value = 0 then
				cost.per.testing = 0
				total = 0
			else
				cost.per.testing = lot.price / conversion.value
				total = cost.per.testing * vol
			endif			
			break
		case 2:	| Get cost per sample
			total = 0
			break
		case 3:	| Get cost of QC Items
			total = 0
			break
		default:
			total = 0
	endcase
	
	return(total)	
}

function domain tccopr get_lot_price(domain tcitem item){
	domain tcclot lot.number
	domain tccopr lot.price
	domain tcitem format.item
	domain tcqiv1 inv.qty
	
	lot.number = ""
	lot.price = 0
	
	format.item = "         " &amp; trim$(item)
	
	| Get the first valid lot (FIFO)
	select whltc105.item, whltc105.clot, whltc105.ldat
	from whltc105
	where whltc105.item = :format.item
		and whltc105.qhnd &gt; 0
		and whltc105.ldat &lt;&gt; 0
		and exists (
			select whltc100.clot
			from whltc100
			where whltc100.item = whltc105.item
				and whltc100.olot = 1
				and whltc100.ldat &lt;&gt; 0)
	order by whltc105.ldat
	as set with 1 rows
	selectdo
		lot.number = whltc105.clot
	endselect
	
	select whltc100.item, whltc100.clot, whltc100.ldat
	from whltc100
	where whltc100.item = :format.item
		and whltc100.clot = :lot.number
		and whltc100.olot = 1				| Purchase
		and whltc100.ldat &lt;&gt; 0				| Lot Date
	as set with 1 rows
	selectdo
		lot.price = 0
		
		select sum(whltc101.pric(1)):lot.price
		from whltc101
		where whltc101.item = :format.item
			and whltc101.clot = :lot.number		| Lot No
			and whltc101.cpcp = "MC0002"	  	| Material Cost			
		as set with 1 rows
		selectdo
		selectempty
			lot.price = 0
		endselect
	selectempty
		lot.price = 0
	endselect
	
	return(lot.price)
}

function domain tcconv get_conversion_value(domain tcitem item, domain tccuni unit){
	domain tcconv value
	domain tcitem format.item
	
	value = 0
	
	format.item = "         " &amp; trim$(item)
	
	select tcibd003.conv
	from tcibd003
	where tcibd003.item = :format.item
		and tcibd003.unit = :unit
	as set with 1 rows
	selectdo
		value = tcibd003.conv
	selectempty
		value = 0
	endselect
	
	return(value)
