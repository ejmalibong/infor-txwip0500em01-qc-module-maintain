| Get the sum of ALL micro test costs
function domain tcqiv1 compute_total_micro_test_cost(domain tcitem item){
	domain tcqiv1 total
	
	total = 0
	
	select txwip037.code
	from txwip037
	where txwip037.item = :item
		and txwip037.code like "M.*"
		and exists
			(select txwip024.anly
			from txwip024
			where txwip024.freq = 2			| Per Batch
			and txwip024.anly = txwip037.code)
	selectdo
		total = total + compute_micro_test_cost(txwip037.code)
	endselect
	
	return(total)
}

| Get the cost of EACH micro test (Material Cost, Reagent Cost, Labor Cost)
function domain tcqiv1 compute_micro_test_cost(domain tcorno anly){
	domain tcqiv1 sub.total, total, mtrl.cost, rgnt.cost
	domain tcorno code
	
	sub.total = 0
	total = 0
	code = trim$(anly)
	
	select txwip025.*
	from txwip025
	where txwip025.anly = :code
	selectdo
		mtrl.cost = compute_materials_cost(txwip025.mtid)
		rgnt.cost = compute_reagents_cost(txwip025.mtid)
		
		| Material Costs + Reagents Cost + Labor Cost
		sub.total = mtrl.cost + rgnt.cost + txwip025.lbst
		total = total + sub.total
	endselect
	
	return(total)
}

| Get the total material cost of EACH micro test activities
function domain tcqiv1 compute_materials_cost(domain tcmcs.long mtid){
	domain tcqiv1 sub.total, total, cost.per.testing
	domain tccopr lot.price
	domain tcconv conversion.value
	
	sub.total = 0
	total = 0
	cost.per.testing = 0

	select txwip027.*
	from txwip027
	where txwip027.mtid = :mtid
	selectdo
		lot.price = 0
		conversion.value = 0
		
		lot.price = get_lot_price(txwip027.item)
		conversion.value = get_conversion_value(txwip027.item, txwip027.cuni)
		
		if conversion.value = 0 then
			cost.per.testing = 0
			sub.total = 0
		else
			cost.per.testing = lot.price / conversion.value
			sub.total = cost.per.testing * txwip027.tsmm
		endif
		
		total = total + sub.total
	endselect
	
	return(total)
}

| Get the total reagent cost of EACH micro test activities
function domain tcqiv1 compute_reagents_cost(domain tcmcs.long mtid){
	domain tcqiv1 sub.total, total, cost.per.sample
	
	sub.total = 0
	total = 0
	cost.per.sample = 0
	
	select txwip028.mtid
	from txwip028
	where txwip028.mtid = :mtid
	selectdo
		sub.total = get_cost_per_sample(trim$(txwip028.rgnt))
		total = total + sub.total		
	endselect
	
	return(total)
}

| Get the reagent cost of EACH reagents (Reagent + Solvent)
function domain tcqiv1 get_cost_per_sample(domain tcmcs.str50 rgnt){
	domain tcqiv1 sub.total, total, reagent.cost, solvent.cost,
		reagent.lot.price, solvent.lot.price, reagent.conversion.value,
		solvent.conversion.value
	
	
	sub.total = 0
	total = 0
	
	select txwip021.*
	from txwip021
	where txwip021.rgnt = :rgnt
	as set with 1 rows
	selectdo
		
		reagent.cost = 0
		solvent.cost = 0
			
		select txwip022.*
		from txwip022
		where txwip022.rgnt = :txwip021.rgnt
		selectdo
			reagent.cost = compute_param_cost(txwip022.rgtp, trim$(txwip022.item), txwip022.rvol, txwip022.rgni)
			solvent.cost = compute_param_cost(txwip022.sltp, trim$(txwip022.slvn), txwip022.svol, txwip022.slni)
			sub.total = reagent.cost + solvent.cost
		selectempty
			reagent.cost = 0
			solvent.cost = 0
		endselect
		
		total = total + sub.total
	endselect
	
	return(total)
}

| Get the parameter cost of EACH components of reagent
function domain tcqiv1 compute_param_cost(domain txmat.types type, domain tcmcs.str50 param, domain tiqcp1 vol, domain tccuni unit){
	domain tcqiv1 sub.total, total, cost.per.uom
	domain tccopr lot.price
	domain tcconv conversion.value

	total = 0
	
	on case etol(type)
		case 1:	| Get cost per UOM
			lot.price = 0
			conversion.value = 0
			cost.per.uom = 0
			
			lot.price = get_lot_price(trim$(param))
			conversion.value = get_conversion_value(trim$(param), unit)
			
			if conversion.value = 0 then
				cost.per.uom = 0
				total = 0
			else
				cost.per.uom = lot.price / conversion.value
				total = cost.per.uom * vol
			endif			
			break
		case 2:	| Get cost per sample
			select txwip021.*
			from txwip021
			where txwip021.rgnt = :param
			as set with 1 rows
			selectdo
			
				select txwip022.*
				from txwip022
				where txwip022.rgnt = :txwip021.rgnt
				selectdo
					
					
					
				endselect
				
			endselect
			break
		case 3:	| Get cost of QC Items
			total = 0
		default:
		
	endcase
	
	return(total)	
}

function domain tccopr get_lot_price(domain tcitem item){
	domain tcclot lot.number
	domain tccopr lot.price
	
	lot.number = ""
	lot.price = 0
	
	select whltc100.item, whltc100.clot, whltc100.ldat
	from whltc100
	where whltc100.item = :item
		and whltc100.olot = 1				| Purchase
		and whltc100.ldat &lt;&gt; 0				| Lot Date
		and (select SUM(whltc105.qhnd)
			from whltc105
			where whltc105.item = whltc100.item
			and whltc105.clot = whltc100.clot) &lt;&gt; 0	| Inventory
	order by whltc100.ldat
	as set with 1 rows
	selectdo
		select sum(whltc101.pric(1)):lot.price
		from whltc101
		where whltc101.item = :whltc100.item
			and whltc101.clot = :whltc100.clot	| Lot No
			and whltc101.cpcp = "MC0002"		| Material Cost			
		as set with 1 rows
		selectdo
		selectempty
			lot.price = 0
		endselect
	endselect
	
	return(lot.price)
}

function domain tcconv get_conversion_value(domain tcitem item, domain tccuni unit){
	domain tcconv value
	
	value = 0
	
	select tcibd003.conv
	from tcibd003
	where tcibd003.item = :item
		and tcibd003.unit = :unit
	as set with 1 rows
	selectdo
		value = tcibd003.conv
	selectempty
		value = 0
	endselect
	
	return(value)
}</expression><expressionLanguageType>Baan4C</expressionLanguageType><sourceType>4</sourceType><sourceDescription>Generate QC Cost</sourceDescription><sourceName>txwip0500em02</sourceName></Source><documentation/><Attachment><type>relnotes</type><name>txwip0500em02</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em02</name></Attachment><additionalConstraints>2590</additionalConstraints><additionalInstructions/><keyword>||</keyword><application>EXTce01106</application></DR_Module><startInCompanyZero>false</startInCompanyZero><repSevLang>false</repSevLang><mainSession>true</mainSession><moduleType>1</moduleType><windowType>3</windowType><subType>4</subType><status>1</status><documentation/><objectLabel/><application>EXTce01106</application><sessionReferenceDescriptionReference>txwip0500em02</sessionReferenceDescriptionReference><sessionReferenceDescription>Generate QC Cost</sessionReferenceDescription><sessionReference>txwip0500em02</sessionReference><UIScript>txwip0500em02</UIScript></DR_Controller>