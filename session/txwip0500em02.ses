|			txwip020.amst = amst / txwip020.btsz
|			txwip020.atst = atst / txwip020.btsz
|		endif
|		
|		txwip020.qcst = txwip020.sust +
|			txwip020.amst +
|			txwip020.atst
|		
|		txwip020.gpdt = utc.num()
|		txwip020.gbby = logname$
|		
|		db.insert(ttxwip020, db.retry)
