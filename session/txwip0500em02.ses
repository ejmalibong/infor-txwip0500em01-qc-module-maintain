>false</startcommand><position>31</position><description/><name>resize.frm</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>32</position><description/><name>cust.grid</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>33</position><description/><name>cmd.options</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>34</position><description/><name>zoom</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>35</position><description/><name>interrupt</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>36</position><description/><name>end.program</name></StandardCommand><StandardCommand><active>true</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>37</position><description/><name>abort.program</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>39</position><description/><name>text.manager</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>40</position><description/><name>run.job</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>41</position><description/><name>global.delete</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>42</position><description/><name>global.copy</name></StandardCommand><StandardCommand><active>true</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>43</position><description/><name>save.defaults</name></StandardCommand><StandardCommand><active>true</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>44</position><description/><name>get.defaults</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>45</position><description/><name>start.chart</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>46</position><description/><name>start.query</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>47</position><description/><name>select.all</name></StandardCommand><defaultStartCommand>false</defaultStartCommand><DR_Module><description>Generate QC Cost</description><versionID>B61O_a_ext</versionID><type>library</type><name>txwip0500em02</name><Version><ObjectID/><classID/><checkInLabel/><documentation/><isExpired>no</isExpired><isCheckedOutParallel>no</isCheckedOutParallel><isCheckedOut>no</isCheckedOut><modificationDateTime>2026-10-21T03:41:51Z</modificationDateTime><modifiedBy>ict004</modifiedBy><creationDateTime>2026-08-06T01:56:57Z</creationDateTime><createdBy>ict004</createdBy></Version><Source><sourceVersion><ObjectID/><classID/><checkInLabel/><documentation/><isExpired>no</isExpired><isCheckedOutParallel>no</isCheckedOutParallel><isCheckedOut>no</isCheckedOut><modificationDateTime>2026-10-21T03:41:51Z</modificationDateTime><modifiedBy>ict004</modifiedBy><creationDateTime>2026-08-06T01:56:57Z</creationDateTime><createdBy>ict004</createdBy></sourceVersion><sourceVersionID>B61O_a_ext</sourceVersionID><sourceObjectID>1</sourceObjectID><expression>|*******************************************************************************
|* txwip0500em02  B61O_a_ext
|* Generate QC Cost
|* ict004
|* 2026-08-06 [09:56]
|*******************************************************************************
|* Script Type: 123
|*******************************************************************************

|*************************** declaration section *******************************
declaration:

	table	ttxwip020		|* QC Costs
	table	ttxwip021		|* Reagents	
	table	ttxwip022		|* Reagents Details
	table	ttxwip024		|* Micro Tests
	table	ttxwip025		|* Micro Test Details
	table	ttxwip026		|* QC Personnels
	table	ttxwip027		|* Micro Test Materials
	table	ttxwip028		|* Micro Test Reagents
	table	ttxwip030		|* Pychem Tests
	table	ttxwip031		|* Pychem Test Details
	table	ttxwip033		|* Third Party Tests
	table	ttxwip034		|* Third Party Test Details
	table	ttxwip035 		|* QC Items
	table	ttxwip036		|* Item Testing Costs
	table	ttxwip037		|* Item Testing Cost Details
	table	ttxwip038		|* Inline &amp; Documentation Costs
	table	ttxwip039		|* Micro Test Materials Reference
	table	ttxwip040		|* QC Cost Simulations
	table	ttxwip041		|* Micro Retests
	table	ttxwip042		|* Micro Retest Details
	table	ttxwip043		|* Micro Retest Materials
	table	ttxwip044		|* Micro Retest Reagents
	table	ttxwip045		|* Pychem Retests
	table	ttxwip046		|* Pychem Retest Details
	table	ttxwip047		|* QC Cost Retest
	table	ttxwip048		|* QC Cost Simulation Retests	
	
	table	ttcibd001		|* Items
	table	ttcibd003		|* Conversion Factors
	table	ttdipu001		|* Item - Purchase
	table	ttcmcs003		|* Warehouses
	table	ttcmcs012		|* Units by Unit Set
	table	twhltc100		|* Lots
	table	twhltc101		|* Lot Cost Details
	table	twhltc105		|* Lots by Warehouse
	table	ttccom100		|* Business Partners
	table	ttisfc001		|* Production Orders
	table	tticpr007		|* Items - Costing
	
	extern domain tcnama		bpid.desc
	extern domain tcitm.dscr	item.desc
	extern domain tcdsca		cwar.desc

|****************************** field section *********************************

field.txwip020.pdno:
before.display:
	txwip020.pdno = ""
	
after.zoom:
	load_jo_details()
	
when.field.changes:
	if trim$(txwip020.pdno) &lt;&gt; "" then
		load_jo_details()
	endif
	
check.input:
	if trim$(txwip020.pdno) = "" then
		message("Please enter JO number.")
		set.input.error("")
	endif
	
|****************************** function section ******************************

functions:

function void load_jo_details(){
	txwip020.clot = ""
	txwip020.cwar = ""
	txwip020.item = ""
	txwip020.bpid = ""

	txwip020.btsz = 0
	
	bpid.desc = ""
	item.desc = ""
	cwar.desc = ""

	select tisfc001.clot, tisfc001.cwar, tisfc001.mitm, tisfc001.cdf_orno
	from tisfc001
	where tisfc001.pdno = :txwip020.pdno
	as set with 1 rows
	selectdo
		txwip020.clot = tisfc001.clot
		txwip020.item = tisfc001.mitm
		txwip020.cwar = tisfc001.cwar
		
		if trim$(tisfc001.cdf_orno) &lt;&gt; "" then
			select tccom100.bpid, tccom100.nama
			from tccom100, tdsls400
			where tccom100.bpid = tdsls400.ofbp
			and tdsls400.orno = :tisfc001.cdf_orno
			as set with 1 rows
			selectdo
				txwip020.bpid = tccom100.bpid
				bpid.desc = tccom100.nama
			endselect
		endif
	endselect
	
	select sum(ticst001.ques):txwip020.btsz
	from ticst001, tcibd001
	where ticst001.pdno = :txwip020.pdno
	and tcibd001.item = ticst001.sitm
	and tcibd001.citg &lt;&gt; "PM"
	selectdo
	endselect
	
	select tcibd001.dsca
	from tcibd001
	where tcibd001.item = :txwip020.item
	as set with 1 rows
	selectdo
		item.desc = tcibd001.dsca
	endselect
	
	select tcmcs003.dsca
	from tcmcs003
	where tcmcs003.cwar = :txwip020.cwar
	as set with 1 rows
	selectdo
		cwar.desc = tcmcs003.dsca
	endselect
}

function extern generate_qc_cost(){
	domain tcqiv1 iidc, mtst, pyst, amst, atst, batch.qty
	domain tccwar equivalent.cwar
	long ret
	
	if trim$(txwip020.pdno) = "" then
		message("Enter a value for the Production Order field.")
		return
	endif
	
	select txwip020.*
	from txwip020
	where txwip020.pdno = :txwip020.pdno
	as set with 1 rows
	selectdo
		message("QC Cost already exists for this production order.")
		return
	endselect
	
	if trim$(txwip020.clot) = "" then
		message("No lot number found on this production order.")
		return
	endif

	iidc = 0
	mtst = 0
	pyst = 0
	amst = 0
	atst = 0
	batch.qty = 0
	
	batch.qty = txwip020.btsz
	equivalent.cwar = get_equivalent_cwar(txwip020.cwar)
	
	select txwip036.*
	from txwip036
	where txwip036.item = :txwip020.item
		and txwip036.cwar = :equivalent.cwar
	as set with 1 rows
	selectdo
		iidc = txwip036.iidc
		mtst = txwip036.mtst
		pyst = txwip036.pyst
		amst = txwip036.amst
		atst = txwip036.atst
	selectempty
		message("No testing cost setup found for this item.")
		return
	endselect
	
	execute(15)
	db.retry.point()
	
	select txwip020.*
	from txwip020
	where txwip020.pdno = :txwip020.pdno
	as set with 1 rows
	selectdo
	selectempty
		txwip020.idst = iidc
		txwip020.mtst = mtst
		txwip020.pyst = pyst
		
		if batch.qty = 0 then
			txwip020.sust = 0
			txwip020.amst = 0
			txwip020.atst = 0
		else
			txwip020.sust = (iidc + mtst + pyst) / batch.qty
			txwip020.amst = amst / batch.qty
			txwip020.atst = atst / batch.qty
		endif
		
		txwip020.qcst = txwip020.sust + txwip020.amst + txwip020.atst
		txwip020.gpdt = utc.num()
		txwip020.gbby = logname$
		db.insert(ttxwip020, db.retry)
		commit.transaction()
	endselect
	
	message("Process completed.")
	ret = refresh.parent(-1)
	end()
}

function domain tccwar get_equivalent_cwar(domain tccwar cwar){
	domain tccwar jo.cwar
	
	select tcmcs003.dsca
	from tcmcs003
	where tcmcs003.cwar = :cwar
	as set with 1 rows
	selectdo
		if str_pos(toupper$(trim$(tcmcs003.dsca)), "SITE 1") &gt; 0 then
			jo.cwar = "1CS001"
		endif
		
		if str_pos(toupper$(trim$(tcmcs003.dsca)), "SITE 2") &gt; 0 then
			jo.cwar = "1PS001"
		endif
	endselect
	
	return(jo.cwar)
}</expression><expressionLanguageType>Baan4C</expressionLanguageType><sourceType>4</sourceType><sourceDescription>Generate QC Cost</sourceDescription><sourceName>txwip0500em02</sourceName></Source><documentation/><Attachment><type>relnotes</type><name>txwip0500em02</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em02</name></Attachment><additionalConstraints>2590</additionalConstraints><additionalInstructions/><keyword>||</keyword><application>EXTce01107</application></DR_Module><startInCompanyZero>false</startInCompanyZero><repSevLang>false</repSevLang><mainSession>true</mainSession><moduleType>1</moduleType><windowType>3</windowType><subType>4</subType><status>1</status><documentation/><objectLabel/><application>EXTce01107</application><sessionReferenceDescriptionReference>txwip0500em02</sessionReferenceDescriptionReference><sessionReferenceDescription>Generate QC Cost</sessionReferenceDescription><sessionReference>txwip0500em02</sessionReference><UIScript>txwip0500em02</UIScript></DR_Controller>