|
|	selectempty
|	
|		txwip020.idst = iidc
|		txwip020.mtst = mtst
|		txwip020.pyst = pyst
|		
|		if txwip020.btsz = 0 then
|			txwip020.sust = 0
|			txwip020.amst = 0
|			txwip020.atst = 0
|		else
|			txwip020.sust = (iidc + mtst + pyst) / txwip020.btsz
|			txwip020.amst = amst / txwip020.btsz
|			txwip020.atst = atst / txwip020.btsz
|		endif
|		
|		txwip020.qcst = txwip020.sust +
|			txwip020.amst +
|			txwip020.atst
|		
|		txwip020.gpdt = utc.num()
|		txwip020.gbby = logname$
|		
|		db.insert(ttxwip020, db.retry)
