<expression>|*******************************************************************************
|* txwip0500em14  B61O_a_ext
|* Item Testing Cost
|* ict004
|* 2026-08-24 [10:23]
|*******************************************************************************
|* Script Type: 123
|*******************************************************************************

|*************************** declaration section *******************************
declaration:

	table	ttxwip020		|* QC Cost Summary
	table	ttxwip021		|* Reagents Header	
	table	ttxwip022		|* Reagents Details
	table	ttxwip024		|* Micro Test Header
	table	ttxwip025		|* Micro Test Details
	table	ttxwip026		|* QC Personnel
	table	ttxwip027		|* Micro Test Materials
	table	ttxwip028		|* Micro Test Reagents
	table	ttxwip030		|* Pychem Test Header
	table	ttxwip031		|* Pychem Test Details
	table	ttxwip033		|* Third Party Test Header
	table	ttxwip034		|* Third Party Test Details
	table	ttxwip035 		|* QC Items
	table	ttxwip036		|* QC Cost Master Data
	table	ttxwip037		|* QC Cost Details
	table	ttxwip038		|* Inline &amp; Documentation Costs
	table	ttxwip039		|* Micro Test Materials Reference

	table	ttcibd001		|* Items
	table	ttcibd003		|* Conversion Factors
	table	ttdipu001		|* Item - Purchase
	table	ttcmcs012		|* Units by Unit Set
	table	twhltc100		|* Lots
	table	twhltc101		|* Lot Cost Details
	table	twhltc105		|* Lots by Warehouse
	table	ttccom100		|* Business Partners
	table	ttisfc001		|* Production Orders
	table	ttcmcs003		|* Warehouses

	extern domain tcitem		item.desc
	extern domain tcdsca		cwar.desc
	extern domain tcitem		item
	
|****************************** program section ********************************

zoom.from.all:
on.entry:
	import("txwip020.item", item)
	
	if not isspace(item) then
		select txwip036.*
		from txwip036
		where txwip036.item = :item
		as set with 1 rows
		selectdo
		endselect
		
		execute(find.data)
	endif

main.table.io:
after.delete:
	select txwip037.*
	from txwip037 for update
	where txwip037.item = :txwip036.item
		and txwip037.cwar = :txwip036.cwar
	selectdo
		db.delete(ttxwip037, db.retry)
		commit.transaction()
	endselect

before.write:
	if txwip036.dcdt = 0 then
		txwip036.dcdt = utc.num()
	endif

before.rewrite:
	txwip036.dmdt = utc.num()
	
before.new.object:
	txwip036.iidc = 0
	txwip036.mtst = 0
	txwip036.pyst = 0
	txwip036.amst = 0
	txwip036.atst = 0
	
	update_documentation_cost()
	txwip036.cwar = "1CS001"

|****************************** field section **********************************

field.txwip036.item.segment.2:
before.display:
	update_item_desc(txwip036.item)

selection.filter:
	query.extend.where.in.zoom("tcibd001.citg IN (""FG"",""SFG"",""RM/FG"", ""RM"")")
	
when.field.changes:
	update_item_desc(txwip036.item)
	
after.zoom:
	update_item_desc(txwip036.item)
	
field.txwip036.cwar:
before.display:
	update_cwar_desc(txwip036.cwar)
	
selection.filter:
	query.extend.where.in.zoom("tcmcs003.cwar IN (""1CS001"",""1PS001"")")
	
when.field.changes:
	update_cwar_desc(txwip036.cwar)
	
after.zoom:
	update_cwar_desc(txwip036.cwar)

|****************************** function section *******************************

functions:

function extern void compute_total_cost(){
	long ret
	
	execute(15)
	update_documentation_cost()
	
	select txwip036.*
	from txwip036 for update
	where txwip036.item = :txwip036.item
		and txwip036.cwar = :txwip036.cwar
	as set with 1 rows
	selectdo
		txwip036.mtst = compute_micro_test_cost(txwip036.item, txwip036.cwar)
		txwip036.pyst = compute_pychem_test_cost(txwip036.item, txwip036.cwar)
		txwip036.amst = compute_annual_micro_test_cost(txwip036.item, txwip036.cwar)
		txwip036.atst = compute_third_party_test_cost(txwip036.item, txwip036.cwar)
		
		if db.update(ttxwip036, db.retry) &lt;&gt; 0 then
			message("Error " &amp; str$(e) &amp; " occurred while updating the record.")
			abort.transaction()
		endif
	endselect
	
	commit.transaction()
	
	select txwip036.*
	from txwip036
	where txwip036.item = :txwip036.item
	as set with 1 rows
	selectdo
	endselect

	execute(find.data)
	
	ret = refresh.parent(-1)
	synchronize.satellite("txwip0500em05")
}

function domain tcqiv1 compute_micro_test_cost(domain tcitem item, domain tccwar cwar){
	domain tcqiv1 total.cost
	
	total.cost = 0
	
	select txwip024.anly, txwip024.pyst
	from txwip024
	where txwip024.freq = 2 | per batch
		and exists
		(select txwip037.code
		 from txwip037
		 where txwip037.code = txwip024.anly
		 	and txwip037.item = :item
		 	and txwip037.cwar = :cwar)
	selectdo
		total.cost = total.cost + txwip024.pyst
	selectempty
		total.cost = 0
	endselect

	return(total.cost)
}

function domain tcqiv1 compute_pychem_test_cost(domain tcitem item, domain tccwar cwar){
	domain tcqiv1 total.cost
	
	total.cost = 0
	
	select txwip030.ptid, txwip030.pyst
	from txwip030
	where exists
		(select txwip037.code
		 from txwip037
		 where txwip037.code = txwip030.ptid
		 	and txwip037.item = :item
		 	and txwip037.cwar = :cwar)
	selectdo
		total.cost = total.cost + txwip030.pyst
	selectempty
		total.cost = 0
	endselect

	return(total.cost)
}

function domain tcqiv1 compute_annual_micro_test_cost(domain tcitem item, domain tccwar cwar){
	domain tcqiv1 total.cost
	
	total.cost = 0
	
	select txwip024.anly, txwip024.pyst
	from txwip024
	where txwip024.freq = 1 | annual
		and exists
		(select txwip037.code
		 from txwip037
		 where txwip037.code = txwip024.anly
		 	and txwip037.item = :item
		 	and txwip037.cwar = :cwar)
	selectdo
		total.cost = total.cost + txwip024.pyst
	selectempty
		total.cost = 0
	endselect

	return(total.cost)
}

function domain tcqiv1 compute_third_party_test_cost(domain tcitem item, domain tccwar cwar){
	domain tcqiv1 total.cost
	
	total.cost = 0
	
	select txwip033.tpid, txwip033.tpst
	from txwip033
	where exists
		(select txwip037.code
		 from txwip037
		 where txwip037.code = txwip033.tpid
		 	and txwip037.item = :item
		 	and txwip037.cwar = :cwar)
	selectdo
		total.cost = total.cost + txwip033.tpst
	selectempty
		total.cost = 0
	endselect

	return(total.cost)
}

function void update_item_desc(domain tcitem item){
	item.desc = get_item_desc(item)
}

function domain tcnama get_item_desc(domain tcitem item){
	domain tcitem format.item
	domain tcnama desc
	
	format.item = "         " &amp; trim$(item)
	desc = ""

	select tcibd001.dsca
	from tcibd001
	where tcibd001.item = :format.item
	selectdo
		desc = tcibd001.dsca
	endselect
	
	return(desc)
}

function void update_cwar_desc(domain tccwar cwar){
	cwar.desc = get_cwar_desc(cwar)
}

function domain tcnama get_cwar_desc(domain tccwar cwar){
	domain tcdsca desc
	
	desc = ""

	select tcmcs003.dsca
	from tcmcs003
	where tcmcs003.cwar = :cwar
	selectdo
		desc = tcmcs003.dsca
	endselect
	
	return(desc)
}

function update_documentation_cost(){
	txwip036.iidc = compute_documentation_cost()
}

function domain tcqiv1 compute_documentation_cost(){
	domain tcqiv1 total
	
	total = 0
	
	select sum(txwip038.lbst):total
	from txwip038
	selectdo
	selectempty
		total = 0
	endselect
	
	return(total)
}	

function extern load_documentation_cost(){
	start.session(MODELESS, "txwip0500em21", "txwip0500em14", "")
}</expression><expressionLanguageType>Baan4C</expressionLanguageType><sourceType>1</sourceType><sourceDescription>QC Cost</sourceDescription><sourceName>txwip0500em14</sourceName></Source><documentation/><Attachment><type>relnotes</type><name>txwip0500em14</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em14</name></Attachment><additionalConstraints>2590</additionalConstraints><additionalInstructions/><keyword>||</keyword><application>EXTce01106</application></DR_Module><startInCompanyZero>false</startInCompanyZero><repSevLang>false</repSevLang><mainSession>true</mainSession><moduleType>1</moduleType><windowType>15</windowType><subType>1</subType><status>1</status><documentation/><Attachment><type>relnotes</type><name>txwip0500em14</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em14</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em14dcwar.desc</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em14dcwar.desc</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em14ditem.desc</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em14ditem.desc</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em14dtxwip036.am</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em14dtxwip036.am</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em14dtxwip036.at</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em14dtxwip036.at</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em14dtxwip036.cw</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em14dtxwip036.cw</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em14dtxwip036.dc</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em14dtxwip036.dc</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em14dtxwip036.dm</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em14dtxwip036.dm</name></