>false</defaultcommand><startcommand>false</startcommand><position>28</position><description/><name>prev.frm</name></StandardCommand><StandardCommand><active>true</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>29</position><description/><name>last.frm</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>31</position><description/><name>resize.frm</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>32</position><description/><name>cust.grid</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>33</position><description/><name>cmd.options</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>34</position><description/><name>zoom</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>35</position><description/><name>interrupt</name></StandardCommand><StandardCommand><active>true</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>36</position><description/><name>end.program</name></StandardCommand><StandardCommand><active>true</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>37</position><description/><name>abort.program</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>39</position><description/><name>text.manager</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>40</position><description/><name>run.job</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>41</position><description/><name>global.delete</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>42</position><description/><name>global.copy</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>43</position><description/><name>save.defaults</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>44</position><description/><name>get.defaults</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>45</position><description/><name>start.chart</name></StandardCommand><StandardCommand><active>true</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>46</position><description/><name>start.query</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>47</position><description/><name>select.all</name></StandardCommand><defaultStartCommand>false</defaultStartCommand><DR_Module><description>QC Cost</description><versionID>B61O_a_ext</versionID><type>library</type><name>txwip0500em14</name><Version><ObjectID/><classID/><checkInLabel/><documentation/><isExpired>no</isExpired><isCheckedOutParallel>no</isCheckedOutParallel><isCheckedOut>no</isCheckedOut><modificationDateTime>2026-09-06T03:57:27Z</modificationDateTime><modifiedBy>ict004</modifiedBy><creationDateTime>2026-08-24T14:24:47Z</creationDateTime><createdBy>ict004</createdBy></Version><Source><sourceVersion><ObjectID/><classID/><checkInLabel/><documentation/><isExpired>no</isExpired><isCheckedOutParallel>no</isCheckedOutParallel><isCheckedOut>no</isCheckedOut><modificationDateTime>2026-09-06T03:57:27Z</modificationDateTime><modifiedBy>ict004</modifiedBy><creationDateTime>2026-08-24T14:24:47Z</creationDateTime><createdBy>ict004</createdBy></sourceVersion><sourceVersionID>B61O_a_ext</sourceVersionID><sourceObjectID>1</sourceObjectID><expression>|*******************************************************************************
|* txwip0500em14  B61O_a_ext
|* Item Testing Cost
|* ict004
|* 2026-08-24 [10:23]
|*******************************************************************************
|* Script Type: 123
|*******************************************************************************

|*************************** declaration section *******************************
declaration:

	table	ttxwip020		|* QC Cost Summary
	table	ttxwip021		|* Reagents Header	
	table	ttxwip022		|* Reagents Details
	table	ttxwip024		|* Micro Test Header
	table	ttxwip025		|* Micro Test Details
	table	ttxwip026		|* QC Personnel
	table	ttxwip027		|* Micro Test Materials
	table	ttxwip028		|* Micro Test Reagents
	table	ttxwip030		|* Pychem Test Header
	table	ttxwip031		|* Pychem Test Details
	table	ttxwip033		|* Third Party Test Header
	table	ttxwip034		|* Third Party Test Details
	table	ttxwip035 		|* QC Items
	table	ttxwip036		|* QC Cost Master Data
	table	ttxwip037		|* QC Cost Details

	table	ttcibd001		|* Items
	table	ttcibd003		|* Conversion Factors
	table	ttdipu001		|* Item - Purchase
	table	ttcmcs012		|* Units by Unit Set

	extern domain tcitem		item.desc
	extern domain tcitem		item
	
|****************************** program section ********************************

zoom.from.all:
on.entry:
	import("txwip020.item", item)
	
	if not isspace(item) then
		select txwip036.*
		from txwip036
		where txwip036.item = :item
		as set with 1 rows
		selectdo
		endselect
		
		execute(find.data)
	endif

main.table.io:
before.write:
	if txwip036.dcdt = 0 then
		txwip036.dcdt = utc.num()
	endif

before.rewrite:
	txwip036.dmdt = utc.num()
	
before.new.object:
	txwip036.iidc = 26.82

|****************************** field section **********************************

field.txwip036.item.segment.2:
selection.filter:
	query.extend.where.in.zoom("tcibd001.kitm = 2")
	
when.field.changes:
	if trim$(txwip036.item) &lt;&gt; "" then
		update_item_desc(txwip036.item)
	else
		item.desc = ""
	endif
	
field.txwip036.item:
before.display:
	update_item_desc(txwip036.item)

|****************************** function section *******************************

functions:

function extern void compute_total_cost(){
	long ret
	
	execute(15)
	
	select txwip036.*
	from txwip036 for update
	where txwip036.item = :txwip036.item
	as set with 1 rows
	selectdo
		txwip036.mtst = compute_micro_test_cost(txwip036.item)
		txwip036.pyst = compute_pychem_test_cost(txwip036.item)
		txwip036.amst = compute_annual_micro_test_cost(txwip036.item)
		txwip036.atst = compute_third_party_test_cost(txwip036.item)
		
		if db.update(ttxwip036, db.retry) &lt;&gt; 0 then
			message("Error " &amp; str$(e) &amp; " occurred while updating the record.")
			abort.transaction()
		endif
	endselect
	
	commit.transaction()
	
	select txwip036.*
	from txwip036
	where txwip036.item = :txwip036.item
	as set with 1 rows
	selectdo
	endselect

	execute(find.data)
	
	ret = refresh.parent(-1)
	synchronize.satellite("txwip0500em05")
}

function domain tcqiv1 compute_micro_test_cost(domain tcitem item){
	domain tcqiv1 total.cost
	
	total.cost = 0
	
	select txwip024.anly, txwip024.pyst
	from txwip024
	where txwip024.freq = 2 | per batch
		and exists
		(select txwip037.code
		 from txwip037
		 where txwip037.code = txwip024.anly
		 	and txwip037.item = :item)
	selectdo
		total.cost = total.cost + txwip024.pyst
	selectempty
		total.cost = 0
	endselect

	return(total.cost)
}

function domain tcqiv1 compute_pychem_test_cost(domain tcitem item){
	domain tcqiv1 total.cost
	
	total.cost = 0
	
	select txwip030.ptid, txwip030.pyst
	from txwip030
	where exists
		(select txwip037.code
		 from txwip037
		 where txwip037.code = txwip030.ptid
		 	and txwip037.item = :item)
	selectdo
		total.cost = total.cost + txwip030.pyst
	selectempty
		total.cost = 0
	endselect

	return(total.cost)
}

function domain tcqiv1 compute_annual_micro_test_cost(domain tcitem item){
	domain tcqiv1 total.cost
	
	total.cost = 0
	
	select txwip024.anly, txwip024.pyst
	from txwip024
	where txwip024.freq = 1 | annual
		and exists
		(select txwip037.code
		 from txwip037
		 where txwip037.code = txwip024.anly
		 	and txwip037.item = :item)
	selectdo
		total.cost = total.cost + txwip024.pyst
	selectempty
		total.cost = 0
	endselect

	return(total.cost)
}

function domain tcqiv1 compute_third_party_test_cost(domain tcitem item){
	domain tcqiv1 total.cost
	
	total.cost = 0
	
	select txwip033.tpid, txwip033.tpst
	from txwip033
	where exists
		(select txwip037.code
		 from txwip037
		 where txwip037.code = txwip033.tpid
		 	and txwip037.item = :item)
	selectdo
		total.cost = total.cost + txwip033.tpst
	selectempty
		total.cost = 0
	endselect

	return(total.cost)
}

function void update_item_desc(domain tcitem item){
	item.desc = get_item_dsc(item)
}

function domain tcnama get_item_dsc(domain tcitem item){
	domain tcnama desc
	
	desc = ""

	select tcibd001.dsca
	from tcibd001
	where tcibd001.item = :item
	selectdo
		desc = tcibd001.dsca
	endselect
	
	return(desc)
}</expression><expressionLanguageType>Baan4C</expressionLanguageType><sourceType>1</sourceType><sourceDescription>QC Cost</sourceDescription><sourceName>txwip0500em14</sourceName></Source><documentation/><Attachment><type>relnotes</type><name>txwip0500em14</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em14</name></Attachment><additionalConstraints>2590</additionalConstraints><additionalInstructions/><keyword>||</keyword><application>EXTce01106</application></DR_Module><startInCompanyZero>false</startInCompanyZero><repSevLang>false</repSevLang><mainSession>true</mainSession><moduleType>1</moduleType><windowType>15</windowType><subType>1</subType><status>1</status><documentation/><objectLabel/><application>EXTce01106</application><sessionReferenceDescriptionReference>txwip0500em14</sessionReferenceDescriptionReference><sessionReferenceDescription>Item Testing Cost</sessionReferenceDescription><sessionReference>txwip0500em14</sessionReference><UIScript>txwip0500em14</UIScript></DR_Controller>