nDateTime><createdBy>ict004</createdBy></sourceVersion><sourceVersionID>B61O_a_ext</sourceVersionID><sourceObjectID>1</sourceObjectID><expression>|*******************************************************************************
|* txwip0500em11  B61O_a_ext
|* Micro Test Materials
|* ict004
|* 2026-08-17 [07:37]
|*******************************************************************************
|* Script Type: 123
|*******************************************************************************

|*************************** declaration section *******************************
declaration:

	table	ttxwip020		|* QC Cost Summary
	table	ttxwip021		|* Reagents Header	
	table	ttxwip022		|* Reagents Details
	table	ttxwip024		|* Micro Test Header
	table	ttxwip025		|* Micro Test Details
	table	ttxwip026		|* QC Personnel
	table	ttxwip027		|* Micro Test Materials
	table	ttxwip028		|* Micro Test Reagents
	table	ttxwip030		|* Pychem Test Header
	table	ttxwip031		|* Pychem Test Details
	table	ttxwip033		|* Third Party Test Header
	table	ttxwip034		|* Third Party Test Details
	table	ttxwip035 		|* QC Items
	table	ttxwip036		|* QC Cost Master Data
	table	ttxwip037		|* QC Cost Details
	table	ttxwip038		|* Inline &amp; Documentation Costs
	table	ttxwip039		|* Micro Test Materials Reference

	table	ttcibd001		|* Items
	table	ttcibd003		|* Conversion Factors
	table	ttdipu001		|* Item - Purchase
	table	ttcmcs012		|* Units by Unit Set
	table	twhltc100		|* Lots
	table	twhltc101		|* Lot Cost Details
	table	twhltc105		|* Lots by Warehouse
	table	ttccom100		|* Business Partners
	table	ttisfc001		|* Production Orders

	extern domain tccwar		cwar
	extern domain tcnama		item.desc
	extern long			current.mtid

|****************************** program section ********************************

| From Micro Test Details txwip0500em10
before.program:
	import("current.mtid", current.mtid)
	import("cwar", cwar)

	if current.mtid &lt;&gt; 0 then
		query.extend.where("txwip027.mtid = " &amp; str$(current.mtid) &amp; "")
	endif

|****************************** group section **********************************


|****************************** field section **********************************
	
field.item.desc:
before.display:
	update_item_desc(txwip027.item)
	
|****************************** function section *******************************

functions:

function void update_item_desc(domain tcitem item){
	item.desc = get_item_desc(item)
}

function domain tcnama get_item_desc(domain tcitem item){
	select tcibd001.dsca
	from tcibd001
	where tcibd001.item = :item
	selectdo
		item.desc = tcibd001.dsca
	endselect
	
	return(item.desc)
}

function extern void save_close_total(){
	domain tcqiv1 total.mat.cost, total.rgt.cost, total
	long ret
	
	execute(15)
	
	total.mat.cost = 0
	total.rgt.cost = 0
	total = 0

	select sum(txwip027.csst):total.mat.cost
	from txwip027
	where txwip027.mtid = :current.mtid
	selectdo
	endselect
	
	select txwip021.rgnt, txwip021.cssm
	from txwip021
	where exists
		(select txwip028.*
		 from txwip028
		 where txwip028.mtid = :current.mtid
		 and txwip028.rgnt = txwip021.rgnt)
	selectdo
		total.rgt.cost = total.rgt.cost + txwip021.cssm
	endselect
	
	total = total.mat.cost + total.rgt.cost
	
	select txwip025.*
	from txwip025 for update
	where txwip025.mtid = :current.mtid
	selectdo
		txwip025.mcst = total
		if db.update(ttxwip025, db.retry) &lt;&gt; 0 then
			message("Error " &amp; str$(e) &amp; " occurred while updating the record.")
			abort.transaction()
		endif
	endselect
	
	commit.transaction()
	ret = refresh.parent(-1)
	end()
}

function extern load_micro_test_materials(){
	export("current.mtid", current.mtid)
	export("cwar", cwar)
	
	string total
	start.session(MODAL_OVERVIEW, "txwip0500em23",  "txwip0500em11", total)
}</expression><expressionLanguageType>Baan4C</expressionLanguageType><sourceType>1</sourceType><sourceDescription>Micro Test Materials</sourceDescription><sourceName>txwip0500em11</sourceName></Source><documentation/><Attachment><type>relnotes</type><name>txwip0500em11</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em11</name></Attachment><additionalConstraints>2590</additionalConstraints><additionalInstructions/><keyword>||</keyword><application>EXTce01106</application></DR_Module><startInCompanyZero>false</startInCompanyZero><repSevLang>false</repSevLang><mainSession>true</mainSession><moduleType>1</moduleType><windowType>6</windowType><subType>1</subType><status>1</status><documentation/><Attachment><type>relnotes</type><name>txwip0500em11</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em11</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em11ditem.desc</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em11ditem.desc</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em11dtxwip027.cs</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em11dtxwip027.cs</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em11dtxwip027.cu</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em11dtxwip027.cu</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em11dtxwip027.fr</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em11dtxwip027.fr</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em11dtxwip027.it</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em11dtxwip027.it</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em11dtxwip027.mt</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em11dtxwip027.mt</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em11dtxwip027.pr</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em11dtxwip027.pr</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em11dtxwip027.ts</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em11dtxwip027.ts</name></Attachment><objectLabel/><application>EXTce01106</application><sessionReferenceDescriptionReference>txwip0500em11</sessionReferenceDescriptionReference><sessionReferenceDescription>Micro Test Materials</sessionReferenceDescription><sessionReference>txwip0500em11</sessionReference><UIScript>txwip0500em11</UIScript></DR_Controller>