|****************************** choice section *********************************

choice.run.job:
before.choice:
	update_all_lot_price_cost()

|****************************** function section *******************************

functions:

function extern update_all_lot_price_cost(){
	update_reagent_costs()
	update_micro_test_material_references()
	update_pychem_material_costs()
	update_micro_test_cost_totals()
	update_pychem_test_cost_totals()
	update_current_item_testing_costs()
	
	commit.transaction()

	message("QC costing refresh completed. Review Job History Messages for skipped costs.")
}

|*******************************************************************************
|* 1. Reagent and solvent costs.
|* Matches txwip0500em05:
|* - FG/SFG/RM-FG use standard cost divided by 1000.
|* - Other inventory items use unit-specific conversion and FIFO lot price.
|* - A computed zero never overwrites a stored cost.
|*******************************************************************************

function extern update_reagent_costs(){
	domain tcqiv1 rgst.cost, slst.cost
	domain tcqiv1 new.cost, cost.ml, cost.sample

	select txwip021.*
	from txwip021 for update
	selectdo
		rgst.cost = 0
		slst.cost = 0

		select txwip022.*
		from txwip022 for update
		where txwip022.rgnt = :txwip021.rgnt
		selectdo
			new.cost = compute_param_cost(txwip021.cwar, txwip022.rgtp, txwip022.item,
				txwip022.rvol, txwip022.rgni, "Reagent Code: " &amp; trim$(txwip021.rgnt))

			if new.cost &lt;&gt; 0 then
				txwip022.rgst = new.cost
			endif

			new.cost = compute_param_cost(txwip021.cwar, txwip022.sltp, txwip022.slvn,
				txwip022.svol, txwip022.slni, "Reagent Code: " &amp; trim$(txwip021.rgnt))

			if new.cost &lt;&gt; 0 then
				txwip022.slst = new.cost
			endif

			rgst.cost = rgst.cost + txwip022.rgst
			slst.cost = slst.cost + txwip022.slst

			if db.update(ttxwip022, db.retry) &lt;&gt; 0 then
				message("Error updating reagent detail costs.")
				abort.transaction()
			endif
		endselect

		if (rgst.cost + slst.cost) &lt;&gt; 0 then
			txwip021.ttst = rgst.cost + slst.cost

			if txwip021.aqsm &lt;&gt; 0 then
				cost.ml = txwip021.ttst / txwip021.aqsm
				cost.sample = cost.ml * txwip021.mult

				if cost.ml &lt;&gt; 0 then
					txwip021.csst = cost.ml
				endif

				if cost.sample &lt;&gt; 0 then
					txwip021.cssm = cost.sample
				endif
			endif

			if db.update(ttxwip021, db.retry) &lt;&gt; 0 then
				message("Error updating reagent header costs.")
				abort.transaction()
			endif
		endif
	endselect

|	commit.transaction()
}

|*******************************************************************************
|* 2. Micro-test material references and existing normal/retest copies.
|* Matches txwip0500em23:
|* lot price / conversion value * configured testing quantity.
|*******************************************************************************

function extern update_micro_test_material_references(){
	domain tcqiv1 cost.per.testing
	domain tccopr lot.price
	domain tcconv conversion.value
	domain tcclot available.lot
	domain tcitem format.item

	select txwip039.*
	from txwip039 for update
	selectdo
		lot.price = 0
		conversion.value = 0
		available.lot = ""

		format.item = "         " &amp; trim$(txwip039.item)

		conversion.value = get_conversion_value(format.item, txwip039.cuni)
		available.lot = get_available_lot(format.item, txwip039.cwar)

		if conversion.value = 0 then
			log_micro_material_issue(txwip039.item, txwip039.cwar, "No conversion value")
		endif

		if available.lot = "" then
			log_micro_material_issue(txwip039.item, txwip039.cwar,	"No available stocks")
		else
			lot.price = get_item_lot_price(format.item, txwip039.cwar)

			if lot.price = 0 then
				log_micro_material_issue(txwip039.item, txwip039.cwar,	"No lot price")
			endif
		endif

		if conversion.value &lt;&gt; 0 and available.lot &lt;&gt; "" and lot.price &lt;&gt; 0 then
			cost.per.testing = lot.price / conversion.value * txwip039.tsmm

			if cost.per.testing &lt;&gt; 0 then
				txwip039.prip = lot.price
				txwip039.csst = cost.per.testing

				if db.update(ttxwip039, db.retry) &lt;&gt; 0 then
					message("Error updating micro-test material reference.")
					abort.transaction()
				endif
			endif
		endif

		| Copy valid stored reference costs to existing normal test
		| details.
		if txwip039.prip &lt;&gt; 0 and txwip039.csst &lt;&gt; 0 then
			select txwip024.*
			from txwip024
			where txwip024.cwar = :txwip039.cwar
			selectdo
			
				select txwip025.*
				from txwip025
				where txwip025.anly = :txwip024.anly
				selectdo
				
					select txwip027.*
					from txwip027 for update
					where txwip027.mtid = :txwip025.mtid
						and txwip027.item = :txwip039.item
					selectdo
						txwip027.prip = txwip039.prip
						txwip027.csst = txwip039.csst
						
						if db.update(ttxwip027, db.retry) &lt;&gt; 0 then
							message("Error updating micro-test material costs.")
							abort.transaction()
						endif
					endselect
					
				endselect
			endselect
			
			select txwip041.*
			from txwip041
			where txwip041.cwar = :txwip039.cwar
			selectdo
			
				select txwip042.*
				from txwip042
				where txwip042.anly = :txwip041.anly
				selectdo
				
					select txwip043.*
					from txwip043 for update
					where txwip043.mtid = :txwip042.mtid
						and txwip043.item = :txwip039.item
					selectdo
						txwip043.prip = txwip039.prip
						txwip043.csst = txwip039.csst
						
						if db.update(ttxwip043, db.retry) &lt;&gt; 0 then
							message("Error updating micro-retest material costs.")
							abort.transaction()
						endif
					endselect
					
				endselect
			endselect
		endif

| 		BACKUP CODE
|		if txwip039.prip &lt;&gt; 0 and txwip039.csst &lt;&gt; 0 then
|			select txwip027.*
|			from txwip027 for update
|			where txwip027.item = :txwip039.item
|			selectdo
|				txwip027.prip = txwip039.prip
|				txwip027.csst = txwip039.csst
|
|				if db.update(ttxwip027, db.retry) &lt;&gt; 0 then
|					message("Error updating micro-test material costs.")
|					abort.transaction()
|				endif
|			endselect
|
|			| Copy valid stored reference costs to existing retest details.
|			select txwip043.*
|			from txwip043 for update
|			where txwip043.item = :txwip039.item
|			selectdo
|				txwip043.prip = txwip039.prip
|				txwip043.csst = txwip039.csst
|
|				if db.update(ttxwip043, db.retry) &lt;&gt; 0 then
|					message("Error updating micro-test retest material costs.")
|					abort.transaction()
|				endif
|			endselect
|		endif
	endselect

|	commit.transaction()
}

|*******************************************************************************
|* Log a micro material issue for each test using the component.
|* txwip024 contains the micro test code, not a separate activity description.
|*******************************************************************************

function void log_micro_material_issue(domain tcitem item, domain tccwar cwar, domain tcmcs.str50 issue){
	long found

	found = 0
	
	select txwip024.*
	from txwip024
	where txwip024.cwar = :cwar
	selectdo
	
		select txwip025.*
		from txwip025
		where txwip025.anly = :txwip024.anly
		selectdo
		
			select txwip027.*
			from txwip027
			where txwip027.mtid = :txwip025.mtid
				and txwip027.item = :item
			as set with 1 rows
			selectdo
				message(issue &amp; ": Micro Test Code: " &amp; trim$(txwip024.anly) &amp; " - " &amp; trim$(item))
				found = 1
			endselect
		
		endselect
	
	endselect

	select txwip041.*
	from txwip041
	where txwip041.cwar = :cwar
	selectdo
	
		select txwip042.*
		from txwip042
		where txwip042.anly = :txwip041.anly
		selectdo
		
			select txwip043.mtid
			from txwip043
			where txwip043.mtid = :txwip042.mtid
				and txwip043.item = :item
			as set with 1 rows
			selectdo
				message(issue &amp; ": Micro Retest Code: " &amp; trim$(txwip041.anly) &amp; " - " &amp; trim$(item))
				found = 1
			endselect
		
		endselect
	
	endselect

	if found = 0 then
		message(issue &amp; ": Micro Test Material Reference: " &amp; trim$(item) &amp; " - Warehouse: " &amp; trim$(cwar))
	endif
}

|*******************************************************************************
|* 3. Pychem normal and retest material details.
|* Normal details use txwip031 fields.
|* Retest details use txwip046 fields. Do not read normal detail fields here.
|*******************************************************************************

function extern update_pychem_material_costs(){
	domain tcqiv1 material.cost
	domain tccwar cwar

	select txwip030.*
	from txwip030
	selectdo
		cwar = txwip030.cwar

		select txwip031.*
		from txwip031 for update
		where txwip031.ptid = :txwip030.ptid
		selectdo
			material.cost = compute_qc_material_cost(txwip031.mttp, txwip031.mtrl, txwip031.aqsm, cwar, "Pychem Test Code: " &amp; trim$(txwip030.ptid))

			if material.cost &lt;&gt; 0 then
				txwip031.mcst = material.cost

				if db.update(ttxwip031, db.retry) &lt;&gt; 0 then
					message("Error updating Pychem material costs.")
					abort.transaction()
				endif
			endif
		endselect
	endselect

	select txwip045.*
	from txwip045
	selectdo
		cwar = txwip045.cwar

		select txwip046.*
		from txwip046 for update
		where txwip046.ptid = :txwip045.ptid
		selectdo
			material.cost = compute_qc_material_cost(txwip046.mttp, txwip046.mtrl, txwip046.aqsm, cwar, "Pychem Test Code: " &amp; trim$(txwip045.ptid))

			if material.cost &lt;&gt; 0 then
				txwip046.mcst = material.cost

				if db.update(ttxwip046, db.retry) &lt;&gt; 0 then
					message("Error updating Pychem retest material costs.")
					abort.transaction()
				endif
			endif
		endselect
	endselect

|	commit.transaction()
}

|*******************************************************************************
|* Pychem formula matches txwip0500em17 and txwip0500em33.
|* Type 1: standard cost for FG/SFG/RM-FG/RM, otherwise lot price / conversion.
|* Type 2: reagent cost per sample.
|* Type 3: configured QC-item price directly.
|*******************************************************************************

function domain tcqiv1 compute_qc_material_cost(domain txmat.types type, domain tcmcs.str50 param, domain tiqcp1 quantity,
	domain tccwar cwar, domain tcmcs.str100 context){
	domain tcqiv1 total, cost.per.testing
	domain tccopr item.price
	domain tcconv conversion.value
	domain tcitem format.item
	domain tcclot available.lot

	total = 0
	item.price = 0
	conversion.value = 0
	cost.per.testing = 0
	available.lot = ""

	on case etol(type)
		case 1:
			format.item = "         " &amp; trim$(param)

			select tcibd001.item
			from tcibd001
			where tcibd001.item = :format.item
				and tcibd001.citg IN ("FG", "SFG", "RM/FG", "RM")
			selectdo
				item.price = get_item_standard_cost(format.item)

				if item.price = 0 then
					message("No standard cost: " &amp; context &amp; " - " &amp; trim$(param))
				else
					conversion.value = 1000
					cost.per.testing = item.price / conversion.value
					total = cost.per.testing * quantity
				endif
			selectempty
				conversion.value = get_conversion_value_by_item(format.item)
				available.lot = get_available_lot(format.item, cwar)

				if conversion.value = 0 then
					message("No conversion value: " &amp; context &amp; " - " &amp; trim$(param))
				endif

				if available.lot = "" then
					message("No available stocks: " &amp; context &amp; " - " &amp; trim$(param))
				else
					item.price = get_item_lot_price(format.item, cwar)

					if item.price = 0 then
						message("No lot price: " &amp; context &amp; " - " &amp; trim$(param))
					endif
				endif

				if conversion.value &lt;&gt; 0 and
					available.lot &lt;&gt; "" and
					item.price &lt;&gt; 0 then

					cost.per.testing = item.price / conversion.value
					total = cost.per.testing * quantity
				endif
			endselect
			break

		case 2:
			format.item = trim$(param)

			select txwip021.csst
			from txwip021
			where txwip021.rgnt = :format.item
				and txwip021.cwar = :cwar
			as set with 1 rows
			selectdo
				total = quantity * txwip021.csst
			selectempty
				message("No reagent cost setup: " &amp; context &amp; " - " &amp; trim$(param))
			endselect
			break

		case 3:
			format.item = trim$(param)

			select txwip035.prip
			from txwip035
			where txwip035.qitm = :format.item
			as set with 1 rows
			selectdo
				total = txwip035.prip

|				if total = 0 then
|					message("No QC item price: " &amp; context &amp; " - " &amp; trim$(param))
|				endif
			selectempty
				message("No QC item setup: " &amp; context &amp; " - " &amp; trim$(param))
			endselect
			break

		default:
			total = 0
	endcase

	return(total)
}

|*******************************************************************************
|* 4. Micro test and micro retest material totals.
|*******************************************************************************

function extern update_micro_test_cost_totals(){
	domain tcqiv1 material.cost, labor.cost, total.cost

	select txwip025.*
	from txwip025
	where txwip025.prmt = 2
	selectdo
		material.cost = compute_micro_material_total(txwip025.mtid)

		if material.cost &lt;&gt; 0 then
			select txwip025.*
			from txwip025 for update
			where txwip025.mtid = :txwip025.mtid
			selectdo
				txwip025.mcst = material.cost

				if db.update(ttxwip025, db.retry) &lt;&gt; 0 then
					message("Error updating micro-test detail totals.")
					abort.transaction()
				endif
			endselect
		endif
	endselect

	select txwip024.*
	from txwip024
	selectdo
		labor.cost = 0
		material.cost = 0

		select sum(txwip025.lbst):labor.cost,
			sum(txwip025.mcst):material.cost
		from txwip025
		where txwip025.anly = :txwip024.anly
		selectdo
		endselect

		total.cost = labor.cost + material.cost

		if total.cost &lt;&gt; 0 then
			select txwip024.*
			from txwip024 for update
			where txwip024.anly = :txwip024.anly
			selectdo
				if labor.cost &lt;&gt; 0 then
					txwip024.tlst = labor.cost
				endif

				if material.cost &lt;&gt; 0 then
					txwip024.tmst = material.cost
				endif

				txwip024.pyst = total.cost

				if db.update(ttxwip024, db.retry) &lt;&gt; 0 then
					message("Error updating micro-test header totals.")
					abort.transaction()
				endif
			endselect
		endif
	endselect

	select txwip042.*
	from txwip042
	where txwip042.prmt = 2
	selectdo
		material.cost = compute_micro_retest_material_total(txwip042.mtid)

		if material.cost &lt;&gt; 0 then
			select txwip042.*
			from txwip042 for update
			where txwip042.mtid = :txwip042.mtid
			selectdo
				txwip042.mcst = material.cost

				if db.update(ttxwip042, db.retry) &lt;&gt; 0 then
					message("Error updating micro-test retest detail totals.")
					abort.transaction()
				endif
			endselect
		endif
	endselect

	select txwip041.*
	from txwip041
	selectdo
		labor.cost = 0
		material.cost = 0

		select sum(txwip042.lbst):labor.cost,
			sum(txwip042.mcst):material.cost
		from txwip042
		where txwip042.anly = :txwip041.anly
		selectdo
		endselect

		total.cost = labor.cost + material.cost

		if total.cost &lt;&gt; 0 then
			select txwip041.*
			from txwip041 for update
			where txwip041.anly = :txwip041.anly
			selectdo
				if labor.cost &lt;&gt; 0 then
					txwip041.tlst = labor.cost
				endif

				if material.cost &lt;&gt; 0 then
					txwip041.tmst = material.cost
				endif

				txwip041.pyst = total.cost

				if db.update(ttxwip041, db.retry) &lt;&gt; 0 then
					message("Error updating micro-test retest header totals.")
					abort.transaction()
				endif
			endselect
		endif
	endselect

|	commit.transaction()
}

function domain tcqiv1 compute_micro_material_total(domain tcmcs.long mtid){
	domain tcqiv1 total.mat.cost, total.rgt.cost, total

	total.mat.cost = 0
	total.rgt.cost = 0
	total = 0

	select sum(txwip027.csst):total.mat.cost
	from txwip027
	where txwip027.mtid = :mtid
	selectdo
	endselect
	
	| Cannot remember the purpose of Diluent (csst) from Micro Test Reagent
	select sum(txwip028.csst):total.rgt.cost
	from txwip028
	where txwip028.mtid = :mtid
	selectdo
	endselect

	| Backup code for above working as of Oct 30, 2026
|	select txwip021.*
|	from txwip021
|	where exists
|		(select txwip028.rgnt
|		 from txwip028
|		 where txwip028.mtid = :mtid
|			and txwip028.rgnt = txwip021.rgnt)
|	selectdo
|		total.rgt.cost = total.rgt.cost + txwip021.cssm
|	endselect

	total = total.mat.cost + total.rgt.cost

	return(total)
}

function domain tcqiv1 compute_micro_retest_material_total(domain tcmcs.long mtid){
	domain tcqiv1 total.mat.cost, total.rgt.cost, total

	total.mat.cost = 0
	total.rgt.cost = 0
	total = 0

	select sum(txwip043.csst):total.mat.cost
	from txwip043
	where txwip043.mtid = :mtid
	selectdo
	endselect

	| Cannot remember the purpose of Diluent (csst) from Micro Test Reagent
	select sum(txwip044.csst):total.rgt.cost
	from txwip044
	where txwip044.mtid = :mtid
	selectdo
	endselect

	| Backup code for above working as of Oct 30, 2026
|	select txwip021.*
|	from txwip021
|	where exists
|		(select txwip044.rgnt
|		 from txwip044
|		 where txwip044.mtid = :mtid
|			and txwip044.rgnt = txwip021.rgnt)
|	selectdo
|		total.rgt.cost = total.rgt.cost + txwip021.cssm
|	endselect

	total = total.mat.cost + total.rgt.cost

	return(total)
}

|*******************************************************************************
|* 5. Pychem test and Pychem retest totals.
|*******************************************************************************

function extern update_pychem_test_cost_totals(){
	domain tcqiv1 material.cost, labor.cost, total, total.retest

	material.cost = 0
	labor.cost = 0
	total = 0
	total.retest = 0

	select txwip030.*
	from txwip030
	selectdo
		material.cost = 0
		labor.cost = txwip030.tlst

		select sum(txwip031.mcst):material.cost
		from txwip031
		where txwip031.ptid = :txwip030.ptid
		selectdo
		endselect

		total = labor.cost + material.cost

		if total &lt;&gt; 0 then
			select txwip030.*
			from txwip030 for update
			where txwip030.ptid = :txwip030.ptid
			selectdo
				if material.cost &lt;&gt; 0 then
					txwip030.tmst = material.cost
				endif

				txwip030.pyst = total

				if db.update(ttxwip030, db.retry) &lt;&gt; 0 then
					message("Error updating Pychem test totals.")
					abort.transaction()
				endif
			endselect
		endif
	endselect

	select txwip045.*
	from txwip045
	selectdo
		material.cost = 0
		labor.cost = txwip045.tlst

		select sum(txwip046.mcst):material.cost
		from txwip046
		where txwip046.ptid = :txwip045.ptid
		selectdo
		endselect

		total.retest = labor.cost + material.cost

		if total.retest &lt;&gt; 0 then
			select txwip045.*
			from txwip045 for update
			where txwip045.ptid = :txwip045.ptid
			selectdo
				if material.cost &lt;&gt; 0 then
					txwip045.tmst = material.cost
				endif

				txwip045.pyst = total.retest

				if db.update(ttxwip045, db.retry) &lt;&gt; 0 then
					message("Error updating Pychem retest totals.")
					abort.transaction()
				endif
			endselect
		endif
	endselect

|	commit.transaction()
}

|*******************************************************************************
|* 6. Current item testing totals.
|* Historical QC cost/simulation snapshots are not updated.
|*******************************************************************************

function extern update_current_item_testing_costs(){
	domain tcqiv1 micro.cost, pychem.cost, annual.cost, third.party.cost

	select txwip036.*
	from txwip036
	selectdo
		micro.cost = 0
		pychem.cost = 0
		annual.cost = 0
		third.party.cost = 0

		select txwip024.*
		from txwip024
		where txwip024.freq = 2
			and exists
			(select txwip037.code
			 from txwip037
			 where txwip037.code = txwip024.anly
				and txwip037.item = :txwip036.item
				and txwip037.cwar = :txwip036.cwar)
		selectdo
			micro.cost = micro.cost + txwip024.pyst
		endselect

		select txwip030.*
		from txwip030
		where exists
			(select txwip037.code
			 from txwip037
			 where txwip037.code = txwip030.ptid
				and txwip037.item = :txwip036.item
				and txwip037.cwar = :txwip036.cwar)
		selectdo
			pychem.cost = pychem.cost + txwip030.pyst
		endselect

		select txwip024.*
		from txwip024
		where txwip024.freq = 1
			and exists
			(select txwip037.code
			 from txwip037
			 where txwip037.code = txwip024.anly
				and txwip037.item = :txwip036.item
				and txwip037.cwar = :txwip036.cwar)
		selectdo
			annual.cost = annual.cost + txwip024.pyst
		endselect

		select txwip033.*
		from txwip033
		where exists
			(select txwip037.code
			 from txwip037
			 where txwip037.code = txwip033.tpid
				and txwip037.item = :txwip036.item
				and txwip037.cwar = :txwip036.cwar)
		selectdo
			third.party.cost = third.party.cost + txwip033.tpst
		endselect

		if micro.cost &lt;&gt; 0 or pychem.cost &lt;&gt; 0 or annual.cost &lt;&gt; 0 or third.party.cost &lt;&gt; 0 then
			select txwip036.*
			from txwip036 for update
			where txwip036.item = :txwip036.item
				and txwip036.cwar = :txwip036.cwar
			as set with 1 rows
			selectdo
				if micro.cost &lt;&gt; 0 then
					txwip036.mtst = micro.cost
				endif

				if pychem.cost &lt;&gt; 0 then
					txwip036.pyst = pychem.cost
				endif

				if annual.cost &lt;&gt; 0 then
					txwip036.amst = annual.cost
				endif

				if third.party.cost &lt;&gt; 0 then
					txwip036.atst = third.party.cost
				endif

				if db.update(ttxwip036, db.retry) &lt;&gt; 0 then
					message("Error updating current QC item testing costs.")
					abort.transaction()
				endif
			endselect
		endif
	endselect

|	commit.transaction()
}

|*******************************************************************************
|* Shared reagent/solvent cost calculation.
|* Signature follows txwip0500em05, with warehouse and log context added.
|*******************************************************************************

function domain tcqiv1 compute_param_cost(domain tccwar cwar, domain txmat.types type, domain tcmcs.str50 param,
	domain tiqcp1 vol, domain tccuni unit, domain tcmcs.str100 context){
	domain tcqiv1 total, cost.per.testing
	domain tccopr item.lot.price
	domain tcconv conversion.value
	domain tcitem format.item
	domain tcclot available.lot

	total = 0
	item.lot.price = 0
	conversion.value = 0
	cost.per.testing = 0
	available.lot = ""

	on case etol(type)
		case 1:
			format.item = "         " &amp; trim$(param)

			select tcibd001.item
			from tcibd001
			where tcibd001.item = :format.item
				and tcibd001.citg IN ("FG", "SFG", "RM/FG")
			selectdo
				item.lot.price = get_item_standard_cost(format.item)

				if item.lot.price = 0 then
					message("No standard cost: " &amp; context &amp; " - " &amp; trim$(param))
				else
					conversion.value = 1000
					cost.per.testing = item.lot.price / conversion.value
					total = cost.per.testing * vol
				endif
			selectempty
				conversion.value = get_conversion_value(format.item, unit)
				available.lot = get_available_lot(format.item, cwar)

				if conversion.value = 0 then
					message("No conversion value: " &amp; context &amp; " - " &amp; trim$(param))
				endif

				if available.lot = "" then
					message("No available stocks: " &amp; context &amp; " - " &amp; trim$(param))
				else
					item.lot.price = get_item_lot_price(format.item, cwar)

					if item.lot.price = 0 then
						message("No lot price: " &amp; context &amp; " - " &amp; trim$(param))
					endif
				endif

				if conversion.value &lt;&gt; 0 and available.lot &lt;&gt; "" and item.lot.price &lt;&gt; 0 then
					cost.per.testing = item.lot.price / conversion.value
					total = cost.per.testing * vol
				endif
			endselect
			break

		case 2:
			format.item = trim$(param)

			select txwip021.csst
			from txwip021
			where txwip021.rgnt = :format.item
			as set with 1 rows
			selectdo
				total = vol * txwip021.csst
			selectempty
				message("No reagent cost setup: " &amp; context &amp; " - " &amp; trim$(param))
			endselect
			break

		case 3:
			format.item = trim$(param)

			select txwip035.prip, txwip035.conv
			from txwip035
			where txwip035.qitm = :format.item
			as set with 1 rows
			selectdo
				item.lot.price = txwip035.prip
				conversion.value = txwip035.conv

				if conversion.value = 0 then
					message("No conversion value: " &amp; context &amp; " - " &amp; trim$(param))
|				elif item.lot.price = 0 then
|					message("No QC item price: " &amp; context &amp; " - " &amp; trim$(param))
				else
					cost.per.testing = item.lot.price / conversion.value
					total = cost.per.testing * vol
				endif
			selectempty
				message("No QC item setup: " &amp; context &amp; " - " &amp; trim$(param))
			endselect
			break

		default:
			total = 0
	endcase

	return(total)
}

|*******************************************************************************
|* FIFO lot lookup using the same stock/location rules as the source sessions.
|*******************************************************************************

function domain tcclot get_available_lot(domain tcitem item, domain tccwar cwar){
	domain tcclot lot.number
	domain tcitem format.item
	domain whloca location

	lot.number = ""
	format.item = "         " &amp; trim$(item)
	
	location =  get_location(cwar)

	select whinr140.*
	from whinr140
	where whinr140.item = :format.item
		and whinr140.cwar = :cwar
		and whinr140.loca = :location		| Location	
		and whinr140.idat &lt;&gt; 0			| With inventory date
		and (whinr140.qhnd - whinr140.qblk) &gt; 0	| On-hand - Blocked
	order by whinr140.idat
	as set with 1 rows
	selectdo
		lot.number = whinr140.clot
	selectempty
		lot.number = ""
	endselect

	return(lot.number)
}

function domain tccopr get_item_lot_price(domain tcitem item, domain tccwar cwar){
	domain tcclot lot.number
	domain tccopr item.lot.price
	domain tcitem format.item
	domain whloca location
	
	item.lot.price = 0
	lot.number = ""
	format.item = "         " &amp; trim$(item)
	
	location =  get_location(cwar)
	
	| Get first valid lot (FIFO)
	select whinr140.*
	from whinr140
	where whinr140.item = :format.item
		and whinr140.cwar = :cwar		| Warehouse
		and whinr140.loca = :location		| Location
		and whinr140.idat &lt;&gt; 0			| Inventory Date
		and (whinr140.qhnd - whinr140.qblk) &gt; 0 | On-hand - Blocked
	order by whinr140.idat
	as set with 1 rows
	selectdo
		lot.number = whinr140.clot
	endselect
	
	select sum(whltc101.pric(1)):item.lot.price
	from whltc101
	where whltc101.item = :format.item
		and whltc101.clot = :lot.number		| Lot No
		and whltc101.cpcp = "MC0002"	  	| Material Cost			
	as set with 1 rows
	selectdo
	endselect

	return(item.lot.price)
}

function domain whloca get_location(domain tccwar cwar){
	if cwar = "1CS001" then
		return("110S1QCD01")
	else
		return("110S2QCD01")
	endif
}

|*******************************************************************************
|* Unit-specific conversion lookup, matching txwip0500em05 and em23.
|*******************************************************************************

function domain tcconv get_conversion_value(domain tcitem item, domain tccuni unit){
	domain tcconv value
	domain tcitem format.item

	value = 0
	format.item = "         " &amp; trim$(item)

	select tcibd003.conv
	from tcibd003
	where tcibd003.item = :format.item
		and tcibd003.unit = :unit
	as set with 1 rows
	selectdo
		value = tcibd003.conv
	selectempty
		value = 0
	endselect

	return(value)
}

|*******************************************************************************
|* Item-level conversion lookup, matching txwip0500em17 and em33.
|*******************************************************************************

function domain tcconv get_conversion_value_by_item(domain tcitem item){
	domain tcconv value
	domain tcitem format.item

	value = 0
	format.item = "         " &amp; trim$(item)

	select tcibd003.conv
	from tcibd003
	where tcibd003.item = :format.item
	as set with 1 rows
	selectdo
		value = tcibd003.conv
	selectempty
		value = 0
	endselect

	return(value)
}

function domain tccopr get_item_standard_cost(domain tcitem item){
	domain tccopr cost

	cost = 0

	select ticpr007.ecpr
	from ticpr007
	where ticpr007.item = :item
	selectdo
		cost = ticpr007.ecpr(1)
	selectempty
		cost = 0
	endselect

	return(cost)
}
