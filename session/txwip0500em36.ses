|* txwip0500em36  B61O_a_ext
|* Update Costs Based on Lot Price
|* ict004
|* 2026-10-15 [03:01]
|*******************************************************************************
|* Script Type: 123
|*******************************************************************************

|*************************** declaration section *******************************
declaration:

	table	ttxwip020		|* QC Costs
	table	ttxwip021		|* Reagents	
	table	ttxwip022		|* Reagents Details
	table	ttxwip024		|* Micro Tests
	table	ttxwip025		|* Micro Test Details
	table	ttxwip026		|* QC Personnels
	table	ttxwip027		|* Micro Test Materials
	table	ttxwip028		|* Micro Test Reagents
	table	ttxwip030		|* Pychem Tests
	table	ttxwip031		|* Pychem Test Details
	table	ttxwip033		|* Third Party Tests
	table	ttxwip034		|* Third Party Test Details
	table	ttxwip035 		|* QC Items
	table	ttxwip036		|* Item Testing Costs
	table	ttxwip037		|* Item Testing Cost Details
	table	ttxwip038		|* Inline &amp; Documentation Costs
	table	ttxwip039		|* Micro Test Materials Reference
	table	ttxwip040		|* QC Cost Simulations
	table	ttxwip041		|* Micro Retests
	table	ttxwip042		|* Micro Retest Details
	table	ttxwip043		|* Micro Retest Materials
	table	ttxwip044		|* Micro Retest Reagents
	table	ttxwip045		|* Pychem Retests
	table	ttxwip046		|* Pychem Retest Details
	table	ttxwip047		|* QC Cost Retests
	table	ttxwip048		|* QC Cost Retest Details
	table	ttxwip049		|* QC Simulation Retests
	table	ttxwip050		|* QC Simulation Retest Details
	
	table	ttcibd001		|* Items
	table	ttcibd003		|* Conversion Factors
	table	ttdipu001		|* Item - Purchase
	table	ttcmcs003		|* Warehouses
	table	ttcmcs012		|* Units by Unit Set
	table	twhltc101		|* Lot Cost Details
	table	ttccom100		|* Business Partners
	table	ttisfc001		|* Production Orders
	table	tticpr007		|* Items - Costing
	table	twhinr140		|* Inventory
	
	extern domain tcdate		date.now

|****************************** program section ********************************


|****************************** group section **********************************

group.1:
init.group:
	get.screen.defaults()

|****************************** choice section *********************************

choice.run.job:
before.choice:
	update_all_lot_price_costs()
	
|****************************** function section *******************************

functions:

function extern update_all_lot_price_costs(){
	update_reagent_costs()
|	update_micro_test_material_references()
|	update_pychem_material_costs()
|	update_micro_test_cost_totals()
|	update_pychem_test_cost_totals()
|	update_current_item_testing_costs()

	message("Current QC costing records have been recalculated.")
}

|*******************************************************************************
|* 1. Recalculate reagent detail costs and reagent totals.
|*
|* Uses the existing validated compute_param_cost(), which calls
|* get_item_lot_price() or get_item_standard_cost() according to the
|* existing parameter type and item category rules.
|*******************************************************************************

function extern update_reagent_costs(){
	domain tcqiv1 rgst.cost, slst.cost
	
	select txwip021.rgnt, txwip021.cwar
	from txwip021
	where txwip021.rgnt IN ('RGN000019', 'RGN000020')
	selectdo
		rgst.cost = 0
		slst.cost = 0
	
		select txwip022.*
		from txwip022 for update
		where txwip022.rgnt = :txwip021.rgnt
		selectdo
			txwip022.rgst = compute_param_cost(txwip021.cwar, txwip022.rgtp, txwip022.item, txwip022.rvol, txwip022.rgni)
			txwip022.slst = compute_param_cost(txwip021.cwar, txwip022.sltp, txwip022.slvn, txwip022.svol, txwip022.slni)
			rgst.cost = rgst.cost + txwip022.rgst
			slst.cost = slst.cost + txwip022.slst
			if db.update(ttxwip022, db.retry) &lt;&gt; 0 then
				message("Error updating reagent detail costs.")
				abort.transaction()
			endif
		endselect
		
		txwip021.ttst = rgst.cost + slst.cost
		
		if txwip021.aqsm = 0 then
			txwip021.csst = 0
			txwip021.cssm = 0
		else
			txwip021.csst = txwip021.ttst / txwip021.aqsm
			txwip021.cssm = txwip021.csst * txwip021.mult
		endif
		
		db.update(ttxwip021, db.retry)
		commit.transaction()
	endselect
}

|*******************************************************************************
|* 2. Refresh the shared micro-test material reference and its existing
|*    normal-test and retest material copies.
|*
|* txwip039.prip = current lot price.
|* txwip039.csst = current cost for the configured test quantity.
|* txwip027 and txwip043 are refreshed from the corresponding reference.
|*******************************************************************************

function extern update_micro_test_material_references(){
	domain tcqiv1 cost.per.testing
	domain tccopr lot.price
	domain tcconv conversion.value

	select txwip039.*
	from txwip039 for update
	selectdo
		lot.price = get_item_lot_price(txwip039.item, txwip039.cwar)
		conversion.value = get_conversion_value(txwip039.item, txwip039.cuni)

		cost.per.testing = 0

		if conversion.value &lt;&gt; 0 then
			cost.per.testing = lot.price / conversion.value * txwip039.tsmm
		endif

		txwip039.prip = lot.price
		txwip039.csst = cost.per.testing

		if db.update(ttxwip039, db.retry) &lt;&gt; 0 then
			message("Error updating micro-test material references.")
			abort.transaction()
		endif

		| Refresh existing normal micro-test material copies.
		select txwip027.*
		from txwip027 for update
		where txwip027.item = :txwip039.item
		selectdo
			txwip027.prip = txwip039.prip
			txwip027.csst = txwip039.csst

			if db.update(ttxwip027, db.retry) &lt;&gt; 0 then
				message("Error updating micro-test material costs.")
				abort.transaction()
			endif
		endselect

		| Refresh existing micro-test retest material copies.
		select txwip043.*
		from txwip043 for update
		where txwip043.item = :txwip039.item
		selectdo
			txwip043.prip = txwip039.prip
			txwip043.csst = txwip039.csst

			if db.update(ttxwip043, db.retry) &lt;&gt; 0 then
				message("Error updating micro-test retest material costs.")
				abort.transaction()
			endif
		endselect
	endselect

	commit.transaction()
}

|*******************************************************************************
|* 3. Recalculate Pychem material details and Pychem retest material details.
|*
|* The calculation follows the existing txwip0500em17 / txwip0500em33 rules:
|*   Type 1: standard cost for FG/SFG/RM/FG/RM, otherwise lot price.
|*   Type 2: reagent cost per sample.
|*   Type 3: configured QC-item price.
|*
|* Conversion is retained from the existing Pychem calculation convention.
|*******************************************************************************

function extern update_pychem_material_costs(){
	domain tcqiv1 material.cost
	domain tccwar cwar

	select txwip030.ptid, txwip030.cwar
	from txwip030
	selectdo
		cwar = txwip030.cwar

		select txwip031.*
		from txwip031 for update
		where txwip031.ptid = :txwip030.ptid
		selectdo
			material.cost = compute_qc_material_cost(txwip031.mttp, txwip031.mtrl, txwip031.aqsm, cwar)
			txwip031.mcst = material.cost

			if db.update(ttxwip031, db.retry) &lt;&gt; 0 then
				message("Error updating Pychem material costs.")
				abort.transaction()
			endif
		endselect
	endselect

	| Refresh retest material details separately.
	select txwip045.ptid, txwip045.cwar
	from txwip045
	selectdo
		cwar = txwip045.cwar

		select txwip046.*
		from txwip046 for update
		where txwip046.ptid = :txwip045.ptid
		selectdo
			material.cost = compute_qc_material_cost(txwip031.mttp, txwip031.mtrl, txwip031.aqsm, cwar)
			txwip046.mcst = material.cost

			if db.update(ttxwip046, db.retry) &lt;&gt; 0 then
				message("Error updating Pychem retest material costs.")
				abort.transaction()
			endif
		endselect
	endselect

	commit.transaction()
}

|*******************************************************************************
|* Calculate Pychem material cost using the existing costing rules.
|*******************************************************************************

function domain tcqiv1 compute_qc_material_cost(domain txmat.types type, domain tcmcs.str50 param, domain tiqcp1 quantity, domain tccwar cwar){
	domain tcqiv1 total, cost.per.testing
	domain tccopr item.price
	domain tcconv conversion.value
	domain tcitem format.item

	total = 0
	item.price = 0
	conversion.value = 0
	cost.per.testing = 0

	on case etol(type)
		case 1:
			format.item = "         " &amp; trim$(param)

			select tcibd001.item
			from tcibd001
			where tcibd001.item = :format.item
				and tcibd001.citg IN ("FG", "SFG", "RM/FG", "RM")
			selectdo
				item.price = get_item_standard_cost(format.item)
				conversion.value = 1000

				if conversion.value &lt;&gt; 0 then
					cost.per.testing = item.price / conversion.value
					total = cost.per.testing * quantity
				endif
			selectempty
				conversion.value = get_conversion_value(format.item, "")
				item.price = get_item_lot_price(format.item, cwar)

				if conversion.value &lt;&gt; 0 then
					cost.per.testing = item.price / conversion.value
					total = cost.per.testing * quantity
				endif
			endselect
			break

		case 2:
			format.item = trim$(param)

			select txwip021.csst
			from txwip021
			where txwip021.rgnt = :format.item
			as set with 1 rows
			selectdo
				total = quantity * txwip021.csst
			endselect
			break

		case 3:
			format.item = trim$(param)

			select txwip035.prip
			from txwip035
			where txwip035.qitm = :format.item
			as set with 1 rows
			selectdo
				total = txwip035.prip
			endselect
			break

		default:
			total = 0
	endcase

	return(total)
}

|*******************************************************************************
|* 4. Refresh current micro-test and micro-test-retest totals.
|*
|* This recalculates only the current reusable test definitions. It does not
|* write the QC cost, simulation, retest, or retest-detail snapshot tables.
|*******************************************************************************

function extern update_micro_test_cost_totals(){
	domain tcqiv1 material.cost, labor.cost, total.cost

	| Normal micro-test detail totals.
	select txwip025.mtid, txwip025.anly
	from txwip025
	where txwip025.prmt = 2
	selectdo
		material.cost = compute_micro_material_total(txwip025.mtid)

		select txwip025.*
		from txwip025 for update
		where txwip025.mtid = :txwip025.mtid
		selectdo
			txwip025.mcst = material.cost

			if db.update(ttxwip025, db.retry) &lt;&gt; 0 then
				message("Error updating micro-test detail totals.")
				abort.transaction()
			endif
		endselect
	endselect

	| Normal micro-test header totals.
	select txwip024.anly
	from txwip024
	selectdo
		labor.cost = 0
		material.cost = 0

		select sum(txwip025.lbst):labor.cost,
			sum(txwip025.mcst):material.cost
		from txwip025
		where txwip025.anly = :txwip024.anly
		selectdo
		endselect

		total.cost = labor.cost + material.cost

		select txwip024.*
		from txwip024 for update
		where txwip024.anly = :txwip024.anly
		selectdo
			txwip024.tlst = labor.cost
			txwip024.tmst = material.cost
			txwip024.pyst = total.cost

			if db.update(ttxwip024, db.retry) &lt;&gt; 0 then
				message("Error updating micro-test header totals.")
				abort.transaction()
			endif
		endselect
	endselect

	| Retest material detail totals.
	select txwip042.mtid, txwip042.anly
	from txwip042
	where txwip042.prmt = 2
	selectdo
		material.cost = compute_micro_retest_material_total(txwip042.mtid)

		select txwip042.*
		from txwip042 for update
		where txwip042.mtid = :txwip042.mtid
		selectdo
			txwip042.mcst = material.cost

			if db.update(ttxwip042, db.retry) &lt;&gt; 0 then
				message("Error updating micro-test retest detail totals.")
				abort.transaction()
			endif
		endselect
	endselect

	| Retest micro-test header totals.
	select txwip041.anly
	from txwip041
	selectdo
		labor.cost = 0
		material.cost = 0

		select sum(txwip042.lbst):labor.cost,
			sum(txwip042.mcst):material.cost
		from txwip042
		where txwip042.anly = :txwip041.anly
		selectdo
		endselect

		total.cost = labor.cost + material.cost

		select txwip041.*
		from txwip041 for update
		where txwip041.anly = :txwip041.anly
		selectdo
			txwip041.tlst = labor.cost
			txwip041.tmst = material.cost
			txwip041.pyst = total.cost

			if db.update(ttxwip041, db.retry) &lt;&gt; 0 then
				message("Error updating micro-test retest totals.")
				abort.transaction()
			endif
		endselect
	endselect

	commit.transaction()
}

|*******************************************************************************
|* Current micro-test material + reagent total.
|*******************************************************************************

function domain tcqiv1 compute_micro_material_total(domain tcmcs.long mtid){
	domain tcqiv1 total.mat.cost, total.rgt.cost, total

	total.mat.cost = 0
	total.rgt.cost = 0
	total = 0

	select sum(txwip027.csst):total.mat.cost
	from txwip027
	where txwip027.mtid = :mtid
	selectdo
	endselect

	select txwip021.rgnt, txwip021.cssm
	from txwip021
	where exists
		(select txwip028.rgnt
		 from txwip028
		 where txwip028.mtid = :mtid
			and txwip028.rgnt = txwip021.rgnt)
	selectdo
		total.rgt.cost = total.rgt.cost + txwip021.cssm
	endselect

	total = total.mat.cost + total.rgt.cost

	return(total)
}

|*******************************************************************************
|* Current micro-test retest material + reagent total.
|*******************************************************************************

function domain tcqiv1 compute_micro_retest_material_total(domain tcmcs.long mtid){
	domain tcqiv1 total.mat.cost, total.rgt.cost, total

	total.mat.cost = 0
	total.rgt.cost = 0
	total = 0

	select sum(txwip043.csst):total.mat.cost
	from txwip043
	where txwip043.mtid = :mtid
	selectdo
	endselect

	select txwip021.rgnt, txwip021.cssm
	from txwip021
	where exists
		(select txwip044.rgnt
		 from txwip044
		 where txwip044.mtid = :mtid
			and txwip044.rgnt = txwip021.rgnt)
	selectdo
		total.rgt.cost = total.rgt.cost + txwip021.cssm
	endselect

	total = total.mat.cost + total.rgt.cost

	return(total)
}

|*******************************************************************************
|* 5. Refresh current Pychem test and Pychem-retest totals.
|*******************************************************************************

function extern update_pychem_test_cost_totals(){
	domain tcqiv1 material.cost, labor.cost, total.cost

	select txwip030.ptid
	from txwip030
	selectdo
		material.cost = 0
		labor.cost = txwip030.tlst

		select sum(txwip031.mcst):material.cost
		from txwip031
		where txwip031.ptid = :txwip030.ptid
		selectdo
		endselect

		total.cost = labor.cost + material.cost

		select txwip030.*
		from txwip030 for update
		where txwip030.ptid = :txwip030.ptid
		selectdo
			txwip030.tmst = material.cost
			txwip030.pyst = total.cost

			if db.update(ttxwip030, db.retry) &lt;&gt; 0 then
				message("Error updating Pychem test totals.")
				abort.transaction()
			endif
		endselect
	endselect

	select txwip045.ptid
	from txwip045
	selectdo
		material.cost = 0
		labor.cost = txwip045.tlst

		select sum(txwip046.mcst):material.cost
		from txwip046
		where txwip046.ptid = :txwip045.ptid
		selectdo
		endselect

		total.cost = labor.cost + material.cost

		select txwip045.*
		from txwip045 for update
		where txwip045.ptid = :txwip045.ptid
		selectdo
			txwip045.tmst = material.cost
			txwip045.pyst = total.cost

			if db.update(ttxwip045, db.retry) &lt;&gt; 0 then
				message("Error updating Pychem retest totals.")
				abort.transaction()
			endif
		endselect
	endselect

	commit.transaction()
}

|*******************************************************************************
|* 6. Refresh current QC item testing totals.
|*
|* The component tests have already been recalculated above. This refreshes
|* the current item-testing aggregates that consume those test costs.
|*
|* Historical QC cost and simulation snapshots are not touched.
|*******************************************************************************

function extern update_current_item_testing_costs(){
	domain tcqiv1 micro.cost, pychem.cost, annual.cost, third.party.cost

	select txwip036.item, txwip036.cwar
	from txwip036
	selectdo
		micro.cost = 0
		pychem.cost = 0
		annual.cost = 0
		third.party.cost = 0

		| Per-batch micro tests.
		select txwip024.anly, txwip024.pyst
		from txwip024
		where txwip024.freq = 2
			and exists
			(select txwip037.code
			 from txwip037
			 where txwip037.code = txwip024.anly
				and txwip037.item = :txwip036.item
				and txwip037.cwar = :txwip036.cwar)
		selectdo
			micro.cost = micro.cost + txwip024.pyst
		endselect

		| Pychem tests.
		select txwip030.ptid, txwip030.pyst
		from txwip030
		where exists
			(select txwip037.code
			 from txwip037
			 where txwip037.code = txwip030.ptid
				and txwip037.item = :txwip036.item
				and txwip037.cwar = :txwip036.cwar)
		selectdo
			pychem.cost = pychem.cost + txwip030.pyst
		endselect

		| Annual micro tests.
		select txwip024.anly, txwip024.pyst
		from txwip024
		where txwip024.freq = 1
			and exists
			(select txwip037.code
			 from txwip037
			 where txwip037.code = txwip024.anly
				and txwip037.item = :txwip036.item
				and txwip037.cwar = :txwip036.cwar)
		selectdo
			annual.cost = annual.cost + txwip024.pyst
		endselect

		| Third-party test costs are not recalculated from lot price.
		| Preserve the existing aggregation behavior.
		select txwip033.tpid, txwip033.tpst
		from txwip033
		where exists
			(select txwip037.code
			 from txwip037
			 where txwip037.code = txwip033.tpid
				and txwip037.item = :txwip036.item
				and txwip037.cwar = :txwip036.cwar)
		selectdo
			third.party.cost = third.party.cost + txwip033.tpst
		endselect

		select txwip036.*
		from txwip036 for update
		where txwip036.item = :txwip036.item
			and txwip036.cwar = :txwip036.cwar
		as set with 1 rows
		selectdo
			txwip036.mtst = micro.cost
			txwip036.pyst = pychem.cost
			txwip036.amst = annual.cost
			txwip036.atst = third.party.cost

			if db.update(ttxwip036, db.retry) &lt;&gt; 0 then
				message("Error updating current QC item testing costs.")
				abort.transaction()
			endif
		endselect
	endselect

	commit.transaction()
}

function domain tcqiv1 compute_param_cost(domain tccwar cwar, domain txmat.types type, domain tcmcs.str50 param, domain tiqcp1 vol, domain tccuni unit){
	domain tcqiv1 total, cost.per.testing
	domain tccopr item.lot.price
	domain tcconv conversion.value
	domain tcitem format.item
	
	total = 0
	
	on case etol(type)
		case 1:
			item.lot.price = 0
			conversion.value = 0
			cost.per.testing = 0
			
			format.item = "         " &amp; trim$(param)
			
			| Workaround to items that unable to have conversion
			| factors with an error message:
			| Change the value of the Unit field.
			| Reason: Define conversion factor on general level.
			
			| Add different computation if parameter is FG
			| Usually occur on Pychem tests
			select tcibd001.item
			from tcibd001
			where tcibd001.item = :format.item
				and tcibd001.citg IN ("FG", "SFG", "RM/FG")
			selectdo
				item.lot.price = get_item_standard_cost(format.item)
				conversion.value = 1000
				cost.per.testing = item.lot.price / conversion.value
				total = cost.per.testing * vol
			selectempty
				conversion.value = get_conversion_value(format.item, unit)
				item.lot.price = get_item_lot_price(format.item, cwar)
				
				if conversion.value = 0 then
					cost.per.testing = 0
					total = 0
				else
					cost.per.testing = item.lot.price / conversion.value
					total = cost.per.testing * vol
				endif	
			endselect
			break
		case 2:
			format.item = trim$(param)
			
			select txwip021.csst
			from txwip021
			where txwip021.rgnt = :format.item
			selectdo
				total = vol * txwip021.csst
			selectempty
				total = 0
			endselect
			break
		case 3:
			item.lot.price = 0
			conversion.value = 0
			cost.per.testing = 0
			
			format.item = trim$(param)
			
			select txwip035.prip, txwip035.conv
			from txwip035
			where txwip035.qitm = :format.item
			selectdo
				item.lot.price = txwip035.prip
				conversion.value = txwip035.conv
			endselect
			
			if conversion.value = 0 then
				cost.per.testing = 0
				total = 0
			else
				cost.per.testing = item.lot.price / conversion.value
				total = cost.per.testing * vol
			endif
			break
		default:
			total = 0
	endcase
	
	return(total)
}

function domain tccopr get_item_standard_cost(domain tcitem item){
	domain tccopr cost
	cost = 0
	
	select ticpr007.ecpr
	from ticpr007
	where ticpr007.item = :item
	selectdo
		cost = ticpr007.ecpr(1)
	endselect
	
	return(cost)
}

function domain tcconv get_conversion_value(domain tcitem item, domain tccuni unit){
	domain tcconv value
	domain tcitem format.item
	
	value = 0
	format.item = "         " &amp; trim$(item)
	
	select tcibd003.conv
	from tcibd003
	where tcibd003.item = :format.item
		and tcibd003.unit = :unit
	as set with 1 rows
	selectdo
		value = tcibd003.conv
	selectempty
		value = 0
	endselect
	
	return(value)
}

function domain tccopr get_item_lot_price(domain tcitem item, domain tccwar cwar){
	domain tcclot lot.number
	domain tccopr item.lot.price
	domain tcitem format.item
	
	item.lot.price = 0
	lot.number = ""
	format.item = "         " &amp; trim$(item)
	
	| Get first valid lot (FIFO)
	select whinr140.clot, whinr140.idat
	from whinr140
	where whinr140.item = :format.item
		and whinr140.cwar = :cwar		| Warehouse
		and whinr140.loca = "110S1QCD01"	| QC Calauan
		and whinr140.idat &lt;&gt; 0			| Inventory Date
		and (whinr140.qhnd - whinr140.qblk) &gt; 0 | On-hand - Blocked
	order by whinr140.idat
	as set with 1 rows
	selectdo
		lot.number = whinr140.clot
	endselect
	
	select sum(whltc101.pric(1)):item.lot.price
	from whltc101
	where whltc101.item = :format.item
		and whltc101.clot = :lot.number		| Lot No
		and whltc101.cpcp = "MC0002"	  	| Material Cost			
	as set with 1 rows
	selectdo
	endselect

	return(item.lot.price)
}</expression><expressionLanguageType>Baan4C</expressionLanguageType><sourceType>4</sourceType><sourceDescription>Update Costs Based on Lot Price</sourceDescription><sourceName>txwip0500em36</sourceName></Source><documentation/><Attachment><type>relnotes</type><name>txwip0500em36</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em36</name></Attachment><additionalConstraints>2610</additionalConstraints><additionalInstructions/><keyword>||</keyword><application>EXTce01107</application></DR_Module><startInCompanyZero>false</startInCompanyZero><repSevLang>false</repSevLang><mainSession>true</mainSession><moduleType>1</moduleType><windowType>3</windowType><subType>2</subType><status>1</status><documentation/><Attachment><type>relnotes</type><name>txwip0500em36</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em36</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em36ddate.now</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em36ddate.now</name></Attachment><objectLabel/><application>EXTce01107</application><sessionReferenceDescriptionReference>txwip0500em36</sessionReferenceDescriptionReference><sessionReferenceDescription>Update Costs Based on Lot Price</sessionReferenceDescription><sessionReference>txwip0500em36</sessionReference><UIScript>txwip0500em36</UIScript></DR_Controller>