ld>70</firstField><nextGroup>0</nextGroup><previousGroup>3</previousGroup><parentGroup>1</parentGroup><overviewSession>false</overviewSession><detailsSession>true</detailsSession><showGroupBox>false</showGroupBox><groupHeader/><level>1</level><repeating>false</repeating><groupID>5</groupID></FormGroup></PhysicalFormLayout><FormCommand><descriptionReference>txsave</descriptionReference><description>Save</description><suppressDialogAllowed>false</suppressDialogAllowed><defaultSpecialCommand>true</defaultSpecialCommand><category>20</category><kindOfSession>9</kindOfSession><startModeSession>9</startModeSession><refreshParent>false</refreshParent><saveBeforeExecution>false</saveBeforeExecution><multipleExecution>false</multipleExecution><questionAnswer>0</questionAnswer><question><name/></question><commandAvailability>1</commandAvailability><authorizationGroup>9</authorizationGroup><initiallyHidden>false</initiallyHidden><initialHidden>false</initialHidden><showOnMenu>true</showOnMenu><showAsButton>false</showAsButton><separator>false</separator><shortcut>1</shortcut><addEllipsesToLabel>false</addEllipsesToLabel><groupFieldNr>0</groupFieldNr><parent>0</parent><activationName>compute_reagent_costs</activationName><activationType>5</activationType><defaultcommand>false</defaultcommand><sequence>1</sequence><position>1</position><type>1</type><shortDescription>Save</shortDescription><name>compute_reagent_costs</name></FormCommand><description>Reagents Header</description><name>txwip0500em04d</name><horizontal>true</horizontal><custProhibited>false</custProhibited><additionalConstraints>1</additionalConstraints><documentation/><application>EXTce01107</application></Form><DR_Module><description>Reagents Header</description><versionID>B61O_a_ext</versionID><type>library</type><name>txwip0500em04</name><Version><ObjectID/><classID/><checkInLabel/><documentation/><isExpired>no</isExpired><isCheckedOutParallel>no</isCheckedOutParallel><isCheckedOut>no</isCheckedOut><modificationDateTime>2026-10-20T05:59:49Z</modificationDateTime><modifiedBy>ict004</modifiedBy><creationDateTime>2026-08-10T06:12:15Z</creationDateTime><createdBy>ict004</createdBy></Version><Source><sourceVersion><ObjectID/><classID/><checkInLabel/><documentation/><isExpired>no</isExpired><isCheckedOutParallel>no</isCheckedOutParallel><isCheckedOut>no</isCheckedOut><modificationDateTime>2026-10-20T05:59:49Z</modificationDateTime><modifiedBy>ict004</modifiedBy><creationDateTime>2026-08-10T06:12:15Z</creationDateTime><createdBy>ict004</createdBy></sourceVersion><sourceVersionID>B61O_a_ext</sourceVersionID><sourceObjectID>1</sourceObjectID><expression>|*******************************************************************************
|* txwip0500em04  B61O_a_ext
|* Reagent
|* ict004
|* 2026-08-10 [02:15]
|*******************************************************************************
|* Script Type: 123
|*******************************************************************************

|*************************** declaration section *******************************
declaration:

	table	ttxwip020		|* QC Costs
	table	ttxwip021		|* Reagents	
	table	ttxwip022		|* Reagents Details
	table	ttxwip024		|* Micro Tests
	table	ttxwip025		|* Micro Test Details
	table	ttxwip026		|* QC Personnels
	table	ttxwip027		|* Micro Test Materials
	table	ttxwip028		|* Micro Test Reagents
	table	ttxwip030		|* Pychem Tests
	table	ttxwip031		|* Pychem Test Details
	table	ttxwip033		|* Third Party Tests
	table	ttxwip034		|* Third Party Test Details
	table	ttxwip035 		|* QC Items
	table	ttxwip036		|* Item Testing Costs
	table	ttxwip037		|* Item Testing Cost Details
	table	ttxwip038		|* Inline &amp; Documentation Costs
	table	ttxwip039		|* Micro Test Materials Reference
	table	ttxwip040		|* QC Cost Simulations
	table	ttxwip041		|* Micro Retests
	table	ttxwip042		|* Micro Retest Details
	table	ttxwip043		|* Micro Retest Materials
	table	ttxwip044		|* Micro Retest Reagents
	table	ttxwip045		|* Pychem Retests
	table	ttxwip046		|* Pychem Retest Details
	table	ttxwip047		|* QC Cost Retest
	table	ttxwip048		|* QC Cost Simulation Retests	
	
	table	ttcibd001		|* Items
	table	ttcibd003		|* Conversion Factors
	table	ttdipu001		|* Item - Purchase
	table	ttcmcs003		|* Warehouses
	table	ttcmcs012		|* Units by Unit Set
	table	twhltc100		|* Lots
	table	twhltc101		|* Lot Cost Details
	table	twhltc105		|* Lots by Warehouse
	table	ttccom100		|* Business Partners
	table	ttisfc001		|* Production Orders
	table	tticpr007		|* Items - Costing

	extern domain tcqiv1		reagent.total.cost, solvent.total.cost,
					total.cost
	extern domain tcdsca		cwar.desc
	extern domain tccwar		cwar

|****************************** program section ********************************

after.form.read:
	add.sync.fields("txwip0500em05", "txwip021.cwar", "cwar")
	
main.table.io:
before.write:
	validate_rgnt_cwar(txwip021.dscr, txwip021.cwar)
	
	if txwip021.dcdt = 0 then
		txwip021.dcdt = utc.num()
	endif

before.rewrite:
	validate_rgnt_cwar(txwip021.dscr, txwip021.cwar)
	txwip021.dmdt = utc.num()

|****************************** field section **********************************

field.txwip021.rgnt:
before.display:
	if trim$(txwip021.rgnt) = "" then
		txwip021.rgnt = set_reagent_code()
		txwip021.cwar = "1CS001"
	endif
	
field.txwip021.cwar:
before.display:
	update_cwar.desc(txwip021.cwar)
	
selection.filter:
	query.extend.where.in.zoom("tcmcs003.cwar IN (""1CS001"",""1PS001"")")
	
when.field.changes:
	update_cwar.desc(txwip021.cwar)
	
after.zoom:
	update_cwar.desc(txwip021.cwar)
	
|****************************** function section *******************************

functions:

function domain tcmcs.str10 set_reagent_code(){
	long cnt, next.id
	domain tcmcs.str10 next.code, last.code
	
	select count(txwip021.rgnt):cnt
	from txwip021
	where txwip021.rgnt &lt;&gt; ""
	selectdo
	endselect
	
	if cnt &gt; 0 then
		select txwip021.rgnt
		from txwip021
		order by txwip021.rgnt desc
		as set with 1 rows
		selectdo
			last.code = txwip021.rgnt(len(trim$(txwip021.rgnt))-1;6)
			next.id = val(last.code) + 1
			next.code = "RGN" &amp; sprintf$("%06d", trim$(str$(next.id)))
		endselect	
	else
		next.code = "RGN000001"
	endif
	
	return(next.code)
}

function extern void compute_reagent_costs(){
	domain tcqiv1 cost.ml, cost.sample, qty.sol
	long ret
	
	execute(15)
	
	reagent.total.cost = 0
	solvent.total.cost = 0
	total.cost = 0
	cost.ml = 0
	cost.sample = 0
	qty.sol = 0

	qty.sol = txwip021.aqsm

	select sum(txwip022.rgst):reagent.total.cost,
		sum(txwip022.slst):solvent.total.cost
	from txwip022
	where txwip022.rgnt = :txwip021.rgnt
	selectdo
	endselect

	total.cost = reagent.total.cost + solvent.total.cost

	if total.cost = 0 or txwip021.aqsm = 0 then
		cost.ml = 0
		cost.sample = 0
	else
		cost.ml = total.cost / txwip021.aqsm
		cost.sample = cost.ml * txwip021.mult
	endif
	
	select txwip021.*
	from txwip021 for update
	where txwip021.rgnt = :txwip021.rgnt
	selectdo
		txwip021.ttst = total.cost
		txwip021.csst = cost.ml
		txwip021.cssm = cost.sample
		txwip021.aqsm = qty.sol

		if db.update(ttxwip021, db.retry) &lt;&gt; 0 then
			message("Error occurred while updating the reagent header.")
			abort.transaction()
		endif
	endselect
	
	commit.transaction()
	execute(find.data)
	ret = refresh.parent(-1)
	synchronize.satellite("txwip0500em05")
}

function update_cwar.desc(domain tccwar cwar){
	domain tcdsca desc
	desc = ""
	
	select tcmcs003.dsca
	from tcmcs003
	where tcmcs003.cwar = :cwar
	as set with 1 rows
	selectdo
		desc = tcmcs003.dsca 
	endselect
	
	cwar.desc = desc
}

function validate_rgnt_cwar(domain tcmcs.str50 desc, domain tccwar cwar){
	if check_is_exist(trim$(desc), cwar) = tcyesno.yes then
		| Automatically shows `Record already exist`
		| due to set indices
		return
	endif
}

function domain tcyesno check_is_exist(domain tcmcs.str50 desc, domain tccwar cwar){
	domain tcyesno is.exist
	domain tcmcs.str50 format.desc
	
	format.desc = ""
	format.desc = trim$(desc)
	
	select txwip021.rgnt
	from txwip021
	where txwip021.dscr = :format.desc
		and txwip021.cwar = :cwar
	selectdo
		is.exist = tcyesno.yes
	selectempty
		is.exist = tcyesno.no
	endselect
	
	return(is.exist) 
}</expression><expressionLanguageType>Baan4C</expressionLanguageType><sourceType>1</sourceType><sourceDescription>Reagents Header</sourceDescription><sourceName>txwip0500em04</sourceName></Source><documentation/><Attachment><type>relnotes</type><name>txwip0500em04</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em04</name></Attachment><additionalConstraints>2590</additionalConstraints><additionalInstructions/><keyword>||</keyword><application>EXTce01107</application></DR_Module><startInCompanyZero>false</startInCompanyZero><repSevLang>false</repSevLang><mainSession>true</mainSession><moduleType>1</moduleType><windowType>15</windowType><subType>1</subType><status>1</status><documentation/><Attachment><type>relnotes</type><name>txwip0500em04</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em04</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em04dcwar.desc</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em04dcwar.desc</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em04dtxwip021.aq</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em04dtxwip021.aq</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em04dtxwip021.cs</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em04dtxwip021.cs</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em04dtxwip021.cs</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em04dtxwip021.cs</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em04dtxwip021.cw</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em04dtxwip021.cw</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em04dtxwip021.dc</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em04dtxwip021.dc</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em04dtxwip021.dm</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em04dtxwip021.dm</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em04dtxwip021.ds</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em04dtxwip021.ds</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em04dtxwip021.mu</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em04dtxwip021.mu</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em04dtxwip021.rg</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em04dtxwip021.rg</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em04dtxwip021.tt</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em04dtxwip021.tt</name></Attachment><objectLabel/><application>EXTce01107</application><sessionReferenceDescriptionReference>txwip0500em04</sessionReferenceDescriptionReference><sessionReferenceDescription>Reagent</sessionReferenceDescription><sessionReference>txwip0500em04</sessionReference><UIScript>txwip0500em04</UIScript></DR_Controller>