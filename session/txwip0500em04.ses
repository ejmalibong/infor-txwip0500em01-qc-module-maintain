|*******************************************************************************
|* Script Type: 123
|*******************************************************************************

|*************************** declaration section *******************************
declaration:

	table	ttxwip020		|* QC Cost Summary
	table	ttxwip021		|* Reagents Header	
	table	ttxwip022		|* Reagents Details
	table	ttxwip024		|* Micro Test Header
	table	ttxwip025		|* Micro Test Details
	table	ttxwip026		|* QC Personnel
	table	ttxwip027		|* Micro Test Materials
	table	ttxwip028		|* Micro Test Reagents
	table	ttxwip030		|* Pychem Test Header
	table	ttxwip031		|* Pychem Test Details
	table	ttxwip033		|* Third Party Test Header
	table	ttxwip034		|* Third Party Test Details
	table	ttxwip035 		|* QC Items
	table	ttxwip036		|* QC Cost Master Data
	table	ttxwip037		|* QC Cost Details

	table	ttcibd001		|* Items
	table	ttcibd003		|* Conversion Factors
	table	ttdipu001		|* Item - Purchase
	table	ttcmcs012		|* Units by Unit Set

|****************************** program section ********************************	

main.table.io:
before.write:
	if txwip021.dcdt = 0 then
		txwip021.dcdt = utc.num()
	endif

before.rewrite:
	txwip021.dmdt = utc.num()

|****************************** field section **********************************

field.txwip021.rgnt:
before.display:
	if trim$(txwip021.rgnt) = "" then
		txwip021.rgnt = set_reagent_code()
	endif

|****************************** function section *******************************

functions:

function domain tcmcs.str10 set_reagent_code(){
	long cnt, next.id
	domain tcmcs.str10 next.code, last.code
	
	select count(txwip021.rgnt):cnt
	from txwip021
	where txwip021.rgnt &lt;&gt; ""
	selectdo
	endselect
	
	if cnt &gt; 0 then
		select txwip021.rgnt
		from txwip021
		order by txwip021.rgnt desc
		as set with 1 rows
		selectdo
			last.code = txwip021.rgnt(len(trim$(txwip021.rgnt))-1;6)
			next.id = val(last.code) + 1
			next.code = "RGN" &amp; sprintf$("%06d", trim$(str$(next.id)))
		endselect	
	else
		next.code = "RGN000001"
	endif
	
	return(next.code)
}

function extern void compute_reagent_costs(){
	domain tcqiv1 reagent.total.cost, solvent.total.cost, total.cost
	domain tcqiv1 cost.ml, cost.sample, qty.sol
	long ret
	
	execute(15)

	reagent.total.cost = 0
	solvent.total.cost = 0
	total.cost = 0
	cost.ml = 0
	cost.sample = 0
	qty.sol = 0

	qty.sol = txwip021.aqsm

|	select sum(txwip022.rgst):reagent.total.cost,
|		sum(txwip022.slst):solvent.total.cost
|	from txwip022
|	where txwip022.rgnt = :txwip021.rgnt
|	selectdo
|	endselect
|
|	total.cost = reagent.total.cost + solvent.total.cost

	if total.cost = 0 or txwip021.aqsm = 0 then
		cost.ml = 0
		cost.sample = 0
	else
		cost.ml = total.cost / txwip021.aqsm
		cost.sample = cost.ml * txwip021.mult
	endif	
	
	select txwip021.*
	from txwip021 for update
	where txwip021.rgnt = :txwip021.rgnt
	selectdo
		txwip021.ttst = total.cost
		txwip021.csst = cost.ml
		txwip021.cssm = cost.sample
		txwip021.aqsm = qty.sol

		if db.update(ttxwip021, db.retry) &lt;&gt; 0 then
			message("Error occurred while updating the reagent header.")
			abort.transaction()
		endif
	endselect
	
	commit.transaction()

	execute(find.data)
	
	ret = refresh.parent(-1)
	synchronize.satellite("txwip0500em05")
}</expression><expressionLanguageType>Baan4C</expressionLanguageType><sourceType>1</sourceType><sourceDescription>Reagents Header</sourceDescription><sourceName>txwip0500em04</sourceName></Source><documentation/><Attachment><type>relnotes</type><name>txwip0500em04</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em04</name></Attachment><additionalConstraints>2590</additionalConstraints><additionalInstructions/><keyword>||</keyword><application>EXTce01106</application></DR_Module><startInCompanyZero>false</startInCompanyZero><repSevLang>false</repSevLang><mainSession>true</mainSession><moduleType>1</moduleType><windowType>15</windowType><subType>1</subType><status>1</status><documentation/><objectLabel/><application>EXTce01106</application><sessionReferenceDescriptionReference>txwip0500em04</sessionReferenceDescriptionReference><sessionReferenceDescription>Reagent</sessionReferenceDescription><sessionReference>txwip0500em04</sessionReference><UIScript>txwip0500em04</UIScript></DR_Controller>