upFieldNr><parent>0</parent><activationName>load_micro_test_reagents</activationName><activationType>5</activationType><defaultcommand>false</defaultcommand><sequence>2</sequence><position>2</position><type>1</type><shortDescription>Add Reagents</shortDescription><name>load_micro_test_reagents</name></FormCommand><description>Micro Retest Reagents</description><name>txwip0500em30d</name><horizontal>true</horizontal><custProhibited>false</custProhibited><additionalConstraints>1</additionalConstraints><documentation/><application>EXTce01107</application></Form><DR_Module><description>Micro Retest Reagents</description><versionID>B61O_a_ext</versionID><type>library</type><name>txwip0500em30</name><Version><ObjectID/><classID/><checkInLabel/><documentation/><isExpired>no</isExpired><isCheckedOutParallel>no</isCheckedOutParallel><isCheckedOut>no</isCheckedOut><modificationDateTime>2026-10-21T03:42:18Z</modificationDateTime><modifiedBy>ict004</modifiedBy><creationDateTime>2026-10-06T06:29:33Z</creationDateTime><createdBy>ict004</createdBy></Version><Source><sourceVersion><ObjectID/><classID/><checkInLabel/><documentation/><isExpired>no</isExpired><isCheckedOutParallel>no</isCheckedOutParallel><isCheckedOut>no</isCheckedOut><modificationDateTime>2026-10-21T03:42:18Z</modificationDateTime><modifiedBy>ict004</modifiedBy><creationDateTime>2026-10-06T06:29:33Z</creationDateTime><createdBy>ict004</createdBy></sourceVersion><sourceVersionID>B61O_a_ext</sourceVersionID><sourceObjectID>1</sourceObjectID><expression>|*******************************************************************************
|* txwip0500em30  B61O_a_ext
|* Micro Retest Reagents
|* ict004
|* 2026-08-19 [08:40]
|*******************************************************************************
|* Script Type: 123
|*******************************************************************************

|*************************** declaration section *******************************
declaration:

	table	ttxwip020		|* QC Costs
	table	ttxwip021		|* Reagents	
	table	ttxwip022		|* Reagents Details
	table	ttxwip024		|* Micro Tests
	table	ttxwip025		|* Micro Test Details
	table	ttxwip026		|* QC Personnels
	table	ttxwip027		|* Micro Test Materials
	table	ttxwip028		|* Micro Test Reagents
	table	ttxwip030		|* Pychem Tests
	table	ttxwip031		|* Pychem Test Details
	table	ttxwip033		|* Third Party Tests
	table	ttxwip034		|* Third Party Test Details
	table	ttxwip035 		|* QC Items
	table	ttxwip036		|* Item Testing Costs
	table	ttxwip037		|* Item Testing Cost Details
	table	ttxwip038		|* Inline &amp; Documentation Costs
	table	ttxwip039		|* Micro Test Materials Reference
	table	ttxwip040		|* QC Cost Simulations
	table	ttxwip041		|* Micro Retests
	table	ttxwip042		|* Micro Retest Details
	table	ttxwip043		|* Micro Retest Materials
	table	ttxwip044		|* Micro Retest Reagents
	table	ttxwip045		|* Pychem Retests
	table	ttxwip046		|* Pychem Retest Details
	table	ttxwip047		|* QC Cost Retest
	table	ttxwip048		|* QC Cost Simulation Retests	
	
	table	ttcibd001		|* Items
	table	ttcibd003		|* Conversion Factors
	table	ttdipu001		|* Item - Purchase
	table	ttcmcs003		|* Warehouses
	table	ttcmcs012		|* Units by Unit Set
	table	twhltc100		|* Lots
	table	twhltc101		|* Lot Cost Details
	table	twhltc105		|* Lots by Warehouse
	table	ttccom100		|* Business Partners
	table	ttisfc001		|* Production Orders
	table	tticpr007		|* Items - Costing

	extern domain tcmcs.str50	rgnt.desc
	extern domain tcqiv1		cssm
	extern domain tccwar		zoom.cwar
	extern long			current.mtid.rt

|****************************** program section ********************************

| From Micro Retest Details txwip0500em28
before.program:
	import("txwip042.mtid", current.mtid.rt)
	import("zoom.cwar", zoom.cwar)

	if current.mtid.rt &lt;&gt; 0 then 
		query.extend.where("txwip044.mtid = " &amp; str$(current.mtid.rt) &amp; "")
	endif
	
before.new.object:
	txwip044.mult = 1
	
zoom.from.all:
on.entry:
	standard.commands.off(add.set, modify.set, update.db, end.program, first.set, next.set, prev.set, last.set)
	
after.form.read:
	if current.mtid.rt = 0 then
		remove.form.commands("save_close_total")
		remove.form.commands("load_micro_test_reagents")
	endif

|****************************** field section **********************************
	
field.rgnt.desc:
before.display:
	update_rgnt_desc(txwip044.rgnt)
	
field.txwip044.mult:
when.field.changes:
	update_cost_per_sample(txwip044.rgnt, txwip044.mult, txwip044.csst)
	
after.field:
	update_cost_per_sample(txwip044.rgnt, txwip044.mult, txwip044.csst)

|****************************** function section *******************************

functions:

function void update_rgnt_desc(domain tcmcs.str10 rgnt){
	rgnt.desc = get_rgnt_desc(rgnt)
}

function domain tcmcs.str50 get_rgnt_desc(domain tcmcs.str10 rgnt){
	domain tcmcs.str10 rgnt.code
	domain tcmcs.str50 desc
	
	rgnt.code = trim$(rgnt)
	desc = ""
	
	select txwip021.dscr
	from txwip021
	where txwip021.rgnt = :rgnt.code
	selectdo
		desc = txwip021.dscr
	endselect
	
	return(desc)
}

function extern void save_close_total(){
	domain tcqiv1 total.mat.cost, total.rgt.cost, total
	long ret
	
	execute(15)
	
	total.mat.cost = 0
	total.rgt.cost = 0
	total = 0

	select sum(txwip043.csst):total.mat.cost
	from txwip043
	where txwip043.mtid = :current.mtid.rt
	selectdo
	endselect
	
	select txwip021.rgnt, txwip021.cssm
	from txwip021
	where exists
		(select txwip044.*
		 from txwip044
		 where txwip044.mtid = :current.mtid.rt
		 and txwip044.rgnt = txwip021.rgnt)
	selectdo
		total.rgt.cost = total.rgt.cost + txwip021.cssm
	endselect
	
	total = total.mat.cost + total.rgt.cost
	
	select txwip042.*
	from txwip042 for update
	where txwip042.mtid = :current.mtid.rt
	selectdo
		txwip042.mcst = total
		if db.update(ttxwip042, db.retry) &lt;&gt; 0 then
			message("Error " &amp; str$(e) &amp; " occurred while updating the record.")
			abort.transaction()
		endif
	endselect
	
	commit.transaction()
	ret = refresh.parent(-1)
	end()
}

function extern load_micro_test_reagents(){
	start.session(MODAL_OVERVIEW, "txwip0500em03",  "txwip0500em30", "")
}

function update_cost_per_sample(domain tcmcs.str10 rgnt, domain tcqiv1 mult, domain tcqiv1 csst){
	txwip044.csst = compute_cost_per_sample(rgnt, mult, csst) 
}

function domain tcqiv1 compute_cost_per_sample(domain tcmcs.str10 rgnt, domain tcqiv1 mult, domain tcqiv1 csst){
	domain tcqiv1 cost.per.sample
	
	if cost.per.sample = 0 or mult = 0 then
		cost.per.sample = 0
	else
		cost.per.sample = csst * mult
	endif
	
	return(cost.per.sample)		
