yperlink>false</hyperlink><searchDescription/><constantValueForYes>0</constantValueForYes><viewField>false</viewField><displayHeight>1</displayHeight><columnID>1</columnID><endXPosition>24</endXPosition><parentField>0</parentField><labelHeightOverview>1</labelHeightOverview><labelLengthOverview>999</labelLengthOverview><labelHeightDetail>1</labelHeightDetail><labelLengthDetail>20</labelLengthDetail><labelPosition>1</labelPosition><dependentOnParentField>false</dependentOnParentField><xPositionLabel>1</xPositionLabel><followUpField>0</followUpField><labelAlignment>2</labelAlignment><windowsControl>6</windowsControl><fieldBelowGrid>false</fieldBelowGrid><overviewSession>true</overviewSession><detailsSession>true</detailsSession><childFieldsBehind>false</childFieldsBehind><followUp>false</followUp><nextField>80</nextField><groupID>1</groupID><synchronizedField>false</synchronizedField><defaultValue/><inputReferenceExpression>1</inputReferenceExpression><fieldLabel>txwip039.cuni</fieldLabel><languageUnitExpression/><mandatoryInput>true</mandatoryInput><sequenceMode>70</sequenceMode><fieldLength>3</fieldLength><echoField>true</echoField><message/><defaultExpression>false</defaultExpression><zoomReturnField>tcibd003.unit</zoomReturnField><zoomProgram>tcibd0103m000</zoomProgram><zoomType>2</zoomType><startPositionString>1</startPositionString><linkInputDigitsBefore>true</linkInputDigitsBefore><inputDigitsBefore>3</inputDigitsBefore><linkDisplayDigitsBefore>true</linkDisplayDigitsBefore><displayDigitsBefore>3</displayDigitsBefore><minimumInputLength>0</minimumInputLength><displayFormatLinked>true</displayFormatLinked><displayFormat/><fieldType>2</fieldType><domain/><element>1</element><fieldName>txwip039.cuni</fieldName><rowScreenPosition>1</rowScreenPosition><columnScreenPosition>22</columnScreenPosition><sequenceNumber>12</sequenceNumber></FormField><FormGroup><selectionGroup>false</selectionGroup><parentTable/><miscellaneous>0</miscellaneous><nextToOtherGroup>false</nextToOtherGroup><checkBoxesOnly>false</checkBoxesOnly><formFormat>13</formFormat><subGroupOnNewPage>false</subGroupOnNewPage><nrSubGroups>1</nrSubGroups><firstChildGroup>0</firstChildGroup><virtualGroup>true</virtualGroup><groupAlignment>1</groupAlignment><firstField>10</firstField><nextGroup>0</nextGroup><previousGroup>0</previousGroup><parentGroup>0</parentGroup><overviewSession>true</overviewSession><detailsSession>true</detailsSession><showGroupBox>false</showGroupBox><groupHeader/><level>0</level><repeating>false</repeating><groupID>1</groupID></FormGroup></PhysicalFormLayout><FormCommand><descriptionReference>txaddselecteditems</descriptionReference><description>Add Selected Items</description><suppressDialogAllowed>false</suppressDialogAllowed><defaultSpecialCommand>true</defaultSpecialCommand><category>20</category><kindOfSession>9</kindOfSession><startModeSession>9</startModeSession><refreshParent>false</refreshParent><saveBeforeExecution>false</saveBeforeExecution><multipleExecution>false</multipleExecution><questionAnswer>0</questionAnswer><question><name/></question><commandAvailability>1</commandAvailability><authorizationGroup>9</authorizationGroup><initiallyHidden>false</initiallyHidden><initialHidden>false</initialHidden><showOnMenu>true</showOnMenu><showAsButton>false</showAsButton><separator>false</separator><shortcut>1</shortcut><addEllipsesToLabel>false</addEllipsesToLabel><groupFieldNr>0</groupFieldNr><parent>0</parent><activationName>get_miro_test_materials</activationName><activationType>5</activationType><defaultcommand>false</defaultcommand><sequence>1</sequence><position>1</position><type>1</type><shortDescription/><name>get_miro_test_materials</name></FormCommand><description>Micro Test Materials Reference</description><name>txwip0500em23d</name><horizontal>true</horizontal><custProhibited>false</custProhibited><additionalConstraints>1</additionalConstraints><documentation/><application>EXTce01107</application></Form><DR_Module><description>Micro Test Materials Reference</description><versionID>B61O_a_ext</versionID><type>library</type><name>txwip0500em23</name><Version><ObjectID/><classID/><checkInLabel/><documentation/><isExpired>no</isExpired><isCheckedOutParallel>no</isCheckedOutParallel><isCheckedOut>no</isCheckedOut><modificationDateTime>2026-10-16T00:14:59Z</modificationDateTime><modifiedBy>ict004</modifiedBy><creationDateTime>2026-10-01T05:09:36Z</creationDateTime><createdBy>ict004</createdBy></Version><Source><sourceVersion><ObjectID/><classID/><checkInLabel/><documentation/><isExpired>no</isExpired><isCheckedOutParallel>no</isCheckedOutParallel><isCheckedOut>no</isCheckedOut><modificationDateTime>2026-10-16T00:14:59Z</modificationDateTime><modifiedBy>ict004</modifiedBy><creationDateTime>2026-10-01T05:09:36Z</creationDateTime><createdBy>ict004</createdBy></sourceVersion><sourceVersionID>B61O_a_ext</sourceVersionID><sourceObjectID>1</sourceObjectID><expression>|*******************************************************************************
|* txwip0500em23  B61O_a_ext
|* Micro Test Materials Reference
|* ict004
|* 2026-10-01 [01:09]
|*******************************************************************************
|* Script Type: 123
|*******************************************************************************

|*************************** declaration section *******************************
declaration:

	table	ttxwip020		|* QC Costs
	table	ttxwip021		|* Reagents	
	table	ttxwip022		|* Reagents Details
	table	ttxwip024		|* Micro Tests
	table	ttxwip025		|* Micro Test Details
	table	ttxwip026		|* QC Personnels
	table	ttxwip027		|* Micro Test Materials
	table	ttxwip028		|* Micro Test Reagents
	table	ttxwip030		|* Pychem Tests
	table	ttxwip031		|* Pychem Test Details
	table	ttxwip033		|* Third Party Tests
	table	ttxwip034		|* Third Party Test Details
	table	ttxwip035 		|* QC Items
	table	ttxwip036		|* Item Testing Costs
	table	ttxwip037		|* Item Testing Cost Details
	table	ttxwip038		|* Inline &amp; Documentation Costs
	table	ttxwip039		|* Micro Test Materials Reference
	table	ttxwip040		|* QC Cost Simulations
	table	ttxwip041		|* Micro Retests
	table	ttxwip042		|* Micro Retest Details
	table	ttxwip043		|* Micro Retest Materials
	table	ttxwip044		|* Micro Retest Reagents
	table	ttxwip045		|* Pychem Retests
	table	ttxwip046		|* Pychem Retest Details
	table	ttxwip047		|* QC Cost Retest
	table	ttxwip048		|* QC Cost Simulation Retests	
	
	table	ttcibd001		|* Items
	table	ttcibd003		|* Conversion Factors
	table	ttdipu001		|* Item - Purchase
	table	ttcmcs003		|* Warehouses
	table	ttcmcs012		|* Units by Unit Set
	table	twhltc100		|* Lots
	table	twhltc101		|* Lot Cost Details
	table	twhltc105		|* Lots by Warehouse
	table	ttccom100		|* Business Partners
	table	ttisfc001		|* Production Orders
	table	tticpr007		|* Items - Costing
	
	extern domain tcitm.dscr	item.desc
	extern domain tcdsca		cwar.desc
	extern domain tccwar		zoom.cwar
	extern long			current.mtid, current.mtid.rt

|****************************** program section ********************************

| From Micro Test Materials txwip0500em11
before.program:
	import("current.mtid", current.mtid)
	import("current.mtid.rt", current.mtid.rt)
	import("zoom.cwar", zoom.cwar)
	
	if trim$(zoom.cwar) &lt;&gt; "" then
		query.extend.where("txwip039.cwar = '" &amp; trim$(zoom.cwar) &amp; "'")
	endif
	
before.new.object:
	txwip039.cwar = "1CS001"
	txwip039.cuni = "PC"
	txwip039.tsmm = 1
	
zoom.from.all:
on.entry:
	standard.commands.off(add.set, mark.delete, update.db, end.program)

after.form.read:
	| Works because imported values were not recognized here yet
	if current.mtid = 0 and current.mtid.rt = 0 then 
		remove.form.commands("get_miro_test_materials")
	endif

main.table.io:
before.write:
	if txwip039.dcdt = 0 then
		txwip039.dcdt = utc.num()
	endif
	
before.rewrite:
	txwip039.dmdt = utc.num()

|****************************** field section **********************************
	
field.txwip039.item.segment.2:
before.display:
	if current.mtid &lt;&gt; 0 or current.mtid.rt &lt;&gt; 0 then 
		disable_fields()
	endif
	
selection.filter:
	query.extend.where.in.zoom("tcibd001.citg = '600'")
	
when.field.changes:
	update_item_desc(txwip039.item)
	update_lot_price(txwip039.item, txwip039.cwar)
	update_cost_per_testing(txwip039.item, txwip039.cwar, txwip039.tsmm, txwip039.cuni)
	
after.zoom:
	update_item_desc(txwip039.item)
	update_lot_price(txwip039.item, txwip039.cwar)
	update_cost_per_testing(txwip039.item, txwip039.cwar, txwip039.tsmm, txwip039.cuni)
	
check.input:
	domain tcitem format.item
	format.item = "         " &amp; trim$(txwip039.item)
	
	select tcibd001.item
	from tcibd001
	where tcibd001.item = :format.item
		and tcibd001.citg IN ("600")
	as set with 1 rows
	selectdo
		break
	selectempty
		message("Please select a valid item.")
		set.input.error("")
	endselect
	
field.item.desc:
before.display:
	update_item_desc(txwip039.item)
	
field.txwip039.cwar:
before.display:
	update_cwar_desc(txwip039.cwar)
	
selection.filter:
	query.extend.where.in.zoom("tcmcs003.cwar IN (""1CS001"",""1PS001"")")
	
when.field.changes:
	update_cwar_desc(txwip039.cwar)
	update_lot_price(txwip039.item, txwip039.cwar)
	update_cost_per_testing(txwip039.item, txwip039.cwar, txwip039.tsmm, txwip039.cuni)
	
after.zoom:
	update_cwar_desc(txwip039.cwar)
	update_lot_price(txwip039.item, txwip039.cwar)
	update_cost_per_testing(txwip039.item, txwip039.cwar, txwip039.tsmm, txwip039.cuni)
	
field.cwar.desc:
before.display:
	update_cwar_desc(txwip039.cwar)
	
field.txwip039.tsmm:
when.field.changes:
	update_lot_price(txwip039.item, txwip039.cwar)
	update_cost_per_testing(txwip039.item, txwip039.cwar, txwip039.tsmm, txwip039.cuni)
	
field.txwip039.cuni:
when.field.changes:
	update_cost_per_testing(txwip039.item, txwip039.cwar, txwip039.tsmm, txwip039.cuni)

selection.filter:
	query.extend.where.in.zoom("tcibd003.item = '" &amp; txwip039.item &amp; "'")
	
field.txwip039.prip:
when.field.changes:
	update_lot_price(txwip039.item, txwip039.cwar)
	update_cost_per_testing(txwip039.item, txwip039.cwar, txwip039.tsmm, txwip039.cuni)

|****************************** function section *******************************

functions:
	
function update_item_desc(domain tcitem item){
	select tcibd001.dsca
	from tcibd001
	where tcibd001.item = :item
	as set with 1 rows
	selectdo
		item.desc = tcibd001.dsca
	endselect
}

function update_cwar_desc(domain tccwar cwar){
	select tcmcs003.dsca
	from tcmcs003
	where tcmcs003.cwar = :cwar
	as set with 1 rows
	selectdo
		cwar.desc = tcmcs003.dsca 
	endselect
}

function update_cost_per_testing(domain tcitem item, domain tccwar cwar, domain tcqiv1 tssm, domain tccuni cuni){
	txwip039.csst = compute_cost_per_testing(item, cwar, tssm, cuni)
}

function domain tcqiv1 compute_cost_per_testing(domain tcitem item, domain tccwar cwar, domain tcqiv1 tssm, domain tccuni cuni){
	domain tcqiv1 cost.per.testing
	cost.per.testing = 0
	
	if get_conversion_value(item, cuni) = 0 then
		cost.per.testing = 0
	else
		cost.per.testing = get_lot_price(item, cwar) / get_conversion_value(item, cuni) * tssm
	endif
	
	return(cost.per.testing)
}

function update_lot_price(domain tcitem item, domain tccwar cwar){
	txwip039.prip = get_lot_price(txwip039.item, txwip039.cwar)
}

function domain tccopr get_lot_price(domain tcitem item, domain tccwar cwar){
	domain tcclot lot.number
	domain tccopr item.lot.price
	
	lot.number = ""
	item.lot.price = 0
	
	| Get the first valid lot (FIFO)
	select whltc105.item, whltc105.clot, whltc105.ldat
	from whltc105
	where whltc105.item = :item
		and whltc105.cwar = :cwar
		and whltc105.qhnd &gt; 0				| With Inventory
		and whltc105.ldat &lt;&gt; 0
		and exists (
			select whltc100.clot
			from whltc100
			where whltc100.item = whltc105.item
				and whltc100.clot = whltc105.clot
				and whltc100.olot = 1		| Purchase
				and whltc100.ldat &lt;&gt; 0)		| Lot Date
	order by whltc105.ldat
	as set with 1 rows
	selectdo
		lot.number = whltc105.clot
	endselect
	
	select whltc100.item, whltc100.clot, whltc100.ldat
	from whltc100
	where whltc100.item = :item
		and whltc100.clot = :lot.number
		and whltc100.olot = 1				| Purchase
		and whltc100.ldat &lt;&gt; 0				| Lot Date
	as set with 1 rows
	selectdo
		item.lot.price = 0
		
		select sum(whltc101.pric(1)):item.lot.price
		from whltc101
		where whltc101.item = :item
			and whltc101.clot = :lot.number		| Lot No
			and whltc101.cpcp = "MC0002"	  	| Material Cost			
		as set with 1 rows
		selectdo
		selectempty
			item.lot.price = 0
		endselect
	selectempty
		item.lot.price = 0
	endselect

	return(item.lot.price)
}

function domain tcconv get_conversion_value(domain tcitem item, domain tccuni cuni){
	domain tcconv value
	value = 0
	
	select tcibd003.conv
	from tcibd003
	where tcibd003.item = :item
		and tcibd003.unit = :cuni
	as set with 1 rows
	selectdo
		value = tcibd003.conv
	selectempty
		value = 0
	endselect
	
	return(value)
}

function extern get_miro_test_materials(){
	long ret
	
	if current.mtid.rt = 0 then
		do.selection(true, save_micro_test_material)
	else
		do.selection(true, save_micro_test_material_rt)
	endif
	
	ret = refresh.parent(-1)
	end()
}

function save_micro_test_material(){
	select txwip027.item
	from txwip027
	where txwip027.mtid = :current.mtid
		and txwip027.item = :txwip039.item
	selectdo
		message(str$(trim$(txwip039.item)) &amp; " is already in the list.")
		return
	selectempty
		txwip027.mtid = current.mtid
		txwip027.item = txwip039.item
		txwip027.freq = txwip039.freq
		txwip027.tsmm = txwip039.tsmm
		txwip027.cuni = txwip039.cuni
		txwip027.prip = txwip039.prip
		txwip027.csst = txwip039.csst
		db.insert(ttxwip027, db.retry)
		commit.transaction()
	endselect
}

function save_micro_test_material_rt(){
	select txwip043.item
	from txwip043
	where txwip043.mtid = :current.mtid.rt
		and txwip043.item = :txwip039.item
	selectdo
		message(str$(trim$(txwip039.item)) &amp; " is already in the list.")
		return
	selectempty
		txwip043.mtid = current.mtid.rt
		txwip043.item = txwip039.item
		txwip043.freq = txwip039.freq
		txwip043.tsmm = txwip039.tsmm
		txwip043.cuni = txwip039.cuni
		txwip043.prip = txwip039.prip
		txwip043.csst = txwip039.csst
		db.insert(ttxwip043, db.retry)
		commit.transaction()
	endselect
}

function disable_fields(){
	disable.fields("txwip039.cwar")
	disable.fields("txwip039.freq")
	disable.fields("txwip039.tsmm")
	disable.fields("txwip039.cuni")
}</expression><expressionLanguageType>Baan4C</expressionLanguageType><sourceType>1</sourceType><sourceDescription>Micro Test Materials Reference</sourceDescription><sourceName>txwip0500em23</sourceName></Source><documentation/><Attachment><type>relnotes</type><name>txwip0500em23</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em23</name></Attachment><additionalConstraints>2590</additionalConstraints><additionalInstructions/><keyword>||</keyword><application>EXTce01107</application></DR_Module><startInCompanyZero>false</startInCompanyZero><repSevLang>false</repSevLang><mainSession>true</mainSession><moduleType>1</moduleType><windowType>6</windowType><subType>1</subType><status>1</status><documentation/><Attachment><type>relnotes</type><name>txwip0500em23</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em23</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em23dcwar.desc</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em23dcwar.desc</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em23ditem.desc</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em23ditem.desc</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em23dtxwip039.cs</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em23dtxwip039.cs</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em23dtxwip039.cu</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em23dtxwip039.cu</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em23dtxwip039.cw</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em23dtxwip039.cw</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em23dtxwip039.dc</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em23dtxwip039.dc</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em23dtxwip039.dm</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em23dtxwip039.dm</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em23dtxwip039.fr</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em23dtxwip039.fr</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em23dtxwip039.it</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em23dtxwip039.it</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em23dtxwip039.pr</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em23dtxwip039.pr</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em23dtxwip039.ts</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em23dtxwip039.ts</name></Attachment><objectLabel/><application>EXTce01107</application><sessionReferenceDescriptionReference>txwip0500em23</sessionReferenceDescriptionReference><sessionReferenceDescription>Micro Test Materials Reference</sessionReferenceDescription><sessionReference>txwip0500em23</sessionReference><UIScript>txwip0500em23</UIScript></DR_Controller>