alse</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>28</position><description/><name>prev.frm</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>29</position><description/><name>last.frm</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>31</position><description/><name>resize.frm</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>32</position><description/><name>cust.grid</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>33</position><description/><name>cmd.options</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>34</position><description/><name>zoom</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>35</position><description/><name>interrupt</name></StandardCommand><StandardCommand><active>true</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>36</position><description/><name>end.program</name></StandardCommand><StandardCommand><active>true</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>37</position><description/><name>abort.program</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>39</position><description/><name>text.manager</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>40</position><description/><name>run.job</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>41</position><description/><name>global.delete</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>42</position><description/><name>global.copy</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>43</position><description/><name>save.defaults</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>44</position><description/><name>get.defaults</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>45</position><description/><name>start.chart</name></StandardCommand><StandardCommand><active>true</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>46</position><description/><name>start.query</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>47</position><description/><name>select.all</name></StandardCommand><defaultStartCommand>false</defaultStartCommand><DR_Module><description>Micro Test Materials Reference</description><versionID>B61O_a_ext</versionID><type>library</type><name>txwip0500em23</name><Version><ObjectID/><classID/><checkInLabel/><documentation/><isExpired>no</isExpired><isCheckedOutParallel>no</isCheckedOutParallel><isCheckedOut>no</isCheckedOut><modificationDateTime>2026-10-26T00:14:29Z</modificationDateTime><modifiedBy>ict004</modifiedBy><creationDateTime>2026-10-01T05:09:36Z</creationDateTime><createdBy>ict004</createdBy></Version><Source><sourceVersion><ObjectID/><classID/><checkInLabel/><documentation/><isExpired>no</isExpired><isCheckedOutParallel>no</isCheckedOutParallel><isCheckedOut>no</isCheckedOut><modificationDateTime>2026-10-26T00:14:29Z</modificationDateTime><modifiedBy>ict004</modifiedBy><creationDateTime>2026-10-01T05:09:36Z</creationDateTime><createdBy>ict004</createdBy></sourceVersion><sourceVersionID>B61O_a_ext</sourceVersionID><sourceObjectID>1</sourceObjectID><expression>|*******************************************************************************
|* txwip0500em23  B61O_a_ext
|* Micro Test Materials Reference
|* ict004
|* 2026-10-01 [01:09]
|*******************************************************************************
|* Script Type: 123
|*******************************************************************************

|*************************** declaration section *******************************
declaration:

	table	ttxwip020		|* QC Costs
	table	ttxwip021		|* Reagents	
	table	ttxwip022		|* Reagents Details
	table	ttxwip024		|* Micro Tests
	table	ttxwip025		|* Micro Test Details
	table	ttxwip026		|* QC Personnels
	table	ttxwip027		|* Micro Test Materials
	table	ttxwip028		|* Micro Test Reagents
	table	ttxwip030		|* Pychem Tests
	table	ttxwip031		|* Pychem Test Details
	table	ttxwip033		|* Third Party Tests
	table	ttxwip034		|* Third Party Test Details
	table	ttxwip035 		|* QC Items
	table	ttxwip036		|* Item Testing Costs
	table	ttxwip037		|* Item Testing Cost Details
	table	ttxwip038		|* Inline &amp; Documentation Costs
	table	ttxwip039		|* Micro Test Materials Reference
	table	ttxwip040		|* QC Cost Simulations
	table	ttxwip041		|* Micro Retests
	table	ttxwip042		|* Micro Retest Details
	table	ttxwip043		|* Micro Retest Materials
	table	ttxwip044		|* Micro Retest Reagents
	table	ttxwip045		|* Pychem Retests
	table	ttxwip046		|* Pychem Retest Details
	table	ttxwip047		|* QC Cost Retest
	table	ttxwip048		|* QC Cost Simulation Retests	
	
	table	ttcibd001		|* Items
	table	ttcibd003		|* Conversion Factors
	table	ttdipu001		|* Item - Purchase
	table	ttcmcs003		|* Warehouses
	table	ttcmcs012		|* Units by Unit Set
	table	twhltc101		|* Lot Cost Details
	table	ttccom100		|* Business Partners
	table	ttisfc001		|* Production Orders
	table	tticpr007		|* Items - Costing
	table	twhinr140		|* Inventory
	
	extern domain tcitm.dscr	item.desc
	extern domain tcdsca		cwar.desc
	extern domain tccwar		zoom.cwar
	extern long			current.mtid, current.mtid.rt

|****************************** program section ********************************

| From Micro Test Materials txwip0500em11
before.program:
	import("current.mtid", current.mtid)
	import("current.mtid.rt", current.mtid.rt)
	import("zoom.cwar", zoom.cwar)
	
	if trim$(zoom.cwar) &lt;&gt; "" then
		query.extend.where("txwip039.cwar = '" &amp; trim$(zoom.cwar) &amp; "'")
	endif
	
before.new.object:
	txwip039.cwar = "1CS001"
	txwip039.cuni = "PC"
	txwip039.tsmm = 1
	
zoom.from.all:
on.entry:
	standard.commands.off(add.set, mark.delete, update.db, end.program)

after.form.read:
	| Works because imported values were not recognized here yet
	if current.mtid = 0 and current.mtid.rt = 0 then 
		remove.form.commands("get_miro_test_materials")
	endif

main.table.io:
before.write:
	if txwip039.dcdt = 0 then
		txwip039.dcdt = utc.num()
	endif
	
before.rewrite:
	txwip039.dmdt = utc.num()

|****************************** field section **********************************
	
field.txwip039.item.segment.2:
before.display:
	if current.mtid &lt;&gt; 0 or current.mtid.rt &lt;&gt; 0 then 
		disable_fields()
	endif
	
selection.filter:
	query.extend.where.in.zoom("tcibd001.citg = '600'")
	
when.field.changes:
	update_item_desc(txwip039.item)
	update_lot_price(txwip039.item, txwip039.cwar)
	update_cost_per_testing(txwip039.item, txwip039.cwar, txwip039.tsmm, txwip039.cuni)
	
after.zoom:
	update_item_desc(txwip039.item)
	update_lot_price(txwip039.item, txwip039.cwar)
	update_cost_per_testing(txwip039.item, txwip039.cwar, txwip039.tsmm, txwip039.cuni)
	
check.input:
	domain tcitem format.item
	format.item = "         " &amp; trim$(txwip039.item)
	
	select tcibd001.item
	from tcibd001
	where tcibd001.item = :format.item
		and tcibd001.citg IN ("600")
	as set with 1 rows
	selectdo
		break
	selectempty
		message("Please select a valid item.")
		set.input.error("")
	endselect
	
field.item.desc:
before.display:
	update_item_desc(txwip039.item)
	
field.txwip039.cwar:
before.display:
	update_cwar_desc(txwip039.cwar)
	
selection.filter:
	query.extend.where.in.zoom("tcmcs003.cwar IN (""1CS001"",""1PS001"")")
	
when.field.changes:
	update_cwar_desc(txwip039.cwar)
	update_lot_price(txwip039.item, txwip039.cwar)
	update_cost_per_testing(txwip039.item, txwip039.cwar, txwip039.tsmm, txwip039.cuni)
	
after.zoom:
	update_cwar_desc(txwip039.cwar)
	update_lot_price(txwip039.item, txwip039.cwar)
	update_cost_per_testing(txwip039.item, txwip039.cwar, txwip039.tsmm, txwip039.cuni)
	
field.cwar.desc:
before.display:
	update_cwar_desc(txwip039.cwar)
	
field.txwip039.tsmm:
when.field.changes:
	update_lot_price(txwip039.item, txwip039.cwar)
	update_cost_per_testing(txwip039.item, txwip039.cwar, txwip039.tsmm, txwip039.cuni)
	
field.txwip039.cuni:
when.field.changes:
	update_cost_per_testing(txwip039.item, txwip039.cwar, txwip039.tsmm, txwip039.cuni)

selection.filter:
	query.extend.where.in.zoom("tcibd003.item = '" &amp; txwip039.item &amp; "'")
	
field.txwip039.prip:
when.field.changes:
	update_lot_price(txwip039.item, txwip039.cwar)
	update_cost_per_testing(txwip039.item, txwip039.cwar, txwip039.tsmm, txwip039.cuni)

|****************************** function section *******************************

functions:
	
function update_item_desc(domain tcitem item){
	select tcibd001.dsca
	from tcibd001
	where tcibd001.item = :item
	as set with 1 rows
	selectdo
		item.desc = tcibd001.dsca
	endselect
}

function update_cwar_desc(domain tccwar cwar){
	select tcmcs003.dsca
	from tcmcs003
	where tcmcs003.cwar = :cwar
	as set with 1 rows
	selectdo
		cwar.desc = tcmcs003.dsca 
	endselect
}

function update_cost_per_testing(domain tcitem item, domain tccwar cwar, domain tcqiv1 tssm, domain tccuni cuni){
	txwip039.csst = compute_cost_per_testing(item, cwar, tssm, cuni)
}

function domain tcqiv1 compute_cost_per_testing(domain tcitem item, domain tccwar cwar, domain tcqiv1 tssm, domain tccuni cuni){
	domain tcqiv1 cost.per.testing
	cost.per.testing = 0
	
	if get_conversion_value(item, cuni) = 0 then
		cost.per.testing = 0
	else
		cost.per.testing = get_item_lot_price(item, cwar) / get_conversion_value(item, cuni) * tssm
	endif
	
	return(cost.per.testing)
}

function update_lot_price(domain tcitem item, domain tccwar cwar){
	txwip039.prip = get_item_lot_price(txwip039.item, txwip039.cwar)
}

function domain tccopr get_item_lot_price(domain tcitem item, domain tccwar cwar){
	domain tcclot lot.number
	domain tccopr item.lot.price
	domain tcitem format.item
	domain whloca location
	
	item.lot.price = 0
	lot.number = ""
	format.item = "         " &amp; trim$(item)
	
	location =  get_location(cwar)
	
	| Get first valid lot (FIFO)
	select whinr140.clot, whinr140.idat
	from whinr140
	where whinr140.item = :format.item
		and whinr140.cwar = :cwar		| Warehouse
		and whinr140.loca = :location		| Location
		and whinr140.idat &lt;&gt; 0			| Inventory Date
		and (whinr140.qhnd - whinr140.qblk) &gt; 0 | On-hand - Blocked
	order by whinr140.idat
	as set with 1 rows
	selectdo
		lot.number = whinr140.clot
	endselect
	
	select sum(whltc101.pric(1)):item.lot.price
	from whltc101
	where whltc101.item = :format.item
		and whltc101.clot = :lot.number		| Lot No
		and whltc101.cpcp = "MC0002"	  	| Material Cost			
	as set with 1 rows
	selectdo
	endselect

	return(item.lot.price)
}

function domain whloca get_location(domain tccwar cwar){
	if cwar = "1CS001" then
		return("110S1QCD01")
	else
		return("110S2QCD01")
	endif
}

function domain tcconv get_conversion_value(domain tcitem item, domain tccuni cuni){
	domain tcconv value
	value = 0
	
	select tcibd003.conv
	from tcibd003
	where tcibd003.item = :item
		and tcibd003.unit = :cuni
	as set with 1 rows
	selectdo
		value = tcibd003.conv
	selectempty
		value = 0
	endselect
	
	return(value)
}

function extern get_miro_test_materials(){
	long ret
	
	if current.mtid.rt = 0 then
		do.selection(true, save_micro_test_material)
	else
		do.selection(true, save_micro_test_material_rt)
	endif
	
	ret = refresh.parent(-1)
	end()
}

function save_micro_test_material(){
	select txwip027.item
	from txwip027
	where txwip027.mtid = :current.mtid
		and txwip027.item = :txwip039.item
	selectdo
		message(str$(trim$(txwip039.item)) &amp; " is already in the list.")
		return
	selectempty
		txwip027.mtid = current.mtid
		txwip027.item = txwip039.item
		txwip027.freq = txwip039.freq
		txwip027.tsmm = txwip039.tsmm
		txwip027.cuni = txwip039.cuni
		txwip027.prip = txwip039.prip
		txwip027.csst = txwip039.csst
		db.insert(ttxwip027, db.retry)
		commit.transaction()
	endselect
}

function save_micro_test_material_rt(){
	select txwip043.item
	from txwip043
	where txwip043.mtid = :current.mtid.rt
		and txwip043.item = :txwip039.item
	selectdo
		message(str$(trim$(txwip039.item)) &amp; " is already in the list.")
		return
	selectempty
		txwip043.mtid = current.mtid.rt
		txwip043.item = txwip039.item
		txwip043.freq = txwip039.freq
		txwip043.tsmm = txwip039.tsmm
		txwip043.cuni = txwip039.cuni
		txwip043.prip = txwip039.prip
		txwip043.csst = txwip039.csst
		db.insert(ttxwip043, db.retry)
		commit.transaction()
	endselect
}

function disable_fields(){
	disable.fields("txwip039.cwar")
	disable.fields("txwip039.freq")
	disable.fields("txwip039.tsmm")
	disable.fields("txwip039.cuni")
}</expression><expressionLanguageType>Baan4C</expressionLanguageType><sourceType>1</sourceType><sourceDescription>Micro Test Materials Reference</sourceDescription><sourceName>txwip0500em23</sourceName></Source><documentation/><Attachment><type>relnotes</type><name>txwip0500em23</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em23</name></Attachment><additionalConstraints>2590</additionalConstraints><additionalInstructions/><keyword>||</keyword><application>EXTce01107</application></DR_Module><startInCompanyZero>false</startInCompanyZero><repSevLang>false</repSevLang><mainSession>true</mainSession><moduleType>1</moduleType><windowType>6</windowType><subType>1</subType><status>1</status><documentation/><objectLabel/><application>EXTce01107</application><sessionReferenceDescriptionReference>txwip0500em23</sessionReferenceDescriptionReference><sessionReferenceDescription>Micro Test Materials Reference</sessionReferenceDescription><sessionReference>txwip0500em23</sessionReference><UIScript>txwip0500em23</UIScript></DR_Controller>