e</repeating><groupID>1</groupID></FormGroup><FormGroup><selectionGroup>false</selectionGroup><parentTable/><miscellaneous>0</miscellaneous><nextToOtherGroup>false</nextToOtherGroup><checkBoxesOnly>false</checkBoxesOnly><formFormat>13</formFormat><subGroupOnNewPage>false</subGroupOnNewPage><nrSubGroups>1</nrSubGroups><firstChildGroup>0</firstChildGroup><virtualGroup>false</virtualGroup><groupAlignment>-3</groupAlignment><firstField>10</firstField><nextGroup>0</nextGroup><previousGroup>0</previousGroup><parentGroup>1</parentGroup><overviewSession>true</overviewSession><detailsSession>true</detailsSession><showGroupBox>false</showGroupBox><groupHeader/><level>1</level><repeating>false</repeating><groupID>3</groupID></FormGroup></PhysicalFormLayout><description>Pychem Retest Details</description><name>txwip0500em33d</name><horizontal>true</horizontal><custProhibited>false</custProhibited><additionalConstraints>1</additionalConstraints><documentation/><application>EXTce01107</application></Form><DR_Module><description>Pychem Retest Details</description><versionID>B61O_a_ext</versionID><type>library</type><name>txwip0500em33</name><Version><ObjectID/><classID/><checkInLabel/><documentation/><isExpired>no</isExpired><isCheckedOutParallel>no</isCheckedOutParallel><isCheckedOut>no</isCheckedOut><modificationDateTime>2026-10-21T23:20:44Z</modificationDateTime><modifiedBy>ict004</modifiedBy><creationDateTime>2026-10-06T06:30:50Z</creationDateTime><createdBy>ict004</createdBy></Version><Source><sourceVersion><ObjectID/><classID/><checkInLabel/><documentation/><isExpired>no</isExpired><isCheckedOutParallel>no</isCheckedOutParallel><isCheckedOut>no</isCheckedOut><modificationDateTime>2026-10-21T23:20:44Z</modificationDateTime><modifiedBy>ict004</modifiedBy><creationDateTime>2026-10-06T06:30:50Z</creationDateTime><createdBy>ict004</createdBy></sourceVersion><sourceVersionID>B61O_a_ext</sourceVersionID><sourceObjectID>1</sourceObjectID><expression>|*******************************************************************************
|* txwip0500em33  B61O_a_ext
|* Pychem Retest Details
|* ict004
|* 2026-08-13 [09:23]
|*******************************************************************************
|* Script Type: 123
|*******************************************************************************

|*************************** declaration section *******************************
declaration:

	table	ttxwip020		|* QC Costs
	table	ttxwip021		|* Reagents	
	table	ttxwip022		|* Reagents Details
	table	ttxwip024		|* Micro Tests
	table	ttxwip025		|* Micro Test Details
	table	ttxwip026		|* QC Personnels
	table	ttxwip027		|* Micro Test Materials
	table	ttxwip028		|* Micro Test Reagents
	table	ttxwip030		|* Pychem Tests
	table	ttxwip031		|* Pychem Test Details
	table	ttxwip033		|* Third Party Tests
	table	ttxwip034		|* Third Party Test Details
	table	ttxwip035 		|* QC Items
	table	ttxwip036		|* Item Testing Costs
	table	ttxwip037		|* Item Testing Cost Details
	table	ttxwip038		|* Inline &amp; Documentation Costs
	table	ttxwip039		|* Micro Test Materials Reference
	table	ttxwip040		|* QC Cost Simulations
	table	ttxwip041		|* Micro Retests
	table	ttxwip042		|* Micro Retest Details
	table	ttxwip043		|* Micro Retest Materials
	table	ttxwip044		|* Micro Retest Reagents
	table	ttxwip045		|* Pychem Retests
	table	ttxwip046		|* Pychem Retest Details
	table	ttxwip047		|* QC Cost Retest
	table	ttxwip048		|* QC Cost Simulation Retests	
	
	table	ttcibd001		|* Items
	table	ttcibd003		|* Conversion Factors
	table	ttdipu001		|* Item - Purchase
	table	ttcmcs003		|* Warehouses
	table	ttcmcs012		|* Units by Unit Set
	table	twhltc101		|* Lot Cost Details
	table	ttccom100		|* Business Partners
	table	ttisfc001		|* Production Orders
	table	tticpr007		|* Items - Costing
	table	twhinr140		|* Inventory
	
	extern domain tcmcs.str50	mtrl.desc
	extern domain tccwar		zoom.cwar
	extern domain tcorno		zoom.code
	extern long			temp.ptid, save.ptid, current.ptid

|****************************** program section ********************************

before.program:
	| Initialize MTID tracking variables.
	| temp.ptid = temporary negative MTID for unsaved rows.
	| save.ptid = highest existing MTID used as the base during Save.
	temp.ptid = 0
	save.ptid = 0
	import("txwip045.ptid", zoom.code)
	
main.table.io:
before.write:
	| Convert temporary negative MTID to permanent positive MTID
	| immediately before the new record is written to the database.
	if txwip046.pdid &lt; 0 then
		save.ptid = save.ptid + 1
		txwip046.pdid = save.ptid
	endif
	
	if txwip046.dcdt = 0 then
		txwip046.dcdt = utc.num()
	endif
	
before.rewrite:
	txwip046.dmdt = utc.num()
	
before.new.object:
	txwip046.mttp = ltoe(2)
	
form.all:
init.form:
	if trim$(zoom.code) &lt;&gt; "" then
		standard.commands.off(add.set, mark.delete, update.db, end.program)
	endif

|****************************** choice section *********************************

choice.add.set:
after.choice:
	| Handle rows created using the toolbar New button.
	| Assign a temporary negative MTID to the new occurrence.
	if txwip046.pdid = 0 then
		set_temp_mtid()
	endif
	
choice.update.db:
before.choice:
	| Before saving, get the latest highest persisted MTID.
	| This becomes the starting point for permanent MTID assignment.
	save.ptid = 0

	select max(txwip046.pdid):save.ptid
	from txwip046
	selectdo
	endselect
	
|****************************** field section **********************************
	
field.txwip046.mttp:
before.display:
	if trim$(zoom.code) &lt;&gt; "" then
		disable_fields()
	endif
	
before.field:
	| Handle rows automatically created by TAB navigation.
	| The new occurrence initially has MTID = 0, so assign
	| a temporary negative MTID when PRMT becomes active.
	if txwip046.pdid = 0 then
		set_temp_mtid()
	endif
	
when.field.changes:
	if txwip046.mttp = ltoe(0) then
		txwip046.mtrl = ""
		mtrl.desc = ""
		txwip046.aqsm = 0
		txwip046.mcst = 0
	endif

	display("txwip046.mtrl")
	display("mtrl.desc")
	display("txwip046.aqsm")
	display("txwip046.mcst")

field.txwip046.mtrl:
before.zoom:
	update_parameter_zoom()
	
selection.filter:
	update_param_selection_filter(txwip046.mttp)

after.zoom:
	if trim$(txwip046.mtrl) &lt;&gt; "" then
		txwip046.mtrl = trim$(txwip046.mtrl)
	endif
	
when.field.changes:
	if trim$(txwip046.mtrl) &lt;&gt; "" then
		update_material_desc(txwip046.mtrl)
	endif
	
check.input:
	domain tcitem format.item
	
	if trim$(txwip046.mtrl) &lt;&gt; "" then
		on case etol(txwip046.mttp)
			case 1:
				format.item = "         " &amp; trim$(txwip046.mtrl)
				
				select tcibd001.item
				from tcibd001
				where tcibd001.item = :format.item
					and tcibd001.citg IN ("600", "FG", "SFG", "RM/FG", "RM")
				as set with 1 rows
				selectdo
					break
				selectempty
					message("Please select a valid item.")
					set.input.error("")
				endselect
				break
			case 2:
				format.item = trim$(txwip046.mtrl)
				
				select txwip021.rgnt
				from txwip021
				where txwip021.rgnt = :format.item
				as set with 1 rows
				selectdo
					break
				selectempty
					message("Please select a valid reagent.")
					set.input.error("")
				endselect
				break			
			case 3:
				format.item = trim$(txwip046.mtrl)
				
				select txwip035.dscr
				from txwip035
				where txwip035.qitm = :format.item
				as set with 1 rows
				selectdo
					break
				selectempty
					message("Please select a valid item.")
					set.input.error("")
				endselect
				break	
			default:
		endcase
	endif
	
field.mtrl.desc:
before.display:
	update_material_desc(txwip046.mtrl)
	
field.txwip046.aqsm:
when.field.changes:
	update_material_cost(txwip046.mttp, txwip046.mtrl, txwip046.aqsm)
		
|****************************** function section *******************************

functions:

function void set_temp_mtid(){
	temp.ptid = temp.ptid - 1
	txwip046.pdid = temp.ptid
}

function void update_parameter_zoom(){
	on case etol(txwip046.mttp)
		case 1:
			attr.zoomcode = 2
			attr.zoomsession$ = "tcibd0501m000"
			attr.zoomreturn$ = "tcibd001.item"
			break
		case 2:
			attr.zoomcode = 2
			attr.zoomsession$ = "txwip0500em03"
			attr.zoomreturn$ = "txwip021.rgnt"
			break
		case 3:
			attr.zoomcode = 2
			attr.zoomsession$ = "txwip0500em06"
			attr.zoomreturn$ = "txwip035.qitm"
			break
		default:
			disable.fields("txwip046.mtrl")
	endcase
}

function void update_param_selection_filter(domain txmat.types param.type){
	on case etol(param.type)
		case 1:
			query.extend.where.in.zoom("tcibd001.citg IN (""600"",""FG"",""SFG"",""RM/FG"", ""RM"")")
			break
		default:
	endcase
}

function void update_material_cost(domain txmat.types type, domain tcmcs.str50 param, domain tiqcp1 aqsm){
	txwip046.mcst = compute_param_cost(type, param, aqsm)
}

function domain tcqiv1 compute_param_cost(domain txmat.types type, domain tcmcs.str50 param, domain tiqcp1 aqsm){
	domain tcqiv1 total, cost.per.testing
	domain tccopr item.lot.price
	domain tcconv conversion.value
	domain tcitem format.item
	
	total = 0
	
	on case etol(type)
		case 1:
			format.item = "         " &amp; trim$(param)
			
			select tcibd001.item
			from tcibd001
			where tcibd001.item = :format.item
				and tcibd001.citg IN ("FG", "SFG", "RM/FG", "RM")
			selectdo
				item.lot.price = get_item_standard_cost(format.item)
				conversion.value = 1000
				cost.per.testing = item.lot.price / conversion.value
				total = cost.per.testing * aqsm
			selectempty
				conversion.value = get_conversion_value(format.item)
				item.lot.price = get_item_lot_price(format.item, zoom.cwar)
				
				if conversion.value = 0 then
					cost.per.testing = 0
					total = 0
				else
					cost.per.testing = item.lot.price / conversion.value
					total = cost.per.testing * aqsm
				endif
			endselect
			break
		case 2:
			format.item = trim$(param)
			
			select txwip021.csst
			from txwip021
			where txwip021.rgnt = :format.item
			as set with 1 rows
			selectdo
				total = aqsm * txwip021.csst
			endselect
			break
		case 3:
			format.item = trim$(param)
			
			select txwip035.prip
			from txwip035
			where txwip035.qitm = :format.item
			selectdo
				total = txwip035.prip
			endselect
			break
		default:
			total = 0
	endcase
	
	return(total)
}

function void update_material_desc(domain tcmcs.str50 mtrl){
	domain tcitem format.item
	mtrl.desc = ""
	
	on case etol(txwip046.mttp)
		case 1:
			format.item = "         " &amp; trim$(mtrl)
			
			select tcibd001.dsca
			from tcibd001
			where tcibd001.item = :format.item
			selectdo
				mtrl.desc = tcibd001.dsca
			endselect
			break
		case 2:
			format.item = trim$(mtrl)
			
			select txwip021.dscr
			from txwip021
			where txwip021.rgnt = :format.item
			selectdo
				mtrl.desc = txwip021.dscr
			endselect
			break
		case 3:
			format.item = trim$(mtrl)
			
			select txwip035.dscr
			from txwip035
			where txwip035.qitm = :mtrl
			as set with 1 rows
			selectdo
				mtrl.desc = txwip035.dscr
			endselect
			break
		default:
			mtrl.desc = ""
	endcase
}

function domain tccopr get_item_standard_cost(domain tcitem item){
	domain tccopr cost
	cost = 0
	
	select ticpr007.ecpr
	from ticpr007
	where ticpr007.item = :item
	selectdo
		cost = ticpr007.ecpr(1)
	endselect
	
	return(cost)
}

function domain tccopr get_item_lot_price(domain tcitem item, domain tccwar cwar){
	domain tcclot lot.number
	domain tccopr item.lot.price
	domain tcitem format.item
	
	item.lot.price = 0
	lot.number = ""
	format.item = "         " &amp; trim$(item)
	
	| Get first valid lot (FIFO)
	select whinr140.clot, whinr140.idat
	from whinr140
	where whinr140.item = :format.item
		and whinr140.cwar = :cwar		| Warehouse
		and whinr140.loca = "110S1QCD01"	| QC Calauan
		and whinr140.idat &lt;&gt; 0			| Inventory Date
		and (whinr140.qhnd - whinr140.qblk) &gt; 0 | On-hand - Blocked
	order by whinr140.idat
	as set with 1 rows
	selectdo
		lot.number = whinr140.clot
	endselect
	
	select sum(whltc101.pric(1)):item.lot.price
	from whltc101
	where whltc101.item = :format.item
		and whltc101.clot = :lot.number		| Lot No
		and whltc101.cpcp = "MC0002"	  	| Material Cost			
	as set with 1 rows
	selectdo
	endselect

	return(item.lot.price)
}

function domain tcconv get_conversion_value(domain tcitem item){
	domain tcconv value
	domain tcitem format.item
	
	value = 0
	format.item = "         " &amp; trim$(item)
	
	select tcibd003.conv
	from tcibd003
	where tcibd003.item = :format.item
	as set with 1 rows
	selectdo
		value = tcibd003.conv
	selectempty
		value = 0
	endselect
	
	return(value)
}

function disable_fields(){
	disable.fields("txwip046.mttp")
	disable.fields("txwip046.mtrl")
	disable.fields("txwip046.aqsm")
}</expression><expressionLanguageType>Baan4C</expressionLanguageType><sourceType>1</sourceType><sourceDescription>Pychem Retest Details</sourceDescription><sourceName>txwip0500em33</sourceName></Source><documentation/><Attachment><type>relnotes</type><name>txwip0500em33</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em33</name></Attachment><additionalConstraints>2590</additionalConstraints><additionalInstructions/><keyword>||</keyword><application>EXTce01107</application></DR_Module><startInCompanyZero>false</startInCompanyZero><repSevLang>false</repSevLang><mainSession>true</mainSession><moduleType>1</moduleType><windowType>6</windowType><subType>1</subType><status>1</status><documentation/><Attachment><type>relnotes</type><name>txwip0500em33</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em33</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em33dmtrl.desc</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em33dmtrl.desc</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em33dtxwip046.aq</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em33dtxwip046.aq</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em33dtxwip046.dc</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em33dtxwip046.dc</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em33dtxwip046.dm</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em33dtxwip046.dm</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em33dtxwip046.mc</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em33dtxwip046.mc</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em33dtxwip046.mt</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em33dtxwip046.mt</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em33dtxwip046.mt</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em33dtxwip046.mt</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em33dtxwip046.pd</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em33dtxwip046.pd</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em33dtxwip046.pt</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em33dtxwip046.pt</name></Attachment><objectLabel/><application>EXTce01107</application><sessionReferenceDescriptionReference>txwip0500em33</sessionReferenceDescriptionReference><sessionReferenceDescription>Pychem Retest Details</sessionReferenceDescription><sessionReference>txwip0500em33</sessionReference><UIScript>txwip0500em33</UIScript></DR_Controller>