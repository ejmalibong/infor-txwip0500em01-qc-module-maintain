6</position><description/><name>dupl.occur</name></StandardCommand><StandardCommand><active>true</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>17</position><description/><name>recover.set</name></StandardCommand><StandardCommand><active>true</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>18</position><description/><name>mark.delete</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>19</position><description/><name>mark.occur</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>20</position><description/><name>change.order</name></StandardCommand><StandardCommand><active>true</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>21</position><description/><name>modify.set</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>23</position><description/><name>print.data</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>24</position><description/><name>create.job</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>25</position><description/><name>change.frm</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>26</position><description/><name>first.frm</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>27</position><description/><name>next.frm</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>28</position><description/><name>prev.frm</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>29</position><description/><name>last.frm</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>31</position><description/><name>resize.frm</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>32</position><description/><name>cust.grid</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>33</position><description/><name>cmd.options</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>34</position><description/><name>zoom</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>35</position><description/><name>interrupt</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>36</position><description/><name>end.program</name></StandardCommand><StandardCommand><active>true</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>37</position><description/><name>abort.program</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>39</position><description/><name>text.manager</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>40</position><description/><name>run.job</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>41</position><description/><name>global.delete</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>42</position><description/><name>global.copy</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>43</position><description/><name>save.defaults</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>44</position><description/><name>get.defaults</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>45</position><description/><name>start.chart</name></StandardCommand><StandardCommand><active>true</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>46</position><description/><name>start.query</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>47</position><description/><name>select.all</name></StandardCommand><defaultStartCommand>false</defaultStartCommand><DR_Module><description>Micro Test Details</description><versionID>B61O_a_ext</versionID><type>library</type><name>txwip0500em10</name><Version><ObjectID/><classID/><checkInLabel/><documentation/><isExpired>no</isExpired><isCheckedOutParallel>no</isCheckedOutParallel><isCheckedOut>no</isCheckedOut><modificationDateTime>2026-10-21T23:51:57Z</modificationDateTime><modifiedBy>ict004</modifiedBy><creationDateTime>2026-08-13T01:23:49Z</creationDateTime><createdBy>ict004</createdBy></Version><Source><sourceVersion><ObjectID/><classID/><checkInLabel/><documentation/><isExpired>no</isExpired><isCheckedOutParallel>no</isCheckedOutParallel><isCheckedOut>no</isCheckedOut><modificationDateTime>2026-10-21T23:51:57Z</modificationDateTime><modifiedBy>ict004</modifiedBy><creationDateTime>2026-08-13T01:23:49Z</creationDateTime><createdBy>ict004</createdBy></sourceVersion><sourceVersionID>B61O_a_ext</sourceVersionID><sourceObjectID>1</sourceObjectID><expression>|*******************************************************************************
|* txwip0500em10  B61O_a_ext
|* Micro Test Details
|* ict004
|* 2026-08-13 [09:23]
|*******************************************************************************
|* Script Type: 123
|*******************************************************************************

|*************************** declaration section *******************************
declaration:

	table	ttxwip020		|* QC Costs
	table	ttxwip021		|* Reagents	
	table	ttxwip022		|* Reagents Details
	table	ttxwip024		|* Micro Tests
	table	ttxwip025		|* Micro Test Details
	table	ttxwip026		|* QC Personnels
	table	ttxwip027		|* Micro Test Materials
	table	ttxwip028		|* Micro Test Reagents
	table	ttxwip030		|* Pychem Tests
	table	ttxwip031		|* Pychem Test Details
	table	ttxwip033		|* Third Party Tests
	table	ttxwip034		|* Third Party Test Details
	table	ttxwip035 		|* QC Items
	table	ttxwip036		|* Item Testing Costs
	table	ttxwip037		|* Item Testing Cost Details
	table	ttxwip038		|* Inline &amp; Documentation Costs
	table	ttxwip039		|* Micro Test Materials Reference
	table	ttxwip040		|* QC Cost Simulations
	table	ttxwip041		|* Micro Retests
	table	ttxwip042		|* Micro Retest Details
	table	ttxwip043		|* Micro Retest Materials
	table	ttxwip044		|* Micro Retest Reagents
	table	ttxwip045		|* Pychem Retests
	table	ttxwip046		|* Pychem Retest Details
	table	ttxwip047		|* QC Cost Retest
	table	ttxwip048		|* QC Cost Simulation Retests	
	
	table	ttcibd001		|* Items
	table	ttcibd003		|* Conversion Factors
	table	ttdipu001		|* Item - Purchase
	table	ttcmcs003		|* Warehouses
	table	ttcmcs012		|* Units by Unit Set
	table	twhltc100		|* Lots
	table	twhltc101		|* Lot Cost Details
	table	twhltc105		|* Lots by Warehouse
	table	ttccom100		|* Business Partners
	table	ttisfc001		|* Production Orders
	table	tticpr007		|* Items - Costing
	
	extern domain tcnama		parm.desc
	extern domain tcmcs.str50	prid.desc
	extern domain tccwar		zoom.cwar
	extern domain tcorno		zoom.code
	extern long			temp.id, save.id, current.mtid

|****************************** program section ********************************

before.program:
	| Initialize MTID tracking variables.
	| temp.id = temporary negative MTID for unsaved rows.
	| save.id = highest existing MTID used as the base during save.
	temp.id = 0
	save.id = 0
	import("txwip024.anly", zoom.code)

before.new.object:
	txwip025.prtm = 1
	txwip025.prid = 1

main.table.io:
before.write:
	| Convert temporary negative MTID to permanent positive MTID
	| immediately before the new record is written to the database.
	if txwip025.mtid &lt; 0 then
		save.id = save.id + 1
		txwip025.mtid = save.id
	endif
	
	if txwip025.dcdt = 0 then
		txwip025.dcdt = utc.num()
	endif
	
	if etol(txwip025.prmt) = 2 and trim$(txwip025.parm) &lt;&gt; ""
		and txwip025.mtid &gt; 0 then
		save_micro_test_materials(txwip025.parm, txwip025.mtid)
		txwip025.mcst = compute_total_material_cost(txwip025.mtid)
	endif
	
before.rewrite:
	txwip025.dmdt = utc.num()
	
before.delete:
	delete_details_references(txwip025.mtid)
	
form.all:
init.form:
	if trim$(zoom.code) &lt;&gt; "" then
		standard.commands.off(add.set, mark.delete, update.db, end.program)
	endif

|****************************** choice section *********************************

choice.add.set:
after.choice:
	| Handle rows created using the toolbar New button.
	| Assign a temporary negative MTID to the new occurrence.
	if txwip025.mtid = 0 then
		set_temp_id()
	endif
	
choice.update.db:
before.choice:
	| Before saving, get the latest highest persisted MTID.
	| This becomes the starting point for permanent MTID assignment.
	save.id = 0

	select max(txwip025.mtid):save.id
	from txwip025
	selectdo
	endselect
	
|****************************** field section **********************************

field.txwip025.prmt:
before.display:
	if trim$(zoom.code) &lt;&gt; "" then
		disable_fields()
	endif
	
before.field:
	| Handle rows automatically created by TAB navigation.
	| The new occurrence initially has MTID = 0, so assign
	| a temporary negative MTID when PRMT becomes active.
	if txwip025.mtid = 0 then
		set_temp_id()
	endif
	
when.field.changes:
	if txwip025.prmt = ltoe(0) then
		txwip025.parm = ""
		parm.desc = ""
		txwip025.prtm = 0
		txwip025.lbhr = 0
		txwip025.lbst = 0
	endif
	
	if txwip025.prmt = ltoe(1) then
		disable.zoom.buttons("txwip025.parm")
	endif
	
	display("parm.desc")
	display("txwip025.prtm")
	display("txwip025.lbhr")
	display("txwip025.lbst")

field.txwip025.parm:
selection.filter:
	if etol(txwip025.prmt) = 2 then
		query.extend.where.in.zoom("tcibd001.citg = '600'")
	endif
	
before.zoom:
	update_parameter_zoom(txwip025.prmt)

after.zoom:
	if etol(txwip025.prmt) = 2 then
		txwip025.parm = trim$(txwip025.parm)
	endif
	
when.field.changes:
	update_parameter_desc(txwip025.parm)
	
check.input:
	if etol(txwip025.prmt) = 2 and trim$(txwip025.parm) &lt;&gt; "" then
		select tcibd001.item
		from tcibd001
		where tcibd001.item = "         " &amp; :txwip025.parm
		and tcibd001.citg = '600'
		selectdo
			break
		selectempty
			message("Please select a valid item.")
			set.input.error("")
		endselect
	endif
	
field.parm.desc:
before.display:
	update_parameter_desc(txwip025.parm)
	
field.txwip025.prtm:
when.field.changes:
	update_labor_hours()
	update_labor_cost()
	
field.txwip025.prid:
when.field.changes:
	update_labor_hours()
	update_labor_cost()
	
field.prid.desc:
before.display:
	update_personnel_desc()
	
|****************************** function section *******************************

functions:

function void set_temp_id(){
	temp.id = temp.id - 1
	txwip025.mtid = temp.id
}

function void update_parameter_zoom(domain txprm.types prmt){
	on case etol(prmt)
		case 0:
			disable.zoom.buttons("txwip025.parm")
			attr.zoomcode = 0
			break
		case 1:
			disable.zoom.buttons("txwip025.parm")
			attr.zoomcode = 0
			break
		case 2:
			enable.zoom.buttons("txwip025.parm")
			attr.zoomcode = 2
			attr.zoomsession$ = "tcibd0501m000"
			attr.zoomreturn$ = "tcibd001.item"
			break
		default:
			disable.fields("txwip025.parm")
	endcase
}

function void update_parameter_desc(domain tcmcs.str100 parm){
	domain tcmcs.str100 format.item
	
	format.item = trim$(parm)
	parm.desc = ""
	
	on case etol(txwip025.prmt)
		case 0:
			parm.desc = ""
			break
		case 1:
			parm.desc = ""
			break
		case 2:
			select tcibd001.dsca
			from tcibd001
			where tcibd001.item = "         " &amp; :format.item
			selectdo
				parm.desc = tcibd001.dsca
			endselect
			break
		default:
			parm.desc = ""
	endcase
}

function void update_personnel_desc(){
	prid.desc = ""
	
	select txwip026.dscr
	from txwip026
	where txwip026.prid = :txwip025.prid
	selectdo
		prid.desc = txwip026.dscr
	endselect
}

function void update_labor_hours(){
	txwip025.lbhr = compute_labor_hours(txwip025.prtm)
}

function domain tcqiv1 compute_labor_hours(domain tcqiv1 process.time){
	domain tcqiv1 labor.hours, mins
	
	labor.hours = 0
	mins = 60
	
	if process.time = 0 then
		labor.hours = 0
	else
		labor.hours = process.time / mins
	endif
	
	return(labor.hours)
}

function void update_labor_cost(){
	txwip025.lbst = compute_labor_cost(txwip025.prid, txwip025.lbhr)
}

function domain tcqiv1 compute_labor_cost(domain tcmcs.long person.id, domain tcqiv1 labor.hours){
	domain tcqiv1 labor.cost, rate.hr
	
	labor.cost = 0
	rate.hr = 0
	
	if labor.hours = 0 then
		rate.hr = 0
		return(rate.hr)
	endif
	
	select txwip026.rthr
	from txwip026
	where txwip026.prid = :person.id
	as set with 1 rows
	selectdo
		rate.hr = labor.hours * txwip026.rthr
	selectempty
		rate.hr = 0
	endselect
	
	return(rate.hr)
}

function extern void load_materials(){
	if trim$(zoom.code) = "" then
		start.session(MODAL_OVERVIEW, "txwip0500em11",  "txwip0500em10", "")
	endif
}

function extern void load_reagents(){
	if trim$(zoom.code) = "" then
		start.session(MODAL_OVERVIEW, "txwip0500em12",  "txwip0500em10", "")
	endif
}

function save_micro_test_materials(domain tcmcs.str100 parm, domain tcmcs.long mtid){
	domain tcitem format.item
	
	format.item = "         " &amp; trim$(parm)
	
	select txwip027.item
	from txwip027
	where txwip027.mtid = :mtid
		and txwip027.item = :format.item
	as set with 1 rows
	selectdo
		return
	selectempty
		select txwip039.*
		from txwip039
		where txwip039.item = :format.item
		as set with 1 rows
		selectdo
			txwip027.mtid = mtid
			txwip027.item = format.item
			txwip027.freq = txwip039.freq
			txwip027.tsmm = txwip039.tsmm
			txwip027.cuni = txwip039.cuni
			txwip027.prip = txwip039.prip
			txwip027.csst = txwip039.csst
			db.insert(ttxwip027, db.retry)	
		endselect
	endselect
}

function domain tcqiv1 compute_total_material_cost(domain tcmcs.long mtid){
	domain tcqiv1 total.mat.cost, total.rgt.cost, total
	long ret
	
	total.mat.cost = 0
	total.rgt.cost = 0
	total = 0

	select sum(txwip027.csst):total.mat.cost
	from txwip027
	where txwip027.mtid = :mtid
	selectdo
	endselect
	
	select txwip021.rgnt, txwip021.cssm
	from txwip021
	where exists
		(select txwip028.*
		 from txwip028
		 where txwip028.mtid = :mtid
		 and txwip028.rgnt = txwip021.rgnt)
	selectdo
		total.rgt.cost = total.rgt.cost + txwip021.cssm
	endselect
	
	total = total.mat.cost + total.rgt.cost
	
	return(total)
}

function delete_details_references(domain tcmcs.long mtid){
	select txwip027.*
	from txwip027 for update
	where txwip027.mtid = :mtid
	selectdo
		db.delete(ttxwip027, db.retry)
	endselect
		
	select txwip028.*
	from txwip028 for update
	where txwip028.mtid = :mtid
	selectdo
		db.delete(ttxwip028, db.retry)
	endselect
}

function disable_fields(){
	disable.fields("txwip025.prmt")
	disable.fields("txwip025.parm")
	disable.fields("txwip025.prtm")
	disable.fields("txwip025.prid")
}</expression><expressionLanguageType>Baan4C</expressionLanguageType><sourceType>1</sourceType><sourceDescription>Micro Test Details</sourceDescription><sourceName>txwip0500em10</sourceName></Source><documentation/><Attachment><type>relnotes</type><name>txwip0500em10</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em10</name></Attachment><additionalConstraints>2590</additionalConstraints><additionalInstructions/><keyword>||</keyword><application>EXTce01107</application></DR_Module><startInCompanyZero>false</startInCompanyZero><repSevLang>false</repSevLang><mainSession>true</mainSession><moduleType>1</moduleType><windowType>6</windowType><subType>1</subType><status>1</status><documentation/><objectLabel/><application>EXTce01107</application><sessionReferenceDescriptionReference>txwip0500em10</sessionReferenceDescriptionReference><sessionReferenceDescription>Micro Test Details</sessionReferenceDescription><sessionReference>txwip0500em10</sessionReference><UIScript>txwip0500em10</UIScript></DR_Controller>