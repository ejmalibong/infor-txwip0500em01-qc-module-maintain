ommand>false</defaultcommand><startcommand>false</startcommand><position>28</position><description/><name>prev.frm</name></StandardCommand><StandardCommand><active>true</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>29</position><description/><name>last.frm</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>31</position><description/><name>resize.frm</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>32</position><description/><name>cust.grid</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>33</position><description/><name>cmd.options</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>34</position><description/><name>zoom</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>35</position><description/><name>interrupt</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>36</position><description/><name>end.program</name></StandardCommand><StandardCommand><active>true</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>37</position><description/><name>abort.program</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>39</position><description/><name>text.manager</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>40</position><description/><name>run.job</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>41</position><description/><name>global.delete</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>42</position><description/><name>global.copy</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>43</position><description/><name>save.defaults</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>44</position><description/><name>get.defaults</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>45</position><description/><name>start.chart</name></StandardCommand><StandardCommand><active>true</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>46</position><description/><name>start.query</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>47</position><description/><name>select.all</name></StandardCommand><defaultStartCommand>false</defaultStartCommand><DR_Module><description>Micro Test Details</description><versionID>B61O_a_ext</versionID><type>library</type><name>txwip0500em10</name><Version><ObjectID/><classID/><checkInLabel/><documentation/><isExpired>no</isExpired><isCheckedOutParallel>no</isCheckedOutParallel><isCheckedOut>no</isCheckedOut><modificationDateTime>2026-09-05T16:46:47Z</modificationDateTime><modifiedBy>ict004</modifiedBy><creationDateTime>2026-08-13T01:23:49Z</creationDateTime><createdBy>ict004</createdBy></Version><Source><sourceVersion><ObjectID/><classID/><checkInLabel/><documentation/><isExpired>no</isExpired><isCheckedOutParallel>no</isCheckedOutParallel><isCheckedOut>no</isCheckedOut><modificationDateTime>2026-09-05T16:46:47Z</modificationDateTime><modifiedBy>ict004</modifiedBy><creationDateTime>2026-08-13T01:23:49Z</creationDateTime><createdBy>ict004</createdBy></sourceVersion><sourceVersionID>B61O_a_ext</sourceVersionID><sourceObjectID>1</sourceObjectID><expression>|*******************************************************************************
|* txwip0500em10  B61O_a_ext
|* Micro Test Details
|* ict004
|* 2026-08-13 [09:23]
|*******************************************************************************
|* Script Type: 123
|*******************************************************************************

|*************************** declaration section *******************************
declaration:

	table	ttxwip020		|* QC Cost Summary
	table	ttxwip021		|* Reagents Header	
	table	ttxwip022		|* Reagents Details
	table	ttxwip024		|* Micro Test Header
	table	ttxwip025		|* Micro Test Details
	table	ttxwip026		|* QC Personnel
	table	ttxwip027		|* Micro Test Materials
	table	ttxwip028		|* Micro Test Reagents
	table	ttxwip030		|* Pychem Test Header
	table	ttxwip031		|* Pychem Test Details
	table	ttxwip033		|* Third Party Test Header
	table	ttxwip034		|* Third Party Test Details
	table	ttxwip035 		|* QC Items
	table	ttxwip036		|* QC Cost Master Data
	table	ttxwip037		|* QC Cost Details
	table	ttcibd001		|* Items
	table	ttcibd003		|* Conversion Factors
	table	ttdipu001		|* Item - Purchase
	table	ttcmcs012		|* Units by Unit Set
	
	extern domain tcnama		parm.desc
	extern domain tcmcs.str50	prid.desc
	extern long			temp.mtid, save.mtid, current.mtid

|****************************** program section ********************************

before.program:
	| Initialize MTID tracking variables.
	| temp.mtid = temporary negative MTID for unsaved rows.
	| save.mtid = highest existing MTID used as the base during Save.
	temp.mtid = 0
	save.mtid = 0
	
main.table.io:
before.write:
	| Convert temporary negative MTID to permanent positive MTID
	| immediately before the new record is written to the database.
	if txwip025.mtid &lt; 0 then
		save.mtid = save.mtid + 1
		txwip025.mtid = save.mtid
	endif
	
	if txwip025.dcdt = 0 then
		txwip025.dcdt = utc.num()
	endif
	
before.rewrite:
	txwip025.dmdt = utc.num()

|****************************** choice section *********************************

choice.add.set:
after.choice:
	| Handle rows created using the toolbar New button.
	| Assign a temporary negative MTID to the new occurrence.
	disable.fields("txwip025.parm")
	disable.fields("txwip025.prtm")
	
	if txwip025.mtid = 0 then
		set_temp_mtid()
		txwip025.prid = 1
	endif
	
choice.update.db:
before.choice:
	| Before saving, get the latest highest persisted MTID.
	| This becomes the starting point for permanent MTID assignment.
	save.mtid = 0

	select max(txwip025.mtid):save.mtid
	from txwip025
	selectdo
	endselect
	
|****************************** field section **********************************
	
field.txwip025.prmt:
before.field:
	| Handle rows automatically created by TAB navigation.
	| The new occurrence initially has MTID = 0, so assign
	| a temporary negative MTID when PRMT becomes active.
	disable.fields("txwip025.prtm")
	
	if txwip025.mtid = 0 then
		set_temp_mtid()
		txwip025.prid = 1
	endif
	
when.field.changes:
	if txwip025.prmt = ltoe(0) then
		txwip025.parm = ""
		parm.desc = ""
		txwip025.prtm = 0
	else
		enable.fields("txwip025.parm")
	endif
	
	display("parm.desc")
	display("txwip025.prtm")

field.txwip025.parm:
before.zoom:
	update_parameter_zoom()	
	
selection.filter:
	if etol(txwip025.prmt) = 2 then
		query.extend.where.in.zoom("tcibd001.citg = '600'")
	endif

after.zoom:
	if etol(txwip025.prmt) = 2 then
		txwip025.parm = trim$(txwip025.parm)
	endif
	
when.field.changes:
	if trim$(txwip025.parm) &lt;&gt; "" then
		update_parameter_desc()
		enable.fields("txwip025.prtm")
	else
		parm.desc = ""
		disable.fields("txwip025.prtm")
	endif
	
check.input:
	if etol(txwip025.prmt) = 2 and trim$(txwip025.parm) &lt;&gt; "" then
		select tcibd001.item
		from tcibd001
		where tcibd001.item = "         " &amp; :txwip025.parm
		and tcibd001.citg = '600'
		selectdo
			break
		selectempty
			message("Please select a valid item.")
			set.input.error("")
		endselect
	endif
	
field.parm.desc:
before.display:
	update_parameter_desc()
	
field.txwip025.prtm:
when.field.changes:
	update_labor_hours()
	update_labor_cost()
	
field.prid.desc:
before.display:
	update_personnel_desc()
	
|****************************** function section *******************************

functions:

function void set_temp_mtid(){
	temp.mtid = temp.mtid - 1
	txwip025.mtid = temp.mtid
}

function void update_parameter_zoom(){
	on case etol(txwip025.prmt)
		case 1:
			disable.zoom.buttons("txwip025.parm")
			attr.zoomcode = 0
			break
		case 2:
			enable.zoom.buttons("txwip025.parm")
			attr.zoomcode = 2
			attr.zoomsession$ = "tcibd0501m000"
			attr.zoomreturn$ = "tcibd001.item"
			break
		default:
			disable.fields("txwip025.parm")
	endcase
}

function void update_parameter_desc(){
	parm.desc = ""
	
	on case etol(txwip025.prmt)
		case 1:
			parm.desc = ""
			break
		case 2:
			select tcibd001.dsca
			from tcibd001
			where tcibd001.item = "         " &amp; :txwip025.parm
			selectdo
				parm.desc = tcibd001.dsca
			endselect
			break
		default:
			parm.desc = ""
	endcase
}

function void update_personnel_desc(){
	prid.desc = ""
	
	select txwip026.dscr
	from txwip026
	where txwip026.prid = :txwip025.prid
	selectdo
		prid.desc = txwip026.dscr
	endselect
}

function void update_labor_hours(){
	txwip025.lbhr = compute_labor_hours(txwip025.prtm)
}

function domain tcqiv1 compute_labor_hours(domain tcqiv1 process.time){
	domain tcqiv1 labor.hours, mins
	
	labor.hours = 0
	mins = 60
	
	if process.time = 0 then
		labor.hours = 0
	else
		labor.hours = process.time / mins
	endif
	
	return(labor.hours)
}

function void update_labor_cost(){
	txwip025.lbst = compute_labor_cost(txwip025.prid, txwip025.lbhr)
}

function domain tcqiv1 compute_labor_cost(domain tcmcs.long person.id, domain tcqiv1 labor.hours){
	domain tcqiv1 labor.cost, rate.hr
	
	labor.cost = 0
	rate.hr = 0
	
	if labor.hours = 0 then
		rate.hr = 0
		return(rate.hr)
	endif
	
	select txwip026.rthr
	from txwip026
	where txwip026.prid = :person.id
	as set with 1 rows
	selectdo
		rate.hr = labor.hours * txwip026.rthr
	selectempty
		rate.hr = 0
	endselect
	
	return(rate.hr)
}

function extern void load_materials(){
	current.mtid = txwip025.mtid
	export("current.mtid", current.mtid)
	
	string total
	start.session(MODAL_OVERVIEW, "txwip0500em11",  "txwip0500em10", total)
}

function extern void load_reagents(){
	current.mtid = txwip025.mtid
	export("current.mtid", current.mtid)
	
	string total
	start.session(MODAL_OVERVIEW, "txwip0500em12",  "txwip0500em10", total)	
}</expression><expressionLanguageType>Baan4C</expressionLanguageType><sourceType>1</sourceType><sourceDescription>Micro Test Details</sourceDescription><sourceName>txwip0500em10</sourceName></Source><documentation/><Attachment><type>relnotes</type><name>txwip0500em10</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em10</name></Attachment><additionalConstraints>2590</additionalConstraints><additionalInstructions/><keyword>||</keyword><application>EXTce01106</application></DR_Module><startInCompanyZero>false</startInCompanyZero><repSevLang>false</repSevLang><mainSession>true</mainSession><moduleType>1</moduleType><windowType>6</windowType><subType>1</subType><status>1</status><documentation/><objectLabel/><application>EXTce01106</application><sessionReferenceDescriptionReference>txwip0500em10</sessionReferenceDescriptionReference><sessionReferenceDescription>Micro Test Details</sessionReferenceDescription><sessionReference>txwip0500em10</sessionReference><UIScript>txwip0500em10</UIScript></DR_Controller>