Session>true</detailsSession><childFieldsBehind>false</childFieldsBehind><followUp>false</followUp><nextField>20</nextField><groupID>1</groupID><synchronizedField>false</synchronizedField><defaultValue/><inputReferenceExpression>1</inputReferenceExpression><fieldLabel>txwip051.inid</fieldLabel><languageUnitExpression/><mandatoryInput>false</mandatoryInput><sequenceMode>10</sequenceMode><fieldLength>10</fieldLength><echoField>true</echoField><message/><defaultExpression>false</defaultExpression><zoomReturnField/><zoomProgram/><zoomType>1</zoomType><startPositionString>1</startPositionString><linkInputDigitsBefore>true</linkInputDigitsBefore><inputDigitsBefore>10</inputDigitsBefore><linkDisplayDigitsBefore>true</linkDisplayDigitsBefore><displayDigitsBefore>10</displayDigitsBefore><minimumInputLength>0</minimumInputLength><displayFormatLinked>true</displayFormatLinked><displayFormat>ZZZZZZZZZ9</displayFormat><fieldType>1</fieldType><domain/><element>1</element><fieldName>txwip051.inid</fieldName><rowScreenPosition>1</rowScreenPosition><columnScreenPosition>22</columnScreenPosition><sequenceNumber>24</sequenceNumber></FormField><FormGroup><selectionGroup>false</selectionGroup><parentTable/><miscellaneous>0</miscellaneous><nextToOtherGroup>false</nextToOtherGroup><checkBoxesOnly>false</checkBoxesOnly><formFormat>13</formFormat><subGroupOnNewPage>false</subGroupOnNewPage><nrSubGroups>1</nrSubGroups><firstChildGroup>0</firstChildGroup><virtualGroup>true</virtualGroup><groupAlignment>1</groupAlignment><firstField>10</firstField><nextGroup>0</nextGroup><previousGroup>0</previousGroup><parentGroup>0</parentGroup><overviewSession>true</overviewSession><detailsSession>true</detailsSession><showGroupBox>false</showGroupBox><groupHeader/><level>0</level><repeating>false</repeating><groupID>1</groupID></FormGroup></PhysicalFormLayout><description>QC Inventory</description><name>txwip0500em37d</name><horizontal>true</horizontal><custProhibited>false</custProhibited><additionalConstraints>1</additionalConstraints><documentation/><application>EXTce01108</application></Form><DR_Module><description>QC Inventory</description><versionID>B61O_a_ext</versionID><type>library</type><name>txwip0500em37</name><Version><ObjectID/><classID/><checkInLabel/><documentation/><isExpired>no</isExpired><isCheckedOutParallel>no</isCheckedOutParallel><isCheckedOut>no</isCheckedOut><modificationDateTime>2026-11-12T07:11:44Z</modificationDateTime><modifiedBy>ict004</modifiedBy><creationDateTime>2026-10-26T06:06:10Z</creationDateTime><createdBy>ict004</createdBy></Version><Source><sourceVersion><ObjectID/><classID/><checkInLabel/><documentation/><isExpired>no</isExpired><isCheckedOutParallel>no</isCheckedOutParallel><isCheckedOut>no</isCheckedOut><modificationDateTime>2026-11-12T07:11:44Z</modificationDateTime><modifiedBy>ict004</modifiedBy><creationDateTime>2026-10-26T06:06:10Z</creationDateTime><createdBy>ict004</createdBy></sourceVersion><sourceVersionID>B61O_a_ext</sourceVersionID><sourceObjectID>1</sourceObjectID><expression>|*******************************************************************************
|* txwip0500em37  B61O_a_ext
|* QC Inventory
|* ict004
|* 2026-10-26 [02:02]
|*******************************************************************************
|* Script Type: 123
|*******************************************************************************

|*************************** declaration section *******************************
declaration:

	table	ttxwip020		|* QC Costs
	table	ttxwip021		|* Reagents	
	table	ttxwip022		|* Reagents Details
	table	ttxwip024		|* Micro Tests
	table	ttxwip025		|* Micro Test Details
	table	ttxwip026		|* QC Personnels
	table	ttxwip027		|* Micro Test Materials
	table	ttxwip028		|* Micro Test Reagents
	table	ttxwip030		|* Pychem Tests
	table	ttxwip031		|* Pychem Test Details
	table	ttxwip033		|* Third Party Tests
	table	ttxwip034		|* Third Party Test Details
	table	ttxwip035 		|* QC Items
	table	ttxwip036		|* Item Testing Costs
	table	ttxwip037		|* Item Testing Cost Details
	table	ttxwip038		|* Inline &amp; Documentation Costs
	table	ttxwip039		|* Micro Test Materials Reference
	table	ttxwip040		|* QC Cost Simulations
	table	ttxwip041		|* Micro Retests
	table	ttxwip042		|* Micro Retest Details
	table	ttxwip043		|* Micro Retest Materials
	table	ttxwip044		|* Micro Retest Reagents
	table	ttxwip045		|* Pychem Retests
	table	ttxwip046		|* Pychem Retest Details
	table	ttxwip047		|* QC Cost Retests
	table	ttxwip048		|* QC Cost Retest Details
	table	ttxwip049		|* QC Simulation Retests
	table	ttxwip050		|* QC Simulation Retest Details
	
	table	ttcibd001		|* Items
	table	ttcibd003		|* Conversion Factors
	table	ttdipu001		|* Item - Purchase
	table	ttcmcs003		|* Warehouses
	table	ttcmcs012		|* Units by Unit Set
	table	twhltc101		|* Lot Cost Details
	table	ttccom100		|* Business Partners
	table	ttisfc001		|* Production Orders
	table	tticpr007		|* Items - Costing
	table	twhinr140		|* Inventory
	table	ttxwip051 		|* QC Inventory
	table	ttxwip052		|* QC Inventory Details
	table	twhwmd300		|* Locations
	
	extern domain tcdsca		item.desc, cwar.desc, loca.desc

|****************************** program section ********************************

main.table.io:
before.write:
	if txwip051.dcdt = 0 then
		txwip051.dcdt = utc.num()
	endif
	
before.rewrite:
	txwip051.dmdt = utc.num()
	
before.new.object:
	txwip051.qava = 1

|****************************** choice section *********************************
	
group.1:
init.group:
	execute(first.set)
	
|****************************** field section **********************************

field.txwip051.inid:
before.display:
	if txwip051.inid = 0 then
		txwip051.inid = set_transaction_id()
	endif

field.txwip051.cwar:
selection.filter:
	query.extend.where.in.zoom("tcmcs003.cwar IN (""1CS001"",""1PS001"")")
	
when.field.changes:
	update_loca(txwip051.cwar)
	update_loca_desc(txwip051.cwar, txwip051.loca)	
	display("loca.desc")

after.zoom:
	update_loca(txwip051.cwar)
	update_loca_desc(txwip051.cwar, txwip051.loca)
	display("loca.desc")
	
field.cwar.desc:
before.display:
	update_cwar_desc(txwip051.cwar)

field.loca.desc:
before.display:
	update_loca_desc(txwip051.cwar, txwip051.loca)
	
field.txwip051.ittp:
when.field.changes:
	txwip051.item = ""
	txwip051.clot = ""
	txwip051.idat = 0
	txwip051.expd = 0
	txwip051.qava = 1
	txwip051.basu = ""
	txwip051.conv = 0
	txwip051.cuni = ""
	item.desc = ""
	
	display("txwip051.item")
	display("txwip051.clot")
	display("txwip051.idat")
	display("txwip051.expd")
	display("txwip051.qava")
	display("txwip051.basu")
	display("txwip051.conv")
	display("txwip051.cuni")
	display("item.desc")
	
	update_clot_zoom_button_state(txwip051.ittp)
	
field.txwip051.item:
before.zoom:
	update_item_zoom()
	
selection.filter:
	update_item_selection_filter(txwip051.ittp, txwip051.cwar)
	
when.field.changes:
	update_item_details(txwip051.ittp, txwip051.item, txwip051.cwar, txwip051.loca)
	
after.zoom:
	txwip051.item = trim$(txwip051.item)
	update_item_details(txwip051.ittp, txwip051.item, txwip051.cwar, txwip051.loca)

field.item.desc:
before.display:
	update_item_desc(txwip051.ittp, txwip051.item)
	
field.txwip051.clot:
before.zoom:
	update_clot_zoom(txwip051.ittp)
	
selection.filter:
	update_clot_zoom_selection_filter(txwip051.ittp, txwip051.item, txwip051.cwar, txwip051.loca)
	
|****************************** function section *******************************

functions:

function domain tcmcs.long set_transaction_id(){
  	domain tcmcs.long next.id
        
        next.id = 0
        
        select txwip051.inid
        from txwip051
        order by txwip051.inid desc
        as set with 1 rows
        selectdo
                next.id = txwip051.inid + 1
        selectempty
                next.id = 1
        endselect
        
        return(next.id)
}

function void update_item_zoom(){
	on case etol(txwip051.ittp)
		case 1:
			attr.zoomcode = 2
			attr.zoomsession$ = "tcibd0501m000"
			attr.zoomreturn$ = "tcibd001.item"
			break
		case 2:
			attr.zoomcode = 2
			attr.zoomsession$ = "txwip0500em03"
			attr.zoomreturn$ = "txwip021.rgnt"
			break
		case 3:
			attr.zoomcode = 2
			attr.zoomsession$ = "txwip0500em06"
			attr.zoomreturn$ = "txwip035.qitm"
			break
	endcase
}

function void update_item_selection_filter(domain txmat.types type, domain tccwar cwar){
	on case etol(type)
		case 1:
			query.extend.where.in.zoom("(tcibd001.item IN (select txwip039.item from txwip039 where txwip039.cwar = '" &amp; cwar &amp; "')) or tcibd001.citg IN (""FG"", ""SFG"", ""RM/FG"") and tcibd001.cdf_stst = 1")
			break
		case 2:
			query.extend.where.in.zoom("txwip021.cwar = '" &amp; cwar &amp; "'")
			break
		case 3:
			break
	endcase
}

function update_item_desc(domain txmat.types type, domain tcmcs.str50 item){
	item.desc = get_item_desc(type, item)
}

function domain tcdsca get_item_desc(domain txmat.types type, domain tcmcs.str50 item){
	domain tcdsca desc
	domain tcmcs.str50 format.item
	
	desc = ""
	format.item = ""
	
	on case etol(type)
		case 1:
			format.item = "         " &amp; trim$(item)
			
			select tcibd001.dsca
			from tcibd001
			where tcibd001.item = :format.item
			as set with 1 rows
			selectdo
				desc = tcibd001.dsca
			endselect
			break
			
		case 2:
			format.item = trim$(item)
			
			select txwip021.dscr
			from txwip021
			where txwip021.rgnt = :format.item
			as set with 1 rows
			selectdo
				desc = txwip021.dscr 
			endselect
			break
			
		case 3:
			format.item = trim$(item)
			
			select txwip035.dscr
			from txwip035
			where txwip035.qitm = :format.item
			as set with 1 rows
			selectdo
				desc = txwip035.dscr
			endselect
			break
	endcase
	
	return(desc)
}

function update_cwar_desc(domain tccwar cwar){
	cwar.desc = get_cwar_desc(cwar)
}

function domain tcdsca get_cwar_desc(domain tccwar cwar){
	domain tcdsca desc
	
	desc = ""
	
	select tcmcs003.dsca
	from tcmcs003
	where tcmcs003.cwar = :cwar
	as set with 1 rows
	selectdo
		desc = tcmcs003.dsca
	endselect
	
	return(desc)
}

function update_loca(domain tccwar cwar){
	if txwip051.cwar = "1CS001" then
		txwip051.loca = "110S1QCD01"
	else | 1PS001 SITE 2 SUPPLIES WAREHOUSE
		txwip051.loca = "110S2QCD01"
	endif
	
	display("txwip051.loca")
}

function update_loca_desc(domain tccwar cwar, domain whloca loca){
	loca.desc = get_loca_desc(cwar, loca)
}

function domain tcdsca get_loca_desc(domain tccwar cwar, domain whloca loca){
	domain tcdsca desc
	
	desc = ""
	
	select whwmd300.dsca
	from whwmd300
	where whwmd300.cwar = :cwar
		and whwmd300.loca = :loca
	as set with 1 rows
	selectdo
		desc = whwmd300.dsca
	endselect
	
	return(desc)
}

function update_clot_zoom(domain txmat.types type){
	on case etol(type)
		case 1:
			attr.zoomcode = 2
			attr.zoomsession$ = "whinr1540m000"
			attr.zoomreturn$ = "whinr140.clot"
			break	
		case 2:
			attr.zoomcode = 0
			break
		case 3:
			attr.zoomcode = 0
			break
		default:
			attr.zoomcode = 0
	endcase
}

function update_clot_zoom_selection_filter(domain txmat.types type, domain tcmcs.str50 item, domain tccwar cwar, domain tcloca loca){
	domain tcitem format.item
	
	on case etol(type)
		case 1:
			format.item = "         " &amp; trim$(item)		
			query.extend.where.in.zoom("whinr140.item = '" &amp; format.item &amp; "' and whinr140.cwar = '" &amp; cwar &amp; "' and whinr140.loca = '" &amp; loca &amp; "' and whinr140.idat &lt;&gt; 0 and (whinr140.qhnd - whinr140.qblk) &gt; 0")
			break
		case 2:
			format.item = trim$(item)
			query.extend.where.in.zoom("txwip021.cwar = '" &amp; cwar &amp;"'")
			break
		case 3:
			break
	endcase
}

function update_clot_zoom_button_state(domain txmat.types type){
	on case etol(type)
		case 1:
			enable.zoom.buttons("txwip051.clot")
			break
		case 2:
			disable.zoom.buttons("txwip051.clot")
			break
		case 3:
			disable.zoom.buttons("txwip051.clot")
			break
	endcase
}

function update_base_unit(domain tcmcs.str50 item){
	txwip051.basu = get_base_unit(item)
}

function domain tccuni get_base_unit(domain tcmcs.str50 item){
	domain tcitem format.item
	domain tccuni unit
	
	format.item = "         " &amp; trim$(item)
	unit = ""
	
	select tcibd003.basu
	from tcibd003
	where tcibd003.item = :format.item
		and tcibd003.appr = 1
	as set with 1 rows
	selectdo
		unit = tcibd003.basu
	endselect
	
	return(unit)
}

function update_fifo_lot_number(domain txmat.types type, domain tcmcs.str50 item, domain tccwar cwar, domain tcloca loca){
	if type = ltoe(1) then
		txwip051.clot = get_fifo_lot_number(item, cwar, loca)
	else
		txwip051.clot = ""
	endif
	
	display("txwip051.clot")
}

function domain tcclot get_fifo_lot_number(domain tcmcs.str50 item, domain tccwar cwar, domain tcloca loca){
	domain tcclot lot.number
	domain tcitem format.item

	lot.number = ""
	format.item = "         " &amp; trim$(item)

	select whinr140.*
	from whinr140
	where whinr140.item = :format.item
		and whinr140.cwar = :cwar
		and whinr140.loca = :loca		| Location	
		and whinr140.idat &lt;&gt; 0			| With inventory date
		and (whinr140.qhnd - whinr140.qblk) &gt; 0	| On-hand - Blocked
	order by whinr140.idat
	as set with 1 rows
	selectdo
		lot.number = whinr140.clot
	selectempty
		lot.number = ""
	endselect

	return(lot.number)
}

function update_quantity(domain txmat.types type, domain tcmcs.str50 item, domain tccwar cwar){
	txwip051.qava = get_quantity(type, item, cwar)
	display("txwip051.qava")
}

function domain tcqiv1 get_quantity(domain txmat.types type, domain tcmcs.str50 item, domain tccwar cwar){
	domain tcitem format.item
	domain tcqiv1 qty
	
	qty = 0
	
	on case etol(type)
		case 1:
			format.item = "         " &amp; trim$(item)
			
			select tcibd001.item
			from tcibd001
			where tcibd001.item = :format.item
				and tcibd001.citg IN ("FG", "SFG", "RM/FG")
			as set with 1 rows
			selectdo | Selected item is FG
				qty = 500
			selectempty | Selected item is materials
				qty = 1
			endselect
			break
		case 2:
			format.item = trim$(item)
			
			select txwip021.aqsm
			from txwip021
			where txwip021.rgnt = :format.item
				and txwip021.cwar = :cwar
			as set with 1 rows
			selectdo
				qty = txwip021.aqsm
			endselect
			break
		case 3:
			qty = 1
			break
	endcase
	
	return(qty)
}

function update_lot_base_unit(domain txmat.types type, domain tcmcs.str50 item, domain tccwar cwar, domain tcloca loca){
	txwip051.basu = get_lot_base_unit(type, item, cwar)	
	display("txwip051.basu")
}

function domain tccuni get_lot_base_unit(domain txmat.types type, domain tcmcs.str50 item, domain tccwar cwar){
	domain tcitem format.item
	domain tccuni unit
	
	unit = ""
	
	on case etol(type)
		case 1:
			format.item = "         " &amp; trim$(item)
			
			select tcibd001.item
			from tcibd001
			where tcibd001.item = :format.item
				and tcibd001.citg IN ("FG", "SFG", "RM/FG")
			as set with 1 rows
			selectdo | Selected item is FG
				unit = "G"
			selectempty | Selected item is materials
				select tcibd003.basu
				from tcibd003
				where tcibd003.item = :format.item
				as set with 1 rows
				selectdo
					unit = tcibd003.basu
				endselect		
			endselect
			break
		case 2:
			unit = "ML"
			break
		case 3:
			format.item = trim$(item)
			
			select txwip035.quni
			from txwip035
			where txwip035.qitm = :format.item
			as set with 1 rows
			selectdo
				unit = txwip035.quni
			endselect
			break
	endcase
	
	return(unit)
}

function update_lot_conv_value(domain txmat.types type, domain tcmcs.str50 item, domain tccwar cwar){
	txwip051.conv = get_lot_conv_value(type, item, cwar)	
	display("txwip051.conv")
}

function domain tcconv get_lot_conv_value(domain txmat.types type, domain tcmcs.str50 item, domain tccwar cwar){
	domain tcitem format.item
	domain tcconv conv
	
	conv = 0
	
	on case etol(type)
		case 1:
			format.item = "         " &amp; trim$(item)
			
			select tcibd001.item
			from tcibd001
			where tcibd001.item = :format.item
				and tcibd001.citg IN ("FG", "SFG", "RM/FG")
			as set with 1 rows
			selectdo | Selected item is FG
				conv = 500
			selectempty | Selected item is materials
				select tcibd003.conv
				from tcibd003
				where tcibd003.item = :format.item
				as set with 1 rows
				selectdo
					conv = tcibd003.conv
				endselect		
			endselect
			break
		case 2:	
			format.item = trim$(item)
			
			select txwip021.mult
			from txwip021
			where txwip021.rgnt = :format.item
				and txwip021.cwar = :cwar
			as set with 1 rows
			selectdo
				conv = txwip021.mult
			endselect
			break
		case 3:
			conv = 1000
			break
	endcase
	
	return(conv)
}

function update_lot_conv_unit(domain txmat.types type, domain tcmcs.str50 item, domain tccwar cwar){
	txwip051.cuni = get_lot_conv_unit(type, item, cwar)	
	display("txwip051.cuni")
}

function domain tccuni get_lot_conv_unit(domain txmat.types type, domain tcmcs.str50 item, domain tccwar cwar){
	domain tcitem format.item
	domain tccuni unit
	
	unit = ""
	
	on case etol(type)
		case 1:
			format.item = "         " &amp; trim$(item)
			
			select tcibd001.item
			from tcibd001
			where tcibd001.item = :format.item
				and tcibd001.citg IN ("FG", "SFG", "RM/FG")
			as set with 1 rows
			selectdo | Selected item is FG
				unit = "G"
			selectempty | Selected item is materials
				select tcibd003.unit
				from tcibd003
				where tcibd003.item = :format.item
				as set with 1 rows
				selectdo
					unit = tcibd003.unit
				endselect		
			endselect
			break
		case 2:
			unit = "ML"
			break
		case 3:
			format.item = trim$(item)
			
			select txwip035.cuni
			from txwip035
			where txwip035.qitm = :format.item
			as set with 1 rows
			selectdo
				unit = txwip035.cuni
			endselect
			break
	endcase
	
	return(unit)
}

function update_lot_inventory_date(domain txmat.types type, domain tcmcs.str50 item, domain tccwar cwar, domain tcloca loca){
	if etol(type) = 1 then
		txwip051.idat = get_lot_inventory_date(item, cwar, loca)
		display("txwip051.idat")
	endif
}

function domain tcdate get_lot_inventory_date(domain tcmcs.str50 item, domain tccwar cwar, domain tcloca loca){
	domain tcitem format.item
	domain tcdate inid.date
	
	inid.date = 0
	format.item = "         " &amp; trim$(item)

	select whinr140.idat
	from whinr140
	where whinr140.item = :format.item
	as set with 1 rows
	selectdo
		inid.date = whinr140.idat
	endselect
		
	return(inid.date)
}

function update_item_details(domain txmat.types type, domain tcmcs.str50 item, domain tccwar cwar, domain tcloca loca){
	update_quantity(type, item, cwar)
	update_fifo_lot_number(type, item, cwar, loca)
	update_lot_base_unit(type, item, cwar, loca)
	update_lot_conv_value(type, item, cwar)
	update_lot_conv_unit(type, item, cwar)
	update_lot_inventory_date(type, item, cwar, loca)
}</expression><expressionLanguageType>Baan4C</expressionLanguageType><sourceType>1</sourceType><sourceDescription>QC Inventory</sourceDescription><sourceName>txwip0500em37</sourceName></Source><documentation/><Attachment><type>relnotes</type><name>txwip0500em37</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em37</name></Attachment><additionalConstraints>2610</additionalConstraints><additionalInstructions/><keyword>||</keyword><application>EXTce01108</application></DR_Module><startInCompanyZero>false</startInCompanyZero><repSevLang>false</repSevLang><mainSession>true</mainSession><moduleType>1</moduleType><windowType>15</windowType><subType>1</subType><status>1</status><documentation/><Attachment><type>relnotes</type><name>txwip0500em37</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em37</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em37dcwar.desc</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em37dcwar.desc</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em37ditem.desc</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em37ditem.desc</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em37dloca.desc</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em37dloca.desc</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em37dtxwip051.ba</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em37dtxwip051.ba</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em37dtxwip051.cl</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em37dtxwip051.cl</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em37dtxwip051.co</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em37dtxwip051.co</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em37dtxwip051.cu</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em37dtxwip051.cu</name><