|*******************************************************************************

|*************************** declaration section *******************************
declaration:

	table	ttxwip020		|* QC Costs
	table	ttxwip021		|* Reagents	
	table	ttxwip022		|* Reagents Details
	table	ttxwip024		|* Micro Tests
	table	ttxwip025		|* Micro Test Details
	table	ttxwip026		|* QC Personnels
	table	ttxwip027		|* Micro Test Materials
	table	ttxwip028		|* Micro Test Reagents
	table	ttxwip030		|* Pychem Tests
	table	ttxwip031		|* Pychem Test Details
	table	ttxwip033		|* Third Party Tests
	table	ttxwip034		|* Third Party Test Details
	table	ttxwip035 		|* QC Items
	table	ttxwip036		|* Item Testing Costs
	table	ttxwip037		|* Item Testing Cost Details
	table	ttxwip038		|* Inline &amp; Documentation Costs
	table	ttxwip039		|* Micro Test Materials Reference
	table	ttxwip040		|* QC Cost Simulations
	table	ttxwip041		|* Micro Retests
	table	ttxwip042		|* Micro Retest Details
	table	ttxwip043		|* Micro Retest Materials
	table	ttxwip044		|* Micro Retest Reagents
	table	ttxwip045		|* Pychem Retests
	table	ttxwip046		|* Pychem Retest Details
	table	ttxwip047		|* QC Cost Retest
	table	ttxwip048		|* QC Cost Simulation Retests	
	
	table	ttcibd001		|* Items
	table	ttcibd003		|* Conversion Factors
	table	ttdipu001		|* Item - Purchase
	table	ttcmcs003		|* Warehouses
	table	ttcmcs012		|* Units by Unit Set
	table	twhltc100		|* Lots
	table	twhltc101		|* Lot Cost Details
	table	twhltc105		|* Lots by Warehouse
	table	ttccom100		|* Business Partners
	table	ttisfc001		|* Production Orders
	table	tticpr007		|* Items - Costing
	
	extern long 			temp.id, save.id

|****************************** program section ********************************

before.program:
	temp.id = 0
	save.id = 0
	
main.table.io:
before.write:
	if txwip026.prid &lt; 0 then
		save.id = save.id + 1
		txwip026.prid = save.id
	endif

	if txwip026.dcdt = 0 then
		txwip026.dcdt = utc.num()
	endif

before.rewrite:
	txwip026.dmdt = utc.num()

|****************************** choice section *********************************

choice.add.set:
after.choice:
	if txwip026.prid = 0 then
		set_temp_id()
	endif
	
choice.update.db:
before.choice:
	save.id = 0
	
	select max(txwip026.prid):save.id
	from txwip026
	selectdo
	endselect
	
|****************************** field section **********************************

field.txwip026.dscr:
check.input:
	if check_exist(txwip026.dscr) = tcyesno.yes then
		message("Personnel already exists.")
		set.input.error("")
	endif
		
before.field:
	if txwip026.prid = 0 then
		set_temp_id()
	endif

|****************************** function section *******************************

functions:

function void set_temp_id(){
	temp.id = temp.id - 1
	txwip026.prid = temp.id
}

function domain tcyesno check_exist(domain tcmcs.str50 actv){
	domain tcyesno is.exist
	domain tcmcs.str50 activity
	
	is.exist = tcyesno.no
	activity = trim$(actv)
	
	select txwip026.prid
	from txwip026
	where txwip026.dscr = :activity
	selectdo
		is.exist = tcyesno.yes
	endselect
	
	return(is.exist)
}</expression><expressionLanguageType>Baan4C</expressionLanguageType><sourceType>1</sourceType><sourceDescription>QC Personnels</sourceDescription><sourceName>txwip0500em22</sourceName></Source><documentation/><Attachment><type>relnotes</type><name>txwip0500em22</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em22</name></Attachment><additionalConstraints>2590</additionalConstraints><additionalInstructions/><keyword>||</keyword><application>EXTce01107</application></DR_Module><startInCompanyZero>false</startInCompanyZero><repSevLang>false</repSevLang><mainSession>true</mainSession><moduleType>1</moduleType><windowType>6</windowType><subType>1</subType><status>1</status><documentation/><Attachment><type>relnotes</type><name>txwip0500em22</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em22</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em22dtxwip026.dc</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em22dtxwip026.dc</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em22dtxwip026.dm</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em22dtxwip026.dm</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em22dtxwip026.ds</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em22dtxwip026.ds</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em22dtxwip026.pr</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em22dtxwip026.pr</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em22dtxwip026.rt</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em22dtxwip026.rt</name></Attachment><objectLabel/><application>EXTce01107</application><sessionReferenceDescriptionReference>txwip0500em22</sessionReferenceDescriptionReference><sessionReferenceDescription>QC Personnels</sessionReferenceDescription><sessionReference>txwip0500em22</sessionReference><UIScript>txwip0500em22</UIScript></DR_Controll