	extern domain tcnama		item.desc

|****************************** field section **********************************

field.item.desc:
before.display:
	select tcibd001.dsca
	from tcibd001
	where tcibd001.item = :txwip036.item
	selectdo
		item.desc = tcibd001.dsca
	endselect</expression><expressionLanguageType>Baan4C</expressionLanguageType><sourceType>1</sourceType><sourceDescription>QC Cost Master Data</sourceDescription><sourceName>txwip0500em13</sourceName></Source><documentation/><Attachment><type>relnotes</type><name>txwip0500em13</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em13</name></Attachment><additionalConstraints>2590</additionalConstraints><additionalInstructions/><keyword>||</keyword><application>EXTce01106</application></DR_Module><startInCompanyZero>false</startInCompanyZero><repSevLang>false</repSevLang><mainSession>true</mainSession><moduleType>1</moduleType><windowType>6</windowType><subType>5</subType><status>1</status><documentation/><Attachment><type>relnotes</type><name>txwip0500em13</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em13</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em13ditem.desc</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em13ditem.desc</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em13dtxwip036.ii</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em13dtxwip036.ii</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em13dtxwip036.it</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em13dtxwip036.it</name></Attachment><objectLabel/><application>EXTce01106</application><sessionReferenceDescriptionReference>txwip0500em13</sessionReferenceDescriptionReference><sessionReferenceDescription>Item Testing Costs</sessionReferenceDescription><sessionReference>txwip0500em13</sessionReference><UIScript>txwip0500em13</UIScript></DR_Controller>