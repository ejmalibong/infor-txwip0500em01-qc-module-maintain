|* txwip0500em13  B61O_a_ext
|* Item Testing Costs
|* ict004
|* 2026-08-23 [10:31]
|*******************************************************************************
|* Script Type: 123
|*******************************************************************************

|*************************** declaration section *******************************
declaration:

	table	ttxwip020		|* QC Costs
	table	ttxwip021		|* Reagents	
	table	ttxwip022		|* Reagents Details
	table	ttxwip024		|* Micro Tests
	table	ttxwip025		|* Micro Test Details
	table	ttxwip026		|* QC Personnels
	table	ttxwip027		|* Micro Test Materials
	table	ttxwip028		|* Micro Test Reagents
	table	ttxwip030		|* Pychem Tests
	table	ttxwip031		|* Pychem Test Details
	table	ttxwip033		|* Third Party Tests
	table	ttxwip034		|* Third Party Test Details
	table	ttxwip035 		|* QC Items
	table	ttxwip036		|* Item Testing Costs
	table	ttxwip037		|* Item Testing Cost Details
	table	ttxwip038		|* Inline &amp; Documentation Costs
	table	ttxwip039		|* Micro Test Materials Reference
	table	ttxwip040		|* QC Cost Simulations
	table	ttxwip041		|* Micro Retests
	table	ttxwip042		|* Micro Retest Details
	table	ttxwip043		|* Micro Retest Materials
	table	ttxwip044		|* Micro Retest Reagents
	table	ttxwip045		|* Pychem Retests
	table	ttxwip046		|* Pychem Retest Details
	table	ttxwip047		|* QC Cost Retest
	table	ttxwip048		|* QC Cost Simulation Retests	
	
	table	ttcibd001		|* Items
	table	ttcibd003		|* Conversion Factors
	table	ttdipu001		|* Item - Purchase
	table	ttcmcs003		|* Warehouses
	table	ttcmcs012		|* Units by Unit Set
	table	twhltc100		|* Lots
	table	twhltc101		|* Lot Cost Details
	table	twhltc105		|* Lots by Warehouse
	table	ttccom100		|* Business Partners
	table	ttisfc001		|* Production Orders
	table	tticpr007		|* Items - Costing
	
	extern domain tcnama		item.desc
	extern domain tcdsca		cwar.desc

|****************************** program section ********************************

main.table.io:
before.delete:
	delete_details_references(txwip036.item, txwip036.cwar)
	
|****************************** field section **********************************

field.item.desc:
before.display:
	select tcibd001.dsca
	from tcibd001
	where tcibd001.item = :txwip036.item
	selectdo
		item.desc = tcibd001.dsca
	endselect
	
field.cwar.desc:
before.display:
	select tcmcs003.dsca
	from tcmcs003
	where tcmcs003.cwar = :txwip036.cwar
	selectdo
		cwar.desc = tcmcs003.dsca
	endselect
	
|****************************** function section *******************************

functions:
	
function delete_details_references(domain tcitem item, domain tccwar cwar){
	select txwip037.*
	from txwip037 for update
	where txwip037.item = :item
		and txwip037.cwar = :cwar
	selectdo
		db.delete(ttxwip037, db.retry)
	endselect
}</expression><expressionLanguageType>Baan4C</expressionLanguageType><sourceType>1</sourceType><sourceDescription>QC Cost Master Data</sourceDescription><sourceName>txwip0500em13</sourceName></Source><documentation/><Attachment><type>relnotes</type><name>txwip0500em13</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em13</name></Attachment><additionalConstraints>2590</additionalConstraints><additionalInstructions/><keyword>||</keyword><application>EXTce01107</application></DR_Module><startInCompanyZero>false</startInCompanyZero><repSevLang>false</repSevLang><mainSession>true</mainSession><moduleType>1</moduleType><windowType>6</windowType><subType>5</subType><status>1</status><documentation/><Attachment><type>relnotes</type><name>txwip0500em13</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em13</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em13dcwar.desc</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em13dcwar.desc</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em13ditem.desc</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em13ditem.desc</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em13dtxwip036.am</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em13dtxwip036.am</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em13dtxwip036.at</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em13dtxwip036.at</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em13dtxwip036.cw</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em13dtxwip036.cw</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em13dtxwip036.dc</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em13dtxwip036.dc</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em13dtxwip036.dm</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em13dtxwip036.