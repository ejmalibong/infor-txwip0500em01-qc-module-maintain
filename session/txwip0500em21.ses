>true</virtualGroup><groupAlignment>1</groupAlignment><firstField>10</firstField><nextGroup>0</nextGroup><previousGroup>0</previousGroup><parentGroup>0</parentGroup><overviewSession>true</overviewSession><detailsSession>true</detailsSession><showGroupBox>false</showGroupBox><groupHeader/><level>0</level><repeating>false</repeating><groupID>1</groupID></FormGroup></PhysicalFormLayout><FormCommand><descriptionReference>txqcpersonnel</descriptionReference><description>QC Personnels</description><suppressDialogAllowed>false</suppressDialogAllowed><defaultSpecialCommand>false</defaultSpecialCommand><category>10</category><kindOfSession>9</kindOfSession><startModeSession>9</startModeSession><refreshParent>false</refreshParent><saveBeforeExecution>false</saveBeforeExecution><multipleExecution>false</multipleExecution><questionAnswer>0</questionAnswer><question><name/></question><commandAvailability>1</commandAvailability><authorizationGroup>9</authorizationGroup><initiallyHidden>false</initiallyHidden><initialHidden>false</initialHidden><showOnMenu>true</showOnMenu><showAsButton>false</showAsButton><separator>false</separator><shortcut>1</shortcut><addEllipsesToLabel>false</addEllipsesToLabel><groupFieldNr>0</groupFieldNr><parent>0</parent><activationName>qc_personnel</activationName><activationType>5</activationType><defaultcommand>false</defaultcommand><sequence>1</sequence><position>1</position><type>1</type><shortDescription>QC Personnels</shortDescription><name>qc_personnel</name></FormCommand><description>Inline &amp; Documentation Costs</description><name>txwip0500em21d</name><horizontal>true</horizontal><custProhibited>false</custProhibited><additionalConstraints>1</additionalConstraints><documentation/><application>EXTce01106</application></Form><DR_Module><description>Inline &amp; Documentation Costs</description><versionID>B61O_a_ext</versionID><type>library</type><name>txwip0500em21</name><Version><ObjectID/><classID/><checkInLabel/><documentation/><isExpired>no</isExpired><isCheckedOutParallel>no</isCheckedOutParallel><isCheckedOut>no</isCheckedOut><modificationDateTime>2026-09-27T13:46:53Z</modificationDateTime><modifiedBy>ict004</modifiedBy><creationDateTime>2026-09-19T14:37:02Z</creationDateTime><createdBy>ict004</createdBy></Version><Source><sourceVersion><ObjectID/><classID/><checkInLabel/><documentation/><isExpired>no</isExpired><isCheckedOutParallel>no</isCheckedOutParallel><isCheckedOut>no</isCheckedOut><modificationDateTime>2026-09-27T13:46:53Z</modificationDateTime><modifiedBy>ict004</modifiedBy><creationDateTime>2026-09-19T14:37:02Z</creationDateTime><createdBy>ict004</createdBy></sourceVersion><sourceVersionID>B61O_a_ext</sourceVersionID><sourceObjectID>1</sourceObjectID><expression>|*******************************************************************************
|* txwip0500em21  B61O_a_ext
|* Inline &amp; Documentation Costs
|* ict004
|* 2026-09-19 [10:23]
|*******************************************************************************
|* Script Type: 123
|*******************************************************************************

|*************************** declaration section *******************************
declaration:

	table	ttxwip020		|* QC Cost Summary
	table	ttxwip021		|* Reagents Header	
	table	ttxwip022		|* Reagents Details
	table	ttxwip024		|* Micro Test Header
	table	ttxwip025		|* Micro Test Details
	table	ttxwip026		|* QC Personnel
	table	ttxwip027		|* Micro Test Materials
	table	ttxwip028		|* Micro Test Reagents
	table	ttxwip030		|* Pychem Test Header
	table	ttxwip031		|* Pychem Test Details
	table	ttxwip033		|* Third Party Test Header
	table	ttxwip034		|* Third Party Test Details
	table	ttxwip035 		|* QC Items
	table	ttxwip036		|* QC Cost Master Data
	table	ttxwip037		|* QC Cost Details
	table	ttxwip038		|* Inline &amp; Documentation Costs
	table	ttxwip039		|* Micro Test Materials Reference

	table	ttcibd001		|* Items
	table	ttcibd003		|* Conversion Factors
	table	ttdipu001		|* Item - Purchase
	table	ttcmcs012		|* Units by Unit Set
	table	twhltc100		|* Lots
	table	twhltc101		|* Lot Cost Details
	table	twhltc105		|* Lots by Warehouse
	table	ttccom100		|* Business Partners
	table	ttisfc001		|* Production Orders
	
	extern long			temp.id, save.id
	extern domain tcmcs.str50	prid.desc
	
|****************************** program section ********************************

before.program:
	temp.id = 0
	save.id = 0
	
	fattr.total.line = true
	
on.display.total.line:
	display.total.fields("txwip038.lbst", compute_total_cost())
	
main.table.io:
before.write:
	if txwip038.actd &lt; 0 then
		save.id = save.id + 1
		txwip038.actd = save.id
	endif
	
	if txwip038.dcdt = 0 then
		txwip038.dcdt = utc.num()
	endif
	
before.rewrite:
	txwip038.dmdt = utc.num()

|****************************** choice section *********************************

choice.add.set:
after.choice:
	if txwip038.actd = 0 then
		txwip038.prid = 0
		set_temp_id()
	endif
	
choice.update.db:
before.choice:
	save.id = 0
	
	select max(txwip038.actd):save.id
	from txwip038
	selectdo
	endselect
	
|****************************** field section **********************************

field.txwip038.acty:
before.field:
	if txwip038.actd = 0 then
		set_temp_id()
	endif
	
when.field.changes:
	if check_exist(txwip038.acty) = tcyesno.yes then
		message("Activity already exists.")
		set.input.error("")
	endif
	
field.txwip038.prtm:
when.field.changes:
	if txwip038.prid = 0 then
		txwip038.rthr = 0
		txwip038.lbhr = 0
		txwip038.lbst = 0
		prid.desc = ""
	else
		update_labor_cost()
	endif
	
	refresh.total.line()
	
field.txwip038.prid:
after.zoom:
	update_labor_cost()
	update_prid_desc(txwip038.prid)
	refresh.total.line()
	
when.field.changes:
	update_labor_cost()
	update_prid_desc(txwip038.prid)
	refresh.total.line()
	
field.prid.desc:
before.display:
	update_prid_desc(txwip038.prid)

|***************************** function section *******************************

functions:

function set_temp_id(){
	temp.id = temp.id - 1
	txwip038.actd = temp.id
}

function domain tcyesno check_exist(domain tcmcs.str100 acty){
	domain tcyesno is.exist
	domain tcmcs.str100 activity
	
	is.exist = tcyesno.no
	activity = trim$(acty)
	
	select txwip038.actd
	from txwip038
	where txwip038.acty = :activity
	selectdo
		is.exist = tcyesno.yes
	endselect
	
	return(is.exist)
}

function update_prid_desc(domain tcmcs.long id){
	prid.desc = get_prid_desc(id)
}

function domain tcmcs.str50 get_prid_desc(domain tcmcs.long id){
	domain tcmcs.str50 desc
	
	desc = ""
	
	select txwip026.dscr
	from txwip026
	where txwip026.prid = :id
	selectdo
		desc = txwip026.dscr
	endselect
	
	return(txwip026.dscr)
}

function domain tcqiv1 compute_total_cost(){
	domain tcqiv1 total
	
	total = 0
	
	select sum(txwip038.lbst):total
	from txwip038
	selectdo
	endselect
	
	return(total) 
}

function update_labor_cost(){
	select txwip026.*
	from txwip026
	where txwip026.prid = :txwip038.prid
	selectdo
		txwip038.rthr = txwip026.rthr
		txwip038.lbhr = txwip038.prtm / 60
		txwip038.lbst = txwip038.lbhr * txwip038.rthr
	endselect
}

function extern qc_personnel(){
	start.session(MODELESS, "txwip0500em22", "txwip0500em21", "")
}</expression><expressionLanguageType>Baan4C</expressionLanguageType><sourceType>1</sourceType><sourceDescription>Inline &amp; Documentation Costs</sourceDescription><sourceName>txwip0500em21</sourceName></Source><documentation/><Attachment><type>relnotes</type><name>txwip0500em21</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em21</name></Attachment><additionalConstraints>2590</additionalConstraints><additionalInstructions/><keyword>||</keyword><application>EXTce01106</application></DR_Module><startInCompanyZero>false</startInCompanyZero><repSevLang>false</repSevLang><mainSession>true</mainSession><moduleType>1</moduleType><windowType>6</windowType><subType>1</subType><status>1</status><documentation/><Attachment><type>relnotes</type><name>txwip0500em21</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em21</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em21dprid.desc</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em21dprid.desc</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em21dtxwip038.ac</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em21dtxwip038.ac</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em21dtxwip038.ac</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em21dtxwip038.ac</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em21dtxwip038.dc</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em21dtxwip038.dc</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em21dtxwip038.dm</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em21dtxwip038.dm</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em21dtxwip038.lb</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em21dtxwip038.lb</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em21dtxwip038.lb</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em21dtxwip038.lb</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em21dtxwip038.pr</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em21dtxwip038.pr</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em21dtxwip038.pr</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em21dtxwip038.pr</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em21dtxwip038.rt</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em21dtxwip038.rt</name></Attachment><objectLabel/><application>EXTce01106</application><sessionReferenceDescriptionReference>txwip0500em21</sessionReferenceDescriptionReference><sessionReferenceDescription>Inline &amp; Documentation Costs</sessionReferenceDescription><sessionReference>txwip0500em21</sessionReference><UIScript>txwip0500em21</UIScript></DR_Controller>