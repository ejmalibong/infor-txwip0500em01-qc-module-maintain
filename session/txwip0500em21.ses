ription/><name>run.job</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>41</position><description/><name>global.delete</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>42</position><description/><name>global.copy</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>43</position><description/><name>save.defaults</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>44</position><description/><name>get.defaults</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>45</position><description/><name>start.chart</name></StandardCommand><StandardCommand><active>true</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>46</position><description/><name>start.query</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>47</position><description/><name>select.all</name></StandardCommand><defaultStartCommand>false</defaultStartCommand><DR_Module><description>Inline &amp; Documentation Costs</description><versionID>B61O_a_ext</versionID><type>library</type><name>txwip0500em21</name><Version><ObjectID/><classID/><checkInLabel/><documentation/><isExpired>no</isExpired><isCheckedOutParallel>no</isCheckedOutParallel><isCheckedOut>no</isCheckedOut><modificationDateTime>2026-10-07T17:20:52Z</modificationDateTime><modifiedBy>ict004</modifiedBy><creationDateTime>2026-09-19T14:37:02Z</creationDateTime><createdBy>ict004</createdBy></Version><Source><sourceVersion><ObjectID/><classID/><checkInLabel/><documentation/><isExpired>no</isExpired><isCheckedOutParallel>no</isCheckedOutParallel><isCheckedOut>no</isCheckedOut><modificationDateTime>2026-10-07T17:20:52Z</modificationDateTime><modifiedBy>ict004</modifiedBy><creationDateTime>2026-09-19T14:37:02Z</creationDateTime><createdBy>ict004</createdBy></sourceVersion><sourceVersionID>B61O_a_ext</sourceVersionID><sourceObjectID>1</sourceObjectID><expression>|*******************************************************************************
|* txwip0500em21  B61O_a_ext
|* Inline &amp; Documentation Costs
|* ict004
|* 2026-09-19 [10:23]
|*******************************************************************************
|* Script Type: 123
|*******************************************************************************

|*************************** declaration section *******************************
declaration:

	table	ttxwip020		|* QC Costs
	table	ttxwip021		|* Reagents	
	table	ttxwip022		|* Reagents Details
	table	ttxwip024		|* Micro Tests
	table	ttxwip025		|* Micro Test Details
	table	ttxwip026		|* QC Personnels
	table	ttxwip027		|* Micro Test Materials
	table	ttxwip028		|* Micro Test Reagents
	table	ttxwip030		|* Pychem Tests
	table	ttxwip031		|* Pychem Test Details
	table	ttxwip033		|* Third Party Tests
	table	ttxwip034		|* Third Party Test Details
	table	ttxwip035 		|* QC Items
	table	ttxwip036		|* Item Testing Costs
	table	ttxwip037		|* Item Testing Cost Details
	table	ttxwip038		|* Inline &amp; Documentation Costs
	table	ttxwip039		|* Micro Test Materials Reference
	table	ttxwip040		|* QC Cost Simulations
	table	ttxwip041		|* Micro Retests
	table	ttxwip042		|* Micro Retest Details
	table	ttxwip043		|* Micro Retest Materials
	table	ttxwip044		|* Micro Retest Reagents
	table	ttxwip045		|* Pychem Retests
	table	ttxwip046		|* Pychem Retest Details
	table	ttxwip047		|* QC Cost Retest
	table	ttxwip048		|* QC Cost Simulation Retests	
	
	table	ttcibd001		|* Items
	table	ttcibd003		|* Conversion Factors
	table	ttdipu001		|* Item - Purchase
	table	ttcmcs003		|* Warehouses
	table	ttcmcs012		|* Units by Unit Set
	table	twhltc100		|* Lots
	table	twhltc101		|* Lot Cost Details
	table	twhltc105		|* Lots by Warehouse
	table	ttccom100		|* Business Partners
	table	ttisfc001		|* Production Orders
	table	tticpr007		|* Items - Costing
	
	extern long			temp.id, save.id
	extern domain tcmcs.str50	prid.desc
	
|****************************** program section ********************************

before.program:
	temp.id = 0
	save.id = 0
	
	fattr.total.line = true
	
on.display.total.line:
	display.total.fields("txwip038.lbst", compute_total_cost())
	
main.table.io:
before.write:
	if txwip038.actd &lt; 0 then
		save.id = save.id + 1
		txwip038.actd = save.id
	endif
	
	if txwip038.dcdt = 0 then
		txwip038.dcdt = utc.num()
	endif
	
before.rewrite:
	txwip038.dmdt = utc.num()

|****************************** choice section *********************************

choice.add.set:
after.choice:
	if txwip038.actd = 0 then
		txwip038.prid = 0
		set_temp_id()
	endif
	
choice.update.db:
before.choice:
	save.id = 0
	
	select max(txwip038.actd):save.id
	from txwip038
	selectdo
	endselect
	
|****************************** field section **********************************

field.txwip038.acty:
before.field:
	if txwip038.actd = 0 then
		set_temp_id()
	endif
	
when.field.changes:
	if check_exist(txwip038.acty) = tcyesno.yes then
		message("Activity already exists.")
		set.input.error("")
	endif
	
field.txwip038.prtm:
when.field.changes:
	if txwip038.prid = 0 then
		txwip038.rthr = 0
		txwip038.lbhr = 0
		txwip038.lbst = 0
		prid.desc = ""
	else
		update_labor_cost()
	endif
	
	refresh.total.line()
	
field.txwip038.prid:
after.zoom:
	update_labor_cost()
	update_prid_desc(txwip038.prid)
	refresh.total.line()
	
when.field.changes:
	update_labor_cost()
	update_prid_desc(txwip038.prid)
	refresh.total.line()
	
field.prid.desc:
before.display:
	update_prid_desc(txwip038.prid)

|***************************** function section *******************************

functions:

function set_temp_id(){
	temp.id = temp.id - 1
	txwip038.actd = temp.id
}

function domain tcyesno check_exist(domain tcmcs.str100 acty){
	domain tcyesno is.exist
	domain tcmcs.str100 activity
	
	is.exist = tcyesno.no
	activity = trim$(acty)
	
	select txwip038.actd
	from txwip038
	where txwip038.acty = :activity
	selectdo
		is.exist = tcyesno.yes
	endselect
	
	return(is.exist)
}

function update_prid_desc(domain tcmcs.long id){
	prid.desc = get_prid_desc(id)
}

function domain tcmcs.str50 get_prid_desc(domain tcmcs.long id){
	domain tcmcs.str50 desc
	
	desc = ""
	
	select txwip026.dscr
	from txwip026
	where txwip026.prid = :id
	selectdo
		desc = txwip026.dscr
	endselect
	
	return(txwip026.dscr)
}

function domain tcqiv1 compute_total_cost(){
	domain tcqiv1 total
	
	total = 0
	
	select sum(txwip038.lbst):total
	from txwip038
	selectdo
	endselect
	
	return(total) 
}

function update_labor_cost(){
	select txwip026.*
	from txwip026
	where txwip026.prid = :txwip038.prid
	selectdo
		txwip038.rthr = txwip026.rthr
		txwip038.lbhr = txwip038.prtm / 60
		txwip038.lbst = txwip038.lbhr * txwip038.rthr
	endselect
}

function extern qc_personnel(){
	start.session(MODELESS, "txwip0500em22", "txwip0500em21", "")
}</expression><expressionLanguageType>Baan4C</expressionLanguageType><sourceType>1</sourceType><sourceDescription>Inline &amp; Documentation Costs</sourceDescription><sourceName>txwip0500em21</sourceName></Source><documentation/><Attachment><type>relnotes</type><name>txwip0500em21</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em21</name></Attachment><additionalConstraints>2590</additionalConstraints><additionalInstructions/><keyword>||</keyword><application>EXTce01107</application></DR_Module><startInCompanyZero>false</startInCompanyZero><repSevLang>false</repSevLang><mainSession>true</mainSession><moduleType>1</moduleType><windowType>6</windowType><subType>1</subType><status>1</status><documentation/><objectLabel/><application>EXTce01107</application><sessionReferenceDescriptionReference>txwip0500em21</sessionReferenceDescriptionReference><sessionReferenceDescription>Inline &amp; Documentation Costs</sessionReferenceDescription><sessionReference>txwip0500em21</sessionReference><UIScript>txwip0500em21</UIScript></DR_Controller>