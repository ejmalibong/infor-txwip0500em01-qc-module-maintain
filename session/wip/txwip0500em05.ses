osition><sequenceNumber>18</sequenceNumber></FormField><FormField><uuid>36b836e2-fa6f-4c5f-af63-bab34bb44470</uuid><textDirection>10</textDirection><fieldAlignment>2</fieldAlignment><indexZoomSession>0</indexZoomSession><iconName/><additionalProperties2>0</additionalProperties2><additionalProperties1>1</additionalProperties1><autoEnableDisable>false</autoEnableDisable><behindEnumConstant>0</behindEnumConstant><hyperlink>false</hyperlink><searchDescription/><constantValueForYes>0</constantValueForYes><viewField>false</viewField><displayHeight>1</displayHeight><columnID>1</columnID><endXPosition>31</endXPosition><parentField>0</parentField><labelHeightOverview>1</labelHeightOverview><labelLengthOverview>999</labelLengthOverview><labelHeightDetail>1</labelHeightDetail><labelLengthDetail>20</labelLengthDetail><labelPosition>1</labelPosition><dependentOnParentField>false</dependentOnParentField><xPositionLabel>1</xPositionLabel><followUpField>0</followUpField><labelAlignment>2</labelAlignment><windowsControl>0</windowsControl><fieldBelowGrid>false</fieldBelowGrid><overviewSession>true</overviewSession><detailsSession>true</detailsSession><childFieldsBehind>false</childFieldsBehind><followUp>false</followUp><nextField>20</nextField><groupID>3</groupID><synchronizedField>false</synchronizedField><defaultValue/><inputReferenceExpression>1</inputReferenceExpression><fieldLabel>txwip022.rgid</fieldLabel><languageUnitExpression/><mandatoryInput>false</mandatoryInput><sequenceMode>10</sequenceMode><fieldLength>10</fieldLength><echoField>true</echoField><message/><defaultExpression>false</defaultExpression><zoomReturnField/><zoomProgram/><zoomType>1</zoomType><startPositionString>1</startPositionString><linkInputDigitsBefore>true</linkInputDigitsBefore><inputDigitsBefore>10</inputDigitsBefore><linkDisplayDigitsBefore>true</linkDisplayDigitsBefore><displayDigitsBefore>10</displayDigitsBefore><minimumInputLength>0</minimumInputLength><displayFormatLinked>true</displayFormatLinked><displayFormat>ZZZZZZZZZ9</displayFormat><fieldType>1</fieldType><domain/><element>1</element><fieldName>txwip022.rgid</fieldName><rowScreenPosition>1</rowScreenPosition><columnScreenPosition>22</columnScreenPosition><sequenceNumber>19</sequenceNumber></FormField><FormGroup><selectionGroup>false</selectionGroup><parentTable/><miscellaneous>0</miscellaneous><nextToOtherGroup>false</nextToOtherGroup><checkBoxesOnly>false</checkBoxesOnly><formFormat>13</formFormat><subGroupOnNewPage>false</subGroupOnNewPage><nrSubGroups>1</nrSubGroups><firstChildGroup>3</firstChildGroup><virtualGroup>true</virtualGroup><groupAlignment>1</groupAlignment><firstField>0</firstField><nextGroup>0</nextGroup><previousGroup>0</previousGroup><parentGroup>0</parentGroup><overviewSession>true</overviewSession><detailsSession>true</detailsSession><showGroupBox>false</showGroupBox><groupHeader/><level>0</level><repeating>false</repeating><groupID>1</groupID></FormGroup><FormGroup><selectionGroup>false</selectionGroup><parentTable/><miscellaneous>0</miscellaneous><nextToOtherGroup>false</nextToOtherGroup><checkBoxesOnly>false</checkBoxesOnly><formFormat>13</formFormat><subGroupOnNewPage>false</subGroupOnNewPage><nrSubGroups>1</nrSubGroups><firstChildGroup>0</firstChildGroup><virtualGroup>false</virtualGroup><groupAlignment>-3</groupAlignment><firstField>10</firstField><nextGroup>0</nextGroup><previousGroup>0</previousGroup><parentGroup>1</parentGroup><overviewSession>true</overviewSession><detailsSession>true</detailsSession><showGroupBox>false</showGroupBox><groupHeader/><level>1</level><repeating>false</repeating><groupID>3</groupID></FormGroup></PhysicalFormLayout><description>Reagent Details</description><name>txwip0500em05d</name><horizontal>true</horizontal><custProhibited>false</custProhibited><additionalConstraints>1</additionalConstraints><documentation/><application>EXTce01105</application></Form><DR_Module><description>Reagent Details</description><versionID>B61O_a_ext</versionID><type>library</type><name>txwip0500em05</name><Version><ObjectID/><classID/><checkInLabel/><documentation/><isExpired>no</isExpired><isCheckedOutParallel>no</isCheckedOutParallel><isCheckedOut>no</isCheckedOut><modificationDateTime>2026-09-02T13:40:53Z</modificationDateTime><modifiedBy>ict004</modifiedBy><creationDateTime>2026-08-06T03:12:13Z</creationDateTime><createdBy>ict004</createdBy></Version><Source><sourceVersion><ObjectID/><classID/><checkInLabel/><documentation/><isExpired>no</isExpired><isCheckedOutParallel>no</isCheckedOutParallel><isCheckedOut>no</isCheckedOut><modificationDateTime>2026-09-02T13:40:53Z</modificationDateTime><modifiedBy>ict004</modifiedBy><creationDateTime>2026-08-06T03:12:13Z</creationDateTime><createdBy>ict004</createdBy></sourceVersion><sourceVersionID>B61O_a_ext</sourceVersionID><sourceObjectID>1</sourceObjectID><expression>|*******************************************************************************
|* txwip0500em05  B61O_a_ext
|* Reagent Details
|* ict004
|* 2026-08-06 [11:25]
|*******************************************************************************
|* Script Type: 123
|*******************************************************************************

|*************************** declaration section *******************************
declaration:

	table	ttxwip020		|* QC Cost Summary
	table	ttxwip021		|* Reagents Header	
	table	ttxwip022		|* Reagents Details
	table	ttxwip024		|* Micro Test Header
	table	ttxwip025		|* Micro Test Details
	table	ttxwip026		|* QC Personnel
	table	ttxwip027		|* Micro Test Materials
	table	ttxwip028		|* Micro Test Reagents
	table	ttxwip030		|* Pychem Test Header
	table	ttxwip031		|* Pychem Test Details
	table	ttxwip033		|* Third Party Test Header
	table	ttxwip034		|* Third Party Test Details
	table	ttxwip035 		|* QC Items
	table	ttxwip036		|* QC Cost Master Data
	table	ttxwip037		|* QC Cost Details

	table	ttcibd001		|* Items
	table	ttcibd003		|* Conversion Factors
	table	ttdipu001		|* Item - Purchase
	table	ttcmcs012		|* Units by Unit Set
	
	table	twhltc100		|* Lots
	table	twhltc101		|* Lot Cost Details
		
	extern domain tcnama		item.desc, slvn.desc
	extern long 			temp.rgid, save.rgid

|****************************** program section ********************************

before.program:
	temp.rgid = 0
	save.rgid = 0

main.table.io:
before.write:
	if txwip022.rgid &lt; 0 then
		save.rgid = save.rgid + 1
		txwip022.rgid = save.rgid
	endif

	if txwip022.dcdt = 0 then
		txwip022.dcdt = utc.num()
	endif

before.rewrite:
	txwip022.dmdt = utc.num()

|****************************** choice section *********************************

choice.add.set:
after.choice:
	disable.fields("txwip022.rvol")
	disable.fields("txwip022.rgni")
	disable.fields("txwip022.svol")
	disable.fields("txwip022.slni")

	if txwip022.rgid = 0 then
		set_temp_rgid()
	endif

choice.update.db:
before.choice:
	save.rgid = 0

	select max(txwip022.rgid):save.rgid
	from txwip022
	selectdo
	endselect

|****************************** field section **********************************

field.txwip022.rgtp:
before.field:
	disable.fields("txwip022.rvol")
	disable.fields("txwip022.rgni")

	if txwip022.rgid = 0 then
		set_temp_rgid()
	endif

when.field.changes:
	if txwip022.rgtp = ltoe(0) then
		txwip022.item = ""
		item.desc = ""
		txwip022.rvol = 0
		txwip022.rgni = ""
	endif

	display("txwip022.item")
	display("item.desc")
	display("txwip022.rgni")

field.txwip022.item:
before.zoom:
	update_reagent_zoom()

selection.filter:
	update_param_selection_filter(txwip022.rgtp)

after.zoom:
	if trim$(txwip022.item) &lt;&gt; "" then
		txwip022.item = trim$(txwip022.item)
		enable.fields("txwip022.rvol")

		if etol(txwip022.rgtp) = 1 then
			enable.fields("txwip022.rgni")
		else
			disable.fields("txwip022.rgni")
		endif
	endif

when.field.changes:
	if trim$(txwip022.item) &lt;&gt; "" then
		update_param_desc("reagent")

		on case check_param_unit(txwip022.rgtp, trim$(txwip022.item))
			case 0:
				if check_param_base_unit(txwip022.rgtp, trim$(txwip022.item)) &gt; 0 then
					enable.fields("txwip022.rvol")
					enable.fields("txwip022.rgni")

					txwip022.rgni = get_param_base_unit(txwip022.rgtp, trim$(txwip022.item))
				else
					disable.fields("txwip022.rvol")
					disable.fields("txwip022.rgni")
					message("No conversion factor found for this item.")
				endif
				break

			case 1:
				on case etol(txwip022.rgtp)
					case 1:
						enable.fields("txwip022.rvol")
						enable.fields("txwip022.rgni")
						break
					case 2:
						enable.fields("txwip022.rvol")
						disable.fields("txwip022.rgni")
						txwip022.rgni = "ML"
						break
					case 3:
						enable.fields("txwip022.rvol")
						disable.fields("txwip022.rgni")
						txwip022.rgni = get_qc_param_unit(txwip022.rgtp, trim$(txwip022.item))
						break
					default:
						disable.fields("txwip022.rvol")
						disable.fields("txwip022.rgni")
				endcase
				break
				
			default:
				enable.fields("txwip022.rvol")
				enable.fields("txwip022.rgni")

				txwip022.rvol = 0
				txwip022.rgni = ""
				txwip022.rgst = 0
		endcase

	else
		item.desc = ""
		txwip022.rvol = 0
		txwip022.rgni = ""

		disable.fields("txwip022.rvol")
		disable.fields("txwip022.rgni")
	endif

field.item.desc:
before.display:
	update_param_desc("reagent")

field.txwip022.rgni:
before.zoom:
	update_unit_zoom(txwip022.rgtp)

selection.filter:
	update_zoom_selection_filter(txwip022.rgtp, trim$(txwip022.item))

field.txwip022.sltp:
before.field:
	disable.fields("txwip022.svol")
	disable.fields("txwip022.slni")

when.field.changes:
	txwip022.slvn = ""
	slvn.desc = ""
	txwip022.svol = 0
	txwip022.slni = ""

	display("txwip022.slvn")
	display("slvn.desc")
	display("txwip022.slni")

field.txwip022.slvn:
before.zoom:
	update_solvent_zoom()

selection.filter:
	update_param_selection_filter(txwip022.sltp)

after.zoom:
	if trim$(txwip022.slvn) &lt;&gt; "" then
		txwip022.slvn = trim$(txwip022.slvn)
		enable.fields("txwip022.svol")

		if etol(txwip022.sltp) = 1 then
			enable.fields("txwip022.slni")
		else
			disable.fields("txwip022.slni")
		endif
	endif

when.field.changes:
	if trim$(txwip022.slvn) &lt;&gt; "" then
		update_param_desc("solvent")

		on case check_param_unit(txwip022.sltp, trim$(txwip022.slvn))
			case 0:
				if check_param_base_unit(txwip022.sltp, trim$(txwip022.slvn)) &gt; 0 then
					enable.fields("txwip022.svol")
					enable.fields("txwip022.slni")

					txwip022.slni = get_param_base_unit(txwip022.sltp, trim$(txwip022.slvn))
				else
					disable.fields("txwip022.svol")
					disable.fields("txwip022.slni")

					message("No conversion factor found for this item.")
				endif
				break

			case 1:
				on case etol(txwip022.sltp)
					case 1:
						enable.fields("txwip022.svol")
						enable.fields("txwip022.slni")
						break
					case 2:

						enable.fields("txwip022.svol")
						disable.fields("txwip022.slni")
						txwip022.slni = "ML"
						break
					case 3:
						enable.fields("txwip022.svol")
						disable.fields("txwip022.slni")
						txwip022.slni = get_qc_param_unit(txwip022.sltp, trim$(txwip022.slvn))
						break
					default:
						disable.fields("txwip022.svol")
						disable.fields("txwip022.slni")
				endcase
				break

			default:
				enable.fields("txwip022.svol")
				enable.fields("txwip022.slni")

				txwip022.svol = 0
				txwip022.slni = ""
				txwip022.slst = 0
		endcase
		
	else
		slvn.desc = ""
		txwip022.svol = 0
		txwip022.slni = ""

		disable.fields("txwip022.svol")
		disable.fields("txwip022.slni")
	endif

field.slvn.desc:
before.display:
	update_param_desc("solvent")

field.txwip022.slni:
before.zoom:
	update_unit_zoom(txwip022.sltp)

selection.filter:
	update_zoom_selection_filter(txwip022.sltp, trim$(txwip022.slvn))

|****************************** function section *******************************

functions:

function void set_temp_rgid(){
	temp.rgid = temp.rgid - 1
	txwip022.rgid = temp.rgid
}

function void update_param_selection_filter(domain txmat.types param.type){
	on case etol(param.type)
		case 1:
			query.extend.where.in.zoom("tcibd001.citg = '600'")
			break
		case 2:
			query.extend.where.in.zoom("txwip021.rgnt &lt;&gt; '" &amp; txwip022.rgnt &amp; "'")
			break
		default:
	endcase
}

function void update_param_desc(domain tcmcs.str50 param){
	if trim$(param) = "reagent" then
		item.desc = get_param_desc(txwip022.rgtp, trim$(txwip022.item))
	else
		slvn.desc = get_param_desc(txwip022.sltp, trim$(txwip022.slvn))
	endif
}

function domain tcnama get_param_desc(domain txmat.types param.type, domain tcmcs.str50 param){
	domain tcnama desc
	
	desc = ""
	
	on case etol(param.type)
		case 1:
			select tcibd001.dsca
			from tcibd001
			where tcibd001.item = "         " &amp; :param
			selectdo
				desc = tcibd001.dsca
			endselect
			break
		case 2:
			select txwip021.dscr
			from txwip021
			where txwip021.rgnt = :param
			selectdo
				desc = txwip021.dscr
			endselect
			break
		case 3:
			select txwip035.dscr
			from txwip035
			where txwip035.qitm = :param
			selectdo
				desc = txwip035.dscr
			endselect
			break
		default:
			desc = ""
	endcase

	return(desc)
}

function domain tcprip get_param_price(domain txmat.types param.type, domain tcmcs.str50 param){
	domain tcprip price

	price = 0

	on case etol(param.type)
		case 1:
			if get_lot_price(trim$(param)) &gt; 0 then
				price = get_lot_price(trim$(param))
			else
				price = 0
				
				| Will use purchase price
				|select tdipu001.prip
				|from tdipu001
				|where tdipu001.item = "         " &amp; :param
				|selectdo
				|	price = tdipu001.prip
				|endselect
			endif
			break
		case 2:
			price = 0
			break
		case 3:
			select txwip035.prip
			from txwip035
			where txwip035.qitm = :param
			as set with 1 rows
			selectdo
				price = txwip035.prip
			selectempty
				price = 0
			endselect
			break
		default:
			price = 0
	endcase

	return(price)
}

function domain tccopr get_lot_price(domain tcitem item){
	domain tcclot lot.number
	domain tccopr lot.price
	
	lot.number = ""
	lot.price = 0
	
	select whltc100.item, whltc100.clot, whltc100.ldat
	from whltc100
	where whltc100.item = :item
	order by whltc100.ldat
	as set with 1 rows
	selectdo
		select whltc101.pric
		from whltc101
		where whltc101.item = :whltc100.item
			and whltc101.cpcp = "MC0002"
		selectdo
			lot.price = whltc101.pric(1)
		selectempty
			lot.price = 0
		endselect
	endselect

	return(lot.price)
}

function long check_param_unit(domain txmat.types param.type, domain tcmcs.str50 param){
	long cnt

	cnt = 0

	on case etol(param.type)
		case 1:
			select count(tcibd003.unit):cnt
			from tcibd003
			where tcibd003.item = "         " &amp; :param
			selectdo
			endselect
			break
		case 2:
			cnt = 1
			break
		case 3:
			select count(txwip035.cuni):cnt
			from txwip035
			where txwip035.qitm = :param
			selectdo
			endselect
			break
		default:
			cnt = 0
	endcase

	return(cnt)
}

function domain tccuni get_qc_param_unit(domain txmat.types param.type, domain tcmcs.str50 param){
	domain tccuni unit

	unit = ""

	select txwip035.cuni
	from txwip035
	where txwip035.qitm = :param
	as set with 1 rows
	selectdo
		unit = txwip035.cuni
	selectempty
		unit = ""
	endselect

	return(unit)
}

function long check_param_base_unit(domain txmat.types param.type, domain tcmcs.str50 param){
	long cnt

	cnt = 0

	on case etol(param.type)
		case 1:
			select count(tcibd003.basu):cnt
			from tcibd003
			where tcibd003.item = "         " &amp; :param
			selectdo
			endselect
			break
		case 2:
			cnt = 0
			break
		case 3:
			cnt = 1
			break
		default:
			cnt = 0
	endcase

	return(cnt)
}

function domain tccuni get_param_base_unit(domain txmat.types param.type, domain tcmcs.str50 param){
	domain tccuni unit

	unit = ""

	on case etol(param.type)
		case 1:
			select tcibd003.basu
			from tcibd003
			where tcibd003.item =
				"         " &amp; :param
			as set with 1 rows
			selectdo
				unit = tcibd003.basu
			endselect
			break
		case 2:
			unit = ""
			break
		case 3:
			select txwip035.cuni
			from txwip035
			where txwip035.qitm = :param
			as set with 1 rows
			selectdo
				unit = txwip035.cuni
			endselect
			break
		default:
			unit = ""
	endcase

	return(unit)
}

function void update_unit_zoom(domain txmat.types param.type){
	on case etol(param.type)
		case 1:
			attr.zoomcode = 2
			attr.zoomsession$ = "tcibd0103m000"
			attr.zoomreturn$ = "tcibd003.unit"
			break
		case 2:
			attr.zoomcode = 0
			break
		case 3:
			attr.zoomcode = 0
			break
		default:
			attr.zoomcode = 0
	endcase
}

function void update_zoom_selection_filter(domain txmat.types param.type, domain tcmcs.str50 param){
	on case etol(param.type)
		case 1:
			query.extend.where.in.zoom("tcibd003.item = '" &amp; "         " &amp; param &amp; "'")
			break
		case 2:
			break
		case 3:
			break
		default:
	endcase
}

function domain tcqiv1 compute_param_cost(domain txmat.types param.type, domain tcmcs.str50 param, domain tiqcp1 volume, domain tccuni unit, domain tcprip price){
	domain tcconv conversion
	domain tcqiv1 cost, cost.per.ml

	conversion = 0
	cost = 0
	cost.per.ml = 0

	on case etol(param.type)
		case 1:
			select tcibd003.conv
			from tcibd003
			where tcibd003.item = "         " &amp; :param
			and tcibd003.unit = :unit
			selectdo
				conversion = tcibd003.conv
				
				if conversion &lt;&gt; 0 then
					cost = volume * (price / conversion)
				else
					cost = 0
				endif
			selectempty
				cost = 0
			endselect
			break
		case 2:
			select txwip021.csst
			from txwip021
			where txwip021.rgnt = :param
			as set with 1 rows
			selectdo
				cost.per.ml = txwip021.csst
			selectempty
				cost.per.ml = 0
			endselect

			cost = volume * cost.per.ml
			
			break
		case 3:
			select txwip035.conv
			from txwip035
			where txwip035.qitm = :param
			as set with 1 rows
			selectdo
				conversion = txwip035.conv

				if conversion &lt;&gt; 0 then
					cost = volume * (price / conversion)
				else
					cost = 0
				endif
			selectempty
				cost = 0
			endselect
			break
		default:
			cost = 0
	endcase

	return(cost)
}

function void update_reagent_zoom(){
	on case etol(txwip022.rgtp)
		case 1:
			enable.fields("txwip022.item")
			attr.zoomcode = 2
			attr.zoomsession$ = "tcibd0501m000"
			attr.zoomreturn$ = "tcibd001.item"
			break
		case 2:
			enable.fields("txwip022.item")
			attr.zoomcode = 2
			attr.zoomsession$ = "txwip0500em03"
			attr.zoomreturn$ = "txwip021.rgnt"
			break
		case 3:
			enable.fields("txwip022.item")
			attr.zoomcode = 2
			attr.zoomsession$ = "txwip0500em06"
			attr.zoomreturn$ = "txwip035.qitm"
			break
		default:
			disable.fields("txwip022.item")
	endcase
}

