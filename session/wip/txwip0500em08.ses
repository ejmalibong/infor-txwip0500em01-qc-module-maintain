teTime><createdBy>ict004</createdBy></Version><Source><sourceVersion><ObjectID/><classID/><checkInLabel/><documentation/><isExpired>no</isExpired><isCheckedOutParallel>no</isCheckedOutParallel><isCheckedOut>no</isCheckedOut><modificationDateTime>2026-09-06T11:44:50Z</modificationDateTime><modifiedBy>ict004</modifiedBy><creationDateTime>2026-08-11T14:50:23Z</creationDateTime><createdBy>ict004</createdBy></sourceVersion><sourceVersionID>B61O_a_ext</sourceVersionID><sourceObjectID>1</sourceObjectID><expression>|*******************************************************************************
|* txwip0500em08  B61O_a_ext
|* Micro Tests
|* ict004
|* 2026-08-11 [10:53]
|*******************************************************************************
|* Script Type: 123
|*******************************************************************************

|*************************** declaration section *******************************
declaration:

	table	ttxwip020		|* QC Cost Summary
	table	ttxwip021		|* Reagents Header	
	table	ttxwip022		|* Reagents Details
	table	ttxwip024		|* Micro Test Header
	table	ttxwip025		|* Micro Test Details
	table	ttxwip026		|* QC Personnel
	table	ttxwip027		|* Micro Test Materials
	table	ttxwip028		|* Micro Test Reagents
	table	ttxwip030		|* Pychem Test Header
	table	ttxwip031		|* Pychem Test Details
	table	ttxwip033		|* Third Party Test Header
	table	ttxwip034		|* Third Party Test Details
	table	ttxwip035 		|* QC Items
	table	ttxwip036		|* QC Cost Master Data
	table	ttxwip037		|* QC Cost Details

	table	ttcibd001		|* Items
	table	ttcibd003		|* Conversion Factors
	table	ttdipu001		|* Item - Purchase
	table	ttcmcs012		|* Units by Unit Set
	
	extern domain tcitem		zoom.item

|****************************** program section ********************************

zoom.from.all:
on.entry:
	import("txwip037.item", zoom.item)
	
before.display.object:
	if trim$(zoom.item) = "" then
		disable.commands("create_cost_details")
	endif

|****************************** function section *******************************

functions:

function extern void create_cost_details(){
	if trim$(zoom.item) &lt;&gt; "" then
		long ret
		
		do.selection(true, save_selected_tests) 
            	ret = refresh.parent(-1) 
		end()
	endif
}

function void save_selected_tests(){
	domain tcorno selected.code
	
	selected.code = trim$(txwip024.anly)
	
	execute(15)
	
	select txwip037.code
	from txwip037
	where txwip037.code = :selected.code
		and txwip037.item = :zoom.item
	selectdo
		message(selected.code &amp; " is already in the list.")
	selectempty
		txwip037.item = zoom.item
		txwip037.code = selected.code
		txwip037.dcdt = utc.num()
		db.insert(ttxwip037, db.retry)
		commit.transaction()
	endselect
}</expression><expressionLanguageType>Baan4C</expressionLanguageType><sourceType>1</sourceType><sourceDescription>Micro Tests</sourceDescription><sourceName>txwip0500em08</sourceName></Source><documentation/><Attachment><type>relnotes</type><name>txwip0500em08</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em08</name></Attachment><additionalConstraints>2590</additionalConstraints><additionalInstructions/><keyword>||</keyword><application>EXTce01105</application></DR_Module><startInCompanyZero>false</startInCompanyZero><repSevLang>false</repSevLang><mainSession>true</mainSession><moduleType>1</moduleType><windowType>6</windowType><subType>5</subType><status>1</status><documentation/><Attachment><type>relnotes</type><name>txwip0500em08</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em08</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em08dtxwip024.an</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em08dtxwip024.an</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em08dtxwip024.dc</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em08dtxwip024.dc</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em08dtxwip024.dm</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em08dtxwip024.dm</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em08dtxwip024.fr</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em08dtxwip024.fr</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em08dtxwip024.tl</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em08dtxwip024.tl</name></Attachment><objectLabel/><application>EXTce01105</application><sessionReferenceDescriptionReference>txwip0500em08</sessionReferenceDescriptionReference><sessionReferenceDescription>Micro Tests</sessionReferenceDescription><sessionReference>txwip0500em08</sessionReference><UIScript>txwip0500em08</UIScript></DR_Controller>