**************
|* txwip0500em34  B61O_a_ext
|* QC Cost Retests
|* ict004
|* 2026-10-08 [12:48]
|*******************************************************************************
|* Script Type: 123
|*******************************************************************************

|*************************** declaration section *******************************
declaration:

	table	ttxwip020		|* QC Costs
	table	ttxwip021		|* Reagents	
	table	ttxwip022		|* Reagents Details
	table	ttxwip024		|* Micro Tests
	table	ttxwip025		|* Micro Test Details
	table	ttxwip026		|* QC Personnels
	table	ttxwip027		|* Micro Test Materials
	table	ttxwip028		|* Micro Test Reagents
	table	ttxwip030		|* Pychem Tests
	table	ttxwip031		|* Pychem Test Details
	table	ttxwip033		|* Third Party Tests
	table	ttxwip034		|* Third Party Test Details
	table	ttxwip035 		|* QC Items
	table	ttxwip036		|* Item Testing Costs
	table	ttxwip037		|* Item Testing Cost Details
	table	ttxwip038		|* Inline &amp; Documentation Costs
	table	ttxwip039		|* Micro Test Materials Reference
	table	ttxwip040		|* QC Cost Simulations
	table	ttxwip041		|* Micro Retests
	table	ttxwip042		|* Micro Retest Details
	table	ttxwip043		|* Micro Retest Materials
	table	ttxwip044		|* Micro Retest Reagents
	table	ttxwip045		|* Pychem Retests
	table	ttxwip046		|* Pychem Retest Details
	table	ttxwip047		|* QC Cost Retests
	table	ttxwip048		|* QC Cost Retest Details
	table	ttxwip049		|* QC Simulation Retests
	table	ttxwip050		|* QC Simulation Retest Details
	
	table	ttcibd001		|* Items
	table	ttcibd003		|* Conversion Factors
	table	ttdipu001		|* Item - Purchase
	table	ttcmcs003		|* Warehouses
	table	ttcmcs012		|* Units by Unit Set
	table	twhltc100		|* Lots
	table	twhltc101		|* Lot Cost Details
	table	twhltc105		|* Lots by Warehouse
	table	ttccom100		|* Business Partners
	table	ttisfc001		|* Production Orders
	table	tticpr007		|* Items - Costing
	
	extern domain tcqiv1		test.cost, total.retest
	extern domain tcmcs.str132	test.desc
	extern domain tcpdno		zoom.pdno
	extern domain tccwar		zoom.cwar

|****************************** program section ********************************

before.program:
	import("txwip020.pdno", zoom.pdno)
	import("txwip020.cwar", zoom.cwar)

zoom.from.all:
on.entry:
	standard.commands.off(add.set, mark.delete, recover.set, update.db, end.program, first.set, next.set, prev.set, last.set)
	disable_fields()
	
	if trim$(zoom.pdno) &lt;&gt; "" then
		select txwip047.*
		from txwip047
		where txwip047.pdno = :zoom.pdno
		as set with 1 rows
		selectdo
		endselect
		
		execute(find.data)	
	endif
	
after.form.read:
	if trim$(zoom.pdno) = "" then
		remove.form.commands("save_total_cost")
	endif
	
	add.sync.fields("txwip0500em35", "zoom.cwar", "zoom.cwar")
	
main.table.io:
before.write:
	if txwip047.dcdt = 0 then
		txwip047.dcdt = utc.num()
	endif

before.rewrite:
	txwip047.dmdt = utc.num()
	
|****************************** field section **********************************

field.txwip047.pdno:
check.input:
	if is_exist(txwip047.pdno) = tcyesno.yes then
		message(txwip047.pdno &amp; " already exist.")
		set.input.error("")
	endif

|****************************** function section *******************************

functions:

function domain tcyesno is_exist(domain tcpdno pdno){
	domain tcyesno is.exist
	
	select txwip047.*
	from txwip047
	where txwip047.pdno = :pdno
	as set with 1 rows
	selectdo
		is.exist = tcyesno.yes	
	selectempty
		is.exist = tcyesno.no
	endselect
	
	return(is.exist)
}

function extern save_total_cost(){
	domain tcqiv1 mtst, pyst
	long ret
	
	mtst = 0
	pyst = 0
	
	execute(15)
	
	select txwip047.*
	from txwip047 for update
	where txwip047.pdno = :txwip047.pdno
	as set with 1 rows
	selectdo
		mtst = compute_micro_retest_cost(txwip047.pdno, get_equivalent_cwar(zoom.cwar))
		pyst = compute_pychem_retest_cost(txwip047.pdno, get_equivalent_cwar(zoom.cwar))
		txwip047.ttst = mtst + pyst
		
		if txwip047.dcdt = 0 then
			txwip047.dcdt = utc.num()
		else
			txwip047.dmdt = utc.num()
		endif
		
		if db.update(ttxwip047, db.retry) &lt;&gt; 0 then
			message("Error " &amp; str$(e) &amp; " occurred while updating the record.")
			abort.transaction()
		endif
		
		select txwip020.*
		from txwip020 for update
		where txwip020.pdno = :txwip047.pdno
		as set with 1 rows
		selectdo
			txwip020.rtst = txwip047.ttst
			
			if db.update(ttxwip020, db.retry) &lt;&gt; 0 then
				message("Error " &amp; str$(e) &amp; " occurred while updating the record.")
				abort.transaction()
			endif
		endselect
	endselect

	commit.transaction()
	
	select txwip047.*
	from txwip047
	where txwip047.pdno = :txwip047.pdno
	as set with 1 rows
	selectdo
	endselect
	
	execute(find.data)
	
	ret = refresh.parent(-1)
	synchronize.satellite("txwip0500em35")
}

function domain tcqiv1 compute_micro_retest_cost(domain tcpdno pdno, domain tccwar cwar){
	domain tcqiv1 total.cost
	
	total.cost = 0
	
	select txwip041.anly, txwip041.pyst
	from txwip041
	where txwip041.cwar = :cwar
		and exists
		(select txwip048.code
		from txwip048
		where txwip048.code = txwip041.anly
			and txwip048.pdno = :pdno)
	selectdo
		total.cost = total.cost + txwip041.pyst
	selectempty
		total.cost = 0
	endselect
	
	return(total.cost)
}

function domain tcqiv1 compute_pychem_retest_cost(domain tcpdno pdno, domain tccwar cwar){
	domain tcqiv1 total.cost
	
	total.cost = 0
	
	select txwip045.ptid, txwip045.pyst
	from txwip045
	where txwip045.cwar = :cwar
		and exists
		(select txwip048.code
		from txwip048
		where txwip048.code = txwip045.ptid
			and txwip048.pdno = :pdno)
	selectdo
		total.cost = total.cost + txwip045.pyst
	selectempty
		total.cost = 0
	endselect
	
	return(total.cost)
}

function disable_fields(){
	disable.fields("txwip047.pdno")
}

function domain tccwar get_equivalent_cwar(domain tccwar cwar){
	domain tccwar jo.cwar
	
	select tcmcs003.dsca
	from tcmcs003
	where tcmcs003.cwar = :cwar
	as set with 1 rows
	selectdo
		if str_pos(toupper$(trim$(tcmcs003.dsca)), "SITE 1") &gt; 0 then
			jo.cwar = "1CS001"
		endif
		
		if str_pos(toupper$(trim$(tcmcs003.dsca)), "SITE 2") &gt; 0 then
			jo.cwar = "1PS001"
		endif
	endselect
	
	return(jo.cwar)
}</expression><expressionLanguageType>Baan4C</expressionLanguageType><sourceType>1</sourceType><sourceDescription>QC Cost Retests</sourceDescription><sourceName>txwip0500em34</sourceName></Source><documentation/><Attachment><type>relnotes</type><name>txwip0500em34</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em34</name></Attachment><additionalConstraints>2590</additionalConstraints><additionalInstructions/><keyword>||</keyword><application>EXTce01107</application></DR_Module><startInCompanyZero>false</startInCompanyZero><repSevLang>false</repSevLang><mainSession>true</mainSession><moduleType>1</moduleType><windowType>15</windowType><subType>1</subType><status>1</status><documentation/><Attachment><type>relnotes</type><name>txwip0500em34</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em34</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em34dtxwip047.dc</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em34dtxwip047.dc</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em34dtxwip047.dm</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em34dtxwip047.dm</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em34dtxwip047.pd</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em34dtxwip047.pd</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em34dtxwip047.tt</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em34dtxwip047.tt</name></Attachment><objectLabel/><application>EXTce01107</application><sessionReferenceDescriptionReference>txwip0500em34</sessionReferenceDescriptionReference><sessionReferenceDescription>QC Cost Retests</sessionReferenceDescription><sessionReference>txwip0500em34</sessionReference><UIScript>txwip0500em34</UIScript></DR_Controller>