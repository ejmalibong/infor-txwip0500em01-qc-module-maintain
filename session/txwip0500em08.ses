cription>Save</shortDescription><name>create_cost_details</name></FormCommand><description>Micro Tests</description><name>txwip0500em08d</name><horizontal>true</horizontal><custProhibited>false</custProhibited><additionalConstraints>1</additionalConstraints><documentation/><application>EXTce01107</application></Form><DR_Module><description>Micro Tests</description><versionID>B61O_a_ext</versionID><type>library</type><name>txwip0500em08</name><Version><ObjectID/><classID/><checkInLabel/><documentation/><isExpired>no</isExpired><isCheckedOutParallel>no</isCheckedOutParallel><isCheckedOut>no</isCheckedOut><modificationDateTime>2026-10-14T00:20:32Z</modificationDateTime><modifiedBy>ict004</modifiedBy><creationDateTime>2026-08-11T14:50:23Z</creationDateTime><createdBy>ict004</createdBy></Version><Source><sourceVersion><ObjectID/><classID/><checkInLabel/><documentation/><isExpired>no</isExpired><isCheckedOutParallel>no</isCheckedOutParallel><isCheckedOut>no</isCheckedOut><modificationDateTime>2026-10-14T00:20:32Z</modificationDateTime><modifiedBy>ict004</modifiedBy><creationDateTime>2026-08-11T14:50:23Z</creationDateTime><createdBy>ict004</createdBy></sourceVersion><sourceVersionID>B61O_a_ext</sourceVersionID><sourceObjectID>1</sourceObjectID><expression>|*******************************************************************************
|* txwip0500em08  B61O_a_ext
|* Micro Tests
|* ict004
|* 2026-08-11 [10:53]
|*******************************************************************************
|* Script Type: 123
|*******************************************************************************

|*************************** declaration section *******************************
declaration:

	table	ttxwip020		|* QC Costs
	table	ttxwip021		|* Reagents	
	table	ttxwip022		|* Reagents Details
	table	ttxwip024		|* Micro Tests
	table	ttxwip025		|* Micro Test Details
	table	ttxwip026		|* QC Personnels
	table	ttxwip027		|* Micro Test Materials
	table	ttxwip028		|* Micro Test Reagents
	table	ttxwip030		|* Pychem Tests
	table	ttxwip031		|* Pychem Test Details
	table	ttxwip033		|* Third Party Tests
	table	ttxwip034		|* Third Party Test Details
	table	ttxwip035 		|* QC Items
	table	ttxwip036		|* Item Testing Costs
	table	ttxwip037		|* Item Testing Cost Details
	table	ttxwip038		|* Inline &amp; Documentation Costs
	table	ttxwip039		|* Micro Test Materials Reference
	table	ttxwip040		|* QC Cost Simulations
	table	ttxwip041		|* Micro Retests
	table	ttxwip042		|* Micro Retest Details
	table	ttxwip043		|* Micro Retest Materials
	table	ttxwip044		|* Micro Retest Reagents
	table	ttxwip045		|* Pychem Retests
	table	ttxwip046		|* Pychem Retest Details
	table	ttxwip047		|* QC Cost Retest
	table	ttxwip048		|* QC Cost Simulation Retests	
	
	table	ttcibd001		|* Items
	table	ttcibd003		|* Conversion Factors
	table	ttdipu001		|* Item - Purchase
	table	ttcmcs003		|* Warehouses
	table	ttcmcs012		|* Units by Unit Set
	table	twhltc100		|* Lots
	table	twhltc101		|* Lot Cost Details
	table	twhltc105		|* Lots by Warehouse
	table	ttccom100		|* Business Partners
	table	ttisfc001		|* Production Orders
	table	tticpr007		|* Items - Costing
	
	extern domain tccwar		zoom.cwar
	extern domain tcitem		zoom.item
	extern domain tcdsca		cwar.desc
	
|****************************** program section ********************************

before.program:
	import("txwip037.cwar", zoom.cwar)
	import("txwip037.item", zoom.item)
	
	if trim$(zoom.cwar) &lt;&gt; "" then
		query.extend.where("txwip024.cwar = '" &amp; trim$(zoom.cwar) &amp; "'")
	endif
	
main.table.io:
before.delete:
	delete_details_references(txwip024.anly)

zoom.from.all:
on.entry:	
	standard.commands.off(add.set, mark.delete, update.db, end.program)

after.form.read:
	if trim$(zoom.item) = "" and trim$(zoom.cwar) = "" then
		remove.form.commands("create_cost_details")
	endif
	
|****************************** field section **********************************

field.cwar.desc:
before.display:
	select tcmcs003.dsca
	from tcmcs003
	where tcmcs003.cwar = :txwip024.cwar
	as set with 1 rows
	selectdo
		cwar.desc = tcmcs003.dsca 
	endselect

|****************************** function section *******************************

functions:

function extern void create_cost_details(){
	if trim$(zoom.item) &lt;&gt; "" then
		long ret
		do.selection(true, save_selected_tests) 
            	ret = refresh.parent(-1) 
		end()
	endif
}

function void save_selected_tests(){
	domain tcorno selected.code
	
	selected.code = trim$(txwip024.anly)
	execute(15)
	
	select txwip037.code
	from txwip037
	where txwip037.code = :selected.code
		and txwip037.item = :zoom.item
		and txwip037.cwar = :zoom.cwar
	selectdo
		message(selected.code &amp; " is already in the list.")
	selectempty
		txwip037.item = zoom.item
		txwip037.cwar = zoom.cwar
		txwip037.code = selected.code
		txwip037.dcdt = utc.num()
		db.insert(ttxwip037, db.retry)
		commit.transaction()
	endselect
}

function delete_details_references(domain tcorno anly){
	select txwip025.mtid
	from txwip025
	where txwip025.anly = :anly
	selectdo
		select txwip027.*
		from txwip027 for update
		where txwip027.mtid = :txwip025.mtid
		selectdo
			db.delete(ttxwip027, db.retry)
		endselect
		
		select txwip028.*
		from txwip028 for update
		where txwip028.mtid = :txwip025.mtid
		selectdo
			db.delete(ttxwip028, db.retry)
		endselect
	endselect
}</expression><expressionLanguageType>Baan4C</expressionLanguageType><sourceType>1</sourceType><sourceDescription>Micro Tests</sourceDescription><sourceName>txwip0500em08</sourceName></Source><documentation/><Attachment><type>relnotes</type><name>txwip0500em08</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em08</name></Attachment><additionalConstraints>2590</additionalConstraints><additionalInstructions/><keyword>||</keyword><application>EXTce01107</application></DR_Module><startInCompanyZero>false</startInCompanyZero><repSevLang>false</repSevLang><mainSession>true</mainSession><moduleType>1</moduleType><windowType>6</windowType><subType>5</subType><status>1</status><documentation/><Attachment><type>relnotes</type><name>txwip0500em08</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em08</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em08dcwar.desc</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em08dcwar.desc</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em08dtxwip024.an</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em08dtxwip024.an</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em08dtxwip024.cw</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em08dtxwip024.cw</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em08dtxwip024.dc</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em08dtxwip024.dc</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em08dtxwip024.dm</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em08dtxwip024.dm</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em08dtxwip024.fr</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em08dtxwip024.fr</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em08dtxwip024.py</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em08dtxwip024.py</