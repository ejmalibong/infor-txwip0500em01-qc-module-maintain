ame></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>41</position><description/><name>global.delete</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>42</position><description/><name>global.copy</name></StandardCommand><StandardCommand><active>true</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>43</position><description/><name>save.defaults</name></StandardCommand><StandardCommand><active>true</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>44</position><description/><name>get.defaults</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>45</position><description/><name>start.chart</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>46</position><description/><name>start.query</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>47</position><description/><name>select.all</name></StandardCommand><defaultStartCommand>false</defaultStartCommand><DR_Module><description>Simulate QC Cost</description><versionID>B61O_a_ext</versionID><type>library</type><name>txwip0500em25</name><Version><ObjectID/><classID/><checkInLabel/><documentation/><isExpired>no</isExpired><isCheckedOutParallel>no</isCheckedOutParallel><isCheckedOut>no</isCheckedOut><modificationDateTime>2026-10-07T17:20:57Z</modificationDateTime><modifiedBy>ict004</modifiedBy><creationDateTime>2026-10-05T08:17:37Z</creationDateTime><createdBy>ict004</createdBy></Version><Source><sourceVersion><ObjectID/><classID/><checkInLabel/><documentation/><isExpired>no</isExpired><isCheckedOutParallel>no</isCheckedOutParallel><isCheckedOut>no</isCheckedOut><modificationDateTime>2026-10-07T17:20:57Z</modificationDateTime><modifiedBy>ict004</modifiedBy><creationDateTime>2026-10-05T08:17:37Z</creationDateTime><createdBy>ict004</createdBy></sourceVersion><sourceVersionID>B61O_a_ext</sourceVersionID><sourceObjectID>1</sourceObjectID><expression>|*******************************************************************************
|* txwip0500em25  B61O_a_ext
|* Simulate QC Cost
|* ict004
|* 2026-08-06 [09:56]
|*******************************************************************************
|* Script Type: 123
|*******************************************************************************

|*************************** declaration section *******************************
declaration:

	table	ttxwip020		|* QC Costs
	table	ttxwip021		|* Reagents	
	table	ttxwip022		|* Reagents Details
	table	ttxwip024		|* Micro Tests
	table	ttxwip025		|* Micro Test Details
	table	ttxwip026		|* QC Personnels
	table	ttxwip027		|* Micro Test Materials
	table	ttxwip028		|* Micro Test Reagents
	table	ttxwip030		|* Pychem Tests
	table	ttxwip031		|* Pychem Test Details
	table	ttxwip033		|* Third Party Tests
	table	ttxwip034		|* Third Party Test Details
	table	ttxwip035 		|* QC Items
	table	ttxwip036		|* Item Testing Costs
	table	ttxwip037		|* Item Testing Cost Details
	table	ttxwip038		|* Inline &amp; Documentation Costs
	table	ttxwip039		|* Micro Test Materials Reference
	table	ttxwip040		|* QC Cost Simulations
	table	ttxwip041		|* Micro Retests
	table	ttxwip042		|* Micro Retest Details
	table	ttxwip043		|* Micro Retest Materials
	table	ttxwip044		|* Micro Retest Reagents
	table	ttxwip045		|* Pychem Retests
	table	ttxwip046		|* Pychem Retest Details
	table	ttxwip047		|* QC Cost Retest
	table	ttxwip048		|* QC Cost Simulation Retests	
	
	table	ttcibd001		|* Items
	table	ttcibd003		|* Conversion Factors
	table	ttdipu001		|* Item - Purchase
	table	ttcmcs003		|* Warehouses
	table	ttcmcs012		|* Units by Unit Set
	table	twhltc100		|* Lots
	table	twhltc101		|* Lot Cost Details
	table	twhltc105		|* Lots by Warehouse
	table	ttccom100		|* Business Partners
	table	ttisfc001		|* Production Orders
	table	tticpr007		|* Items - Costing
	
	extern domain tcitm.dscr	item.desc
	extern domain tcdsca		cwar.desc

|****************************** field section *********************************
	
field.txwip040.item.segment.2:
before.display:
	update_item_desc(txwip040.item)
	
when.field.changes:
	update_item_desc(txwip040.item)
	
after.zoom:
	update_item_desc(txwip040.item)
	
field.item.desc:
before.display:
	update_item_desc(txwip040.item)
	
field.txwip040.cwar:
when.field.changes:
	update_cwar_desc(txwip040.cwar)

after.zoom:
	update_cwar_desc(txwip040.cwar)

selection.filter:
	query.extend.where.in.zoom("tcmcs003.cwar IN (""1CS001"",""1PS001"")")
	
field.cwar.desc:
before.display:
	update_cwar_desc(txwip040.cwar)
	
|****************************** function section ******************************

functions:

function extern generate_cost_simulation(){
	domain tcqiv1 iidc, mtst, pyst, amst, atst, batch.qty
	domain tcmcs.long smid, next.id
	long ret
	
	iidc = 0
	mtst = 0
	pyst = 0
	amst = 0
	atst = 0
	batch.qty = 0
	smid = 0
	next.id = 0
	
	select txwip040.*
	from txwip040
	where txwip040.item = :txwip040.item
		and txwip040.cwar = :txwip040.cwar
		and txwip040.btsz = :txwip040.btsz
	as set with 1 rows
	selectdo
		message("Simulation already exist.")
		return
	endselect
	
	select max(txwip040.smid):next.id
	from txwip040
	selectdo
		smid = next.id + 1
	selectempty
		smid = 1
	endselect
	
	select txwip036.*
	from txwip036
	where txwip036.item = :txwip040.item
		and txwip036.cwar = :txwip040.cwar
	as set with 1 rows
	selectdo
		iidc = txwip036.iidc
		mtst = txwip036.mtst
		pyst = txwip036.pyst
		amst = txwip036.amst
		atst = txwip036.atst
	selectempty
		message("No testing cost setup found for this item.")
		return
	endselect
	
	execute(15)
	db.retry.point()
	
	select txwip040.*
	from txwip040
	where txwip040.item = :txwip040.item
		and txwip040.cwar = :txwip040.cwar
		and txwip040.btsz = :txwip040.btsz
	as set with 1 rows
	selectdo
	selectempty
		txwip040.smid = smid
		txwip040.idst = iidc
		txwip040.mtst = mtst
		txwip040.pyst = pyst
		
		if txwip040.btsz = 0 then
			txwip040.sust = 0
			txwip040.amst = 0
			txwip040.atst = 0
		else
			txwip040.sust = (iidc + mtst + pyst) / txwip040.btsz
			txwip040.amst = amst / txwip040.btsz
			txwip040.atst = atst / txwip040.btsz
		endif
		
		txwip040.qcst = txwip040.sust + txwip040.amst + txwip040.atst
		txwip040.gpdt = utc.num()
		txwip040.gbby = logname$
		db.insert(ttxwip040, db.retry)
		commit.transaction()
	endselect
	
	message("Process completed.")
	ret = refresh.parent(-1)
	end()
}

function update_cwar_desc(domain tccwar cwar){
	cwar.desc = get_cwar_desc(cwar)
}

function domain tcdsca get_cwar_desc(domain tccwar cwar){
	domain tcdsca desc
	
	desc = ""
	
	select tcmcs003.dsca
	from tcmcs003
	where tcmcs003.cwar = :cwar
	as set with 1 rows
	selectdo
		desc = tcmcs003.dsca
	endselect
	
	return(desc)
}

function void update_item_desc(domain tcitem item){
	item.desc = get_item_desc(item)
}

function domain tcnama get_item_desc(domain tcitem item){
	domain tcitem format.item
	domain tcitm.dscr desc
	
	format.item = "         " &amp; trim$(item)
	desc = ""

	select tcibd001.dsca
	from tcibd001
	where tcibd001.item = :format.item
	selectdo
		desc = tcibd001.dsca
	endselect
	
	return(desc)
}</expression><expressionLanguageType>Baan4C</expressionLanguageType><sourceType>4</sourceType><sourceDescription>Simulate QC Cost</sourceDescription><sourceName>txwip0500em25</sourceName></Source><documentation/><Attachment><type>relnotes</type><name>txwip0500em25</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em25</name></Attachment><additionalConstraints>2590</additionalConstraints><additionalInstructions/><keyword>||</keyword><application>EXTce01107</application></DR_Module><startInCompanyZero>false</startInCompanyZero><repSevLang>false</repSevLang><mainSession>true</mainSession><moduleType>1</moduleType><windowType>3</windowType><subType>4</subType><status>1</status><documentation/><objectLabel/><application>EXTce01107</application><sessionReferenceDescriptionReference>txwip0500em25</sessionReferenceDescriptionReference><sessionReferenceDescription>Simulate QC Cost</sessionReferenceDescription><sessionReference>txwip0500em25</sessionReference><UIScript>txwip0500em25</UIScript></DR_Controller>