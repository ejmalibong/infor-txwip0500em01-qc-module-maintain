04</modifiedBy><creationDateTime>2026-08-26T13:20:08Z</creationDateTime><createdBy>ict004</createdBy></Version><Source><sourceVersion><ObjectID/><classID/><checkInLabel/><documentation/><isExpired>no</isExpired><isCheckedOutParallel>no</isCheckedOutParallel><isCheckedOut>no</isCheckedOut><modificationDateTime>2026-09-06T11:44:52Z</modificationDateTime><modifiedBy>ict004</modifiedBy><creationDateTime>2026-08-26T13:20:08Z</creationDateTime><createdBy>ict004</createdBy></sourceVersion><sourceVersionID>B61O_a_ext</sourceVersionID><sourceObjectID>1</sourceObjectID><expression>|*******************************************************************************
|* txwip0500em15  B61O_a_ext
|* Pychem Tests
|* ict004
|* 2026-08-11 [10:53]
|*******************************************************************************
|* Script Type: 123
|*******************************************************************************

|*************************** declaration section *******************************
declaration:

	table	ttxwip020		|* QC Cost Summary
	table	ttxwip021		|* Reagents Header	
	table	ttxwip022		|* Reagents Details
	table	ttxwip030		|* Micro Test Header
	table	ttxwip025		|* Micro Test Details
	table	ttxwip026		|* QC Personnel
	table	ttxwip027		|* Micro Test Materials
	table	ttxwip028		|* Micro Test Reagents
	table	ttxwip030		|* Pychem Test Header
	table	ttxwip031		|* Pychem Test Details
	table	ttxwip033		|* Third Party Test Header
	table	ttxwip034		|* Third Party Test Details
	table	ttxwip035 		|* QC Items
	table	ttxwip036		|* QC Cost Master Data
	table	ttxwip037		|* QC Cost Details

	table	ttcibd001		|* Items
	table	ttcibd003		|* Conversion Factors
	table	ttdipu001		|* Item - Purchase
	table	ttcmcs012		|* Units by Unit Set
	
	extern domain tcitem		zoom.item
	extern domain tcmcs.str50	prid.desc

|****************************** program section ********************************

before.program:
	import("txwip037.item", zoom.item)
	
before.display.object:
	if trim$(zoom.item) &lt;&gt; "" then
		enable.commands("create_cost_details")
	endif
	
|****************************** field section **********************************	

field.prid.desc:
before.display:
	update_personnel_desc()

|****************************** function section *******************************

functions:

function extern void create_cost_details(){
	if trim$(zoom.item) &lt;&gt; "" then
		long ret
		
		do.selection(true, save_selected_tests) 
            	ret = refresh.parent(-1) 
		end()
	endif
}

function void save_selected_tests(){
	domain tcorno selected.code
	
	selected.code = trim$(txwip030.ptid)
	
	execute(15)
	
	select txwip037.code
	from txwip037
	where txwip037.code = :selected.code
		and txwip037.item = :zoom.item
	selectdo
		message(selected.code &amp; " is already in the list.")
	selectempty
		txwip037.item = zoom.item
		txwip037.code = selected.code
		txwip037.dcdt = utc.num()
		db.insert(ttxwip037, db.retry)
		commit.transaction()
	endselect
}

function void update_personnel_desc(){
	prid.desc = ""
	
	select txwip026.dscr
	from txwip026
	where txwip026.prid = :txwip030.prid
	selectdo
		prid.desc = txwip026.dscr
	endselect
}</expression><expressionLanguageType>Baan4C</expressionLanguageType><sourceType>1</sourceType><sourceDescription>Pychem Tests</sourceDescription><sourceName>txwip0500em15</sourceName></Source><documentation/><Attachment><type>relnotes</type><name>txwip0500em15</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em15</name></Attachment><additionalConstraints>2590</additionalConstraints><additionalInstructions/><keyword>||</keyword><application>EXTce01106</application></DR_Module><startInCompanyZero>false</startInCompanyZero><repSevLang>false</repSevLang><mainSession>true</mainSession><moduleType>1</moduleType><windowType>6</windowType><subType>5</subType><status>1</status><documentation/><objectLabel/><application>EXTce01106</application><sessionReferenceDescriptionReference>txwip0500em15</sessionReferenceDescriptionReference><sessionReferenceDescription>Pychem Tests</sessionReferenceDescription><sessionReference>txwip0500em15</sessionReference><UIScript>txwip0500em15</UIScript></DR_Controller>