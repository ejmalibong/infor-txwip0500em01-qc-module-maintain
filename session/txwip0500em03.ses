|* txwip0500em03  B61O_a_ext
|* Reagents
|* ict004
|* 2026-08-06 [11:12]
|*******************************************************************************
|* Script Type: 123
|*******************************************************************************

|*************************** declaration section *******************************
declaration:

	table	ttxwip020		|* QC Cost Summary
	table	ttxwip021		|* Reagents Header	
	table	ttxwip022		|* Reagents Details
	table	ttxwip024		|* Micro Test Header
	table	ttxwip025		|* Micro Test Details
	table	ttxwip026		|* QC Personnel
	table	ttxwip027		|* Micro Test Materials
	table	ttxwip028		|* Micro Test Reagents
	table	ttxwip030		|* Pychem Test Header
	table	ttxwip031		|* Pychem Test Details
	table	ttxwip033		|* Third Party Test Header
	table	ttxwip034		|* Third Party Test Details
	table	ttxwip035 		|* QC Items
	table	ttxwip036		|* QC Cost Master Data
	table	ttxwip037		|* QC Cost Details
	table	ttxwip038		|* Inline &amp; Documentation Costs
	table	ttxwip039		|* Micro Test Materials Reference

	table	ttcibd001		|* Items
	table	ttcibd003		|* Conversion Factors
	table	ttccom100		|* Business Partners
	table	ttcmcs003		|* Warehouses
	table	ttcmcs012		|* Units by Unit Set
	table	ttdipu001		|* Item - Purchase
	table	ttisfc001		|* Production Orders
	table	twhltc100		|* Lots
	table	twhltc101		|* Lot Cost Details
	table	twhltc105		|* Lots by Warehouse
	
	extern domain tcdsca		cwar.desc
	extern domain tccwar		cwar.dtl
	extern long			current.mtid.dtl

|****************************** program section ********************************

| From Micro Test Reagents txwip0500em12
before.program:
	import("current.mtid", current.mtid.dtl)
	import("cwar", cwar.dtl)
	
	if current.mtid.dtl &lt;&gt; 0 then
		query.extend.where("txwip021.cwar = '" &amp; str$(cwar.dtl) &amp; "'")
	endif
	
after.form.read:
	if current.mtid.dtl = 0 then 
		remove.form.commands("get_reagents")
		enable.commands(add.set)
		enable.commands(mark.delete)
	else
		disable.commands(add.set)
		disable.commands(mark.delete)
		disable.commands(update.db)
	endif
	
|****************************** group section **********************************


|****************************** field section **********************************

field.cwar.desc:
before.display:
	select tcmcs003.dsca
	from tcmcs003
	where tcmcs003.cwar = :txwip021.cwar
	as set with 1 rows
	selectdo
		cwar.desc = tcmcs003.dsca
	endselect
	
|****************************** function section *******************************

functions:

function extern get_reagents(){
	long ret
	do.selection(true, save_reagent)
	ret = refresh.parent(-1)
	end()
}

function save_reagent(){
	select txwip028.rgnt
	from txwip028
	where txwip028.mtid = :current.mtid.dtl
		and txwip028.rgnt = :txwip021.rgnt
	selectdo
		message(str$(trim$(txwip028.rgnt)) &amp; " is already in the list.")
	selectempty
		txwip028.mtid = current.mtid.dtl
		txwip028.rgnt = txwip021.rgnt
		txwip028.mult = 1
		db.insert(ttxwip028, db.retry)
		commit.transaction()
	endselect
}</expression><expressionLanguageType>Baan4C</expressionLanguageType><sourceType>1</sourceType><sourceDescription>Reagents</sourceDescription><sourceName>txwip0500em03</sourceName></Source><documentation/><Attachment><type>relnotes</type><name>txwip0500em03</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em03</name></Attachment><additionalConstraints>2590</additionalConstraints><additionalInstructions/><keyword>||</keyword><application>EXTce01106</application></DR_Module><startInCompanyZero>false</startInCompanyZero><repSevLang>false</repSevLang><mainSession>true</mainSession><moduleType>1</moduleType><windowType>6</windowType><subType>5</subType><status>1</status><documentation/><Attachment><type>relnotes</type><name>txwip0500em03</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em03</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em03dcwar.desc</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em03dcwar.desc</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em03dtxwip021.aq</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em03dtxwip021.aq</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em03dtxwip021.cs</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em03dtxwip021.cs</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em03dtxwip021.cs</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em03dtxwip021.cs</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em03dtxwip021.cw</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em03dtxwip021.cw</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em03dtxwip021.dc</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em03dtxwip021.dc</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em03dtxwip021.dm</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em03dtxwip021.dm</nam