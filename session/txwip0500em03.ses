ialHidden>false</initialHidden><showOnMenu>true</showOnMenu><showAsButton>false</showAsButton><separator>false</separator><shortcut>1</shortcut><addEllipsesToLabel>false</addEllipsesToLabel><groupFieldNr>0</groupFieldNr><parent>0</parent><activationName>get_reagents</activationName><activationType>5</activationType><defaultcommand>false</defaultcommand><sequence>1</sequence><position>1</position><type>1</type><shortDescription/><name>get_reagents</name></FormCommand><FormCommand><descriptionReference>txaddmicrorestest</descriptionReference><description>Add Micro Retest</description><suppressDialogAllowed>false</suppressDialogAllowed><defaultSpecialCommand>false</defaultSpecialCommand><category>5</category><kindOfSession>9</kindOfSession><startModeSession>9</startModeSession><refreshParent>false</refreshParent><saveBeforeExecution>false</saveBeforeExecution><multipleExecution>false</multipleExecution><questionAnswer>0</questionAnswer><question><name/></question><commandAvailability>1</commandAvailability><authorizationGroup>9</authorizationGroup><initiallyHidden>false</initiallyHidden><initialHidden>false</initialHidden><showOnMenu>true</showOnMenu><showAsButton>false</showAsButton><separator>false</separator><shortcut>1</shortcut><addEllipsesToLabel>false</addEllipsesToLabel><groupFieldNr>0</groupFieldNr><parent>0</parent><activationName>update_reagent_costs</activationName><activationType>5</activationType><defaultcommand>false</defaultcommand><sequence>2</sequence><position>2</position><type>1</type><shortDescription>Add Micro Retest</shortDescription><name>update_reagent_costs</name></FormCommand><description>Reagents</description><name>txwip0500em03d</name><horizontal>true</horizontal><custProhibited>false</custProhibited><additionalConstraints>1</additionalConstraints><documentation/><application>EXTce01107</application></Form><DR_Module><description>Reagents</description><versionID>B61O_a_ext</versionID><type>library</type><name>txwip0500em03</name><Version><ObjectID/><classID/><checkInLabel/><documentation/><isExpired>no</isExpired><isCheckedOutParallel>no</isCheckedOutParallel><isCheckedOut>no</isCheckedOut><modificationDateTime>2026-10-16T03:12:12Z</modificationDateTime><modifiedBy>ict004</modifiedBy><creationDateTime>2026-08-06T03:12:40Z</creationDateTime><createdBy>ict004</createdBy></Version><Source><sourceVersion><ObjectID/><classID/><checkInLabel/><documentation/><isExpired>no</isExpired><isCheckedOutParallel>no</isCheckedOutParallel><isCheckedOut>no</isCheckedOut><modificationDateTime>2026-10-16T03:12:12Z</modificationDateTime><modifiedBy>ict004</modifiedBy><creationDateTime>2026-08-06T03:12:40Z</creationDateTime><createdBy>ict004</createdBy></sourceVersion><sourceVersionID>B61O_a_ext</sourceVersionID><sourceObjectID>1</sourceObjectID><expression>|*******************************************************************************
|* txwip0500em03  B61O_a_ext
|* Reagents
|* ict004
|* 2026-08-06 [11:12]
|*******************************************************************************
|* Script Type: 123
|*******************************************************************************

|*************************** declaration section *******************************
declaration:

	table	ttxwip020		|* QC Costs
	table	ttxwip021		|* Reagents	
	table	ttxwip022		|* Reagents Details
	table	ttxwip024		|* Micro Tests
	table	ttxwip025		|* Micro Test Details
	table	ttxwip026		|* QC Personnels
	table	ttxwip027		|* Micro Test Materials
	table	ttxwip028		|* Micro Test Reagents
	table	ttxwip030		|* Pychem Tests
	table	ttxwip031		|* Pychem Test Details
	table	ttxwip033		|* Third Party Tests
	table	ttxwip034		|* Third Party Test Details
	table	ttxwip035 		|* QC Items
	table	ttxwip036		|* Item Testing Costs
	table	ttxwip037		|* Item Testing Cost Details
	table	ttxwip038		|* Inline &amp; Documentation Costs
	table	ttxwip039		|* Micro Test Materials Reference
	table	ttxwip040		|* QC Cost Simulations
	table	ttxwip041		|* Micro Retests
	table	ttxwip042		|* Micro Retest Details
	table	ttxwip043		|* Micro Retest Materials
	table	ttxwip044		|* Micro Retest Reagents
	table	ttxwip045		|* Pychem Retests
	table	ttxwip046		|* Pychem Retest Details
	table	ttxwip047		|* QC Cost Retest
	table	ttxwip048		|* QC Cost Simulation Retests	
	
	table	ttcibd001		|* Items
	table	ttcibd003		|* Conversion Factors
	table	ttdipu001		|* Item - Purchase
	table	ttcmcs003		|* Warehouses
	table	ttcmcs012		|* Units by Unit Set
	table	twhltc101		|* Lot Cost Details
	table	ttccom100		|* Business Partners
	table	ttisfc001		|* Production Orders
	table	tticpr007		|* Items - Costing
	table	twhinr140		|* Inventory
	
	extern domain tcdsca		cwar.desc
	extern domain tccwar		zoom.cwar
	extern long			current.mtid, current.mtid.rt

|****************************** program section ********************************

| From Micro Test Reagents txwip0500em12
before.program:
	import("current.mtid", current.mtid)
	import("current.mtid.rt", current.mtid.rt)
	import("zoom.cwar", zoom.cwar)
	
	if trim$(zoom.cwar) &lt;&gt; "" then
		query.extend.where("txwip021.cwar = '" &amp; trim$(zoom.cwar) &amp; "'")
	endif
	
zoom.from.all:
on.entry:
	standard.commands.off(add.set, mark.delete, update.db, end.program)
	
after.form.read:
	if current.mtid = 0 and current.mtid.rt = 0 then
		remove.form.commands("get_reagents")
	endif
	
main.table.io:
before.write:
	if txwip021.dcdt = 0 then
		txwip021.dcdt = utc.num()
	endif
	
before.rewrite:
	txwip021.dmdt = utc.num()

|****************************** field section **********************************

field.cwar.desc:
before.display:
	select tcmcs003.dsca
	from tcmcs003
	where tcmcs003.cwar = :txwip021.cwar
	as set with 1 rows
	selectdo
		cwar.desc = tcmcs003.dsca
	endselect
	
|****************************** function section *******************************

functions:

function extern get_reagents(){
	long ret
	
	if current.mtid.rt = 0 then
		do.selection(true, save_reagent)
	else
		do.selection(true, save_reagent_rt)
	endif
	
	ret = refresh.parent(-1)
	end()
}

function save_reagent(){
	select txwip028.rgnt
	from txwip028
	where txwip028.mtid = :current.mtid
		and txwip028.rgnt = :txwip021.rgnt
	selectdo
		message(str$(trim$(txwip028.rgnt)) &amp; " is already in the list.")
	selectempty
		txwip028.mtid = current.mtid
		txwip028.rgnt = txwip021.rgnt
		txwip028.mult = 1
		txwip028.csst = txwip021.cssm
		db.insert(ttxwip028, db.retry)
		commit.transaction()
	endselect
}

function save_reagent_rt(){
	select txwip044.rgnt
	from txwip044
	where txwip044.mtid = :current.mtid.rt
		and txwip044.rgnt = :txwip021.rgnt
	selectdo
		message(str$(trim$(txwip028.rgnt)) &amp; " is already in the list.")
	selectempty
		txwip044.mtid = current.mtid.rt
		txwip044.rgnt = txwip021.rgnt
		txwip044.mult = 1
		txwip044.csst = txwip021.cssm
		db.insert(ttxwip044, db.retry)
		commit.transaction()
	endselect
}

| Update Reagent Details
| Temporarily placed here to run intentionally the QC Cost Update for testing

function extern update_reagent_costs(){
	domain tcqiv1 rgst.cost, slst.cost
	
	select txwip021.rgnt, txwip021.cwar
	from txwip021
	where txwip021.rgnt IN ('RGN000019', 'RGN000020')
	selectdo
		rgst.cost = 0
		slst.cost = 0
	
		select txwip022.*
		from txwip022 for update
		where txwip022.rgnt = :txwip021.rgnt
		selectdo
			txwip022.rgst = compute_param_cost(txwip021.cwar, txwip022.rgtp, txwip022.item, txwip022.rvol, txwip022.rgni)
			txwip022.slst = compute_param_cost(txwip021.cwar, txwip022.sltp, txwip022.slvn, txwip022.svol, txwip022.slni)
			rgst.cost = rgst.cost + txwip022.rgst
			slst.cost = slst.cost + txwip022.slst
			db.update(ttxwip022, db.retry)
		endselect
		
		txwip021.ttst = rgst.cost + slst.cost
		
		if txwip021.aqsm = 0 then
			txwip021.csst = 0
			txwip021.cssm = 0
		else
			txwip021.csst = txwip021.ttst / txwip021.aqsm
			txwip021.cssm = txwip021.csst * txwip021.mult
		endif
		
		db.update(ttxwip021, db.retry)
		commit.transaction()
	endselect
}

function domain tcqiv1 compute_param_cost(domain tccwar cwar, domain txmat.types type, domain tcmcs.str50 param, domain tiqcp1 vol, domain tccuni unit){
	domain tcqiv1 total, cost.per.testing
	domain tccopr item.lot.price
	domain tcconv conversion.value
	domain tcitem format.item
	
	total = 0
	
	on case etol(type)
		case 1:
			item.lot.price = 0
			conversion.value = 0
			cost.per.testing = 0
			
			format.item = "         " &amp; trim$(param)
			
			| Workaround to items that unable to have conversion
			| factors with an error message:
			| Change the value of the Unit field.
			| Reason: Define conversion factor on general level.
			
			| Add different computation if parameter is FG
			| Usually occur on Pychem tests
			select tcibd001.item
			from tcibd001
			where tcibd001.item = :format.item
				and tcibd001.citg IN ("FG", "SFG", "RM/FG")
			selectdo
				item.lot.price = get_item_standard_cost(format.item)
				conversion.value = 1000
				cost.per.testing = item.lot.price / conversion.value
				total = cost.per.testing * vol
			selectempty
				conversion.value = get_conversion_value(format.item, unit)
				item.lot.price = get_item_lot_price(format.item, cwar)
				
				if conversion.value = 0 then
					cost.per.testing = 0
					total = 0
				else
					cost.per.testing = item.lot.price / conversion.value
					total = cost.per.testing * vol
				endif	
			endselect
			break
		case 2:
			format.item = trim$(param)
			
			select txwip021.csst
			from txwip021
			where txwip021.rgnt = :format.item
			selectdo
				total = vol * txwip021.csst
			selectempty
				total = 0
			endselect
			break
		case 3:
			item.lot.price = 0
			conversion.value = 0
			cost.per.testing = 0
			
			format.item = trim$(param)
			
			select txwip035.prip, txwip035.conv
			from txwip035
			where txwip035.qitm = :format.item
			selectdo
				item.lot.price = txwip035.prip
				conversion.value = txwip035.conv
			endselect
			
			if conversion.value = 0 then
				cost.per.testing = 0
				total = 0
			else
				cost.per.testing = item.lot.price / conversion.value
				total = cost.per.testing * vol
			endif
			break
		default:
			total = 0
	endcase
	
	return(total)
}

function domain tccopr get_item_standard_cost(domain tcitem item){
	domain tccopr cost
	cost = 0
	
	select ticpr007.ecpr
	from ticpr007
	where ticpr007.item = :item
	selectdo
		cost = ticpr007.ecpr(1)
	endselect
	
	return(cost)
}

function domain tcconv get_conversion_value(domain tcitem item, domain tccuni unit){
	domain tcconv value
	domain tcitem format.item
	
	value = 0
	format.item = "         " &amp; trim$(item)
	
	select tcibd003.conv
	from tcibd003
	where tcibd003.item = :format.item
		and tcibd003.unit = :unit
	as set with 1 rows
	selectdo
		value = tcibd003.conv
	selectempty
		value = 0
	endselect
	
	return(value)
}

function domain tccopr get_item_lot_price(domain tcitem item, domain tccwar cwar){
	domain tcclot lot.number
	domain tccopr item.lot.price
	domain tcitem format.item
	
	item.lot.price = 0
	lot.number = ""
	format.item = "         " &amp; trim$(item)
	
	| Get first valid lot (FIFO)
	select whinr140.clot, whinr140.idat
	from whinr140
	where whinr140.item = :format.item
		and whinr140.cwar = :cwar		| Warehouse
		and whinr140.loca = "110S1QCD01"	| QC Calauan
		and whinr140.idat &lt;&gt; 0			| Inventory Date
		and (whinr140.qhnd - whinr140.qblk) &gt; 0 | On-hand - Blocked
	order by whinr140.idat
	as set with 1 rows
	selectdo
		lot.number = whinr140.clot
	endselect
	
	select sum(whltc101.pric(1)):item.lot.price
	from whltc101
	where whltc101.item = :format.item
		and whltc101.clot = :lot.number		| Lot No
		and whltc101.cpcp = "MC0002"	  	| Material Cost			
	as set with 1 rows
	selectdo
	endselect

	return(item.lot.price)
