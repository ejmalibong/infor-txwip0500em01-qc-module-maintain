fiedBy><creationDateTime>2026-08-06T03:12:40Z</creationDateTime><createdBy>ict004</createdBy></Version><Source><sourceVersion><ObjectID/><classID/><checkInLabel/><documentation/><isExpired>no</isExpired><isCheckedOutParallel>no</isCheckedOutParallel><isCheckedOut>no</isCheckedOut><modificationDateTime>2026-10-18T19:30:39Z</modificationDateTime><modifiedBy>ict004</modifiedBy><creationDateTime>2026-08-06T03:12:40Z</creationDateTime><createdBy>ict004</createdBy></sourceVersion><sourceVersionID>B61O_a_ext</sourceVersionID><sourceObjectID>1</sourceObjectID><expression>|*******************************************************************************
|* txwip0500em03  B61O_a_ext
|* Reagents
|* ict004
|* 2026-08-06 [11:12]
|*******************************************************************************
|* Script Type: 123
|*******************************************************************************

|*************************** declaration section *******************************
declaration:

	table	ttxwip020		|* QC Costs
	table	ttxwip021		|* Reagents	
	table	ttxwip022		|* Reagents Details
	table	ttxwip024		|* Micro Tests
	table	ttxwip025		|* Micro Test Details
	table	ttxwip026		|* QC Personnels
	table	ttxwip027		|* Micro Test Materials
	table	ttxwip028		|* Micro Test Reagents
	table	ttxwip030		|* Pychem Tests
	table	ttxwip031		|* Pychem Test Details
	table	ttxwip033		|* Third Party Tests
	table	ttxwip034		|* Third Party Test Details
	table	ttxwip035 		|* QC Items
	table	ttxwip036		|* Item Testing Costs
	table	ttxwip037		|* Item Testing Cost Details
	table	ttxwip038		|* Inline &amp; Documentation Costs
	table	ttxwip039		|* Micro Test Materials Reference
	table	ttxwip040		|* QC Cost Simulations
	table	ttxwip041		|* Micro Retests
	table	ttxwip042		|* Micro Retest Details
	table	ttxwip043		|* Micro Retest Materials
	table	ttxwip044		|* Micro Retest Reagents
	table	ttxwip045		|* Pychem Retests
	table	ttxwip046		|* Pychem Retest Details
	table	ttxwip047		|* QC Cost Retest
	table	ttxwip048		|* QC Cost Simulation Retests	
	
	table	ttcibd001		|* Items
	table	ttcibd003		|* Conversion Factors
	table	ttdipu001		|* Item - Purchase
	table	ttcmcs003		|* Warehouses
	table	ttcmcs012		|* Units by Unit Set
	table	twhltc101		|* Lot Cost Details
	table	ttccom100		|* Business Partners
	table	ttisfc001		|* Production Orders
	table	tticpr007		|* Items - Costing
	table	twhinr140		|* Inventory
	
	extern domain tcdsca		cwar.desc
	extern domain tccwar		zoom.cwar
	extern long			current.mtid, current.mtid.rt

|****************************** program section ********************************

| From Micro Test Reagents txwip0500em12
before.program:
	import("current.mtid", current.mtid)
	import("current.mtid.rt", current.mtid.rt)
	import("zoom.cwar", zoom.cwar)
	
	if trim$(zoom.cwar) &lt;&gt; "" then
		query.extend.where("txwip021.cwar = '" &amp; trim$(zoom.cwar) &amp; "'")
	endif
	
zoom.from.all:
on.entry:
	standard.commands.off(add.set, mark.delete, update.db, end.program)
	
after.form.read:
	if current.mtid = 0 and current.mtid.rt = 0 then
		remove.form.commands("get_reagents")
	endif
	
main.table.io:
before.write:
	if txwip021.dcdt = 0 then
		txwip021.dcdt = utc.num()
	endif
	
before.rewrite:
	txwip021.dmdt = utc.num()

|****************************** field section **********************************

field.cwar.desc:
before.display:
	select tcmcs003.dsca
	from tcmcs003
	where tcmcs003.cwar = :txwip021.cwar
	as set with 1 rows
	selectdo
		cwar.desc = tcmcs003.dsca
	endselect
	
|****************************** function section *******************************

functions:

function extern get_reagents(){
	long ret
	
	if current.mtid.rt = 0 then
		do.selection(true, save_reagent)
	else
		do.selection(true, save_reagent_rt)
	endif
	
	ret = refresh.parent(-1)
	end()
}

function save_reagent(){
	select txwip028.rgnt
	from txwip028
	where txwip028.mtid = :current.mtid
		and txwip028.rgnt = :txwip021.rgnt
	selectdo
		message(str$(trim$(txwip028.rgnt)) &amp; " is already in the list.")
	selectempty
		txwip028.mtid = current.mtid
		txwip028.rgnt = txwip021.rgnt
		txwip028.mult = 1
		txwip028.csst = txwip021.cssm
		db.insert(ttxwip028, db.retry)
		commit.transaction()
	endselect
}

function save_reagent_rt(){
	select txwip044.rgnt
	from txwip044
	where txwip044.mtid = :current.mtid.rt
		and txwip044.rgnt = :txwip021.rgnt
	selectdo
		message(str$(trim$(txwip028.rgnt)) &amp; " is already in the list.")
	selectempty
		txwip044.mtid = current.mtid.rt
		txwip044.rgnt = txwip021.rgnt
		txwip044.mult = 1
		txwip044.csst = txwip021.cssm
		db.insert(ttxwip044, db.retry)
		commit.transaction()
	endselect
}</expression><expressionLanguageType>Baan4C</expressionLanguageType><sourceType>1</sourceType><sourceDescription>Reagents</sourceDescription><sourceName>txwip0500em03</sourceName></Source><documentation/><Attachment><type>relnotes</type><name>txwip0500em03</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em03</name></Attachment><additionalConstraints>2590</additionalConstraints><additionalInstructions/><keyword>||</keyword><application>EXTce01107</application></DR_Module><startInCompanyZero>false</startInCompanyZero><repSevLang>false</repSevLang><mainSession>true</mainSession><moduleType>1</moduleType><windowType>6</windowType><subType>5</subType><status>1</status><documentation/><objectLabel/><application>EXTce01107</application><sessionReferenceDescriptionReference>txwip0500em03</sessionReferenceDescriptionReference><sessionReferenceDescription>Reagents</sessionReferenceDescription><sessionReference>txwip0500em03</sessionReference><UIScript>txwip0500em03</UIScript></DR_Controller>