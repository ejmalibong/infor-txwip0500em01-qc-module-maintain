heckedOutParallel><isCheckedOut>no</isCheckedOut><modificationDateTime>2026-10-14T00:51:13Z</modificationDateTime><modifiedBy>ict004</modifiedBy><creationDateTime>2026-08-11T14:36:07Z</creationDateTime><createdBy>ict004</createdBy></sourceVersion><sourceVersionID>B61O_a_ext</sourceVersionID><sourceObjectID>1</sourceObjectID><expression>|*******************************************************************************
|* txwip0500em07  B61O_a_ext
|* Item Testing Cost Details
|* ict004
|* 2026-08-11 [10:36]
|*******************************************************************************
|* Script Type: 123
|*******************************************************************************

|*************************** declaration section *******************************
declaration:

	table	ttxwip020		|* QC Costs
	table	ttxwip021		|* Reagents	
	table	ttxwip022		|* Reagents Details
	table	ttxwip024		|* Micro Tests
	table	ttxwip025		|* Micro Test Details
	table	ttxwip026		|* QC Personnels
	table	ttxwip027		|* Micro Test Materials
	table	ttxwip028		|* Micro Test Reagents
	table	ttxwip030		|* Pychem Tests
	table	ttxwip031		|* Pychem Test Details
	table	ttxwip033		|* Third Party Tests
	table	ttxwip034		|* Third Party Test Details
	table	ttxwip035 		|* QC Items
	table	ttxwip036		|* Item Testing Costs
	table	ttxwip037		|* Item Testing Cost Details
	table	ttxwip038		|* Inline &amp; Documentation Costs
	table	ttxwip039		|* Micro Test Materials Reference
	table	ttxwip040		|* QC Cost Simulations
	table	ttxwip041		|* Micro Retests
	table	ttxwip042		|* Micro Retest Details
	table	ttxwip043		|* Micro Retest Materials
	table	ttxwip044		|* Micro Retest Reagents
	table	ttxwip045		|* Pychem Retests
	table	ttxwip046		|* Pychem Retest Details
	table	ttxwip047		|* QC Cost Retest
	table	ttxwip048		|* QC Cost Simulation Retests	
	
	table	ttcibd001		|* Items
	table	ttcibd003		|* Conversion Factors
	table	ttdipu001		|* Item - Purchase
	table	ttcmcs003		|* Warehouses
	table	ttcmcs012		|* Units by Unit Set
	table	twhltc100		|* Lots
	table	twhltc101		|* Lot Cost Details
	table	twhltc105		|* Lots by Warehouse
	table	ttccom100		|* Business Partners
	table	ttisfc001		|* Production Orders
	table	tticpr007		|* Items - Costing
	
	extern domain tcmcs.str132	test.desc
	extern domain tcmcs.str20	test.freq
	extern domain tcqiv1		test.cost
	extern domain tccwar		cwar

|****************************** program section ********************************

	
|****************************** field section **********************************

field.test.desc:
before.display:
	update_test_desc(txwip037.code)
	
field.test.freq:
before.display:
	update_test_freq(txwip037.code)
	
field.test.cost:
before.display:
	update_test_cost(txwip037.code)
	
|****************************** function section *******************************

functions:

function extern load_micro_tests(){
	start.session(MODAL_OVERVIEW, "txwip0500em08",  "txwip0500em07", "")
}

function extern load_pychem_tests(){
	start.session(MODAL_OVERVIEW, "txwip0500em15",  "txwip0500em07", "")
}

function extern load_third_party_tests(){
	start.session(MODAL_OVERVIEW, "txwip0500em18",  "txwip0500em07", "")
}

function update_test_desc(domain tcorno test.code){
	test.desc = get_test_desc(test.code)
}

function domain tcmcs.str100 get_test_desc(domain tcorno test.code){
	domain tcmcs.str100 test.desc
	
	test.desc = ""
	
	if str_pos(toupper$(trim$(test.code)), "M") &gt; 0 then
		select txwip024.anly
		from txwip024
		where txwip024.anly = :test.code
		selectdo
			test.desc = txwip024.anly
		selectempty
			test.desc = ""
		endselect
	endif
	
	if str_pos(toupper$(trim$(test.code)), "P") &gt; 0 then
		select txwip030.dscr
		from txwip030
		where txwip030.ptid = :test.code
		selectdo
			test.desc = txwip030.dscr
		selectempty
			test.desc = ""
		endselect
	endif
	
	if str_pos(toupper$(trim$(test.code)), "T") &gt; 0 then
		select txwip033.dscr
		from txwip033
		where txwip033.tpid = :test.code
		selectdo
			test.desc = txwip033.dscr
		selectempty
			test.desc = ""
		endselect
	endif
	
	return(test.desc)
}

function update_test_cost(domain tcorno test.code){
	test.cost = get_test_cost(test.code)
}

function domain tcqiv1 get_test_cost(domain tcorno test.code){
	domain tcqiv1 cost
	
	cost = 0
	
	if str_pos(toupper$(trim$(test.code)), "M") &gt; 0 then
		select txwip024.pyst
		from txwip024
		where txwip024.anly = :test.code
		selectdo
			cost = txwip024.pyst
		selectempty
			cost = 0
		endselect
	endif
	
	if str_pos(toupper$(trim$(test.code)), "P") &gt; 0 then
		select txwip030.pyst
		from txwip030
		where txwip030.ptid = :test.code
		selectdo
			cost = txwip030.pyst
		selectempty
			cost = 0
		endselect
	endif
	
	if str_pos(toupper$(trim$(test.code)), "T") &gt; 0 then
		select txwip033.tpst
		from txwip033
		where txwip033.tpid = :test.code
		selectdo
			cost = txwip033.tpst
		selectempty
			cost = 0
		endselect
	endif
	
	return(cost)
}

function update_test_freq(domain tcorno test.code){
	test.freq = get_test_freq(test.code)
}

function domain tcmcs.str20 get_test_freq(domain tcorno test.code){
	domain tcmcs.str20 test.freq	
	
	test.freq = ""
	
	if str_pos(toupper$(trim$(test.code)), "M") &gt; 0 then
		select txwip024.freq
		from txwip024
		where txwip024.anly = :test.code
		selectdo
			test.freq = enum.descr$("txtest.freq", txwip024.freq)
		selectempty
			test.freq = ""
		endselect
	endif
	
	if str_pos(toupper$(trim$(test.code)), "P") &gt; 0 then
		test.freq = "Per Batch"
	endif
	
	if str_pos(toupper$(trim$(test.code)), "T") &gt; 0 then
		select txwip033.freq
		from txwip033
		where txwip033.tpid = :test.code
		selectdo
			test.freq = enum.descr$("txtest.freq", txwip033.freq)
		selectempty
			test.freq = ""
		endselect
	endif
	
	return(test.freq)
}

function extern load_test_reference(){
	do.selection(true, get_test_reference)
}

function get_test_reference(){
	if str_pos(toupper$(trim$(txwip037.code)), "M") &gt; 0 then
		start.session(MODAL_OVERVIEW, "txwip0500em09", "txwip0500em07", "")
	endif
	
	if str_pos(toupper$(trim$(txwip037.code)), "P") &gt; 0 then
		start.session(MODAL_OVERVIEW, "txwip0500em16", "txwip0500em07", "")
	endif
	
	if str_pos(toupper$(trim$(txwip037.code)), "T") &gt; 0 then
		start.session(MODAL_OVERVIEW, "txwip0500em19", "txwip0500em07", "")
	endif
