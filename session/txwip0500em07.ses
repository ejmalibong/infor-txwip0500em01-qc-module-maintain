|* txwip0500em07  B61O_a_ext
|* Item Testing Cost Details
|* ict004
|* 2026-08-11 [10:36]
|*******************************************************************************
|* Script Type: 123
|*******************************************************************************

|*************************** declaration section *******************************
declaration:

	table	ttxwip020		|* QC Cost Summary
	table	ttxwip021		|* Reagents Header	
	table	ttxwip022		|* Reagents Details
	table	ttxwip024		|* Micro Test Header
	table	ttxwip025		|* Micro Test Details
	table	ttxwip026		|* QC Personnel
	table	ttxwip027		|* Micro Test Materials
	table	ttxwip028		|* Micro Test Reagents
	table	ttxwip030		|* Pychem Test Header
	table	ttxwip031		|* Pychem Test Details
	table	ttxwip033		|* Third Party Test Header
	table	ttxwip034		|* Third Party Test Details
	table	ttxwip035 		|* QC Items
	table	ttxwip036		|* QC Cost Master Data
	table	ttxwip037		|* QC Cost Details

	table	ttcibd001		|* Items
	table	ttcibd003		|* Conversion Factors
	table	ttdipu001		|* Item - Purchase
	table	ttcmcs012		|* Units by Unit Set
	
	extern domain tcmcs.str50	test.desc
	extern domain tcmcs.str20	test.freq
	extern domain tcqiv1		test.cost
	extern domain tcorno		test.code

|****************************** program section ********************************

before.program:
	test.cost = 0
	test.freq = ""
	test.desc = ""

|****************************** field section **********************************

field.test.desc:
before.display:
	update_test_desc(txwip037.code)
	
field.test.freq:
before.display:
	update_test_freq(txwip037.code)

field.test.cost:
before.display:
	update_test_cost(txwip037.code)
	
|****************************** function section *******************************

functions:

function extern void load_micro_tests(){
	export(txwip037.item, "zoom.item")
	
	string total
	start.session(MODAL_OVERVIEW, "txwip0500em08",  "txwip0500em07", total)
}

function extern void load_pychem_tests(){
	export(txwip037.item, "zoom.item")
	
	string total
	start.session(MODAL_OVERVIEW, "txwip0500em15",  "txwip0500em07", total)
}

function extern void load_third_party_tests(){
	export(txwip037.item, "zoom.item")
	
	string total
	start.session(MODAL_OVERVIEW, "txwip0500em18",  "txwip0500em07", total)
}

function void update_test_desc(domain tcorno test.code){
	test.desc = get_test_desc(test.code)
}

function domain tcmcs.str100 get_test_desc(domain tcorno test.code){
	domain tcmcs.str100 test.desc
	
	test.desc = ""
	
	if str_pos(toupper$(trim$(test.code)), "M") &gt; 0 then
		select txwip024.anly
		from txwip024
		where txwip024.anly = :test.code
		selectdo
			test.desc = txwip024.anly
		selectempty
			test.desc = ""
		endselect
	endif
	
	if str_pos(toupper$(trim$(test.code)), "P") &gt; 0 then
		select txwip030.dscr
		from txwip030
		where txwip030.ptid = :test.code
		selectdo
			test.desc = txwip030.dscr
		selectempty
			test.desc = ""
		endselect
	endif
	
	if str_pos(toupper$(trim$(test.code)), "T") &gt; 0 then
		select txwip033.dscr
		from txwip033
		where txwip033.tpid = :test.code
		selectdo
			test.desc = txwip033.dscr
		selectempty
			test.desc = ""
		endselect
	endif
	
	return(test.desc)
}

function void update_test_freq(domain tcorno test.code){
	test.freq = get_test_freq(test.code)
}

function domain tcmcs.str20 get_test_freq(domain tcorno test.code){
	domain tcmcs.str20 test.freq	
	
	test.freq = ""
	
	if str_pos(toupper$(trim$(test.code)), "M") &gt; 0 then
		select txwip024.freq
		from txwip024
		where txwip024.anly = :test.code
		selectdo
			test.freq = enum.descr$("txtest.freq", txwip024.freq)
		selectempty
			test.freq = ""
		endselect
	endif
	
	if str_pos(toupper$(trim$(test.code)), "P") &gt; 0 then
		test.freq = "Per Batch"
	endif
	
	if str_pos(toupper$(trim$(test.code)), "T") &gt; 0 then
		select txwip033.freq
		from txwip033
		where txwip033.tpid = :test.code
		selectdo
			test.freq = enum.descr$("txtest.freq", txwip033.freq)
		selectempty
			test.freq = ""
		endselect
	endif
	
	return(test.freq)
}

function void update_test_cost(domain tcorno test.code){
	test.cost = get_test_cost(test.code)
}

function domain tcqiv1 get_test_cost(domain tcorno test.code){
	domain tcqiv1 t.cost
	
	t.cost = 0
	
	if str_pos(toupper$(trim$(test.code)), "M") &gt; 0 then
		select txwip024.pyst
		from txwip024
		where txwip024.anly = :test.code
		selectdo
			t.cost = txwip024.pyst
		selectempty
			t.cost = 0
		endselect
	endif
	
	if str_pos(toupper$(trim$(test.code)), "P") &gt; 0 then
		select txwip030.pyst
		from txwip030
		where txwip030.ptid = :test.code
		selectdo
			t.cost = txwip030.pyst
		selectempty
			t.cost = 0
		endselect
	endif
	
	if str_pos(toupper$(trim$(test.code)), "T") &gt; 0 then
		select txwip033.tpst
		from txwip033
		where txwip033.tpid = :test.code
		selectdo
			t.cost = txwip033.tpst
		selectempty
			t.cost = 0
		endselect
	endif
	
	return(t.cost)
}

function extern test_reference(){
	do.selection(true, get_test_reference)
}

function void get_test_reference(){
	if str_pos(toupper$(trim$(txwip037.code)), "M") &gt; 0 then
		export(txwip037.code, "test.code")
		start.session(MODELESS, "txwip0500em09", "txwip0500em07", "")
	endif
	
	if str_pos(toupper$(trim$(txwip037.code)), "P") &gt; 0 then
		export(txwip037.code, "test.code")
		start.session(MODELESS, "txwip0500em15", "txwip0500em07", "")
	endif
	
	if str_pos(toupper$(trim$(txwip037.code)), "T") &gt; 0 then
		export(txwip037.code, "test.code")
		start.session(MODELESS, "txwip0500em18", "txwip0500em07", "")
	endif
}</expression><expressionLanguageType>Baan4C</expressionLanguageType><sourceType>1</sourceType><sourceDescription>Micro Test Costs</sourceDescription><sourceName>txwip0500em07</sourceName></Source><documentation/><Attachment><type>relnotes</type><name>txwip0500em07</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em07</name></Attachment><additionalConstraints>2590</additionalConstraints><additionalInstructions/><keyword>||</keyword><application>EXTce01106</application></DR_Module><startInCompanyZero>false</startInCompanyZero><repSevLang>false</repSevLang><mainSession>true</mainSession><moduleType>1</moduleType><windowType>6</windowType><subType>1</subType><status>1</status><documentation/><objectLabel/><application>EXTce01106</application><sessionReferenceDescriptionReference>txwip0500em07</sessionReferenceDescriptionReference><sessionReferenceDescription>Item Testing Cost Details</sessionReferenceDescription><sessionReference>txwip0500em07</sessionReference><UIScript>txwip0500em07</UIScript></DR_Controller>