e</description><suppressDialogAllowed>false</suppressDialogAllowed><defaultSpecialCommand>true</defaultSpecialCommand><category>20</category><kindOfSession>9</kindOfSession><startModeSession>9</startModeSession><refreshParent>false</refreshParent><saveBeforeExecution>false</saveBeforeExecution><multipleExecution>false</multipleExecution><questionAnswer>0</questionAnswer><question><name/></question><commandAvailability>1</commandAvailability><authorizationGroup>9</authorizationGroup><initiallyHidden>false</initiallyHidden><initialHidden>false</initialHidden><showOnMenu>true</showOnMenu><showAsButton>false</showAsButton><separator>false</separator><shortcut>1</shortcut><addEllipsesToLabel>false</addEllipsesToLabel><groupFieldNr>0</groupFieldNr><parent>0</parent><activationName>compute_micro_test_cost</activationName><activationType>5</activationType><defaultcommand>false</defaultcommand><sequence>1</sequence><position>1</position><type>1</type><shortDescription>Save</shortDescription><name>compute_micro_test_cost</name></FormCommand><description>Micro Test Deails</description><name>txwip0500em09d</name><horizontal>true</horizontal><custProhibited>false</custProhibited><additionalConstraints>1</additionalConstraints><documentation/><application>EXTce01106</application></Form><DR_Module><description>Micro Test Deails</description><versionID>B61O_a_ext</versionID><type>library</type><name>txwip0500em09</name><Version><ObjectID/><classID/><checkInLabel/><documentation/><isExpired>no</isExpired><isCheckedOutParallel>no</isCheckedOutParallel><isCheckedOut>no</isCheckedOut><modificationDateTime>2026-10-01T13:19:43Z</modificationDateTime><modifiedBy>ict004</modifiedBy><creationDateTime>2026-08-11T14:53:53Z</creationDateTime><createdBy>ict004</createdBy></Version><Source><sourceVersion><ObjectID/><classID/><checkInLabel/><documentation/><isExpired>no</isExpired><isCheckedOutParallel>no</isCheckedOutParallel><isCheckedOut>no</isCheckedOut><modificationDateTime>2026-10-01T13:19:43Z</modificationDateTime><modifiedBy>ict004</modifiedBy><creationDateTime>2026-08-11T14:53:53Z</creationDateTime><createdBy>ict004</createdBy></sourceVersion><sourceVersionID>B61O_a_ext</sourceVersionID><sourceObjectID>1</sourceObjectID><expression>|*******************************************************************************
|* txwip0500em09  B61O_a_ext
|* Micro Test
|* ict004
|* 2026-08-11 [10:55]
|*******************************************************************************
|* Script Type: 123
|*******************************************************************************

|*************************** declaration section *******************************
declaration:

	table	ttxwip020		|* QC Cost Summary
	table	ttxwip021		|* Reagents Header	
	table	ttxwip022		|* Reagents Details
	table	ttxwip024		|* Micro Test Header
	table	ttxwip025		|* Micro Test Details
	table	ttxwip026		|* QC Personnel
	table	ttxwip027		|* Micro Test Materials
	table	ttxwip028		|* Micro Test Reagents
	table	ttxwip030		|* Pychem Test Header
	table	ttxwip031		|* Pychem Test Details
	table	ttxwip033		|* Third Party Test Header
	table	ttxwip034		|* Third Party Test Details
	table	ttxwip035 		|* QC Items
	table	ttxwip036		|* QC Cost Master Data
	table	ttxwip037		|* QC Cost Details
	table	ttxwip038		|* Inline &amp; Documentation Costs
	table	ttxwip039		|* Micro Test Materials Reference

	table	ttcibd001		|* Items
	table	ttcibd003		|* Conversion Factors
	table	ttdipu001		|* Item - Purchase
	table	ttcmcs012		|* Units by Unit Set
	table	twhltc100		|* Lots
	table	twhltc101		|* Lot Cost Details
	table	twhltc105		|* Lots by Warehouse
	table	ttccom100		|* Business Partners
	table	ttisfc001		|* Production Orders
	table	ttcmcs003		|* Warehouses
	
	extern domain tcorno		test.code
	extern domain tcdsca		cwar.desc
	extern domain tccwar		cwar

|****************************** program section ********************************	

zoom.from.all:
on.entry:
	import("txwip024.anly", test.code)

	if not isspace(test.code) then
		select txwip024.*
		from txwip024
		where txwip024.anly = :test.code
		as set with 1 rows
		selectdo
		endselect

		execute(find.data)
	endif
	
after.form.read:
	add.sync.fields("txwip0500em10", "txwip024.cwar", "cwar")

main.table.io:
before.write:
	if txwip024.dcdt = 0 then
		txwip024.dcdt = utc.num()
	endif

before.rewrite:
	txwip024.dmdt = utc.num()
	
|****************************** field section **********************************

field.txwip024.anly:
before.display:
	if trim$(txwip024.anly) = "" then
		enable.fields("txwip024.freq")
		txwip024.anly = set_micro_test_code(2)
		txwip024.cwar = "1CS001"
		txwip024.freq = ltoe(2)
	else
		disable.fields("txwip024.freq")
	endif

field.txwip024.freq:
when.field.changes:
	txwip024.anly = set_micro_test_code(etol(txwip024.freq))
	display("txwip024.anly")
	
	if txwip024.dcdt = 0 then
		enable.fields("txwip024.freq")
	else
		disable.fields("txwip024.freq")
	endif
	
field.txwip024.cwar:
before.display:
	update_cwar.desc(txwip024.cwar)
	
selection.filter:
	query.extend.where.in.zoom("tcmcs003.cwar IN (""1CS001"",""1PS001"")")
	
when.field.changes:
	update_cwar.desc(txwip024.cwar)
	
after.zoom:
	update_cwar.desc(txwip024.cwar)
	
field.cwar.desc:
before.display:
	update_cwar.desc(txwip024.cwar)

|****************************** function section *******************************

functions:

function domain tcorno set_micro_test_code(domain tcmcs.long freq){
	| Frequency
	| 1 - Annual
	| 2 - Per Batch
	
	long cnt, next.id
	domain tcmcs.str10 next.code, last.code
	
	if freq = 1 then
		cnt = 0
		last.code = ""
		next.code = ""
	
		select count(txwip024.anly):cnt
		from txwip024
		where txwip024.anly &lt;&gt; ""
			and txwip024.anly like "MA.*"
		selectdo
		endselect
		
		if cnt &gt; 0 then
			select txwip024.anly
			from txwip024
			order by txwip024.anly desc
			as set with 1 rows
			selectdo
				last.code = txwip024.anly(len(trim$(txwip024.anly))-1;3)
				next.id = val(last.code) + 1
				next.code = "MA" &amp; sprintf$("%03d", trim$(str$(next.id)))
			endselect
		else
			next.code = "MA001"
		endif
	else | 2
		cnt = 0
		last.code = ""
		next.code = ""
		
		select count(txwip024.anly):cnt
		from txwip024
		where txwip024.anly &lt;&gt; ""
			and txwip024.anly like "M.*"
			and not exists (
				select sub.anly
				from txwip024 sub
				where sub.anly &lt;&gt; ""
					and sub.anly like "MA.*"
					and sub.anly = txwip024.anly)
		selectdo
		endselect
		
		if cnt &gt; 0 then
			select txwip024.anly
			from txwip024
			where txwip024.anly &lt;&gt; ""
				and txwip024.anly like "M.*"
				and not exists (
					select sub.anly
					from txwip024 sub
					where sub.anly &lt;&gt; ""
						and sub.anly like "MA.*"
						and sub.anly = txwip024.anly)
			order by txwip024.anly desc
			as set with 1 rows
			selectdo
				last.code = txwip024.anly(len(trim$(txwip024.anly))-1;3)
				next.id = val(last.code) + 1
				next.code = "M" &amp; sprintf$("%03d", trim$(str$(next.id)))
			endselect
		else
			next.code = "M001"
		endif
	endif
	
	return(next.code)
}

function extern void compute_micro_test_cost(){
	domain tcqiv1 total.labor.cost, total.material.cost, total.test.cost
	long ret
	
	execute(15)

	total.labor.cost = 0
	total.material.cost = 0
	total.test.cost = 0

	select sum(txwip025.lbst):total.labor.cost,
		sum(txwip025.mcst):total.material.cost
	from txwip025
	where txwip025.anly = :txwip024.anly
	selectdo
	endselect

	total.test.cost = total.labor.cost + total.material.cost
	
	select txwip024.*
	from txwip024 for update
	where txwip024.anly = :txwip024.anly
	selectdo
		txwip024.tlst = total.labor.cost
		txwip024.tmst = total.material.cost
		txwip024.pyst = total.test.cost
		
		if db.update(ttxwip024, db.retry) &lt;&gt; 0 then
			message("Error " &amp; str$(e) &amp; " occurred while updating the record.")
			abort.transaction()
		endif
	endselect
	
	commit.transaction()
	execute(find.data)
	ret = refresh.parent(-1)
	synchronize.satellite("txwip0500em05")
}

function update_cwar.desc(domain tccwar cwar){
	domain tcdsca desc
	desc = ""
	
	select tcmcs003.dsca
	from tcmcs003
	where tcmcs003.cwar = :cwar
	as set with 1 rows
	selectdo
		desc = tcmcs003.dsca 
	endselect
	
	cwar.desc = desc
}</expression><expressionLanguageType>Baan4C</expressionLanguageType><sourceType>1</sourceType><sourceDescription>Micro Test Deails</sourceDescription><sourceName>txwip0500em09</sourceName></Source><documentation/><Attachment><type>relnotes</type><name>txwip0500em09</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em09</name></Attachment><additionalConstraints>2590</additionalConstraints><additionalInstructions/><keyword>||</keyword><application>EXTce01106</application></DR_Module><startInCompanyZero>false</startInCompanyZero><repSevLang>false</repSevLang><mainSession>true</mainSession><moduleType>1</moduleType><windowType>15</windowType><subType>1</subType><status>1</status><documentation/><Attachment><type>relnotes</type><name>txwip0500em09</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em09</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em09dcwar.desc</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em09dcwar.desc</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em09dtxwip024.an</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em09dtxwip024.an</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em09dtxwip024.cw</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em09dtxwip024.cw</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em09dtxwip024.dc</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em09dtxwip024.dc</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em09dtxwip024.dm</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em09dtxwip024.dm</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em09dtxwip024.fr</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em09dtxwip024.fr</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em09dtxwip024.py</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em09dtxwip024.py</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em09dtxwip024.tl</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em09dtxwip024.tl</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em09dtxwip024.tm</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em09dtxwip024.tm</name></Attachment><objectLabel/><application>EXTce01106</application><sessionReferenceDescriptionReference>txwip0500em09</sessionReferenceDescriptionReference><sessionReferenceDescription>Micro Test</sessionReferenceDescription><sessionReference>txwip0500em09</sessionReference><UIScript>txwip0500em09</UIScript></DR_Controller>