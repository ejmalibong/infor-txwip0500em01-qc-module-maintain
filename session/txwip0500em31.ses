edBy>ict004</modifiedBy><creationDateTime>2026-10-06T06:29:58Z</creationDateTime><createdBy>ict004</createdBy></Version><Source><sourceVersion><ObjectID/><classID/><checkInLabel/><documentation/><isExpired>no</isExpired><isCheckedOutParallel>no</isCheckedOutParallel><isCheckedOut>no</isCheckedOut><modificationDateTime>2026-10-20T06:04:26Z</modificationDateTime><modifiedBy>ict004</modifiedBy><creationDateTime>2026-10-06T06:29:58Z</creationDateTime><createdBy>ict004</createdBy></sourceVersion><sourceVersionID>B61O_a_ext</sourceVersionID><sourceObjectID>1</sourceObjectID><expression>|*******************************************************************************
|* txwip0500em31  B61O_a_ext
|* Pychem Retests
|* ict004
|* 2026-08-11 [10:53]
|*******************************************************************************
|* Script Type: 123
|*******************************************************************************

|*************************** declaration section *******************************
declaration:

	table	ttxwip020		|* QC Costs
	table	ttxwip021		|* Reagents	
	table	ttxwip022		|* Reagents Details
	table	ttxwip024		|* Micro Tests
	table	ttxwip025		|* Micro Test Details
	table	ttxwip026		|* QC Personnels
	table	ttxwip027		|* Micro Test Materials
	table	ttxwip028		|* Micro Test Reagents
	table	ttxwip030		|* Pychem Tests
	table	ttxwip031		|* Pychem Test Details
	table	ttxwip033		|* Third Party Tests
	table	ttxwip034		|* Third Party Test Details
	table	ttxwip035 		|* QC Items
	table	ttxwip036		|* Item Testing Costs
	table	ttxwip037		|* Item Testing Cost Details
	table	ttxwip038		|* Inline &amp; Documentation Costs
	table	ttxwip039		|* Micro Test Materials Reference
	table	ttxwip040		|* QC Cost Simulations
	table	ttxwip041		|* Micro Retests
	table	ttxwip042		|* Micro Retest Details
	table	ttxwip043		|* Micro Retest Materials
	table	ttxwip044		|* Micro Retest Reagents
	table	ttxwip045		|* Pychem Retests
	table	ttxwip046		|* Pychem Retest Details
	table	ttxwip047		|* QC Cost Retest
	table	ttxwip048		|* QC Cost Simulation Retests	
	
	table	ttcibd001		|* Items
	table	ttcibd003		|* Conversion Factors
	table	ttdipu001		|* Item - Purchase
	table	ttcmcs003		|* Warehouses
	table	ttcmcs012		|* Units by Unit Set
	table	twhltc100		|* Lots
	table	twhltc101		|* Lot Cost Details
	table	twhltc105		|* Lots by Warehouse
	table	ttccom100		|* Business Partners
	table	ttisfc001		|* Production Orders
	table	tticpr007		|* Items - Costing
	
	extern domain tcdsca		cwar.desc
	extern domain tccwar		zoom.cwar, format.cwar
	extern domain tcpdno		zoom.pdno
	extern domain tcmcs.str50	prid.desc

|****************************** program section ********************************

before.program:
	import("zoom.pdno", zoom.pdno)
	import("zoom.cwar", zoom.cwar)
	format.cwar = get_equivalent_cwar(zoom.cwar)
	
	if trim$(format.cwar) &lt;&gt; "" then
		query.extend.where("txwip045.cwar = '" &amp; trim$(format.cwar) &amp; "'")
	endif

zoom.from.all:
on.entry:	
	standard.commands.off(add.set, mark.delete, update.db, end.program)
	
after.form.read:
	if trim$(zoom.pdno) = "" then
		remove.form.commands("create_cost_details")
		enable.commands(mark.delete)
	else
		disable.commands(mark.delete)
	endif
	
|****************************** field section **********************************	

field.prid.desc:
before.display:
	select txwip026.dscr
	from txwip026
	where txwip026.prid = :txwip045.prid
	selectdo
		prid.desc = txwip026.dscr
	endselect
	
field.cwar.desc:
before.display:
	select tcmcs003.dsca
	from tcmcs003
	where tcmcs003.cwar = :txwip045.cwar
	as set with 1 rows
	selectdo
		cwar.desc = tcmcs003.dsca 
	endselect

|****************************** function section *******************************

functions:

function extern void create_cost_details(){
	if trim$(zoom.pdno) &lt;&gt; "" then
		long ret
		do.selection(true, save_selected_tests) 
            	ret = refresh.parent(-1) 
		end()
	endif
}

function void save_selected_tests(){
	domain tcorno selected.code
	
	selected.code = trim$(txwip045.ptid)
	execute(15)
	
	select txwip048.code
	from txwip048
	where txwip048.code = :selected.code
		and txwip048.pdno = :zoom.pdno
	selectdo
		message(selected.code &amp; " is already in the list.")
	selectempty
		txwip048.pdno = zoom.pdno
		txwip048.code = selected.code
		txwip048.dcdt = utc.num()
		db.insert(ttxwip048, db.retry)
		commit.transaction()
	endselect
}

function domain tccwar get_equivalent_cwar(domain tccwar cwar){
	domain tccwar jo.cwar
	
	select tcmcs003.dsca
	from tcmcs003
	where tcmcs003.cwar = :cwar
	as set with 1 rows
	selectdo
		if str_pos(toupper$(trim$(tcmcs003.dsca)), "SITE 1") &gt; 0 then
			jo.cwar = "1CS001"
		endif
		
		if str_pos(toupper$(trim$(tcmcs003.dsca)), "SITE 2") &gt; 0 then
			jo.cwar = "1PS001"
		endif
	endselect
	
	return(jo.cwar)
}</expression><expressionLanguageType>Baan4C</expressionLanguageType><sourceType>1</sourceType><sourceDescription>Pychem Retests</sourceDescription><sourceName>txwip0500em31</sourceName></Source><documentation/><Attachment><type>relnotes</type><name>txwip0500em31</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em31</name></Attachment><additionalConstraints>2590</additionalConstraints><additionalInstructions/><keyword>||</keyword><application>EXTce01107</application></DR_Module><startInCompanyZero>false</startInCompanyZero><repSevLang>false</repSevLang><mainSession>true</mainSession><moduleType>1</moduleType><windowType>6</windowType><subType>5</subType><status>1</status><documentation/><objectLabel/><application>EXTce01107</application><sessionReferenceDescriptionReference>txwip0500em31</sessionReferenceDescriptionReference><sessionReferenceDescription>Pychem Retests</sessionReferenceDescription><sessionReference>txwip0500em31</sessionReference><UIScript>txwip0500em31</UIScript></DR_Controller>