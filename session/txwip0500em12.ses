ob</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>41</position><description/><name>global.delete</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>42</position><description/><name>global.copy</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>43</position><description/><name>save.defaults</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>44</position><description/><name>get.defaults</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>45</position><description/><name>start.chart</name></StandardCommand><StandardCommand><active>true</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>46</position><description/><name>start.query</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>47</position><description/><name>select.all</name></StandardCommand><defaultStartCommand>false</defaultStartCommand><DR_Module><description>Micro Test Reagents</description><versionID>B61O_a_ext</versionID><type>library</type><name>txwip0500em12</name><Version><ObjectID/><classID/><checkInLabel/><documentation/><isExpired>no</isExpired><isCheckedOutParallel>no</isCheckedOutParallel><isCheckedOut>no</isCheckedOut><modificationDateTime>2026-10-03T17:06:06Z</modificationDateTime><modifiedBy>ict004</modifiedBy><creationDateTime>2026-08-19T12:50:58Z</creationDateTime><createdBy>ict004</createdBy></Version><Source><sourceVersion><ObjectID/><classID/><checkInLabel/><documentation/><isExpired>no</isExpired><isCheckedOutParallel>no</isCheckedOutParallel><isCheckedOut>no</isCheckedOut><modificationDateTime>2026-10-03T17:06:06Z</modificationDateTime><modifiedBy>ict004</modifiedBy><creationDateTime>2026-08-19T12:50:58Z</creationDateTime><createdBy>ict004</createdBy></sourceVersion><sourceVersionID>B61O_a_ext</sourceVersionID><sourceObjectID>1</sourceObjectID><expression>|*******************************************************************************
|* txwip0500em12  B61O_a_ext
|* Micro Test Reagents
|* ict004
|* 2026-08-19 [08:40]
|*******************************************************************************
|* Script Type: 123
|*******************************************************************************

|*************************** declaration section *******************************
declaration:

	table	ttxwip020		|* QC Cost Summary
	table	ttxwip021		|* Reagents Header	
	table	ttxwip022		|* Reagents Details
	table	ttxwip024		|* Micro Test Header
	table	ttxwip025		|* Micro Test Details
	table	ttxwip026		|* QC Personnel
	table	ttxwip027		|* Micro Test Materials
	table	ttxwip028		|* Micro Test Reagents
	table	ttxwip030		|* Pychem Test Header
	table	ttxwip031		|* Pychem Test Details
	table	ttxwip033		|* Third Party Test Header
	table	ttxwip034		|* Third Party Test Details
	table	ttxwip035 		|* QC Items
	table	ttxwip036		|* QC Cost Master Data
	table	ttxwip037		|* QC Cost Details
	table	ttxwip038		|* Inline &amp; Documentation Costs
	table	ttxwip039		|* Micro Test Materials Reference

	table	ttcibd001		|* Items
	table	ttcibd003		|* Conversion Factors
	table	ttdipu001		|* Item - Purchase
	table	ttcmcs012		|* Units by Unit Set
	table	twhltc100		|* Lots
	table	twhltc101		|* Lot Cost Details
	table	twhltc105		|* Lots by Warehouse
	table	ttccom100		|* Business Partners
	table	ttisfc001		|* Production Orders

	extern domain tcmcs.str50	rgnt.desc
	extern domain tcqiv1		cssm
	extern domain tccwar		cwar
	extern long			current.mtid

|****************************** program section ********************************

| From Micro Test Details txwip0500em10
before.program:
	import("current.mtid", current.mtid)
	import("cwar", cwar)

	if current.mtid &lt;&gt; 0 then 
		query.extend.where("txwip028.mtid = " &amp; str$(current.mtid) &amp; "")
	endif
	
before.new.object:
	txwip028.mult = 1

|****************************** group section **********************************

	
|****************************** field section **********************************
	
field.rgnt.desc:
before.display:
	update_rgnt_desc(txwip028.rgnt)
	
field.txwip028.mult:
when.field.changes:
	update_cost_per_sample(txwip028.rgnt, txwip028.mult)
	
after.field:
	update_cost_per_sample(txwip028.rgnt, txwip028.mult)

|****************************** function section *******************************

functions:

function void update_rgnt_desc(domain tcmcs.str10 rgnt){
	rgnt.desc = get_rgnt_desc(rgnt)
}

function domain tcmcs.str50 get_rgnt_desc(domain tcmcs.str10 rgnt){
	domain tcmcs.str10 rgnt.code
	domain tcmcs.str50 desc
	
	rgnt.code = trim$(rgnt)
	desc = ""
	
	select txwip021.dscr
	from txwip021
	where txwip021.rgnt = :rgnt.code
	selectdo
		desc = txwip021.dscr
	endselect
	
	return(desc)
}

function extern void save_close_total(){
	domain tcqiv1 total.mat.cost, total.rgt.cost, total
	long ret
	
	execute(15)
	
	total.mat.cost = 0
	total.rgt.cost = 0
	total = 0

	select sum(txwip027.csst):total.mat.cost
	from txwip027
	where txwip027.mtid = :current.mtid
	selectdo
	endselect
	
	select txwip021.rgnt, txwip021.cssm
	from txwip021
	where exists
		(select txwip028.*
		 from txwip028
		 where txwip028.mtid = :current.mtid
		 and txwip028.rgnt = txwip021.rgnt)
	selectdo
		total.rgt.cost = total.rgt.cost + txwip021.cssm
	endselect
	
	total = total.mat.cost + total.rgt.cost
	
	select txwip025.*
	from txwip025 for update
	where txwip025.mtid = :current.mtid
	selectdo
		txwip025.mcst = total
		if db.update(ttxwip025, db.retry) &lt;&gt; 0 then
			message("Error " &amp; str$(e) &amp; " occurred while updating the record.")
			abort.transaction()
		endif
	endselect
	
	commit.transaction()
	ret = refresh.parent(-1)
	end()
}

function extern load_micro_test_reagents(){
	export("current.mtid", current.mtid)
	export("cwar", cwar)
	
	string total
	start.session(MODAL_OVERVIEW, "txwip0500em03",  "txwip0500em12", total)
}

function update_cost_per_sample(domain tcmcs.str10 rgnt, domain tcqiv1 mult){
	txwip028.csst = compute_cost_per_sample(rgnt, mult) 
}

function domain tcqiv1 compute_cost_per_sample(domain tcmcs.str10 rgnt, domain tcqiv1 mult){
	domain tcmcs.str10 rgnt.code
	domain tcqiv1 cost.per.ml, cost.per.sample
	
	rgnt.code = trim$(rgnt)
	cost.per.ml = get_cost_per_ml(rgnt.code)
	
	if cost.per.ml = 0 or mult = 0 then
		cost.per.sample = 0
	else
		cost.per.sample = cost.per.ml * mult
	endif
	
	return(cost.per.sample)
		
}

function domain tcqiv1 get_cost_per_ml(domain tcmcs.str10 rgnt){
	domain tcmcs.str10 rgnt.code
	domain tcqiv1 cost
	
	rgnt.code = trim$(rgnt)
	cost = 0
	
	select txwip021.csst
	from txwip021
	where txwip021.rgnt = :rgnt.code
	selectdo
		cost = txwip021.csst
	endselect
	
	return(cost)
}</expression><expressionLanguageType>Baan4C</expressionLanguageType><sourceType>1</sourceType><sourceDescription>Micro Test Reagents</sourceDescription><sourceName>txwip0500em12</sourceName></Source><documentation/><Attachment><type>relnotes</type><name>txwip0500em12</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em12</name></Attachment><additionalConstraints>2590</additionalConstraints><additionalInstructions/><keyword>||</keyword><application>EXTce01106</application></DR_Module><startInCompanyZero>false</startInCompanyZero><repSevLang>false</repSevLang><mainSession>true</mainSession><moduleType>1</moduleType><windowType>6</windowType><subType>1</subType><status>1</status><documentation/><objectLabel/><application>EXTce01106</application><sessionReferenceDescriptionReference>txwip0500em12</sessionReferenceDescriptionReference><sessionReferenceDescription>Micro Test Reagents</sessionReferenceDescription><sessionReference>txwip0500em12</sessionReference><UIScript>txwip0500em12</UIScript></DR_Controller>