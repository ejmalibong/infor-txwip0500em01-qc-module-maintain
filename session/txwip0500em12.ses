|* txwip0500em12  B61O_a_ext
|* Micro Test Reagents
|* ict004
|* 2026-08-19 [08:40]
|*******************************************************************************
|* Script Type: 123
|*******************************************************************************

|*************************** declaration section *******************************
declaration:

	table	ttxwip020		|* QC Cost Summary
	table	ttxwip021		|* Reagents Header	
	table	ttxwip022		|* Reagents Details
	table	ttxwip024		|* Micro Test Header
	table	ttxwip025		|* Micro Test Details
	table	ttxwip026		|* QC Personnel
	table	ttxwip027		|* Micro Test Materials
	table	ttxwip028		|* Micro Test Reagents
	table	ttxwip030		|* Pychem Test Header
	table	ttxwip031		|* Pychem Test Details
	table	ttxwip033		|* Third Party Test Header
	table	ttxwip034		|* Third Party Test Details
	table	ttxwip035 		|* QC Items
	table	ttxwip036		|* QC Cost Master Data
	table	ttxwip037		|* QC Cost Details

	table	ttcibd001		|* Items
	table	ttcibd003		|* Conversion Factors
	table	ttdipu001		|* Item - Purchase
	table	ttcmcs012		|* Units by Unit Set

	extern long			current.mtid
	extern domain tcmcs.str50	rgnt.desc
	extern domain tcqiv1		cssm

|****************************** program section ********************************

before.program:
	import("current.mtid", current.mtid)

	if current.mtid &lt;&gt; 0 then 
		query.extend.where("txwip028.mtid = " &amp; str$(current.mtid) &amp; "")
	endif

|****************************** group section **********************************

choice.add.set:
after.choice:
	txwip028.mtid = current.mtid
	
|****************************** field section **********************************

field.txwip028.mtid:
before.field:
	txwip028.mtid = current.mtid
	
field.txwip028.rgnt:
after.zoom:
	if trim$(txwip028.rgnt) &lt;&gt; "" then
		update_rgnt_desc(trim$(txwip028.rgnt))
|		update_computation(trim$(txwip028.rgnt))
	else
		clear_row()
	endif
	
when.field.changes:
	if trim$(txwip028.rgnt) &lt;&gt; "" then
		update_rgnt_desc(trim$(txwip028.rgnt))
|		update_computation(trim$(txwip028.rgnt))
	else
		clear_row()
	endif
	
field.rgnt.desc:
before.display:
	update_rgnt_desc(trim$(txwip028.rgnt))
	
|field.cssm:
|before.display:
|	cssm = get_rgnt_cost_sample(trim$(txwip028.rgnt))

|****************************** function section *******************************

functions:
	
function void clear_row(){
	rgnt.desc = ""
	txwip028.rgnt = ""
}

function void update_rgnt_desc(domain tcmcs.str10 rgnt){
	rgnt.desc = get_rgnt_desc(trim$(rgnt))
}

function domain tcmcs.str50 get_rgnt_desc(domain tcmcs.str10 rgnt){
	domain tcmcs.str50 desc
	
	desc = ""
	
	select txwip021.dscr
	from txwip021
	where txwip021.rgnt = :rgnt
	selectdo
		desc = txwip021.dscr
	endselect
	
	return(desc)
}

|function void update_computation(domain tcmcs.str10 rgnt){
|	cssm = get_rgnt_cost_sample(trim$(rgnt))
|}
|
|function domain tcqiv1 get_rgnt_cost_sample(domain tcmcs.str10 rgnt){
|	domain tcqiv1 cost.sample
|	
|	cost.sample = 0
|	
|	select txwip021.cssm
|	from txwip021
|	where txwip021.rgnt = :rgnt
|	selectdo
|		cost.sample = txwip021.cssm
|	endselect
|	
|	return(cost.sample)
|}

function extern void save_close_total(){
	domain tcqiv1 total.mat.cost, total.rgt.cost, total
	long ret
	
	execute(15)
	
	total.mat.cost = 0
	total.rgt.cost = 0
	total = 0

|	select sum(txwip027.csst):total.mat.cost
|	from txwip027
|	where txwip027.mtid = :current.mtid
|	selectdo
|	endselect
	
|	select txwip021.rgnt, txwip021.cssm
|	from txwip021
|	where exists
|		(select txwip028.*
|		 from txwip028
|		 where txwip028.mtid = :current.mtid
|		 and txwip028.rgnt = txwip021.rgnt)
|	selectdo
|		total.rgt.cost = total.rgt.cost + txwip021.cssm
|	endselect
	
	total = total.mat.cost + total.rgt.cost
	
	select txwip025.*
	from txwip025 for update
	where txwip025.mtid = :current.mtid
	selectdo
		txwip025.mcst = total
		if db.update(ttxwip025, db.retry) &lt;&gt; 0 then
			message("Error " &amp; str$(e) &amp; " occurred while updating the record.")
			abort.transaction()
		endif
	endselect
	
	commit.transaction()
	ret = refresh.parent(-1)
	end()
}</expression><expressionLanguageType>Baan4C</expressionLanguageType><sourceType>1</sourceType><sourceDescription>Micro Test Reagents</sourceDescription><sourceName>txwip0500em12</sourceName></Source><documentation/><Attachment><type>relnotes</type><name>txwip0500em12</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em12</name></Attachment><additionalConstraints>2590</additionalConstraints><additionalInstructions/><keyword>||</keyword><application>EXTce01106</application></DR_Module><startInCompanyZero>false</startInCompanyZero><repSevLang>false</repSevLang><mainSession>true</mainSession><moduleType>1</moduleType><windowType>6</windowType><subType>1</subType><status>1</status><documentation/><objectLabel/><application>EXTce01106</application><sessionReferenceDescriptionReference>txwip0500em12</sessionReferenceDescriptionReference><sessionReferenceDescription>Micro Test Reagents</sessionReferenceDescription><sessionReference>txwip0500em12</sessionReference><UIScript>txwip0500em12</UIScript></DR_Controller>