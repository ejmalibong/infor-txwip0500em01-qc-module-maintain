d><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>41</position><description/><name>global.delete</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>42</position><description/><name>global.copy</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>43</position><description/><name>save.defaults</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>44</position><description/><name>get.defaults</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>45</position><description/><name>start.chart</name></StandardCommand><StandardCommand><active>true</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>46</position><description/><name>start.query</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>47</position><description/><name>select.all</name></StandardCommand><defaultStartCommand>false</defaultStartCommand><DR_Module><description>Pychem Test</description><versionID>B61O_a_ext</versionID><type>library</type><name>txwip0500em16</name><Version><ObjectID/><classID/><checkInLabel/><documentation/><isExpired>no</isExpired><isCheckedOutParallel>no</isCheckedOutParallel><isCheckedOut>no</isCheckedOut><modificationDateTime>2026-09-06T03:47:55Z</modificationDateTime><modifiedBy>ict004</modifiedBy><creationDateTime>2026-08-26T13:19:24Z</creationDateTime><createdBy>ict004</createdBy></Version><Source><sourceVersion><ObjectID/><classID/><checkInLabel/><documentation/><isExpired>no</isExpired><isCheckedOutParallel>no</isCheckedOutParallel><isCheckedOut>no</isCheckedOut><modificationDateTime>2026-09-06T03:47:55Z</modificationDateTime><modifiedBy>ict004</modifiedBy><creationDateTime>2026-08-26T13:19:24Z</creationDateTime><createdBy>ict004</createdBy></sourceVersion><sourceVersionID>B61O_a_ext</sourceVersionID><sourceObjectID>1</sourceObjectID><expression>|*******************************************************************************
|* txwip0500em09  B61O_a_ext
|* Micro Test
|* ict004
|* 2026-08-11 [10:55]
|*******************************************************************************
|* Script Type: 123
|*******************************************************************************

|*************************** declaration section *******************************
declaration:

	table	ttxwip020		|* QC Cost Summary
	table	ttxwip021		|* Reagents Header	
	table	ttxwip022		|* Reagents Details
	table	ttxwip030		|* Micro Test Header
	table	ttxwip025		|* Micro Test Details
	table	ttxwip026		|* QC Personnel
	table	ttxwip027		|* Micro Test Materials
	table	ttxwip028		|* Micro Test Reagents
	table	ttxwip030		|* Pychem Test Header
	table	ttxwip031		|* Pychem Test Details
	table	ttxwip033		|* Third Party Test Header
	table	ttxwip034		|* Third Party Test Details
	table	ttxwip035 		|* QC Items
	table	ttxwip036		|* QC Cost Master Data
	table	ttxwip037		|* QC Cost Details

	table	ttcibd001		|* Items
	table	ttcibd003		|* Conversion Factors
	table	ttdipu001		|* Item - Purchase
	table	ttcmcs012		|* Units by Unit Set
	
	extern domain tcorno		test.code
	extern domain tcmcs.str50	prid.desc

|****************************** program section ********************************

zoom.from.all:
on.entry:
	import("txwip030.ptid", test.code)

	if not isspace(test.code) then
		select txwip030.*
		from txwip030
		where txwip030.ptid = :test.code
		as set with 1 rows
		selectdo
		endselect

		execute(find.data)
	endif

main.table.io:
before.write:
	if txwip030.dcdt = 0 then
		txwip030.dcdt = utc.num()
	endif

before.rewrite:
	txwip030.dmdt = utc.num()
	
before.new.object:
	txwip030.prid = 2
	update_personnel_desc(txwip030.prid)

|****************************** field section **********************************

field.txwip030.prtm:
when.field.changes:
	update_labor_hour(txwip030.prtm)
	update_labor_cost(txwip030.prid, txwip030.lbhr)
	
field.prid.desc:
before.display:
	update_personnel_desc(txwip030.prid)
	
|****************************** function section *******************************

functions:

function void update_labor_hour(domain tcqiv1 mins){
	txwip030.lbhr = compute_labor_hour(mins)
}

function domain tcqiv1 compute_labor_hour(domain tcqiv1 mins){
	domain tcqiv1 labor.hr, hr
	
	hr = 60
	labor.hr = 0
	
	if mins &lt;&gt; 0 then
		labor.hr = mins / hr
	endif
	
	return(labor.hr)
}

function domain tcqiv1 get_rate_hr(domain tcmcs.long prid){
	domain tcqiv1 rate.hr
	
	rate.hr = 0
	
	select txwip026.rthr
	from txwip026
	where txwip026.prid = :prid
	selectdo
		rate.hr = txwip026.rthr
	endselect
	
	return(rate.hr)
}

function void update_labor_cost(domain tcmcs.long prid, domain tcqiv1 labor.hr){
	txwip030.tlst = compute_labor_cost(prid, labor.hr)
}

function domain tcqiv1 compute_labor_cost(domain tcmcs.long prid, domain tcqiv1 labor.hr){
	domain tcqiv1 labor.cost
	
	labor.cost = 0 
	
	if labor.hr = 0 or labor.hr = 0 then
		labor.cost = 0
	else
		labor.cost = get_rate_hr(prid) * labor.hr
	endif
	
	return(labor.cost)
}

function void update_personnel_desc(domain tcmcs.long prid){
	prid.desc = get_personnel_desc(prid)
}

function domain tcmcs.str50 get_personnel_desc(domain tcmcs.long prid){
	domain tcmcs.str50 desc
	
	desc = ""
	
	select txwip026.dscr
	from txwip026
	where txwip026.prid = :prid
	selectdo
		desc = txwip026.dscr
	endselect
	
	return(desc)
}

function extern void compute_micro_test_cost(){
	domain tcqiv1 total.labor.cost, total.material.cost, total.test.cost
	long ret
	
	execute(15)

	total.labor.cost = 0
	total.material.cost = 0
	total.test.cost = 0
	
	total.labor.cost = txwip030.tlst

	select sum(txwip031.mcst):total.material.cost
	from txwip031
	where txwip031.ptid = :txwip030.ptid
	selectdo
	endselect

	total.test.cost = total.labor.cost + total.material.cost
	
	select txwip030.*
	from txwip030 for update
	where txwip030.ptid = :txwip030.ptid
	selectdo
		txwip030.tmst = total.material.cost
		txwip030.pyst = total.test.cost
		if db.update(ttxwip030, db.retry) &lt;&gt; 0 then
			message("Error " &amp; str$(e) &amp; " occurred while updating the record.")
			abort.transaction()
		endif
	endselect
	
	commit.transaction()
	
	execute(find.data)
	
	ret = refresh.parent(-1)
	synchronize.satellite("txwip0500em17")
}</expression><expressionLanguageType>Baan4C</expressionLanguageType><sourceType>1</sourceType><sourceDescription>Pychem Test</sourceDescription><sourceName>txwip0500em16</sourceName></Source><documentation/><Attachment><type>relnotes</type><name>txwip0500em16</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em16</name></Attachment><additionalConstraints>2590</additionalConstraints><additionalInstructions/><keyword>||</keyword><application>EXTce01106</application></DR_Module><startInCompanyZero>false</startInCompanyZero><repSevLang>false</repSevLang><mainSession>true</mainSession><moduleType>1</moduleType><windowType>15</windowType><subType>1</subType><status>1</status><documentation/><objectLabel/><application>EXTce01106</application><sessionReferenceDescriptionReference>txwip0500em16</sessionReferenceDescriptionReference><sessionReferenceDescription>Pychem Test</sessionReferenceDescription><sessionReference>txwip0500em16</sessionReference><UIScript>txwip0500em16</UIScript></DR_Controller>