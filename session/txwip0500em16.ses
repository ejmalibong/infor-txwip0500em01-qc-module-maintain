defaultcommand><startcommand>false</startcommand><position>28</position><description/><name>prev.frm</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>29</position><description/><name>last.frm</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>31</position><description/><name>resize.frm</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>32</position><description/><name>cust.grid</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>33</position><description/><name>cmd.options</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>34</position><description/><name>zoom</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>35</position><description/><name>interrupt</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>36</position><description/><name>end.program</name></StandardCommand><StandardCommand><active>true</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>37</position><description/><name>abort.program</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>39</position><description/><name>text.manager</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>40</position><description/><name>run.job</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>41</position><description/><name>global.delete</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>42</position><description/><name>global.copy</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>43</position><description/><name>save.defaults</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>44</position><description/><name>get.defaults</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>45</position><description/><name>start.chart</name></StandardCommand><StandardCommand><active>true</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>46</position><description/><name>start.query</name></StandardCommand><StandardCommand><active>false</active><defaultcommand>false</defaultcommand><startcommand>false</startcommand><position>47</position><description/><name>select.all</name></StandardCommand><defaultStartCommand>false</defaultStartCommand><DR_Module><description>Pychem Test</description><versionID>B61O_a_ext</versionID><type>library</type><name>txwip0500em16</name><Version><ObjectID/><classID/><checkInLabel/><documentation/><isExpired>no</isExpired><isCheckedOutParallel>no</isCheckedOutParallel><isCheckedOut>no</isCheckedOut><modificationDateTime>2026-10-16T00:14:58Z</modificationDateTime><modifiedBy>ict004</modifiedBy><creationDateTime>2026-08-26T13:19:24Z</creationDateTime><createdBy>ict004</createdBy></Version><Source><sourceVersion><ObjectID/><classID/><checkInLabel/><documentation/><isExpired>no</isExpired><isCheckedOutParallel>no</isCheckedOutParallel><isCheckedOut>no</isCheckedOut><modificationDateTime>2026-10-16T00:14:58Z</modificationDateTime><modifiedBy>ict004</modifiedBy><creationDateTime>2026-08-26T13:19:24Z</creationDateTime><createdBy>ict004</createdBy></sourceVersion><sourceVersionID>B61O_a_ext</sourceVersionID><sourceObjectID>1</sourceObjectID><expression>|*******************************************************************************
|* txwip0500em09  B61O_a_ext
|* Micro Test
|* ict004
|* 2026-08-11 [10:55]
|*******************************************************************************
|* Script Type: 123
|*******************************************************************************

|*************************** declaration section *******************************
declaration:

	table	ttxwip020		|* QC Costs
	table	ttxwip021		|* Reagents	
	table	ttxwip022		|* Reagents Details
	table	ttxwip024		|* Micro Tests
	table	ttxwip025		|* Micro Test Details
	table	ttxwip026		|* QC Personnels
	table	ttxwip027		|* Micro Test Materials
	table	ttxwip028		|* Micro Test Reagents
	table	ttxwip030		|* Pychem Tests
	table	ttxwip031		|* Pychem Test Details
	table	ttxwip033		|* Third Party Tests
	table	ttxwip034		|* Third Party Test Details
	table	ttxwip035 		|* QC Items
	table	ttxwip036		|* Item Testing Costs
	table	ttxwip037		|* Item Testing Cost Details
	table	ttxwip038		|* Inline &amp; Documentation Costs
	table	ttxwip039		|* Micro Test Materials Reference
	table	ttxwip040		|* QC Cost Simulations
	table	ttxwip041		|* Micro Retests
	table	ttxwip042		|* Micro Retest Details
	table	ttxwip043		|* Micro Retest Materials
	table	ttxwip044		|* Micro Retest Reagents
	table	ttxwip045		|* Pychem Retests
	table	ttxwip046		|* Pychem Retest Details
	table	ttxwip047		|* QC Cost Retest
	table	ttxwip048		|* QC Cost Simulation Retests	
	
	table	ttcibd001		|* Items
	table	ttcibd003		|* Conversion Factors
	table	ttdipu001		|* Item - Purchase
	table	ttcmcs003		|* Warehouses
	table	ttcmcs012		|* Units by Unit Set
	table	twhltc100		|* Lots
	table	twhltc101		|* Lot Cost Details
	table	twhltc105		|* Lots by Warehouse
	table	ttccom100		|* Business Partners
	table	ttisfc001		|* Production Orders
	table	tticpr007		|* Items - Costing
	
	extern domain tcorno		zoom.code
	extern domain tcmcs.str50	prid.desc
	extern domain tcdsca		cwar.desc

|****************************** program section ********************************

before.program:
	import("txwip037.code", zoom.code)

zoom.from.all:
on.entry:
	standard.commands.off(add.set, mark.delete, recover.set, update.db, end.program, first.set, next.set, prev.set, last.set)
	disable_fields()

	if trim$(zoom.code) &lt;&gt; "" then
		select txwip030.*
		from txwip030
		where txwip030.ptid = :zoom.code
		as set with 1 rows
		selectdo
		endselect
		
		execute(find.data)
	endif
	
after.form.read:
	if trim$(zoom.code) &lt;&gt; "" then
		remove.form.commands("compute_pychem_test_cost")
	endif
	
	| Imported value (zoom.code) can only read starting from field sections
	add.sync.fields("txwip0500em17", "txwip030.cwar", "zoom.cwar")

main.table.io:
before.write:
	if txwip030.dcdt = 0 then
		txwip030.dcdt = utc.num()
	endif

before.rewrite:
	txwip030.dmdt = utc.num()

|****************************** field section **********************************

field.txwip030.ptid:
before.display:
	if trim$(txwip030.ptid) = "" then
		txwip030.ptid = set_pychem_test_code()
		txwip030.prid = 2
		txwip030.cwar = "1CS001"
	endif

field.txwip030.cwar:
before.display:
	update_cwar.desc(txwip030.cwar)
	
selection.filter:
	query.extend.where.in.zoom("tcmcs003.cwar IN (""1CS001"",""1PS001"")")
	
when.field.changes:
	update_cwar.desc(txwip030.cwar)
	
after.zoom:
	update_cwar.desc(txwip030.cwar)
	
field.cwar.desc:
before.display:
	update_cwar.desc(txwip030.cwar)

field.txwip030.prtm:
when.field.changes:
	update_labor_costs()
	
after.field:
	update_labor_costs()
	
field.txwip030.prid:
when.field.changes:
	update_labor_costs()
	
after.field:
	update_labor_costs()
	
field.prid.desc:
before.display:
	update_personnel_desc(txwip030.prid)
	
when.field.changes:
	update_personnel_desc(txwip030.prid)
	
after.zoom:
	update_personnel_desc(txwip030.prid)
	
|****************************** function section *******************************

functions:

function domain tcorno set_pychem_test_code(){
	long cnt, next.id
	domain tcmcs.str10 next.code, last.code
	
	cnt = 0
	last.code = ""
	next.code = ""
	
	select count(txwip030.ptid):cnt
	from txwip030
	where txwip030.ptid &lt;&gt; ""
	selectdo
	endselect
	
	if cnt &gt; 0 then
		select txwip030.ptid
		from txwip030
		order by txwip030.ptid desc
		as set with 1 rows
		selectdo
			last.code = txwip030.ptid(len(trim$(txwip030.ptid))-1;3)
			next.id = val(last.code) + 1
			next.code = "P" &amp; sprintf$("%03d", trim$(str$(next.id)))
		endselect
	else
		next.code = "P001"
	endif
	
	return(next.code)
}

function void update_labor_hour(domain tcqiv1 mins){
	txwip030.lbhr = compute_labor_hour(mins)
}

function domain tcqiv1 compute_labor_hour(domain tcqiv1 mins){
	domain tcqiv1 labor.hr, hr
	
	hr = 60
	labor.hr = 0
	
	if mins &lt;&gt; 0 then
		labor.hr = mins / hr
	endif
	
	return(labor.hr)
}

function domain tcqiv1 get_rate_hr(domain tcmcs.long prid){
	domain tcqiv1 rate.hr
	rate.hr = 0
	
	select txwip026.rthr
	from txwip026
	where txwip026.prid = :prid
	selectdo
		rate.hr = txwip026.rthr
	endselect
	
	return(rate.hr)
}

function void update_labor_cost(domain tcmcs.long prid, domain tcqiv1 labor.hr){
	txwip030.tlst = compute_labor_cost(prid, labor.hr)
}

function domain tcqiv1 compute_labor_cost(domain tcmcs.long prid, domain tcqiv1 labor.hr){
	domain tcqiv1 labor.cost
	labor.cost = 0 
	
	if labor.hr = 0 or labor.hr = 0 then
		labor.cost = 0
	else
		labor.cost = get_rate_hr(prid) * labor.hr
	endif
	
	return(labor.cost)
}

function void update_personnel_desc(domain tcmcs.long prid){
	prid.desc = get_personnel_desc(prid)
}

function domain tcmcs.str50 get_personnel_desc(domain tcmcs.long prid){
	domain tcmcs.str50 desc
	desc = ""
	
	select txwip026.dscr
	from txwip026
	where txwip026.prid = :prid
	selectdo
		desc = txwip026.dscr
	endselect
	
	return(desc)
}

function extern void compute_pychem_test_cost(){
	domain tcqiv1 total.labor.cost, total.material.cost, total.test.cost
	long ret
	
	execute(15)

	total.labor.cost = 0
	total.material.cost = 0
	total.test.cost = 0
	
	total.labor.cost = txwip030.tlst

	select sum(txwip031.mcst):total.material.cost
	from txwip031
	where txwip031.ptid = :txwip030.ptid
	selectdo
	endselect

	total.test.cost = total.labor.cost + total.material.cost
	
	select txwip030.*
	from txwip030 for update
	where txwip030.ptid = :txwip030.ptid
	selectdo
		txwip030.tmst = total.material.cost
		txwip030.pyst = total.test.cost
		if db.update(ttxwip030, db.retry) &lt;&gt; 0 then
			message("Error " &amp; str$(e) &amp; " occurred while updating the record.")
			abort.transaction()
		endif
	endselect
	
	commit.transaction()
	execute(find.data)
	ret = refresh.parent(-1)
	synchronize.satellite("txwip0500em17")
}

function update_cwar.desc(domain tccwar cwar){
	domain tcdsca desc
	desc = ""
	
	select tcmcs003.dsca
	from tcmcs003
	where tcmcs003.cwar = :cwar
	as set with 1 rows
	selectdo
		desc = tcmcs003.dsca 
	endselect
	
	cwar.desc = desc
}

function update_labor_costs(){
	update_labor_hour(txwip030.prtm)
	update_labor_cost(txwip030.prid, txwip030.lbhr)
	display("txwip030.lbhr")
	display("txwip030.tlst")
}

function disable_fields(){
	disable.fields("txwip030.dscr")
	disable.fields("txwip030.cwar")
	disable.fields("txwip030.prtm")
	disable.fields("txwip030.prid")
}</expression><expressionLanguageType>Baan4C</expressionLanguageType><sourceType>1</sourceType><sourceDescription>Pychem Test</sourceDescription><sourceName>txwip0500em16</sourceName></Source><documentation/><Attachment><type>relnotes</type><name>txwip0500em16</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em16</name></Attachment><additionalConstraints>2590</additionalConstraints><additionalInstructions/><keyword>||</keyword><application>EXTce01107</application></DR_Module><startInCompanyZero>false</startInCompanyZero><repSevLang>false</repSevLang><mainSession>true</mainSession><moduleType>1</moduleType><windowType>15</windowType><subType>1</subType><status>1</status><documentation/><objectLabel/><application>EXTce01107</application><sessionReferenceDescriptionReference>txwip0500em16</sessionReferenceDescriptionReference><sessionReferenceDescription>Pychem Test</sessionReferenceDescription><sessionReference>txwip0500em16</sessionReference><UIScript>txwip0500em16</UIScript></DR_Controller>