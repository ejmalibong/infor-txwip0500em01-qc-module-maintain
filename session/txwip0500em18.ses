|* txwip0500em18  B61O_a_ext
|* Third Party Tests
|* ict004
|* 2026-08-11 [10:53]
|*******************************************************************************
|* Script Type: 123
|*******************************************************************************

|*************************** declaration section *******************************
declaration:

	table	ttxwip020		|* QC Cost Summary
	table	ttxwip021		|* Reagents Header	
	table	ttxwip022		|* Reagents Details
	table	ttxwip024		|* Micro Test Header
	table	ttxwip025		|* Micro Test Details
	table	ttxwip026		|* QC Personnel
	table	ttxwip027		|* Micro Test Materials
	table	ttxwip028		|* Micro Test Reagents
	table	ttxwip030		|* Pychem Test Header
	table	ttxwip031		|* Pychem Test Details
	table	ttxwip033		|* Third Party Test Header
	table	ttxwip034		|* Third Party Test Details
	table	ttxwip035 		|* QC Items
	table	ttxwip036		|* QC Cost Master Data
	table	ttxwip037		|* QC Cost Details
	table	ttxwip038		|* Inline &amp; Documentation Costs
	table	ttxwip039		|* Micro Test Materials Reference

	table	ttcibd001		|* Items
	table	ttcibd003		|* Conversion Factors
	table	ttdipu001		|* Item - Purchase
	table	ttcmcs012		|* Units by Unit Set
	table	twhltc100		|* Lots
	table	twhltc101		|* Lot Cost Details
	table	twhltc105		|* Lots by Warehouse
	table	ttccom100		|* Business Partners
	table	ttisfc001		|* Production Orders
	table	ttcmcs003		|* Warehouses
	
	extern domain tccwar		cwar
	extern domain tcitem		zoom.item
	extern domain tcdsca		cwar.desc

|****************************** program section ********************************

before.program:
	import("txwip037.cwar", cwar)
	
	if trim$(cwar) &lt;&gt; "" then
		query.extend.where("txwip033.cwar = '" &amp; cwar &amp; "'")
	endif

| Triggers when this session was used as zoom by Item Testing Cost Details txwip0500em07
zoom.from.all:
on.entry:
	import("txwip037.item", zoom.item)
	
after.form.read:
	update_zoom_buttons()
	
form.all:
init.form:
	update_zoom_buttons()

before.display.object:
	update_zoom_buttons()
	
|****************************** field section **********************************	

field.cwar.desc:
before.display:
	select tcmcs003.dsca
	from tcmcs003
	where tcmcs003.cwar = :txwip033.cwar
	as set with 1 rows
	selectdo
		cwar.desc = tcmcs003.dsca 
	endselect

|****************************** function section *******************************

functions:

function extern void create_cost_details(){
	if trim$(zoom.item) &lt;&gt; "" then
		long ret
		do.selection(true, save_selected_tests) 
            	ret = refresh.parent(-1) 
		end()
	endif
}

function void save_selected_tests(){
	domain tcorno selected.code
	
	selected.code = trim$(txwip033.tpid)
	execute(15)
	
	select txwip037.code
	from txwip037
	where txwip037.code = :selected.code
		and txwip037.item = :zoom.item
		and txwip037.cwar = :cwar
	selectdo
		message(selected.code &amp; " is already in the list.")
	selectempty
		txwip037.item = zoom.item
		txwip037.cwar = cwar
		txwip037.code = selected.code
		txwip037.dcdt = utc.num()
		db.insert(ttxwip037, db.retry)
		commit.transaction()
	endselect
}

function update_zoom_buttons(){
	if trim$(zoom.item) = "" then
		remove.form.commands("create_cost_details")
		enable.commands(add.set)
		enable.commands(mark.delete)
	else
		disable.commands(add.set)
		disable.commands(mark.delete)
		disable.commands(update.db)
	endif
}</expression><expressionLanguageType>Baan4C</expressionLanguageType><sourceType>1</sourceType><sourceDescription>Third Party Tests</sourceDescription><sourceName>txwip0500em18</sourceName></Source><documentation/><Attachment><type>relnotes</type><name>txwip0500em18</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em18</name></Attachment><additionalConstraints>2590</additionalConstraints><additionalInstructions/><keyword>||</keyword><application>EXTce01106</application></DR_Module><startInCompanyZero>false</startInCompanyZero><repSevLang>false</repSevLang><mainSession>true</mainSession><moduleType>1</moduleType><windowType>6</windowType><subType>5</subType><status>1</status><documentation/><Attachment><type>relnotes</type><name>txwip0500em18</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em18</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em18dcwar.desc</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em18dcwar.desc</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em18dtxwip033.cw</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em18dtxwip033.cw</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em18dtxwip033.dc</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em18dtxwip033.dc</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em18dtxwip033.dm</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em18dtxwip033.dm</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em18dtxwip033.ds</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em18dtxwip033.ds</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em18dtxwip033.fr</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em18dtxwip033.fr</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em18dtxwip033.tp</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em18dtxwip033.tp</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em18dtxwip033.tp</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em18dtxwip033.tp</name></Attachment><objectLabel/><application>EXTce01106</application><sessionReferenceDescriptionReference>txwip0500em18</sessionReferenceDescriptionReference><sessionReferenceDescription>Third Party Tests</sessionReferenceDescription><sessionReference>txwip0500em18</sessionReference><UIScript>txwip0500em18</UIScript></DR_Controller>