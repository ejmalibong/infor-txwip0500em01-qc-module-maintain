isExpired><isCheckedOutParallel>no</isCheckedOutParallel><isCheckedOut>no</isCheckedOut><modificationDateTime>2026-10-14T01:43:13Z</modificationDateTime><modifiedBy>ict004</modifiedBy><creationDateTime>2026-10-06T06:28:58Z</creationDateTime><createdBy>ict004</createdBy></sourceVersion><sourceVersionID>B61O_a_ext</sourceVersionID><sourceObjectID>1</sourceObjectID><expression>|*******************************************************************************
|* txwip0500em29  B61O_a_ext
|* Micro Retest Materials
|* ict004
|* 2026-08-17 [07:37]
|*******************************************************************************
|* Script Type: 123
|*******************************************************************************

|*************************** declaration section *******************************
declaration:

	table	ttxwip020		|* QC Costs
	table	ttxwip021		|* Reagents	
	table	ttxwip022		|* Reagents Details
	table	ttxwip024		|* Micro Tests
	table	ttxwip025		|* Micro Test Details
	table	ttxwip026		|* QC Personnels
	table	ttxwip027		|* Micro Test Materials
	table	ttxwip028		|* Micro Test Reagents
	table	ttxwip030		|* Pychem Tests
	table	ttxwip031		|* Pychem Test Details
	table	ttxwip033		|* Third Party Tests
	table	ttxwip034		|* Third Party Test Details
	table	ttxwip035 		|* QC Items
	table	ttxwip036		|* Item Testing Costs
	table	ttxwip037		|* Item Testing Cost Details
	table	ttxwip038		|* Inline &amp; Documentation Costs
	table	ttxwip039		|* Micro Test Materials Reference
	table	ttxwip040		|* QC Cost Simulations
	table	ttxwip041		|* Micro Retests
	table	ttxwip042		|* Micro Retest Details
	table	ttxwip043		|* Micro Retest Materials
	table	ttxwip044		|* Micro Retest Reagents
	table	ttxwip045		|* Pychem Retests
	table	ttxwip046		|* Pychem Retest Details
	table	ttxwip047		|* QC Cost Retest
	table	ttxwip048		|* QC Cost Simulation Retests	
	
	table	ttcibd001		|* Items
	table	ttcibd003		|* Conversion Factors
	table	ttdipu001		|* Item - Purchase
	table	ttcmcs003		|* Warehouses
	table	ttcmcs012		|* Units by Unit Set
	table	twhltc100		|* Lots
	table	twhltc101		|* Lot Cost Details
	table	twhltc105		|* Lots by Warehouse
	table	ttccom100		|* Business Partners
	table	ttisfc001		|* Production Orders
	table	tticpr007		|* Items - Costing

	extern domain tccwar		zoom.cwar
	extern domain tcnama		item.desc
	extern long			current.mtid.rt

|****************************** program section ********************************

| From Micro Retest Details txwip0500em28
before.program:
	import("txwip042.mtid", current.mtid.rt)
	import("zoom.cwar", zoom.cwar)

	if current.mtid.rt &lt;&gt; 0 then
		query.extend.where("txwip043.mtid = " &amp; str$(current.mtid.rt) &amp; "")
	endif
	
zoom.from.all:
on.entry:
	standard.commands.off(add.set, modify.set, update.db, end.program, first.set, next.set, prev.set, last.set)

after.form.read:
	if current.mtid.rt = 0 then
		remove.form.commands("save_close_total")
		remove.form.commands("load_micro_test_materials")
	endif

|****************************** field section **********************************
	
field.item.desc:
before.display:
	update_item_desc(txwip043.item)
	
|****************************** function section *******************************

functions:

function void update_item_desc(domain tcitem item){
	item.desc = get_item_desc(item)
}

function domain tcnama get_item_desc(domain tcitem item){
	select tcibd001.dsca
	from tcibd001
	where tcibd001.item = :item
	selectdo
		item.desc = tcibd001.dsca
	endselect
	
	return(item.desc)
}

function extern void save_close_total(){
	domain tcqiv1 total.mat.cost, total.rgt.cost, total
	long ret
	
	execute(15)
	
	total.mat.cost = 0
	total.rgt.cost = 0
	total = 0

	select sum(txwip043.csst):total.mat.cost
	from txwip043
	where txwip043.mtid = :current.mtid.rt
	selectdo
	endselect
	
	select txwip021.rgnt, txwip021.cssm
	from txwip021
	where exists
		(select txwip044.*
		 from txwip044
		 where txwip044.mtid = :current.mtid.rt
		 and txwip044.rgnt = txwip021.rgnt)
	selectdo
		total.rgt.cost = total.rgt.cost + txwip021.cssm
	endselect
	
	total = total.mat.cost + total.rgt.cost
	
	select txwip042.*
	from txwip042 for update
	where txwip042.mtid = :current.mtid.rt
	selectdo
		txwip042.mcst = total
		if db.update(ttxwip042, db.retry) &lt;&gt; 0 then
			message("Error " &amp; str$(e) &amp; " occurred while updating the record.")
			abort.transaction()
		endif
	endselect
	
	commit.transaction()
	ret = refresh.parent(-1)
	end()
}

function extern load_micro_test_materials(){
	export("current.mtid.rt", current.mtid.rt)
	start.session(MODAL_OVERVIEW, "txwip0500em23",  "txwip0500em29", "")
}</expression><expressionLanguageType>Baan4C</expressionLanguageType><sourceType>1</sourceType><sourceDescription>Micro Retest Materials</sourceDescription><sourceName>txwip0500em29</sourceName></Source><documentation/><Attachment><type>relnotes</type><name>txwip0500em29</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em29</name></Attachment><additionalConstraints>2590</additionalConstraints><additionalInstructions/><keyword>||</keyword><application>EXTce01107</application></DR_Module><startInCompanyZero>false</startInCompanyZero><repSevLang>false</repSevLang><mainSession>true</mainSession><moduleType>1</moduleType><windowType>6</windowType><subType>1</subType><status>1</status><documentation/><objectLabel/><application>EXTce01107</application><sessionReferenceDescriptionReference>txwip0500em29</sessionReferenceDescriptionReference><sessionReferenceDescription>Micro Retest Materials</sessionReferenceDescription><sessionReference>txwip0500em29</sessionReference><UIScript>txwip0500em29</UIScript></DR_Controller>