sExpired><isCheckedOutParallel>no</isCheckedOutParallel><isCheckedOut>no</isCheckedOut><modificationDateTime>2026-10-14T23:20:20Z</modificationDateTime><modifiedBy>ict004</modifiedBy><creationDateTime>2026-10-14T06:58:10Z</creationDateTime><createdBy>ict004</createdBy></sourceVersion><sourceVersionID>B61O_a_ext</sourceVersionID><sourceObjectID>1</sourceObjectID><expression>|*******************************************************************************
|* txwip0500em35  B61O_a_ext
|* QC Cost Retest Details
|* ict004
|* 2026-10-14 [02:58]
|*******************************************************************************
|* Script Type: 123
|*******************************************************************************

|*************************** declaration section *******************************
declaration:

	table	ttxwip020		|* QC Costs
	table	ttxwip021		|* Reagents	
	table	ttxwip022		|* Reagents Details
	table	ttxwip024		|* Micro Tests
	table	ttxwip025		|* Micro Test Details
	table	ttxwip026		|* QC Personnels
	table	ttxwip027		|* Micro Test Materials
	table	ttxwip028		|* Micro Test Reagents
	table	ttxwip030		|* Pychem Tests
	table	ttxwip031		|* Pychem Test Details
	table	ttxwip033		|* Third Party Tests
	table	ttxwip034		|* Third Party Test Details
	table	ttxwip035 		|* QC Items
	table	ttxwip036		|* Item Testing Costs
	table	ttxwip037		|* Item Testing Cost Details
	table	ttxwip038		|* Inline &amp; Documentation Costs
	table	ttxwip039		|* Micro Test Materials Reference
	table	ttxwip040		|* QC Cost Simulations
	table	ttxwip041		|* Micro Retests
	table	ttxwip042		|* Micro Retest Details
	table	ttxwip043		|* Micro Retest Materials
	table	ttxwip044		|* Micro Retest Reagents
	table	ttxwip045		|* Pychem Retests
	table	ttxwip046		|* Pychem Retest Details
	table	ttxwip047		|* QC Cost Retests
	table	ttxwip048		|* QC Cost Retest Details
	table	ttxwip049		|* QC Simulation Retests
	table	ttxwip050		|* QC Simulation Retest Details
	
	table	ttcibd001		|* Items
	table	ttcibd003		|* Conversion Factors
	table	ttdipu001		|* Item - Purchase
	table	ttcmcs003		|* Warehouses
	table	ttcmcs012		|* Units by Unit Set
	table	twhltc100		|* Lots
	table	twhltc101		|* Lot Cost Details
	table	twhltc105		|* Lots by Warehouse
	table	ttccom100		|* Business Partners
	table	ttisfc001		|* Production Orders
	table	tticpr007		|* Items - Costing
	
	extern domain tcmcs.str132	test.desc
	extern domain tcqiv1		test.cost
	extern domain tccwar		zoom.cwar
	extern domain tcpdno		zoom.pdno

|****************************** program section ********************************

before.program:
	import("txwip047.pdno", zoom.pdno)
	
main.table.io:
before.write:
	if txwip048.dcdt = 0 then
		txwip048.dcdt = utc.num()
	endif

before.rewrite:
	txwip048.dmdt = utc.num()
	
form.all:
init.form:
	if trim$(zoom.pdno) &lt;&gt; "" then
		standard.commands.off(add.set, update.db, end.program)
	endif

|****************************** field section **********************************

field.test.desc:
before.display:
	update_test_desc(txwip048.code)
	
field.test.cost:
before.display:
	update_test_cost(txwip048.code)
	
|****************************** function section *******************************

functions:

function update_test_cost(domain tcorno test.code){
	test.cost = get_test_cost(test.code)
}

function domain tcqiv1 get_test_cost(domain tcorno test.code){
	domain tcqiv1 cost
	
	cost = 0
	
	if str_pos(toupper$(trim$(test.code)), "M") &gt; 0 then
		select txwip041.pyst
		from txwip041
		where txwip041.anly = :test.code
		selectdo
			cost = txwip041.pyst
		selectempty
			cost = 0
		endselect
	endif
	
	if str_pos(toupper$(trim$(test.code)), "P") &gt; 0 then
		select txwip045.pyst
		from txwip045
		where txwip045.ptid = :test.code
		selectdo
			cost = txwip045.pyst
		selectempty
			cost = 0
		endselect
	endif
	
	return(cost)
}

function void update_test_desc(domain tcorno test.code){
	test.desc = get_test_desc(test.code)
}

function domain tcmcs.str100 get_test_desc(domain tcorno test.code){
	domain tcmcs.str100 desc
	
	desc = ""
	
	if str_pos(toupper$(trim$(test.code)), "M") &gt; 0 then
		select txwip024.anly
		from txwip024
		where txwip024.anly = :test.code
		selectdo
			desc = txwip024.anly
		selectempty
			desc = ""
		endselect
	endif
	
	if str_pos(toupper$(trim$(test.code)), "P") &gt; 0 then
		select txwip030.dscr
		from txwip030
		where txwip030.ptid = :test.code
		selectdo
			desc = txwip030.dscr
		selectempty
			desc = ""
		endselect
	endif
	
	if str_pos(toupper$(trim$(test.code)), "T") &gt; 0 then
		select txwip033.dscr
		from txwip033
		where txwip033.tpid = :test.code
		selectdo
			desc = txwip033.dscr
		selectempty
			desc = ""
		endselect
	endif
	
	return(desc)
}

function extern void load_micro_retests(){
	start.session(MODAL_OVERVIEW, "txwip0500em26",  "txwip0500em35", "")
}

function extern void load_pychem_retests(){
	start.session(MODAL_OVERVIEW, "txwip0500em31",  "txwip0500em35", "")
}
