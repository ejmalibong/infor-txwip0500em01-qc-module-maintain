4</inputDigitsBefore><linkDisplayDigitsBefore>true</linkDisplayDigitsBefore><displayDigitsBefore>15</displayDigitsBefore><minimumInputLength>0</minimumInputLength><displayFormatLinked>true</displayFormatLinked><displayFormat>%AQ20</displayFormat><fieldType>1</fieldType><domain/><element>1</element><fieldName>txwip022.rgst</fieldName><rowScreenPosition>1</rowScreenPosition><columnScreenPosition>22</columnScreenPosition><sequenceNumber>20</sequenceNumber></FormField><FormField><uuid>ae3a46f8-3745-485c-9db5-afbe70af9cb3</uuid><textDirection>10</textDirection><fieldAlignment>2</fieldAlignment><indexZoomSession>0</indexZoomSession><iconName/><additionalProperties2>0</additionalProperties2><additionalProperties1>1</additionalProperties1><autoEnableDisable>false</autoEnableDisable><behindEnumConstant>0</behindEnumConstant><hyperlink>false</hyperlink><searchDescription/><constantValueForYes>0</constantValueForYes><viewField>false</viewField><displayHeight>1</displayHeight><columnID>1</columnID><endXPosition>36</endXPosition><parentField>0</parentField><labelHeightOverview>1</labelHeightOverview><labelLengthOverview>999</labelLengthOverview><labelHeightDetail>1</labelHeightDetail><labelLengthDetail>20</labelLengthDetail><labelPosition>1</labelPosition><dependentOnParentField>false</dependentOnParentField><xPositionLabel>1</xPositionLabel><followUpField>0</followUpField><labelAlignment>2</labelAlignment><windowsControl>0</windowsControl><fieldBelowGrid>false</fieldBelowGrid><overviewSession>true</overviewSession><detailsSession>true</detailsSession><childFieldsBehind>false</childFieldsBehind><followUp>false</followUp><nextField>150</nextField><groupID>3</groupID><synchronizedField>false</synchronizedField><defaultValue/><inputReferenceExpression>1</inputReferenceExpression><fieldLabel>txwip022.slst</fieldLabel><languageUnitExpression/><mandatoryInput>false</mandatoryInput><sequenceMode>140</sequenceMode><fieldLength>14</fieldLength><echoField>true</echoField><message/><defaultExpression>false</defaultExpression><zoomReturnField/><zoomProgram/><zoomType>1</zoomType><startPositionString>1</startPositionString><linkInputDigitsBefore>true</linkInputDigitsBefore><inputDigitsBefore>4</inputDigitsBefore><linkDisplayDigitsBefore>true</linkDisplayDigitsBefore><displayDigitsBefore>15</displayDigitsBefore><minimumInputLength>0</minimumInputLength><displayFormatLinked>true</displayFormatLinked><displayFormat>%AQ20</displayFormat><fieldType>1</fieldType><domain/><element>1</element><fieldName>txwip022.slst</fieldName><rowScreenPosition>1</rowScreenPosition><columnScreenPosition>22</columnScreenPosition><sequenceNumber>21</sequenceNumber></FormField><FormGroup><selectionGroup>false</selectionGroup><parentTable/><miscellaneous>0</miscellaneous><nextToOtherGroup>false</nextToOtherGroup><checkBoxesOnly>false</checkBoxesOnly><formFormat>13</formFormat><subGroupOnNewPage>false</subGroupOnNewPage><nrSubGroups>1</nrSubGroups><firstChildGroup>3</firstChildGroup><virtualGroup>true</virtualGroup><groupAlignment>1</groupAlignment><firstField>0</firstField><nextGroup>0</nextGroup><previousGroup>0</previousGroup><parentGroup>0</parentGroup><overviewSession>true</overviewSession><detailsSession>true</detailsSession><showGroupBox>false</showGroupBox><groupHeader/><level>0</level><repeating>false</repeating><groupID>1</groupID></FormGroup><FormGroup><selectionGroup>false</selectionGroup><parentTable/><miscellaneous>0</miscellaneous><nextToOtherGroup>false</nextToOtherGroup><checkBoxesOnly>false</checkBoxesOnly><formFormat>13</formFormat><subGroupOnNewPage>false</subGroupOnNewPage><nrSubGroups>1</nrSubGroups><firstChildGroup>0</firstChildGroup><virtualGroup>false</virtualGroup><groupAlignment>-3</groupAlignment><firstField>10</firstField><nextGroup>0</nextGroup><previousGroup>0</previousGroup><parentGroup>1</parentGroup><overviewSession>true</overviewSession><detailsSession>true</detailsSession><showGroupBox>false</showGroupBox><groupHeader/><level>1</level><repeating>false</repeating><groupID>3</groupID></FormGroup></PhysicalFormLayout><description>Reagent Details</description><name>txwip0500em05d</name><horizontal>true</horizontal><custProhibited>false</custProhibited><additionalConstraints>1</additionalConstraints><documentation/><application>EXTce01106</application></Form><DR_Module><description>Reagent Details</description><versionID>B61O_a_ext</versionID><type>library</type><name>txwip0500em05</name><Version><ObjectID/><classID/><checkInLabel/><documentation/><isExpired>no</isExpired><isCheckedOutParallel>no</isCheckedOutParallel><isCheckedOut>no</isCheckedOut><modificationDateTime>2026-09-29T03:22:18Z</modificationDateTime><modifiedBy>ict004</modifiedBy><creationDateTime>2026-08-06T03:12:13Z</creationDateTime><createdBy>ict004</createdBy></Version><Source><sourceVersion><ObjectID/><classID/><checkInLabel/><documentation/><isExpired>no</isExpired><isCheckedOutParallel>no</isCheckedOutParallel><isCheckedOut>no</isCheckedOut><modificationDateTime>2026-09-29T03:22:18Z</modificationDateTime><modifiedBy>ict004</modifiedBy><creationDateTime>2026-08-06T03:12:13Z</creationDateTime><createdBy>ict004</createdBy></sourceVersion><sourceVersionID>B61O_a_ext</sourceVersionID><sourceObjectID>1</sourceObjectID><expression>|*******************************************************************************
|* txwip0500em05  B61O_a_ext
|* Reagent Details
|* ict004
|* 2026-08-06 [11:25]
|*******************************************************************************
|* Script Type: 123
|*******************************************************************************

|*************************** declaration section *******************************
declaration:

	table	ttxwip020		|* QC Cost Summary
	table	ttxwip021		|* Reagents Header	
	table	ttxwip022		|* Reagents Details
	table	ttxwip024		|* Micro Test Header
	table	ttxwip025		|* Micro Test Details
	table	ttxwip026		|* QC Personnel
	table	ttxwip027		|* Micro Test Materials
	table	ttxwip028		|* Micro Test Reagents
	table	ttxwip030		|* Pychem Test Header
	table	ttxwip031		|* Pychem Test Details
	table	ttxwip033		|* Third Party Test Header
	table	ttxwip034		|* Third Party Test Details
	table	ttxwip035 		|* QC Items
	table	ttxwip036		|* QC Cost Master Data
	table	ttxwip037		|* QC Cost Details
	table	ttxwip038		|* Inline &amp; Documentation Costs
	table	ttxwip039		|* Micro Test Materials Reference

	table	ttcibd001		|* Items
	table	ttcibd003		|* Conversion Factors
	table	ttccom100		|* Business Partners
	table	ttcmcs003		|* Warehouses
	table	ttcmcs012		|* Units by Unit Set
	table	ttdipu001		|* Item - Purchase
	table	ttisfc001		|* Production Orders
	table	twhltc100		|* Lots
	table	twhltc101		|* Lot Cost Details
	table	twhltc105		|* Lots by Warehouse
	table	tticpr007		|* Items - Costing
		
	extern long 			temp.id, save.id
	extern domain tcnama		item.desc, slvn.desc
	extern domain tccwar		cwar

|****************************** program section ********************************

before.program:
	| Initialize MTID tracking variables.
	| temp.id = temporary negative MTID for unsaved rows
	| save.id = highest existing MTID used as the base during Save
	temp.id = 0
	save.id = 0

main.table.io:
before.write:
	| Convert temporary negative ID to permanent positive ID
	| immediately before the new record is written to the database
	if txwip022.rgid &lt; 0 then
		save.id = save.id + 1
		txwip022.rgid = save.id
	endif

	if txwip022.dcdt = 0 then
		txwip022.dcdt = utc.num()
	endif

before.rewrite:
	txwip022.dmdt = utc.num()

|****************************** choice section *********************************

choice.add.set:
after.choice:
	| Handle rows created using the toolbar New button
	| Assign a temporary negative ID to the new occurrence
	if txwip022.rgid = 0 then
		set_temp_rgid()
	endif

choice.update.db:
before.choice:
	| Before saving, get the latest highest persisted ID
	| This becomes the starting point for permanent ID assignment
	save.id = 0

	select max(txwip022.rgid):save.id
	from txwip022
	selectdo
	endselect

|****************************** field section **********************************

field.txwip022.rgtp:
before.field:
	if txwip022.rgid = 0 then
		set_temp_rgid()
	endif

when.field.changes:
	if txwip022.rgtp = ltoe(0) then
		txwip022.item = ""
		item.desc = ""
		txwip022.rvol = 0
		txwip022.rgni = ""
	endif

	display("txwip022.item")
	display("item.desc")
	display("txwip022.rgni")
	display("txwip022.rvol")

field.txwip022.item:
before.zoom:
	update_reagent_zoom()

selection.filter:
	update_param_selection_filter(txwip022.rgtp)

after.zoom:
	if trim$(txwip022.item) &lt;&gt; "" then
		txwip022.item = trim$(txwip022.item)
		enable.fields("txwip022.rvol")

		if etol(txwip022.rgtp) = 1 then
			enable.fields("txwip022.rgni")
		else
			disable.fields("txwip022.rgni")
		endif
	endif

when.field.changes:
	if trim$(txwip022.item) &lt;&gt; "" then
		domain tcitem format.item
		update_param_desc("reagent")

		on case check_param_unit(txwip022.rgtp, trim$(txwip022.item))
			case 0:
				if check_param_base_unit(txwip022.rgtp, trim$(txwip022.item)) &gt; 0 then
					enable.fields("txwip022.rvol")
					enable.fields("txwip022.rgni")
					txwip022.rgni = get_param_base_unit(txwip022.rgtp, trim$(txwip022.item))
				else
					disable.fields("txwip022.rvol")
					disable.fields("txwip022.rgni")
					message("No conversion factor found for this item.")
				endif
				break
			case 1:
				on case etol(txwip022.rgtp)
					case 1:
						format.item = "         " &amp; trim$(txwip022.item)
						
						select tcibd001.item
						from tcibd001
						where tcibd001.item = :format.item
							and tcibd001.citg IN ("FG", "SFG", "RM/FG")
						selectdo
							enable.fields("txwip022.rvol")
							disable.fields("txwip022.rgni")
							txwip022.rgni = "G"
						selectempty
							enable.fields("txwip022.rvol")
							enable.fields("txwip022.rgni")
						endselect
						break
					case 2:
						enable.fields("txwip022.rvol")
						disable.fields("txwip022.rgni")
						txwip022.rgni = "ML"
						break
					case 3:
						enable.fields("txwip022.rvol")
						disable.fields("txwip022.rgni")
						txwip022.rgni = get_qc_param_unit(txwip022.rgtp, trim$(txwip022.item))
						break
					default:
						disable.fields("txwip022.rvol")
						disable.fields("txwip022.rgni")
				endcase
				break
			default:
				enable.fields("txwip022.rvol")
				enable.fields("txwip022.rgni")

				txwip022.rvol = 0
				txwip022.rgni = ""
				txwip022.rgst = 0
		endcase
	else
		item.desc = ""
		txwip022.rvol = 0
		txwip022.rgni = ""
	endif

field.item.desc:
before.display:
	update_param_desc("reagent")
	
field.txwip022.rvol:
when.field.changes:
	update_reagent_cost(txwip022.rgtp, txwip022.item, txwip022.rvol, txwip022.rgni)
	
field.txwip022.rgni:
before.zoom:
	update_unit_zoom(txwip022.rgtp)

selection.filter:
	update_zoom_selection_filter(txwip022.rgtp, trim$(txwip022.item))
	
when.field.changes:
	update_reagent_cost(txwip022.rgtp, txwip022.item, txwip022.rvol, txwip022.rgni)

field.txwip022.rgst:
before.display:
	update_reagent_cost(txwip022.rgtp, txwip022.item, txwip022.rvol, txwip022.rgni)
	
field.txwip022.sltp:
when.field.changes:
	if txwip022.sltp = ltoe(0) then
		txwip022.slvn = ""
		slvn.desc = ""
		txwip022.svol = 0
		txwip022.slni = ""
	endif

	display("txwip022.slvn")
	display("slvn.desc")
	display("txwip022.slni")
	display("txwip022.svol")

field.txwip022.slvn:
before.zoom:
	update_solvent_zoom()

selection.filter:
	update_param_selection_filter(txwip022.sltp)

after.zoom:
	if trim$(txwip022.slvn) &lt;&gt; "" then
		txwip022.slvn = trim$(txwip022.slvn)
		enable.fields("txwip022.svol")

		if etol(txwip022.sltp) = 1 then
			enable.fields("txwip022.slni")
		else
			disable.fields("txwip022.slni")
		endif
	endif

when.field.changes:
	if trim$(txwip022.slvn) &lt;&gt; "" then
		domain tcitem format.item
		update_param_desc("solvent")

		on case check_param_unit(txwip022.sltp, trim$(txwip022.slvn))
			case 0:
				if check_param_base_unit(txwip022.sltp, trim$(txwip022.slvn)) &gt; 0 then
					enable.fields("txwip022.svol")
					enable.fields("txwip022.slni")
					txwip022.slni = get_param_base_unit(txwip022.sltp, trim$(txwip022.slvn))
				else
					disable.fields("txwip022.svol")
					disable.fields("txwip022.slni")
					message("No conversion factor found for this item.")
				endif
				break
			case 1:
				on case etol(txwip022.sltp)
					case 1:
						format.item = "         " &amp; trim$(txwip022.slvn)
						
						select tcibd001.item
						from tcibd001
						where tcibd001.item = :format.item
							and tcibd001.citg IN ("FG", "SFG", "RM/FG")
						selectdo
							enable.fields("txwip022.svol")
							disable.fields("txwip022.slni")
							txwip022.rgni = "G"
						selectempty
							enable.fields("txwip022.svol")
							enable.fields("txwip022.slni")
						endselect
						break
					case 2:
						enable.fields("txwip022.svol")
						disable.fields("txwip022.slni")
						txwip022.slni = "ML"
						break
					case 3:
						enable.fields("txwip022.svol")
						disable.fields("txwip022.slni")
						txwip022.slni = get_qc_param_unit(txwip022.sltp, trim$(txwip022.slvn))
						break
					default:
						disable.fields("txwip022.svol")
						disable.fields("txwip022.slni")
				endcase
				break
			default:
				enable.fields("txwip022.svol")
				enable.fields("txwip022.slni")

				txwip022.svol = 0
				txwip022.slni = ""
				txwip022.slst = 0
		endcase	
	else
		slvn.desc = ""
		txwip022.svol = 0
		txwip022.slni = ""
	endif

field.slvn.desc:
before.display:
	update_param_desc("solvent")
	
field.txwip022.svol:
when.field.changes:
	update_solvent_cost(txwip022.sltp, txwip022.slvn, txwip022.svol, txwip022.slni)

field.txwip022.slni:
before.zoom:
	update_unit_zoom(txwip022.sltp)

selection.filter:
	update_zoom_selection_filter(txwip022.sltp, trim$(txwip022.slvn))
	
when.field.changes:
	update_solvent_cost(txwip022.sltp, txwip022.slvn, txwip022.svol, txwip022.slni)

field.txwip022.slst:
before.display:
	update_solvent_cost(txwip022.sltp, txwip022.slvn, txwip022.svol, txwip022.slni)

|****************************** function section *******************************

functions:

function void set_temp_rgid(){
	temp.id = temp.id - 1
	txwip022.rgid = temp.id
}

function void update_param_selection_filter(domain txmat.types param.type){
	on case etol(param.type)
		case 1:
			query.extend.where.in.zoom("tcibd001.citg IN (""600"",""FG"",""SFG"",""RM/FG"")")
			break
		case 2:
			query.extend.where.in.zoom("txwip021.rgnt &lt;&gt; '" &amp; txwip022.rgnt &amp; "'")
			break
		default:
	endcase
}

function void update_param_desc(domain tcmcs.str50 param){
	if trim$(param) = "reagent" then
		item.desc = get_param_desc(txwip022.rgtp, trim$(txwip022.item))
	else
		slvn.desc = get_param_desc(txwip022.sltp, trim$(txwip022.slvn))
	endif
}

function domain tcnama get_param_desc(domain txmat.types param.type, domain tcmcs.str50 param){
	domain tcnama desc
	
	desc = ""
	
	on case etol(param.type)
		case 1:
			select tcibd001.dsca
			from tcibd001
			where tcibd001.item = "         " &amp; :param
			selectdo
				desc = tcibd001.dsca
			endselect
			break
		case 2:
			select txwip021.dscr
			from txwip021
			where txwip021.rgnt = :param
			selectdo
				desc = txwip021.dscr
			endselect
			break
		case 3:
			select txwip035.dscr
			from txwip035
			where txwip035.qitm = :param
			selectdo
				desc = txwip035.dscr
			endselect
			break
		default:
			desc = ""
	endcase

	return(desc)
}

function long check_param_unit(domain txmat.types param.type, domain tcmcs.str50 param){
	domain tcitem format.item
	long cnt
	cnt = 0

	on case etol(param.type)
		case 1:
			format.item = "         " &amp; trim$(param)
			
			select tcibd001.item
			from tcibd001
			where tcibd001.item = :format.item
				and tcibd001.citg IN ("FG", "SFG", "RM/FG")
			selectdo
				cnt = 1
			selectempty
				select count(tcibd003.unit):cnt
				from tcibd003
				where tcibd003.item = :format.item
				selectdo
				endselect	
			endselect
			break
		case 2:
			cnt = 1
			break
		case 3:
			format.item = trim$(param)
			
			select count(txwip035.cuni):cnt
			from txwip035
			where txwip035.qitm = :format.item
			selectdo
			endselect
			break
		default:
			cnt = 0
	endcase

	return(cnt)
}

function domain tccuni get_qc_param_unit(domain txmat.types param.type, domain tcmcs.str50 param){
	domain tccuni unit

	unit = ""

	select txwip035.cuni
	from txwip035
	where txwip035.qitm = :param
	as set with 1 rows
	selectdo
		unit = txwip035.cuni
	selectempty
		unit = ""
	endselect

	return(unit)
}

function long check_param_base_unit(domain txmat.types param.type, domain tcmcs.str50 param){
	long cnt

	cnt = 0

	on case etol(param.type)
		case 1:
			select count(tcibd003.basu):cnt
			from tcibd003
			where tcibd003.item = "         " &amp; :param
			selectdo
			endselect
			break
		case 2:
			cnt = 0
			break
		case 3:
			cnt = 1
			break
		default:
			cnt = 0
	endcase

	return(cnt)
}

function domain tccuni get_param_base_unit(domain txmat.types param.type, domain tcmcs.str50 param){
	domain tccuni unit

	unit = ""

	on case etol(param.type)
		case 1:
			select tcibd003.basu
			from tcibd003
			where tcibd003.item =
				"         " &amp; :param
			as set with 1 rows
			selectdo
				unit = tcibd003.basu
			endselect
			break
		case 2:
			unit = ""
			break
		case 3:
			select txwip035.cuni
			from txwip035
			where txwip035.qitm = :param
			as set with 1 rows
			selectdo
				unit = txwip035.cuni
			endselect
			break
		default:
			unit = ""
	endcase

	return(unit)
}

function void update_unit_zoom(domain txmat.types param.type){
	on case etol(param.type)
		case 1:
			attr.zoomcode = 2
			attr.zoomsession$ = "tcibd0103m000"
			attr.zoomreturn$ = "tcibd003.unit"
			break
		case 2:
			attr.zoomcode = 0
			break
		case 3:
			attr.zoomcode = 0
			break
		default:
			attr.zoomcode = 0
	endcase
}

function void update_zoom_selection_filter(domain txmat.types param.type, domain tcmcs.str50 param){
	on case etol(param.type)
		case 1:
			query.extend.where.in.zoom("tcibd003.item = '" &amp; "         " &amp; param &amp; "'")
			break
		case 2:
			break
		case 3:
			break
		default:
	endcase
}

function void update_reagent_zoom(){
	on case etol(txwip022.rgtp)
		case 1:
			enable.fields("txwip022.item")
			attr.zoomcode = 2
			attr.zoomsession$ = "tcibd0501m000"
			attr.zoomreturn$ = "tcibd001.item"
			break
		case 2:
			enable.fields("txwip022.item")
			attr.zoomcode = 2
			attr.zoomsession$ = "txwip0500em03"
			attr.zoomreturn$ = "txwip021.rgnt"
			break
		case 3:
			enable.fields("txwip022.item")
			attr.zoomcode = 2
			attr.zoomsession$ = "txwip0500em06"
			attr.zoomreturn$ = "txwip035.qitm"
			break
		default:
			disable.fields("txwip022.item")
	endcase
}

function void update_solvent_zoom(){
	on case etol(txwip022.sltp)
		case 1:
			enable.fields("txwip022.slvn")
			attr.zoomcode = 2
			attr.zoomsession$ = "tcibd0501m000"
			attr.zoomreturn$ = "tcibd001.item"
			break
		case 2:
			enable.fields("txwip022.slvn")
			attr.zoomcode = 2
			attr.zoomsession$ = "txwip0500em03"
			attr.zoomreturn$ = "txwip021.rgnt"
			break
		case 3:
			enable.fields("txwip022.slvn")
			attr.zoomcode = 2
			attr.zoomsession$ = "txwip0500em06"
			attr.zoomreturn$ = "txwip035.qitm"
			break
		default:
			disable.fields("txwip022.slvn")
	endcase
}

function update_reagent_cost(domain txmat.types type, domain tcmcs.str50 param, domain tiqcp1 vol, domain tccuni unit){
	txwip022.rgst = compute_param_cost(type, param, vol, unit)
}

function update_solvent_cost(domain txmat.types type, domain tcmcs.str50 param, domain tiqcp1 vol, domain tccuni unit){
	txwip022.slst = compute_param_cost(type, param, vol, unit)
}

function domain tcqiv1 compute_param_cost(domain txmat.types type, domain tcmcs.str50 param, domain tiqcp1 vol, domain tccuni unit){
	domain tcqiv1 total, cost.per.testing
	domain tccopr item.lot.price
	domain tcconv conversion.value
	domain tcitem format.item
	
	total = 0
	
	on case etol(type)
		case 1:
			item.lot.price = 0
			conversion.value = 0
			cost.per.testing = 0
			
			format.item = "         " &amp; trim$(param)
			
			| Workaround to items that unable to have conversion
			| factors with an error message:
			| Change the value of the Unit field.
			| Reason: Define conversion factor on general level.
			
			| Add different computation if parameter is FG
			| Usually occur on Pychem tests
			select tcibd001.item
			from tcibd001
			where tcibd001.item = :format.item
				and tcibd001.citg IN ("FG", "SFG", "RM/FG")
			selectdo
				item.lot.price = get_item_standard_cost(format.item)
				conversion.value = 1000
				cost.per.testing = item.lot.price / conversion.value
				total = cost.per.testing * vol
			selectempty
				conversion.value = get_conversion_value(format.item, unit)
				item.lot.price = get_item_lot_price(format.item, cwar)
				
				if conversion.value = 0 then
					cost.per.testing = 0
					total = 0
				else
					cost.per.testing = item.lot.price / conversion.value
					total = cost.per.testing * vol
				endif	
			endselect
			break
		case 2:
			format.item = trim$(param)
			
			select txwip021.csst
			from txwip021
			where txwip021.rgnt = :format.item
			selectdo
				total = vol * txwip021.csst
			selectempty
				total = 0
			endselect
			break
		case 3:
			item.lot.price = 0
			conversion.value = 0
			cost.per.testing = 0
			
			format.item = trim$(param)
			
			select txwip035.prip
			from txwip035
			where txwip035.qitm = :format.item
			selectdo
				item.lot.price = txwip035.prip
			endselect
			
			if conversion.value = 0 then
				cost.per.testing = 0
				total = 0
			else
				cost.per.testing = item.lot.price / conversion.value
				total = cost.per.testing * vol
			endif
			break
		default:
			total = 0
	endcase
	
	return(total)
}

function domain tccopr get_item_standard_cost(domain tcitem item){
	domain tccopr cost
	cost = 0
	
	select ticpr007.ecpr
	from ticpr007
	where ticpr007.item = :item
	selectdo
		cost = ticpr007.ecpr(1)
	endselect
	
	return(cost)
}

function domain tccopr get_item_lot_price(domain tcitem item, domain tccwar cwar){
	domain tcclot lot.number
	domain tccopr item.lot.price
	domain tcitem format.item
	
	lot.number = ""
	item.lot.price = 0
	
	format.item = "         " &amp; trim$(item)
	
	| Get the first valid lot (FIFO)
	select whltc105.item, whltc105.clot, whltc105.ldat
	from whltc105
	where whltc105.item = :format.item
		and whltc105.cwar = :cwar
		and whltc105.qhnd &gt; 0				| With Inventory
		and whltc105.ldat &lt;&gt; 0
		and exists (
			select whltc100.clot
			from whltc100
			where whltc100.item = whltc105.item
				and whltc100.olot = 1		| Purchase
				and whltc100.ldat &lt;&gt; 0)		| Lot Date
	order by whltc105.ldat
	as set with 1 rows
	selectdo
		lot.number = whltc105.clot
	endselect
	
	select whltc100.item, whltc100.clot, whltc100.ldat
	from whltc100
	where whltc100.item = :format.item
		and whltc100.clot = :lot.number
		and whltc100.olot = 1				| Purchase
		and whltc100.ldat &lt;&gt; 0				| Lot Date
	as set with 1 rows
	selectdo
		item.lot.price = 0
		
		select sum(whltc101.pric(1)):item.lot.price
		from whltc101
		where whltc101.item = :format.item
			and whltc101.clot = :lot.number		| Lot No
			and whltc101.cpcp = "MC0002"	  	| Material Cost			
		as set with 1 rows
		selectdo
		selectempty
			item.lot.price = 0
		endselect
	selectempty
		item.lot.price = 0
	endselect

	return(item.lot.price)
}

function domain tcconv get_conversion_value(domain tcitem item, domain tccuni unit){
	domain tcconv value
	domain tcitem format.item
	
	value = 0
	
	format.item = "         " &amp; trim$(item)
	
	select tcibd003.conv
	from tcibd003
	where tcibd003.item = :format.item
		and tcibd003.unit = :unit
	as set with 1 rows
	selectdo
		value = tcibd003.conv
	selectempty
		value = 0
	endselect
	
	return(value)
}</expression><expressionLanguageType>Baan4C</expressionLanguageType><sourceType>1</sourceType><sourceDescription>Reagent Details</sourceDescription><sourceName>txwip0500em05</sourceName></Source><documentation/><Attachment><type>relnotes</type><name>txwip0500em05</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em05</name></Attachment><additionalConstraints>2590</additionalConstraints><additionalInstructions/><keyword>||</keyword><application>EXTce01106</application></DR_Module><startInCompanyZero>false</startInCompanyZero><repSevLang>false</repSevLang><mainSession>true</mainSession><moduleType>1</moduleType><windowType>6</windowType><subType>1</subType><status>1</status><documentation/><Attachment><type>relnotes</type><name>txwip0500em05</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em05</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em05ditem.desc</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em05ditem.desc</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em05dslvn.desc</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em05dslvn.desc</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em05dtxwip022.dc</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em05dtxwip022.dc</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em05dtxwip022.dm</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em05dtxwip022.dm</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em05dtxwip022.it</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em05dtxwip022.it</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em05dtxwip022.rg</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em05dtxwip022.rg</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em05dtxwip022.rg</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em05dtxwip022.rg</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em05dtxwip022.rg</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em05dtxwip022.rg</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em05dtxwip022.rg</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em05dtxwip022.rg</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em05dtxwip022.rg</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em05dtxwip022.rg</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em05dtxwip022.rv</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em05dtxwip022.rv</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em05dtxwip022.sl</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em05dtxwip022.sl</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em05dtxwip022.sl</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em05dtxwip022.sl</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em05dtxwip022.sl</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em05dtxwip022.sl</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em05dtxwip022.sl</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em05dtxwip022.sl</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em05dtxwip022.sv</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em05dtxwip022.sv</name></Attachment><objectLabel/><application>EXTce01106</application><sessionReferenceDescriptionReference>txwip0500em05</sessionReferenceDescriptionReference><sessionReferenceDescription>Reagent Details</sessionReferenceDescription><sessionReference>txwip0500em05</sessionReference><UIScript>txwip0500em05</UIScript></DR_Controller>