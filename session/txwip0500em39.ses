pression><zoomReturnField/><zoomProgram/><zoomType>1</zoomType><startPositionString>1</startPositionString><linkInputDigitsBefore>true</linkInputDigitsBefore><inputDigitsBefore>8</inputDigitsBefore><linkDisplayDigitsBefore>true</linkDisplayDigitsBefore><displayDigitsBefore>6</displayDigitsBefore><minimumInputLength>0</minimumInputLength><displayFormatLinked>true</displayFormatLinked><displayFormat>%.8@ZZZZZ9VD99999999@</displayFormat><fieldType>2</fieldType><domain/><element>1</element><fieldName>txwip051.conv</fieldName><rowScreenPosition>1</rowScreenPosition><columnScreenPosition>22</columnScreenPosition><sequenceNumber>22</sequenceNumber></FormField><FormGroup><selectionGroup>false</selectionGroup><parentTable/><miscellaneous>0</miscellaneous><nextToOtherGroup>false</nextToOtherGroup><checkBoxesOnly>false</checkBoxesOnly><formFormat>13</formFormat><subGroupOnNewPage>false</subGroupOnNewPage><nrSubGroups>1</nrSubGroups><firstChildGroup>0</firstChildGroup><virtualGroup>true</virtualGroup><groupAlignment>1</groupAlignment><firstField>10</firstField><nextGroup>0</nextGroup><previousGroup>0</previousGroup><parentGroup>0</parentGroup><overviewSession>true</overviewSession><detailsSession>true</detailsSession><showGroupBox>false</showGroupBox><groupHeader/><level>0</level><repeating>false</repeating><groupID>1</groupID></FormGroup></PhysicalFormLayout><description>QC Inventory</description><name>txwip0500em39d</name><horizontal>true</horizontal><custProhibited>false</custProhibited><additionalConstraints>1</additionalConstraints><documentation/><application>EXTce01108</application></Form><DR_Module><description>QC Inventory</description><versionID>B61O_a_ext</versionID><type>library</type><name>txwip0500em39</name><Version><ObjectID/><classID/><checkInLabel/><documentation/><isExpired>no</isExpired><isCheckedOutParallel>no</isCheckedOutParallel><isCheckedOut>no</isCheckedOut><modificationDateTime>2026-11-12T05:57:37Z</modificationDateTime><modifiedBy>ict004</modifiedBy><creationDateTime>2026-11-04T07:13:42Z</creationDateTime><createdBy>ict004</createdBy></Version><Source><sourceVersion><ObjectID/><classID/><checkInLabel/><documentation/><isExpired>no</isExpired><isCheckedOutParallel>no</isCheckedOutParallel><isCheckedOut>no</isCheckedOut><modificationDateTime>2026-11-12T05:57:37Z</modificationDateTime><modifiedBy>ict004</modifiedBy><creationDateTime>2026-11-04T07:13:42Z</creationDateTime><createdBy>ict004</createdBy></sourceVersion><sourceVersionID>B61O_a_ext</sourceVersionID><sourceObjectID>1</sourceObjectID><expression>|*******************************************************************************
|* txwip0500em39  B61O_a_ext
|* QC Inventory
|* ict004
|* 2026-11-04 [03:13]
|*******************************************************************************
|* Script Type: 123
|*******************************************************************************

|*************************** declaration section *******************************
declaration:

	table	ttxwip020		|* QC Costs
	table	ttxwip021		|* Reagents	
	table	ttxwip022		|* Reagents Details
	table	ttxwip024		|* Micro Tests
	table	ttxwip025		|* Micro Test Details
	table	ttxwip026		|* QC Personnels
	table	ttxwip027		|* Micro Test Materials
	table	ttxwip028		|* Micro Test Reagents
	table	ttxwip030		|* Pychem Tests
	table	ttxwip031		|* Pychem Test Details
	table	ttxwip033		|* Third Party Tests
	table	ttxwip034		|* Third Party Test Details
	table	ttxwip035 		|* QC Items
	table	ttxwip036		|* Item Testing Costs
	table	ttxwip037		|* Item Testing Cost Details
	table	ttxwip038		|* Inline &amp; Documentation Costs
	table	ttxwip039		|* Micro Test Materials Reference
	table	ttxwip040		|* QC Cost Simulations
	table	ttxwip041		|* Micro Retests
	table	ttxwip042		|* Micro Retest Details
	table	ttxwip043		|* Micro Retest Materials
	table	ttxwip044		|* Micro Retest Reagents
	table	ttxwip045		|* Pychem Retests
	table	ttxwip046		|* Pychem Retest Details
	table	ttxwip047		|* QC Cost Retest
	table	ttxwip048		|* QC Cost Simulation Retests
	table	ttxwip049		|* QC Simulation Retests
	table	ttxwip050		|* QC Simulation Retest Details
	table	ttxwip051 		|* QC Inventory

	table	ttcibd001		|* Items
	table	ttcibd003		|* Conversion Factors
	table	ttdipu001		|* Item - Purchase
	table	ttcmcs003		|* Warehouses
	table	ttcmcs012		|* Units by Unit Set
	table	twhltc100		|* Lots
	table	twhltc101		|* Lot Cost Details
	table	twhltc105		|* Lots by Warehouse
	table	ttccom100		|* Business Partners
	table	ttisfc001		|* Production Orders
	table	tticpr007		|* Items - Costing
	table	twhwmd300		|* Locations
	
	extern domain tcdsca		item.desc, cwar.desc, loca.desc
		
|****************************** program section ********************************


|****************************** field section **********************************

field.item.desc:
before.display:
	update_item_desc(txwip051.ittp, txwip051.item)

field.cwar.desc:
before.display:
	update_cwar_desc(txwip051.cwar)

field.loca.desc:
before.display:
	update_loca_desc(txwip051.cwar, txwip051.loca)
	
|****************************** function section *******************************

functions:

function update_item_desc(domain txmat.types type, domain tcmcs.str50 item){
	item.desc = get_item_desc(type, item)
}

function domain tcdsca get_item_desc(domain txmat.types type, domain tcmcs.str50 item){
	domain tcdsca desc
	domain tcmcs.str50 format.item
	
	desc = ""
	format.item = ""
	
	on case etol(type)
		case 1:
			format.item = "         " &amp; trim$(item)
			
			select tcibd001.dsca
			from tcibd001
			where tcibd001.item = :format.item
			as set with 1 rows
			selectdo
				desc = tcibd001.dsca
			endselect
			break
			
		case 2:
			format.item = trim$(item)
			
			select txwip021.dscr
			from txwip021
			where txwip021.rgnt = :format.item
			as set with 1 rows
			selectdo
				desc = txwip021.dscr 
			endselect
			break
			
		case 3:
			format.item = trim$(item)
			
			select txwip035.dscr
			from txwip035
			where txwip035.qitm = :format.item
			as set with 1 rows
			selectdo
				desc = txwip035.dscr
			endselect
			break
	endcase
	
	return(desc)
}

function update_cwar_desc(domain tccwar cwar){
	cwar.desc = get_cwar_desc(cwar)
}

function domain tcdsca get_cwar_desc(domain tccwar cwar){
	domain tcdsca desc
	
	desc = ""
	
	select tcmcs003.dsca
	from tcmcs003
	where tcmcs003.cwar = :cwar
	as set with 1 rows
	selectdo
		desc = tcmcs003.dsca
	endselect
	
	return(desc)
}

function update_loca_desc(domain tccwar cwar, domain whloca loca){
	loca.desc = get_loca_desc(cwar, loca)
}

function domain tcdsca get_loca_desc(domain tccwar cwar, domain whloca loca){
	domain tcdsca desc
	
	desc = ""
	
	select whwmd300.dsca
	from whwmd300
	where whwmd300.cwar = :cwar
		and whwmd300.loca = :loca
	as set with 1 rows
	selectdo
		desc = whwmd300.dsca
	endselect
	
	return(desc)
}</expression><expressionLanguageType>Baan4C</expressionLanguageType><sourceType>1</sourceType><sourceDescription>QC Inventory</sourceDescription><sourceName>txwip0500em39</sourceName></Source><documentation/><Attachment><type>relnotes</type><name>txwip0500em39</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em39</name></Attachment><additionalConstraints>2610</additionalConstraints><additionalInstructions/><keyword>||</keyword><application>EXTce01108</application></DR_Module><startInCompanyZero>false</startInCompanyZero><repSevLang>false</repSevLang><mainSession>true</mainSession><moduleType>1</moduleType><windowType>6</windowType><subType>5</subType><status>1</status><documentation/><Attachment><type>relnotes</type><name>txwip0500em39</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em39</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em39dcwar.desc</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em39dcwar.desc</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em39ditem.desc</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em39ditem.desc</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em39dloca.desc</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em39dloca.desc</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em39dtxwip051.ba</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em39dtxwip051.ba</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em39dtxwip051.cl</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em39dtxwip051.cl</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em39dtxwip051.co</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em39dtxwip051.co</name></Attachment><Attachment><type>relnotes</type><name>txwip0500em39dtxwip051.cu</name></Attachment><Attachment><type>techdoc</type><name>txwip0500em39dtxwip051.cu</name></