	EndFunctionUsage

	domain	ttxmlnode	fields

	fields = xmlNewNode("FIELDS")

	ext.get.form.fields.from.table.selection(fields)
	ext.get.form.fields.from.secondary.tables(fields)
	ext.get.form.fields.from.calculated.fields(fields)
	ext.get.form.fields.from.custom.fields(fields)

	return(fields)
}

