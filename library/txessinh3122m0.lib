#include	&lt;bic_interface&gt;

#define	ICM.NULL	"___null___"

| Hook declarations
#context_on "declarations"
    table                       ttcmcs003       |* Warehouses
    table                       ttxwip024       |* Micro Tests
    table                       ttxwip025       |* Micro Test Details
    table                       ttxwip027       |* Micro Test Materials
    table                       ttxwip030       |* Pychem Tests
    table                       ttxwip031       |* Pychem Test Details
    table                       ttxwip037       |* Item Testing Cost Details
    table                       ttxwip051       |* QC Inventory
    table                       ttxwip052       |* QC Inventory Details
    table                       ttcibd003       |* Item Conversion Factors
    table                       twhltc101       |* Lot Cost Details
    table                       twhinh211       |* Warehouse Inspection
    table                       ttisfc001       |* Production Orders
    table                       ttcibd001       |* Items
    table                       twhltc105       |* Lots by Warehouse

    extern domain tccwar        qc.warehouse
    extern domain whloca        qc.location
    extern domain tcitem        inspected.item, formatted.item
    extern domain tcorno        inspection.number
    extern domain tcpono        inspection.sequence
    extern domain tcpdno        production.order

    extern domain tcqiv1        required.quantity, available.quantity, remaining.quantity
    extern domain tcqiv1        total.demand, conversion.value

    extern domain tccuni        inventory.unit, consumption.unit

    extern domain tcmcs.long    inventory.id, detail.id

    extern long                 validation.result, process.result
#context_off

| Additional generated declaration lines
table	ttcibd001
table	ttcmcs003
table	twhinh200

| Hook functions
#context_on "functions"
| Resolve the QC warehouse based on the main warehouse description.
function extern domain tccwar get_equivalent_cwar(domain tccwar cwar){
    domain tccwar jo.cwar

    jo.cwar = ""

    select tcmcs003.dsca
    from tcmcs003
    where tcmcs003.cwar = :cwar
    as set with 1 rows
    selectdo
        if str_pos(toupper$(trim$(tcmcs003.dsca)), "SITE 1") &gt; 0 then
            jo.cwar = "1CS001"
        endif

        if str_pos(toupper$(trim$(tcmcs003.dsca)), "SITE 2") &gt; 0 then
            jo.cwar = "1PS001"
        endif
    endselect

    return(jo.cwar)
}

| Resolve QC inventory location based on QC warehouse.
function extern domain whloca get_location(domain tccwar cwar){
    if cwar = "1CS001" then
        return("110S1QCD01")
    endif

    if cwar = "1PS001" then
        return("110S2QCD01")
    endif

    return("")
}

| Get the inventory base unit for a component item.
| FG, SFG, RM/FG and RM use KG as their inventory unit.
| Other items use the base unit stored in QC inventory.
function extern domain tccuni get_inventory_unit(
    domain tcitem item,
    domain tccwar cwar,
    domain whloca loca
){
    domain tccuni unit
    domain tcitem formatted.item
    domain tcitem inventory.item

    unit = ""

    | Standard LN item-master formatting.
    formatted.item = "         " &amp; trim$(item)

    | QC inventory stores the item without the nine-character prefix.
    inventory.item = trim$(item)

    | Preserve the existing category-based KG rule.
    select tcibd001.item
    from tcibd001
    where tcibd001.item = :formatted.item
        and tcibd001.citg in ("FG", "SFG", "RM/FG", "RM")
    as set with 1 rows
    selectdo
        unit = "KG"

    selectempty

        | Resolve the base unit from available QC inventory.
        select txwip051.*
        from txwip051
        where txwip051.item = :inventory.item
            and txwip051.cwar = :cwar
            and txwip051.loca = :loca
            and txwip051.ittp = 1
            and txwip051.qava &gt; 0
            and txwip051.basu &lt;&gt; ""
        order by txwip051.idat, txwip051.inid
        as set with 1 rows
        selectdo
            unit = txwip051.basu

        selectempty

            | Receipt-created records may have blank basu.
            | Resolve the base unit from item conversion data.
            select tcibd003.basu
            from tcibd003
            where tcibd003.item = :formatted.item
                and tcibd003.appr = 1
            as set with 1 rows
            selectdo
                unit = tcibd003.basu
            endselect

        endselect
    endselect

    return(unit)
}

| Get the conversion factor for a component item.
| basu = inventory base unit.
| unit = consumption or inventory quantity unit.
function extern domain tcconv get_inventory_conversion(domain tcitem item, domain tccuni basu, domain tccuni unit){
    domain tcconv conversion.value
    domain tcitem formatted.item

    conversion.value = 0
    formatted.item = "         " &amp; trim$(item)

    | Preserve the existing category-specific KG conversion rule.
    select tcibd001.item
    from tcibd001
    where tcibd001.item = :formatted.item
        and tcibd001.citg in ("FG", "SFG", "RM/FG", "RM")
    as set with 1 rows
    selectdo
        conversion.value = 1000
    selectempty

        if basu = unit then
            conversion.value = 1
        else
            select tcibd003.conv
            from tcibd003
            where tcibd003.item = :formatted.item
                and tcibd003.basu = :basu
                and tcibd003.unit = :unit
                and tcibd003.appr = 1
            as set with 1 rows
            selectdo
                conversion.value = tcibd003.conv
            endselect
        endif
    endselect

    return(conversion.value)
}

| Resolve the conversion factor for one QC inventory record.
| Prefer the conversion stored in txwip051.
| Fall back to the approved item conversion when receipt data has no conversion.
function extern domain tcconv get_inventory_row_conversion(domain tcitem item, domain tccuni basu, domain tccuni unit, domain tcconv stored.conversion){
    domain tcconv conversion.value

    conversion.value = 0

    if basu = unit then
        conversion.value = 1
    else
        if stored.conversion &gt; 0 then
            conversion.value = stored.conversion
        else
            conversion.value = get_inventory_conversion(item, basu, unit)
        endif
    endif

    return(conversion.value)
}

| Get lot price.
| whltc101 has no warehouse field.
| Warehouse and location filtering is performed against txwip051.
function extern domain tccopr get_inventory_lot_price(
    domain tcitem item,
    domain tcclot clot,
    domain tccwar cwar
){
    domain tccopr lot.price
    domain tcitem formatted.item

    lot.price = 0
    formatted.item = "         " &amp; trim$(item)

    select sum(whltc101.pric(1)):lot.price
    from whltc101, whltc105
    where whltc101.item = :formatted.item
        and whltc101.clot = :clot
        and whltc101.cpcp = "MC0002"
        and whltc105.item = :formatted.item
        and whltc105.clot = :clot
        and whltc105.cwar = :cwar
    as set with 1 rows
    selectdo
    endselect

    return(lot.price)
}

| Calculate aggregate base-unit demand for one component item.
|
| Includes:
|   - Micro Per Batch materials.
|   - Pychem standard-item materials.
|
| Excludes:
|   - Micro reagents and QC items.
|   - Pychem reagents and QC items.
|
| The returned quantity is expressed in the inventory base unit.
| A negative result indicates a conversion error.
function extern domain tcqiv1 get_total_base_demand(domain tcitem item, domain tccwar cwar, domain whloca loca){
    domain tcqiv1 total.demand
    domain tcconv conversion.value
    domain tccuni inventory.unit
    domain tcitem formatted.item
    long conversion.error

    total.demand = 0
    conversion.error = 0

    inventory.unit = get_inventory_unit(item, cwar, loca)
    formatted.item = "         " &amp; trim$(inspected.item)

    if trim$(inventory.unit) = "" then
        return(-1)
    endif

    | Micro materials: Per Batch only.
    select txwip037.code
    from txwip037
    where txwip037.item = :formatted.item
        and txwip037.cwar = :cwar
    selectdo

        select txwip024.anly
        from txwip024
        where txwip024.anly = :txwip037.code
            and txwip024.freq = 2
        selectdo

            select txwip025.mtid
            from txwip025
            where txwip025.anly = :txwip024.anly
            selectdo

                select txwip027.tsmm, txwip027.cuni
                from txwip027
                where txwip027.mtid = :txwip025.mtid
                    and txwip027.item = :item
                selectdo

                    if txwip027.tsmm &gt; 0 then
                        conversion.value = get_inventory_conversion(item, inventory.unit, txwip027.cuni)

                        if conversion.value &lt;= 0 then
                            conversion.error = 1
                        else
                            total.demand = total.demand + (txwip027.tsmm / conversion.value)
                        endif
                    endif

                endselect

            endselect

        endselect

    endselect

    | Pychem materials: standard items only.
    select txwip037.code
    from txwip037
    where txwip037.item = :formatted.item
        and txwip037.cwar = :cwar
    selectdo

        select txwip030.ptid
        from txwip030
        where txwip030.ptid = :txwip037.code
        selectdo

            select txwip031.aqsm
            from txwip031
            where txwip031.ptid = :txwip030.ptid
                and txwip031.mttp = 1
                and txwip031.mtrl = :item
            selectdo

                if txwip031.aqsm &gt; 0 then
                    conversion.value = get_inventory_conversion(item, inventory.unit, "ML")

                    if conversion.value &lt;= 0 then
                        conversion.error = 1
                    else
                        total.demand = total.demand + (txwip031.aqsm / conversion.value)
                    endif
                endif

            endselect

        endselect

    endselect

    if conversion.error = 1 then
        return(-1)
    endif

    return(total.demand)
}

| Validate inventory for one component item.
|
| Demand and available inventory are both converted to the inventory base unit.
| Each inventory record uses its own cuni and conv.
| No inventory is modified by this function.
function extern long validate_inventory_item(
    domain tcitem item,
    domain tccwar cwar,
    domain whloca loca
){
    domain tcqiv1 total.demand
    domain tcqiv1 available.quantity
    domain tcqiv1 remaining.quantity
    domain tcqiv1 lot.quantity
    domain tcqiv1 base.quantity
    domain tcqiv1 lot.price
    domain tcconv conversion.value
    domain tccuni inventory.unit
    domain tcitem formatted.item
    long validation.error

    total.demand = 0
    available.quantity = 0
    remaining.quantity = 0
    lot.quantity = 0
    base.quantity = 0
    lot.price = 0
    validation.error = 0

    inventory.unit = get_inventory_unit(item, cwar, loca)

    | QC inventory stores the item without the nine-character prefix.
    formatted.item = trim$(item)

    if trim$(inventory.unit) = "" then
        message("No QC inventory unit found for item: " &amp; trim$(item))
        return(0)
    endif

    total.demand = get_total_base_demand(item, cwar, loca)

    if total.demand &lt; 0 then
        message("Missing approved unit conversion for item: " &amp; trim$(item))
        return(0)
    endif

    if total.demand = 0 then
        return(1)
    endif

    | Calculate available stock in the inventory base unit.
    select txwip051.qava,
           txwip051.basu,
           txwip051.cuni,
           txwip051.conv
    from txwip051
    where txwip051.item = :formatted.item
        and txwip051.cwar = :cwar
        and txwip051.loca = :loca
        and txwip051.ittp = 1
        and txwip051.qava &gt; 0
    selectdo

        if txwip051.basu &lt;&gt; "" and txwip051.basu &lt;&gt; inventory.unit then
            validation.error = 1
        else
            conversion.value = get_inventory_row_conversion(
                item,
                inventory.unit,
                txwip051.cuni,
                txwip051.conv
            )

            if conversion.value &lt;= 0 then
                validation.error = 1
            else
                available.quantity =
                    available.quantity + (txwip051.qava / conversion.value)
            endif
        endif

    endselect

    if validation.error = 1 then
        message("Invalid or missing inventory conversion for item: " &amp; trim$(item))
        return(0)
    endif

    if available.quantity &lt; total.demand then
        message(
            "Insufficient QC inventory for item: " &amp; trim$(item) &amp;
            ". Required: " &amp; str$(total.demand) &amp;
            ", Available: " &amp; str$(available.quantity)
        )
        return(0)
    endif

    | Validate FIFO lot prices before inventory updates.
    remaining.quantity = total.demand

    select txwip051.*
    from txwip051
    where txwip051.item = :formatted.item
        and txwip051.cwar = :cwar
        and txwip051.loca = :loca
        and txwip051.ittp = 1
        and txwip051.qava &gt; 0
    order by txwip051.idat, txwip051.inid
    selectdo

        if remaining.quantity &gt; 0 then

            conversion.value = get_inventory_row_conversion(
                item,
                inventory.unit,
                txwip051.cuni,
                txwip051.conv
            )

            if conversion.value &lt;= 0 then
                validation.error = 1
            else
                base.quantity = txwip051.qava / conversion.value

                if base.quantity &gt;= remaining.quantity then
                    lot.quantity = remaining.quantity
                else
                    lot.quantity = base.quantity
                endif

                if lot.quantity &gt; 0 then
                    lot.price = get_inventory_lot_price(
                        item,
                        txwip051.clot,
                        cwar
                    )

                    if lot.price &lt;= 0 then
                        message(
                            "Missing lot cost for item: " &amp; trim$(item) &amp;
                            ", Lot: " &amp; trim$(txwip051.clot)
                        )
                        validation.error = 1
                    else
                        remaining.quantity = remaining.quantity - lot.quantity
                    endif
                endif
            endif

        endif

    endselect

    if validation.error = 1 then
        return(0)
    endif

    if remaining.quantity &gt; 0 then
        message("Unable to validate FIFO inventory for item: " &amp; trim$(item))
        return(0)
    endif

    return(1)
}

| Get next detail ID for one inventory transaction.
function extern domain tcmcs.long get_next_inventory_detail_id(domain tcmcs.long inid){
    domain tcmcs.long next.id

    next.id = 0

    select max(txwip052.dlid):next.id
    from txwip052
    where txwip052.inid = :inid
    as set with 1 rows
    selectdo
    endselect

    next.id = next.id + 1

    return(next.id)
}


| Process one material consumption.
|
| qtty = original consumption quantity.
| unit = original consumption unit.
|
| bqty = converted inventory base quantity.
| Inventory is deducted in FIFO order.
function extern long process_inventory_material(
    domain tcitem item,
    domain tcqiv1 qtty,
    domain tccuni unit,
    domain tccwar cwar,
    domain whloca loca,
    domain tcorno apno,
    domain tcpono apsq,
    domain tcpdno pdno
){
    domain tcqiv1 remaining.quantity
    domain tcqiv1 base.quantity
    domain tcqiv1 row.quantity
    domain tcqiv1 row.base.quantity
    domain tcqiv1 lot.price
    domain tcconv demand.conversion
    domain tcconv row.conversion
    domain tccuni inventory.unit
    domain tcitem formatted.item
    domain tcmcs.long detail.id
    domain tcdate transaction.date

    remaining.quantity = 0
    base.quantity = 0
    row.quantity = 0
    row.base.quantity = 0
    lot.price = 0

    inventory.unit = get_inventory_unit(item, cwar, loca)

    | QC inventory stores the item without the nine-character prefix.
    formatted.item = trim$(item)

    if trim$(inventory.unit) = "" then
        return(0)
    endif

    demand.conversion = get_inventory_conversion(item, inventory.unit, unit)

    if demand.conversion &lt;= 0 then
        message(
            "Missing approved unit conversion for item: " &amp; trim$(item) &amp;
            ", Unit: " &amp; trim$(unit)
        )
        return(0)
    endif

    | Convert the requested consumption quantity to inventory base unit.
    remaining.quantity = qtty / demand.conversion

    | Allocate inventory using FIFO order.
    select txwip051.*
    from txwip051 for update
    where txwip051.item = :formatted.item
        and txwip051.cwar = :cwar
        and txwip051.loca = :loca
        and txwip051.ittp = 1
        and txwip051.qava &gt; 0
    order by txwip051.idat, txwip051.inid
    selectdo

        if remaining.quantity &gt; 0 then

            if txwip051.basu &lt;&gt; "" and txwip051.basu &lt;&gt; inventory.unit then
                message("Inventory base-unit mismatch for item: " &amp; trim$(item))
                return(0)
            endif

            row.conversion = get_inventory_row_conversion(
                item,
                inventory.unit,
                txwip051.cuni,
                txwip051.conv
            )

            if row.conversion &lt;= 0 then
                message(
                    "Missing inventory conversion for item: " &amp; trim$(item) &amp;
                    ", Unit: " &amp; trim$(txwip051.cuni)
                )
                return(0)
            endif

            | Convert available inventory quantity to base unit.
            row.base.quantity = txwip051.qava / row.conversion

            if row.base.quantity &gt;= remaining.quantity then
                base.quantity = remaining.quantity
            else
                base.quantity = row.base.quantity
            endif

            if base.quantity &gt; 0 then

                | Convert allocated base quantity to the inventory row unit.
                row.quantity = base.quantity * row.conversion

                lot.price = get_inventory_lot_price(
                    item,
                    txwip051.clot,
                    cwar
                )

                if lot.price &lt;= 0 then
                    message(
                        "Missing lot cost for item: " &amp; trim$(item) &amp;
                        ", Lot: " &amp; trim$(txwip051.clot)
                    )
                    return(0)
                endif

                | Deduct available quantity only.
                txwip051.qava = txwip051.qava - row.quantity
                txwip051.dmdt = utc.num()

                db.update(ttxwip051, db.retry)

                | Create consumption detail for this FIFO allocation.
                detail.id = get_next_inventory_detail_id(txwip051.inid)
                transaction.date = utc.num()

                txwip052.inid = txwip051.inid
                txwip052.dlid = detail.id
                txwip052.trtp = ltoe(2)
                txwip052.qtty = row.quantity
                txwip052.unit = txwip051.cuni
                txwip052.apno = apno
                txwip052.apsq = apsq
                txwip052.pdno = pdno
                txwip052.dcdt = transaction.date
                txwip052.dmdt = transaction.date

                db.insert(ttxwip052, db.retry)

                remaining.quantity = remaining.quantity - base.quantity

            endif

        endif

    endselect

    if remaining.quantity &gt; 0 then
        message("Insufficient QC inventory during FIFO processing for item: " &amp; trim$(item))
        return(0)
    endif

    return(1)
}

| Process all Micro standard-item materials for the inspection.
function extern long process_micro_materials(domain tccwar cwar, domain whloca loca, domain tcorno apno, domain tcpono apsq, domain tcpdno pdno){
    long result
    domain tcitem formatted.item

    result = 1
    formatted.item = "         " &amp; trim$(inspected.item)

    | Resolve mapped Micro test codes.
    select txwip037.code
    from txwip037
    where txwip037.item = :formatted.item
        and txwip037.cwar = :cwar
    selectdo

        select txwip024.anly
        from txwip024
        where txwip024.anly = :txwip037.code
            and txwip024.freq = 2
        selectdo

            select txwip025.mtid
            from txwip025
            where txwip025.anly = :txwip024.anly
            selectdo

                select txwip027.item,
                       txwip027.tsmm,
                       txwip027.cuni
                from txwip027
                where txwip027.mtid = :txwip025.mtid
                selectdo

                    if trim$(txwip027.item) &lt;&gt; "" and txwip027.tsmm &gt; 0 then

                        result = process_inventory_material(txwip027.item, txwip027.tsmm, txwip027.cuni, cwar, loca, apno, apsq, pdno)

                        if result = 0 then
                            return(0)
                        endif

                    endif

                endselect

            endselect

        endselect

    endselect

    return(result)
}

| Process all Pychem standard-item materials for the inspection.
function extern long process_pychem_materials(domain tccwar cwar, domain whloca loca, domain tcorno apno, domain tcpono apsq, domain tcpdno pdno){
    long result
    domain tcitem formatted.item

    result = 1
    formatted.item = "         " &amp; trim$(inspected.item)

    | Resolve mapped Pychem test codes.
    select txwip037.code
    from txwip037
    where txwip037.item = :formatted.item
        and txwip037.cwar = :cwar
    selectdo

        select txwip030.ptid
        from txwip030
        where txwip030.ptid = :txwip037.code
        selectdo

            select txwip031.mtrl,
                   txwip031.aqsm
            from txwip031
            where txwip031.ptid = :txwip030.ptid
                and txwip031.mttp = 1
            selectdo

                if trim$(txwip031.mtrl) &lt;&gt; "" and txwip031.aqsm &gt; 0 then

                    result = process_inventory_material(txwip031.mtrl, txwip031.aqsm, "ML", cwar, loca, apno, apsq, pdno)

                    if result = 0 then
                        return(0)
                    endif

                endif

            endselect

        endselect

    endselect

    return(result)
}

function extern long load_inventory_inspection_context(){

    inspection.number = whinh211.apno
    inspection.sequence = whinh211.apsq
    production.order = whinh211.orno
    inspected.item = trim$(whinh211.item)

    if trim$(inspection.number) = "" then
        message("Warehouse inspection number is missing.")
        return(0)
    endif

    if trim$(production.order) = "" then
        message("Production order is missing from the warehouse inspection.")
        return(0)
    endif

    if trim$(inspected.item) = "" then
        message("Inspected item is missing from the warehouse inspection.")
        return(0)
    endif

    qc.warehouse = get_equivalent_cwar(whinh211.cwar)

    if trim$(qc.warehouse) = "" then
        message("Unable to resolve QC warehouse for main warehouse: " &amp; trim$(whinh211.cwar))
        return(0)
    endif

    qc.location = get_location(qc.warehouse)

    if trim$(qc.location) = "" then
        message("Unable to resolve QC inventory location for warehouse: " &amp; trim$(qc.warehouse))
        return(0)
    endif

    return(1)
}


function extern long is_inventory_consumption_processed(){
    long already.processed

    already.processed = 0

    select txwip052.inid
    from txwip052
    where txwip052.apno = :inspection.number
        and txwip052.apsq = :inspection.sequence
        and txwip052.pdno = :production.order
        and txwip052.trtp = 2
    as set with 1 rows
    selectdo
        already.processed = 1
    endselect

    return(already.processed)
}


function extern long validate_inspection_inventory(){
    domain tcitem formatted.item

    formatted.item = "         " &amp; trim$(inspected.item)

    | Validate Micro Per Batch materials.
    select txwip037.code
    from txwip037
    where txwip037.item = :formatted.item
        and txwip037.cwar = :qc.warehouse
    selectdo

        select txwip024.anly
        from txwip024
        where txwip024.anly = :txwip037.code
            and txwip024.freq = 2
        selectdo

            select txwip025.mtid
            from txwip025
            where txwip025.anly = :txwip024.anly
            selectdo

                select txwip027.item
                from txwip027
                where txwip027.mtid = :txwip025.mtid
                selectdo

                    if trim$(txwip027.item) &lt;&gt; "" then

                        validation.result = validate_inventory_item(
                            txwip027.item,
                            qc.warehouse,
                            qc.location
                        )

                        if validation.result = 0 then
                            return(0)
                        endif

                    endif

                endselect

            endselect

        endselect

    endselect

    | Validate Pychem standard-item materials.
    select txwip037.code
    from txwip037
    where txwip037.item = :formatted.item
        and txwip037.cwar = :qc.warehouse
    selectdo

        select txwip030.ptid
        from txwip030
        where txwip030.ptid = :txwip037.code
        selectdo

            select txwip031.mtrl
            from txwip031
            where txwip031.ptid = :txwip030.ptid
                and txwip031.mttp = 1
            selectdo

                if trim$(txwip031.mtrl) &lt;&gt; "" then

                    validation.result = validate_inventory_item(
                        txwip031.mtrl,
                        qc.warehouse,
                        qc.location
                    )

                    if validation.result = 0 then
                        return(0)
                    endif

                endif

            endselect

        endselect

    endselect

    return(1)
}
#context_off

function extern boolean ext.is.cdfs.of.ref.tables.selected()
{
	FunctionUsage
		Get the value of the "include.cdfs.of.ref.tables" property of the session extension.
	EndFunctionUsage

	return(true)
}

| Hook function.approve.and.process.before.command
#context_on "function.approve.and.process.before.command"
function extern void function.approve.and.process.before.command(){

    long already.processed

    | Only production warehouse inspections consume QC inventory.
    if whinh211.oorg &lt;&gt; ltoe(50) then
        return
    endif

    | Load and validate inspection context.
    if load_inventory_inspection_context() = 0 then
        choice.again()
        return
    endif

    | Prevent duplicate consumption.
    already.processed = is_inventory_consumption_processed()

    if already.processed = 1 then
        return
    endif

    | Validate every applicable material before standard approval.
    if validate_inspection_inventory() = 0 then
        choice.again()
        return
    endif

}
#context_off

| Hook function.approve.and.process.after.command
#context_on "function.approve.and.process.after.command"
function extern void function.approve.and.process.after.command(){

    long already.processed

    | Only production warehouse inspections consume QC inventory.
    if whinh211.oorg &lt;&gt; ltoe(50) then
        return
    endif

    | Reload inspection context.
    if load_inventory_inspection_context() = 0 then
        return
    endif

    | Prevent duplicate consumption.
    already.processed = is_inventory_consumption_processed()

    if already.processed = 1 then
        return
    endif

    | Revalidate because stock may have changed after Before Command.
    if validate_inspection_inventory() = 0 then
        message("QC inventory consumption was not posted for inspection: " &amp; trim$(inspection.number))
        return
    endif

    | Process Micro materials.
    process.result = process_micro_materials(
        qc.warehouse,
        qc.location,
        inspection.number,
        inspection.sequence,
        production.order
    )

    if process.result = 0 then
        message("Error processing Micro QC inventory consumption for inspection: " &amp; trim$(inspection.number))
        return
    endif

    | Process Pychem materials.
    process.result = process_pychem_materials(
        qc.warehouse,
        qc.location,
        inspection.number,
        inspection.sequence,
        production.order
    )

    if process.result = 0 then
        message("Error processing Pychem QC inventory consumption for inspection: " &amp; trim$(inspection.number))
        return
    endif

    | Commit QC inventory consumption.
    commit.transaction()

    message("QC inventory consumption completed for inspection: " &amp; trim$(inspection.number))

}
#context_off

