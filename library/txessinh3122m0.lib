| Hook functions
#context_on "functions"
function extern domain tccwar get_equivalent_cwar(domain tccwar cwar){
    domain tccwar jo.cwar

    jo.cwar = ""

    select tcmcs003.dsca
    from tcmcs003
    where tcmcs003.cwar = :cwar
    as set with 1 rows
    selectdo
        if str_pos(toupper$(trim$(tcmcs003.dsca)), "SITE 1") &gt; 0 then
            jo.cwar = "1CS001"
        endif

        if str_pos(toupper$(trim$(tcmcs003.dsca)), "SITE 2") &gt; 0 then
            jo.cwar = "1PS001"
        endif
    endselect

    return(jo.cwar)
}

| Resolve QC inventory location based on QC warehouse.
function extern domain whloca get_location(domain tccwar cwar){
    if cwar = "1CS001" then
        return("110S1QCD01")
    endif

    if cwar = "1PS001" then
        return("110S2QCD01")
    endif

    return("")
}

| Determines the inventory base unit for a given component item or reagent.
|  
| Resolution Rules:
| - FG, SFG, RM/FG, and RM use KG.
| - All other items use the base unit stored in QC inventory.
| 
| QC Inventory Consumption Reference:
| - Inventory Types:
|     1 = Item
|     2 = Reagent
| - Reagent Specifications:
|     - Base Unit = ML
|     - Conversion Unit = ML
|     - Available Qty = txwip021.aqsm
function extern domain tccuni get_inventory_unit(
    domain txmat.types type,
    domain tcmcs.str50 item,
    domain tccwar cwar,
    domain whloca loca
){
    domain tccuni unit
    domain tcitem formatted.item
    domain tcitem inventory.item

    unit = ""
    formatted.item = ""
    inventory.item = trim$(item)

    on case etol(type)

        case 1:

            formatted.item = "         " &amp; trim$(item)

            | FG, SFG, RM/FG and RM use KG as their inventory unit.
            select tcibd001.item
            from tcibd001
            where tcibd001.item = :formatted.item
                and tcibd001.citg in ("FG", "SFG", "RM/FG", "RM")
            as set with 1 rows
            selectdo
                unit = "KG"

            selectempty

                | Resolve the base unit from available QC inventory.
                select txwip051.*
                from txwip051
                where txwip051.item = :inventory.item
                    and txwip051.cwar = :cwar
                    and txwip051.loca = :loca
                    and txwip051.ittp = 1
                    and txwip051.qava &gt; 0
                    and txwip051.basu&lt;&gt; ""
                order by txwip051.idat, txwip051.inid
                as set with 1 rows
                selectdo
                    unit = txwip051.basu

                selectempty

                    select tcibd003.basu
                    from tcibd003
                    where tcibd003.item = :formatted.item
                        and tcibd003.appr = 1
                    as set with 1 rows
                    selectdo
                        unit = tcibd003.basu
                    endselect

                endselect

            endselect

            break

        case 2:

            | Reagent inventory is maintained in ML.
            unit = "ML"
            break

        default:

            unit = ""
            break

    endcase

    return(unit)
}

| Get the conversion factor for an item or reagent.
function extern domain tcconv get_inventory_conversion(
    domain txmat.types type,
    domain tcmcs.str50 item,
    domain tccuni basu,
    domain tccuni unit
){
    domain tcconv conversion.value
    domain tcitem formatted.item

    conversion.value = 0
    formatted.item = "         " &amp; trim$(item)

    on case etol(type)

        case 1:

            | Preserve the category-specific KG conversion rule.
            select tcibd001.item
            from tcibd001
            where tcibd001.item = :formatted.item
                and tcibd001.citg in ("FG", "SFG", "RM/FG", "RM")
            as set with 1 rows
            selectdo
                conversion.value = 1000

            selectempty

                if basu = unit then
                    conversion.value = 1
                else
                    select tcibd003.conv
                    from tcibd003
                    where tcibd003.item = :formatted.item
                        and tcibd003.basu = :basu
                        and tcibd003.unit = :unit
                        and tcibd003.appr = 1
                    as set with 1 rows
                    selectdo
                        conversion.value = tcibd003.conv
                    endselect
                endif

            endselect

            break

        case 2:

            | Reagents are maintained in ML.
            if basu = "ML" and unit = "ML" then
                conversion.value = 1
            endif

            break

        default:

            conversion.value = 0
            break

    endcase

    return(conversion.value)
}

| Resolve conversion for one inventory record.
function extern domain tcconv get_inventory_row_conversion(
    domain txmat.types type,
    domain tcmcs.str50 item,
    domain tccuni basu,
    domain tccuni unit,
    domain tcconv stored.conversion
){
    domain tcconv conversion.value

    conversion.value = 0

    if basu = unit then
        conversion.value = 1
    else
        if stored.conversion &gt; 0 then
            conversion.value = stored.conversion
        else
            conversion.value = get_inventory_conversion(
                type,
                item,
                basu,
                unit
            )
        endif
    endif

    return(conversion.value)
}

| Get lot price.
| whltc101 has no warehouse field.
| Warehouse and location filtering is performed against txwip051.
function extern domain tccopr get_inventory_lot_price(
    domain tcitem item,
    domain tcclot clot,
    domain tccwar cwar
){
    domain tccopr lot.price
    domain tcitem formatted.item

    lot.price = 0
    formatted.item = "         " &amp; trim$(item)

    select sum(whltc101.pric(1)):lot.price
    from whltc101, whltc105
    where whltc101.item = :formatted.item
        and whltc101.clot = :clot
        and whltc101.cpcp = "MC0002"
        and whltc105.item = :formatted.item
        and whltc105.clot = :clot
        and whltc105.cwar = :cwar
    as set with 1 rows
    selectdo
    endselect

    return(lot.price)
}

|===============================================================================
| Calculate physical inventory demand from a reagent formulation.
|
| NONRECURSIVE IMPLEMENTATION
|
| Rules:
| 1. Stockable reagents (aqsm &lt;&gt; 1) are consumed directly.
| 2. Derived reagents (aqsm = 1) are expanded through txwip022.
| 3. Type 1 = Physical item.
| 4. Type 2 = Reagent.
| 5. Type 3 = QC item (ignored).
| 6. Both component and solution branches are processed.
| 7. Quantity is scaled using the reagent's prepared output (aqsm).
| 8. A fixed LIFO stack replaces recursive function calls.
|
| Return:
|   &gt;= 0 : Physical demand for the specified target item/reagent.
|   -1   : Invalid formulation, conversion, or traversal.
|
| Existing function signature is preserved.
|===============================================================================
function domain tcqiv1 get_reagent_component_demand(
    domain txmat.types target.type,
    domain tcmcs.str50 target.item,
    domain tcmcs.str50 reagent,
    domain tcqiv1 quantity,
    domain tccuni quantity.unit,
    domain tccwar cwar,
    domain whloca loca,
    long depth
){
    domain tcmcs.str50 stack.reagent(256)
    domain tccuni stack.unit(256)
    domain tcqiv1 stack.quantity(256)
    long stack.depth(256)

    domain tcmcs.str50 current.reagent
    domain tccuni current.unit
    domain tcqiv1 current.quantity
    long current.depth

    domain tcqiv1 reagent.aqsm
    domain tcqiv1 base.quantity
    domain tcqiv1 component.quantity
    domain tcqiv1 total.demand

    domain txmat.types component.type
    domain tcmcs.str50 component.item
    domain tccuni component.unit
    domain tcqiv1 component.volume

    domain tccuni target.unit
    domain tcconv conversion.value

    long stack.top
    long branch
    long formula.found
    long processed.nodes

    total.demand = 0
    stack.top = 0
    processed.nodes = 0

    if quantity &lt;= 0 then
        return(0)
    endif

    if trim$(reagent) = "" then
        message("Reagent code is missing.")
        return(-1)
    endif

    target.unit = get_inventory_unit(
        target.type,
        target.item,
        cwar,
        loca
    )

    if trim$(target.unit) = "" then
        message(
            "Inventory unit not found for: " &amp;
            trim$(target.item)
        )
        return(-1)
    endif

    | Initialize traversal stack (string-array first subscript = 1).
    stack.top = 1
    stack.reagent(1, 1) = trim$(reagent)
    stack.unit(1, 1) = quantity.unit
    stack.quantity(1) = quantity
    stack.depth(1) = depth

    while stack.top &gt; 0

        processed.nodes = processed.nodes + 1

        if processed.nodes &gt; 10000 then
            message("Reagent formulation traversal limit exceeded.")
            return(-1)
        endif

        current.reagent = stack.reagent(1, stack.top)
        current.unit = stack.unit(1, stack.top)
        current.quantity = stack.quantity(stack.top)
        current.depth = stack.depth(stack.top)

        stack.top = stack.top - 1

        if current.depth &gt; 20 then
            message(
                "Reagent formulation depth exceeded: " &amp;
                trim$(current.reagent)
            )
            return(-1)
        endif

        if current.quantity &gt; 0 then

            reagent.aqsm = 0

            select txwip021.aqsm
            from txwip021
            where txwip021.rgnt = :current.reagent
                and txwip021.cwar = :cwar
            as set with 1 rows
            selectdo
                reagent.aqsm = txwip021.aqsm
            selectempty
                message(
                    "Reagent master not found: " &amp;
                    trim$(current.reagent)
                )
                return(-1)
            endselect

            if reagent.aqsm &lt;= 0 then
                message(
                    "Invalid reagent output quantity: " &amp;
                    trim$(current.reagent)
                )
                return(-1)
            endif

            |---------------------------------------------------------------
            | Stockable reagent: stop formulation expansion.
            |---------------------------------------------------------------

            if reagent.aqsm &lt;&gt; 1 then

                if etol(target.type) = 2 and
                    trim$(target.item) = trim$(current.reagent) then

                    conversion.value = get_inventory_conversion(
                        target.type,
                        target.item,
                        target.unit,
                        current.unit
                    )

                    if conversion.value &lt;= 0 then
                        message(
                            "Invalid reagent unit conversion: " &amp;
                            trim$(current.reagent)
                        )
                        return(-1)
                    endif

                    total.demand = total.demand +
                        (current.quantity / conversion.value)

                endif

            else

                |-----------------------------------------------------------
                | Derived reagent: expand formulation.
                |-----------------------------------------------------------

                conversion.value = get_inventory_conversion(
                    ltoe(2),
                    current.reagent,
                    "ML",
                    current.unit
                )

                if conversion.value &lt;= 0 then
                    message(
                        "Invalid reagent unit conversion: " &amp;
                        trim$(current.reagent)
                    )
                    return(-1)
                endif

                base.quantity =
                    current.quantity / conversion.value

                formula.found = 0

                select txwip022.rgtp,
                       txwip022.item,
                       txwip022.rvol,
                       txwip022.rgni,
                       txwip022.sltp,
                       txwip022.slvn,
                       txwip022.svol,
                       txwip022.slni
                from txwip022
                where txwip022.rgnt = :current.reagent
                selectdo

                    formula.found = formula.found + 1

                    | Process component and solution branches.
                    for branch = 1 to 2

                        if branch = 1 then
                            component.type = txwip022.rgtp
                            component.item = trim$(txwip022.item)
                            component.volume = txwip022.rvol
                            component.unit = txwip022.rgni
                        else
                            component.type = txwip022.sltp
                            component.item = trim$(txwip022.slvn)
                            component.volume = txwip022.svol
                            component.unit = txwip022.slni
                        endif

                        if component.volume &lt; 0 then
                            message(
                                "Negative formulation quantity: " &amp;
                                trim$(current.reagent)
                            )
                            return(-1)
                        endif

                        if component.volume &gt; 0 then

                            component.quantity =
                                base.quantity *
                                (component.volume / reagent.aqsm)

                            |-----------------------------------------------
                            | Type 1: Physical inventory item.
                            |-----------------------------------------------

                            if etol(component.type) = 1 then

                                if trim$(component.item) = "" then
                                    message(
                                        "Missing formulation item: " &amp;
                                        trim$(current.reagent)
                                    )
                                    return(-1)
                                endif

                                if etol(target.type) = 1 and
                                    trim$(target.item) =
                                        trim$(component.item) then

                                    conversion.value =
                                        get_inventory_conversion(
                                            target.type,
                                            target.item,
                                            target.unit,
                                            component.unit
                                        )

                                    if conversion.value &lt;= 0 then
                                        message(
                                            "Invalid item conversion: " &amp;
                                            trim$(component.item)
                                        )
                                        return(-1)
                                    endif

                                    total.demand = total.demand +
                                        (
                                            component.quantity /
                                            conversion.value
                                        )

                                endif

                            endif

                            |-----------------------------------------------
                            | Type 2: Reagent.
                            |-----------------------------------------------

                            if etol(component.type) = 2 then

                                if trim$(component.item) = "" then
                                    message(
                                        "Missing reagent component: " &amp;
                                        trim$(current.reagent)
                                    )
                                    return(-1)
                                endif

                                if trim$(component.unit) = "" then
                                    message(
                                        "Missing reagent unit: " &amp;
                                        trim$(component.item)
                                    )
                                    return(-1)
                                endif

                                if stack.top &gt;= 256 then
                                    message(
                                        "Reagent traversal stack exceeded."
                                    )
                                    return(-1)
                                endif

                                stack.top = stack.top + 1

                                stack.reagent(1, stack.top) =
                                    component.item

                                stack.unit(1, stack.top) =
                                    component.unit

                                stack.quantity(stack.top) =
                                    component.quantity

                                stack.depth(stack.top) =
                                    current.depth + 1

                            endif

                            | Type 3: QC item. No physical consumption.
                            | Type 0: No component.

                        endif

                    endfor

                endselect

                if formula.found = 0 then
                    message(
                        "No formulation found for derived reagent: " &amp;
                        trim$(current.reagent)
                    )
                    return(-1)
                endif

            endif

        endif

    endwhile

    return(total.demand)
}

| Calculates the aggregate base-unit demand for a specified inventory item.
|
| Item Classifications:
|   Type 1 - Micro per-batch materials and Pychem standard items.
|   Type 2 - Micro reagents and Pychem reagents.
|
| Return Value:
|   Expressed in the inventory base unit.
|   A negative value indicates missing or invalid conversion/master data.
function extern domain tcqiv1 get_total_base_demand(
    domain txmat.types type,
    domain tcmcs.str50 item,
    domain tccwar cwar,
    domain whloca loca
){
    domain tcqiv1 total.demand
    domain tcqiv1 reagent.quantity
    domain tcqiv1 component.demand

    domain tcconv conversion.value

    domain tccuni inventory.unit

    domain tcitem formatted.item
    domain tcmcs.str50 reagent.code

    long conversion.error

    total.demand = 0
    conversion.error = 0

    inventory.unit = get_inventory_unit(
        type,
        item,
        cwar,
        loca
    )

    if trim$(inventory.unit) = "" then
        return(-1)
    endif

    formatted.item = "         " &amp; trim$(inspected.item)

    |===============================================================
    | MICRO TESTS
    |===============================================================

    select txwip037.code
    from txwip037
    where txwip037.item = :formatted.item
        and txwip037.cwar = :cwar
    selectdo

        select txwip024.anly
        from txwip024
        where txwip024.anly = :txwip037.code
            and txwip024.freq = 2
        selectdo

            select txwip025.mtid
            from txwip025
            where txwip025.anly = :txwip024.anly
            selectdo

                |---------------------------------------------------
                | MICRO STANDARD MATERIALS
                |---------------------------------------------------

                if etol(type) = 1 then

                    select txwip027.tsmm,
                           txwip027.cuni
                    from txwip027
                    where txwip027.mtid = :txwip025.mtid
                        and txwip027.item = :item
                    selectdo

                        if txwip027.tsmm &gt; 0 then

                            conversion.value = get_inventory_conversion(
                                type,
                                item,
                                inventory.unit,
                                txwip027.cuni
                            )

                            if conversion.value &lt;= 0 then
                                conversion.error = 1
                            else
                                total.demand =
                                    total.demand +
                                    (
                                        txwip027.tsmm /
                                        conversion.value
                                    )
                            endif

                        endif

                    endselect

                endif

                |---------------------------------------------------
                | MICRO REAGENTS
                |---------------------------------------------------

                select txwip028.rgnt
                from txwip028
                where txwip028.mtid = :txwip025.mtid
                selectdo

                    reagent.code = trim$(txwip028.rgnt)

                    if reagent.code &lt;&gt; "" then

                        select txwip021.mult
                        from txwip021
                        where txwip021.rgnt = :reagent.code
                            and txwip021.cwar = :cwar
                        as set with 1 rows
                        selectdo

                            reagent.quantity = txwip021.mult

                            if reagent.quantity &lt;= 0 then
                                conversion.error = 1
                            else

                                component.demand =
                                    get_reagent_component_demand(
                                        type,
                                        item,
                                        reagent.code,
                                        reagent.quantity,
                                        "ML",
                                        cwar,
                                        loca,
                                        0
                                    )

                                if component.demand &lt; 0 then
                                    conversion.error = 1
                                else
                                    total.demand =
                                        total.demand +
                                        component.demand
                                endif

                            endif

                        selectempty
                            conversion.error = 1
                        endselect

                    endif

                endselect

            endselect

        endselect

    endselect

    |===============================================================
    | PYCHEM TESTS
    |===============================================================

    select txwip037.code
    from txwip037
    where txwip037.item = :formatted.item
        and txwip037.cwar = :cwar
    selectdo

        select txwip030.ptid
        from txwip030
        where txwip030.ptid = :txwip037.code
        selectdo

            select txwip031.mttp,
                   txwip031.mtrl,
                   txwip031.aqsm
            from txwip031
            where txwip031.ptid = :txwip030.ptid
            selectdo

                |---------------------------------------------------
                | PYCHEM STANDARD MATERIALS
                |---------------------------------------------------

                if etol(type) = 1 and
                    txwip031.mttp = ltoe(1) and
                    trim$(txwip031.mtrl) = trim$(item) and
                    txwip031.aqsm &gt; 0 then

                    conversion.value = get_inventory_conversion(
                        type,
                        item,
                        inventory.unit,
                        "ML"
                    )

                    if conversion.value &lt;= 0 then
                        conversion.error = 1
                    else
                        total.demand =
                            total.demand +
                            (
                                txwip031.aqsm /
                                conversion.value
                            )
                    endif

                endif

                |---------------------------------------------------
                | PYCHEM REAGENTS
                |---------------------------------------------------

                if txwip031.mttp = ltoe(2) and
                    trim$(txwip031.mtrl) &lt;&gt; "" and
                    txwip031.aqsm &gt; 0 then

                    component.demand =
                        get_reagent_component_demand(
                            type,
                            item,
                            txwip031.mtrl,
                            txwip031.aqsm,
                            "ML",
                            cwar,
                            loca,
                            0
                        )

                    if component.demand &lt; 0 then
                        conversion.error = 1
                    else
                        total.demand =
                            total.demand +
                            component.demand
                    endif

                endif

            endselect

        endselect

    endselect

    if conversion.error = 1 then
        return(-1)
    endif

    return(total.demand)
}

| Validate inventory for one item or reagent.
|
| Demand and available inventory are both converted to the inventory base unit.
| Each inventory record uses its own cuni and conv.
| No inventory is modified by this function.
function extern long validate_inventory_item(
    domain txmat.types type,
    domain tcmcs.str50 item,
    domain tccwar cwar,
    domain whloca loca
){
    domain tcqiv1 total.demand
    domain tcqiv1 available.quantity
    domain tcqiv1 remaining.quantity
    domain tcqiv1 lot.quantity
    domain tcqiv1 base.quantity
    domain tcqiv1 lot.price
    domain tcconv conversion.value
    domain tccuni inventory.unit
    domain tcmcs.str50 formatted.item
    long validation.error

    total.demand = 0
    available.quantity = 0
    remaining.quantity = 0
    lot.quantity = 0
    base.quantity = 0
    lot.price = 0
    validation.error = 0

    inventory.unit = get_inventory_unit(
        type,
        item,
        cwar,
        loca
    )

    formatted.item = trim$(item)

    if trim$(inventory.unit) = "" then
        message(
            "No QC inventory unit found for item/reagent: " &amp;
            trim$(item)
        )
        return(0)
    endif

    total.demand = get_total_base_demand(
        type,
        item,
        cwar,
        loca
    )

    if total.demand&lt; 0 then
        message(
            "Missing or invalid unit conversion/master data for item/reagent: " &amp;
            trim$(item)
        )
        return(0)
    endif

    if total.demand = 0 then
        return(1)
    endif

    | qava is already stored in basu.
    select txwip051.qava,
           txwip051.basu,
           txwip051.cuni,
           txwip051.conv
    from txwip051
    where txwip051.item = :formatted.item
        and txwip051.cwar = :cwar
        and txwip051.loca = :loca
        and txwip051.ittp = :type
        and txwip051.qava &gt; 0
    selectdo

        if txwip051.basu&lt;&gt; "" and
            txwip051.basu&lt;&gt; inventory.unit then

            validation.error = 1

        else

            conversion.value = get_inventory_row_conversion(
                type,
                item,
                inventory.unit,
                txwip051.cuni,
                txwip051.conv
            )

            if conversion.value&lt;= 0 then
                validation.error = 1
            else
                available.quantity =
                    available.quantity + txwip051.qava
            endif

        endif

    endselect

    if validation.error = 1 then
        message(
            "Invalid or missing inventory conversion for item/reagent: " &amp;
            trim$(item)
        )
        return(0)
    endif

    if available.quantity&lt; total.demand then
        message(
            "Insufficient QC inventory for item/reagent: " &amp;
            trim$(item) &amp;
            ". Required: " &amp; str$(total.demand) &amp;
            ", Available: " &amp; str$(available.quantity)
        )
        return(0)
    endif

    | Validate FIFO allocation.
    remaining.quantity = total.demand

    select txwip051.*
    from txwip051
    where txwip051.item = :formatted.item
        and txwip051.cwar = :cwar
        and txwip051.loca = :loca
        and txwip051.ittp = :type
        and txwip051.qava &gt; 0
    order by txwip051.idat, txwip051.inid
    selectdo

        if remaining.quantity &gt; 0 then

            conversion.value = get_inventory_row_conversion(
                type,
                item,
                inventory.unit,
                txwip051.cuni,
                txwip051.conv
            )

            if conversion.value&lt;= 0 then

                validation.error = 1

            else

                base.quantity = txwip051.qava

                if base.quantity &gt;= remaining.quantity then
                    lot.quantity = remaining.quantity
                else
                    lot.quantity = base.quantity
                endif

                if lot.quantity &gt; 0 then

                    | Reagents do not use LN lot-cost records.
                    | Their inventory is maintained in ML.
                    if etol(type) = 1 then

                        lot.price = get_inventory_lot_price(
                            item,
                            txwip051.clot,
                            cwar
                        )

                        if lot.price&lt;= 0 then

                            message(
                                "Missing lot cost for item: " &amp;
                                trim$(item) &amp;
                                ", Lot: " &amp;
                                trim$(txwip051.clot)
                            )

                            validation.error = 1

                        endif

                    endif

                    if validation.error = 0 then
                        remaining.quantity =
                            remaining.quantity - lot.quantity
                    endif

                endif

            endif

        endif

    endselect

    if validation.error = 1 then
        return(0)
    endif

    if remaining.quantity &gt; 0 then
        message(
            "Unable to validate FIFO inventory for item/reagent: " &amp;
            trim$(item)
        )
        return(0)
    endif

    return(1)
}

function long validate_reagent_formula(
    domain tcmcs.str50 reagent,
    domain tccwar cwar,
    domain whloca loca,
    long depth
){
    domain tcmcs.str50 stack.reagent(256)
    long stack.depth(256)

    domain tcmcs.str50 current.reagent
    domain tcmcs.str50 component.item
    domain txmat.types component.type
    domain tcqiv1 component.quantity
    domain tcqiv1 reagent.aqsm

    long stack.top
    long current.depth
    long branch
    long formula.found
    long processed.nodes
    long result

    stack.top = 1
    stack.reagent(1, 1) = trim$(reagent)
    stack.depth(1) = depth
    processed.nodes = 0

    while stack.top &gt; 0

        processed.nodes = processed.nodes + 1

        if processed.nodes &gt; 10000 then
            message("Reagent validation traversal limit exceeded.")
            return(0)
        endif

        current.reagent = stack.reagent(1, stack.top)
        current.depth = stack.depth(stack.top)

        stack.top = stack.top - 1

        if current.depth &gt; 20 then
            message(
                "Reagent validation depth exceeded: " &amp;
                trim$(current.reagent)
            )
            return(0)
        endif

        reagent.aqsm = 0

        select txwip021.aqsm
        from txwip021
        where txwip021.rgnt = :current.reagent
            and txwip021.cwar = :cwar
        as set with 1 rows
        selectdo
            reagent.aqsm = txwip021.aqsm
        selectempty
            message(
                "Reagent master not found: " &amp;
                trim$(current.reagent)
            )
            return(0)
        endselect

        if reagent.aqsm &lt;= 0 then
            message(
                "Invalid reagent output quantity: " &amp;
                trim$(current.reagent)
            )
            return(0)
        endif

        |---------------------------------------------------------------
        | Stockable reagent: validate aggregated inventory demand.
        |---------------------------------------------------------------

        if reagent.aqsm &lt;&gt; 1 then

            result = validate_inventory_item(
                ltoe(2),
                current.reagent,
                cwar,
                loca
            )

            if result = 0 then
                return(0)
            endif

        else

            |-----------------------------------------------------------
            | Derived reagent: inspect formulation components.
            |-----------------------------------------------------------

            formula.found = 0

            select txwip022.rgtp,
                   txwip022.item,
                   txwip022.rvol,
                   txwip022.sltp,
                   txwip022.slvn,
                   txwip022.svol
            from txwip022
            where txwip022.rgnt = :current.reagent
            selectdo

                formula.found = formula.found + 1

                for branch = 1 to 2

                    if branch = 1 then
                        component.type = txwip022.rgtp
                        component.item = trim$(txwip022.item)
                        component.quantity = txwip022.rvol
                    else
                        component.type = txwip022.sltp
                        component.item = trim$(txwip022.slvn)
                        component.quantity = txwip022.svol
                    endif

                    if component.quantity &lt; 0 then
                        message(
                            "Negative formulation quantity: " &amp;
                            trim$(current.reagent)
                        )
                        return(0)
                    endif

                    if component.quantity &gt; 0 then

                        |---------------------------------------------------
                        | Physical item.
                        |---------------------------------------------------

                        if etol(component.type) = 1 then

                            if trim$(component.item) = "" then
                                message(
                                    "Missing formulation item: " &amp;
                                    trim$(current.reagent)
                                )
                                return(0)
                            endif

                            result = validate_inventory_item(
                                ltoe(1),
                                component.item,
                                cwar,
                                loca
                            )

                            if result = 0 then
                                return(0)
                            endif

                        endif

                        |---------------------------------------------------
                        | Child reagent.
                        |---------------------------------------------------

                        if etol(component.type) = 2 then

                            if trim$(component.item) = "" then
                                message(
                                    "Missing reagent component: " &amp;
                                    trim$(current.reagent)
                                )
                                return(0)
                            endif

                            if stack.top &gt;= 256 then
                                message(
                                    "Reagent validation stack exceeded."
                                )
                                return(0)
                            endif

                            stack.top = stack.top + 1

                            stack.reagent(1, stack.top) =
                                component.item

                            stack.depth(stack.top) =
                                current.depth + 1

                        endif

                    endif

                endfor

            endselect

            if formula.found = 0 then
                message(
                    "No formulation found for derived reagent: " &amp;
                    trim$(current.reagent)
                )
                return(0)
            endif

        endif

    endwhile

    return(1)
}

| Get next detail ID for one inventory transaction.
function extern domain tcmcs.long get_next_inventory_detail_id(domain tcmcs.long inid){
    domain tcmcs.long next.id

    next.id = 0

    select max(txwip052.dlid):next.id
    from txwip052
    where txwip052.inid = :inid
    as set with 1 rows
    selectdo
    endselect

    next.id = next.id + 1

    return(next.id)
}

| Process one material or reagent consumption.
|
| qtty = original consumption quantity.
| unit = original consumption unit.
|
| Inventory is deducted in FIFO order.
| txwip052 records the allocated quantity in the inventory row unit.
function extern long process_inventory_material(
    domain txmat.types type,
    domain tcmcs.str50 item,
    domain tcqiv1 qtty,
    domain tccuni unit,
    domain tccwar cwar,
    domain whloca loca,
    domain tcorno apno,
    domain tcpono apsq,
    domain tcpdno pdno
){
    domain tcqiv1 remaining.quantity
    domain tcqiv1 base.quantity
    domain tcqiv1 row.quantity
    domain tcqiv1 lot.price
    domain tcconv demand.conversion
    domain tcconv row.conversion
    domain tccuni inventory.unit
    domain tcmcs.str50 formatted.item
    domain tcmcs.long detail.id
    domain tcdate transaction.date

    remaining.quantity = 0
    base.quantity = 0
    row.quantity = 0
    lot.price = 0

    if qtty&lt;= 0 then
        return(1)
    endif

    inventory.unit = get_inventory_unit(
        type,
        item,
        cwar,
        loca
    )

    formatted.item = trim$(item)

    if trim$(inventory.unit) = "" then
        message(
            "No QC inventory unit found for item/reagent: " &amp;
            trim$(item)
        )
        return(0)
    endif

    demand.conversion = get_inventory_conversion(
        type,
        item,
        inventory.unit,
        unit
    )

    if demand.conversion&lt;= 0 then
        message(
            "Missing approved unit conversion for item/reagent: " &amp;
            trim$(item) &amp;
            ", Unit: " &amp; trim$(unit)
        )
        return(0)
    endif

    | Convert requested consumption quantity to inventory base unit.
    remaining.quantity = qtty / demand.conversion


    | Allocate inventory using FIFO order.
    select txwip051.*
    from txwip051 for update
    where txwip051.item = :formatted.item
        and txwip051.cwar = :cwar
        and txwip051.loca = :loca
        and txwip051.ittp = :type
        and txwip051.qava &gt; 0
    order by txwip051.idat, txwip051.inid
    selectdo

        if remaining.quantity &gt; 0 then

            if txwip051.basu&lt;&gt; "" and
                txwip051.basu&lt;&gt; inventory.unit then

                message(
                    "Inventory base-unit mismatch for item/reagent: " &amp;
                    trim$(item)
                )
                return(0)

            endif


            row.conversion = get_inventory_row_conversion(
                type,
                item,
                inventory.unit,
                txwip051.cuni,
                txwip051.conv
            )

            if row.conversion&lt;= 0 then
                message(
                    "Missing inventory conversion for item/reagent: " &amp;
                    trim$(item) &amp;
                    ", Unit: " &amp; trim$(txwip051.cuni)
                )
                return(0)
            endif


            | qava is already stored in basu.
            base.quantity = txwip051.qava

            if base.quantity &gt;= remaining.quantity then
                base.quantity = remaining.quantity
            endif


            if base.quantity &gt; 0 then

                | Convert allocated base quantity to inventory row unit.
                row.quantity = base.quantity * row.conversion


                | LN lot cost applies only to standard items.
                | Reagent inventory does not use whltc101 lot pricing.
                if etol(type) = 1 then

                    lot.price = get_inventory_lot_price(
                        item,
                        txwip051.clot,
                        cwar
                    )

                    if lot.price&lt;= 0 then
                        message(
                            "Missing lot cost for item: " &amp;
                            trim$(item) &amp;
                            ", Lot: " &amp; trim$(txwip051.clot)
                        )
                        return(0)
                    endif

                endif


                | Deduct allocated base quantity.
                txwip051.qava =
                    txwip051.qava - base.quantity

                if db.update(ttxwip051, db.retry)&lt;&gt; 0 then
                    message(
                        "Error updating QC inventory for item/reagent: " &amp;
                        trim$(item)
                    )
                    abort.transaction()
                    return(0)
                endif


                | Create consumption detail for this FIFO allocation.
                detail.id = get_next_inventory_detail_id(
                    txwip051.inid
                )

                transaction.date = utc.num()

                txwip052.inid = txwip051.inid
                txwip052.dlid = detail.id
                txwip052.trtp = ltoe(2)
                txwip052.qtty = row.quantity
                txwip052.unit = txwip051.cuni
                txwip052.apno = apno
                txwip052.apsq = apsq
                txwip052.pdno = pdno
                txwip052.dcdt = transaction.date

                if db.insert(ttxwip052, db.retry)&lt;&gt; 0 then
                    message(
                        "Error recording QC inventory consumption for item/reagent: " &amp;
                        trim$(item)
                    )
                    abort.transaction()
                    return(0)
                endif


                remaining.quantity =
                    remaining.quantity - base.quantity

            endif

        endif

    endselect


    if remaining.quantity &gt; 0 then
        message(
            "Insufficient QC inventory during FIFO processing for item/reagent: " &amp;
            trim$(item)
        )
        return(0)
    endif

    return(1)
}

function long process_reagent_formula(
    domain tcmcs.str50 reagent,
    domain tcqiv1 quantity,
    domain tccuni quantity.unit,
    domain tccwar cwar,
    domain whloca loca,
    domain tcorno apno,
    domain tcpono apsq,
    domain tcpdno pdno,
    long expand.current,
    long depth
){
    domain tcmcs.str50 stack.reagent(256)
    domain tccuni stack.unit(256)
    domain tcqiv1 stack.quantity(256)
    long stack.depth(256)
    long stack.expand(256)

    domain tcmcs.str50 current.reagent
    domain tccuni current.unit
    domain tcqiv1 current.quantity
    long current.depth
    long current.expand

    domain tcqiv1 reagent.aqsm
    domain tcqiv1 base.quantity
    domain tcqiv1 component.quantity

    domain txmat.types component.type
    domain tcmcs.str50 component.item
    domain tccuni component.unit
    domain tcqiv1 component.volume

    domain tcconv conversion.value

    long stack.top
    long branch
    long formula.found
    long processed.nodes
    long result

    if quantity &lt;= 0 then
        return(1)
    endif

    if trim$(reagent) = "" then
        message("Reagent code is missing.")
        return(0)
    endif

    stack.top = 1
    stack.reagent(1, 1) = trim$(reagent)
    stack.unit(1, 1) = quantity.unit
    stack.quantity(1) = quantity
    stack.depth(1) = depth
    stack.expand(1) = expand.current

    processed.nodes = 0

    while stack.top &gt; 0

        processed.nodes = processed.nodes + 1

        if processed.nodes &gt; 10000 then
            message("Reagent processing traversal limit exceeded.")
            return(0)
        endif

        current.reagent = stack.reagent(1, stack.top)
        current.unit = stack.unit(1, stack.top)
        current.quantity = stack.quantity(stack.top)
        current.depth = stack.depth(stack.top)
        current.expand = stack.expand(stack.top)

        stack.top = stack.top - 1

        if current.depth &gt; 20 then
            message(
                "Reagent processing depth exceeded: " &amp;
                trim$(current.reagent)
            )
            return(0)
        endif

        if current.quantity &gt; 0 then

            reagent.aqsm = 0

            select txwip021.aqsm
            from txwip021
            where txwip021.rgnt = :current.reagent
                and txwip021.cwar = :cwar
            as set with 1 rows
            selectdo
                reagent.aqsm = txwip021.aqsm
            selectempty
                message(
                    "Reagent master not found: " &amp;
                    trim$(current.reagent)
                )
                return(0)
            endselect

            if reagent.aqsm &lt;= 0 then
                message(
                    "Invalid reagent output quantity: " &amp;
                    trim$(current.reagent)
                )
                return(0)
            endif

            |---------------------------------------------------------------
            | Stockable reagent.
            |
            | Test consumption: consume directly.
            | Registration parent: expand its own formulation.
            |---------------------------------------------------------------

            if reagent.aqsm &lt;&gt; 1 and current.expand = 0 then

                result = process_inventory_material(
                    ltoe(2),
                    current.reagent,
                    current.quantity,
                    current.unit,
                    cwar,
                    loca,
                    apno,
                    apsq,
                    pdno
                )

                if result = 0 then
                    return(0)
                endif

            else

                |-----------------------------------------------------------
                | Expand derived reagent or registered parent.
                |-----------------------------------------------------------

                conversion.value = get_inventory_conversion(
                    ltoe(2),
                    current.reagent,
                    "ML",
                    current.unit
                )

                if conversion.value &lt;= 0 then
                    message(
                        "Invalid reagent conversion: " &amp;
                        trim$(current.reagent)
                    )
                    return(0)
                endif

                base.quantity =
                    current.quantity / conversion.value

                formula.found = 0

                select txwip022.rgtp,
                       txwip022.item,
                       txwip022.rvol,
                       txwip022.rgni,
                       txwip022.sltp,
                       txwip022.slvn,
                       txwip022.svol,
                       txwip022.slni
                from txwip022
                where txwip022.rgnt = :current.reagent
                selectdo

                    formula.found = formula.found + 1

                    for branch = 1 to 2

                        if branch = 1 then
                            component.type = txwip022.rgtp
                            component.item = trim$(txwip022.item)
                            component.volume = txwip022.rvol
                            component.unit = txwip022.rgni
                        else
                            component.type = txwip022.sltp
                            component.item = trim$(txwip022.slvn)
                            component.volume = txwip022.svol
                            component.unit = txwip022.slni
                        endif

                        if component.volume &lt; 0 then
                            message(
                                "Negative formulation quantity: " &amp;
                                trim$(current.reagent)
                            )
                            return(0)
                        endif

                        if component.volume &gt; 0 then

                            component.quantity =
                                base.quantity *
                                (component.volume / reagent.aqsm)

                            |-----------------------------------------------
                            | Physical item: consume directly.
                            |-----------------------------------------------

                            if etol(component.type) = 1 then

                                if trim$(component.item) = "" then
                                    message(
                                        "Missing formulation item: " &amp;
                                        trim$(current.reagent)
                                    )
                                    return(0)
                                endif

                                result = process_inventory_material(
                                    ltoe(1),
                                    component.item,
                                    component.quantity,
                                    component.unit,
                                    cwar,
                                    loca,
                                    apno,
                                    apsq,
                                    pdno
                                )

                                if result = 0 then
                                    return(0)
                                endif

                            endif

                            |-----------------------------------------------
                            | Reagent: enqueue for processing.
                            |
                            | Child stockable reagents will be consumed.
                            | Child derived reagents will be expanded.
                            |-----------------------------------------------

                            if etol(component.type) = 2 then

                                if trim$(component.item) = "" then
                                    message(
                                        "Missing reagent component: " &amp;
                                        trim$(current.reagent)
                                    )
                                    return(0)
                                endif

                                if trim$(component.unit) = "" then
                                    message(
                                        "Missing reagent unit: " &amp;
                                        trim$(component.item)
                                    )
                                    return(0)
                                endif

                                if stack.top &gt;= 256 then
                                    message(
                                        "Reagent processing stack exceeded."
                                    )
                                    return(0)
                                endif

                                stack.top = stack.top + 1

                                stack.reagent(1, stack.top) =
                                    component.item

                                stack.unit(1, stack.top) =
                                    component.unit

                                stack.quantity(stack.top) =
                                    component.quantity

                                stack.depth(stack.top) =
                                    current.depth + 1

                                | Only the registration root is forced
                                | to expand its formulation.
                                stack.expand(stack.top) = 0

                            endif

                            | Type 3: QC item; skip physical consumption.
                            | Type 0: No component.

                        endif

                    endfor

                endselect

                | A derived reagent must have a formulation.
                | A stockable parent may have no formulation rows.
                if formula.found = 0 and reagent.aqsm = 1 then
                    message(
                        "No formulation found for derived reagent: " &amp;
                        trim$(current.reagent)
                    )
                    return(0)
                endif

            endif

        endif

    endwhile

    return(1)
}

function extern long process_registered_reagent_components(
    domain tcmcs.str50 reagent,
    domain tcqiv1 quantity,
    domain tccuni unit,
    domain tccwar cwar,
    domain whloca loca
){

    return(
        process_reagent_formula(
            reagent,
            quantity,
            unit,
            cwar,
            loca,
            "",
            0,
            "",
            1,
            0
        )
    )
}

| Process all Micro standard-item materials.
function extern long process_micro_materials(
    domain tccwar cwar,
    domain whloca loca,
    domain tcorno apno,
    domain tcpono apsq,
    domain tcpdno pdno
){
    long result
    domain tcitem formatted.item

    result = 1
    formatted.item = "         " &amp; trim$(inspected.item)

    select txwip037.code
    from txwip037
    where txwip037.item = :formatted.item
        and txwip037.cwar = :cwar
    selectdo

        select txwip024.anly
        from txwip024
        where txwip024.anly = :txwip037.code
            and txwip024.freq = 2
        selectdo

            select txwip025.mtid
            from txwip025
            where txwip025.anly = :txwip024.anly
            selectdo

                select txwip027.item,
                       txwip027.tsmm,
                       txwip027.cuni
                from txwip027
                where txwip027.mtid = :txwip025.mtid
                selectdo

                    if trim$(txwip027.item)&lt;&gt; "" and
                        txwip027.tsmm &gt; 0 then

                        result = process_inventory_material(
                            ltoe(1),
                            txwip027.item,
                            txwip027.tsmm,
                            txwip027.cuni,
                            cwar,
                            loca,
                            apno,
                            apsq,
                            pdno
                        )

                        if result = 0 then
                            return(0)
                        endif

                    endif

                endselect

            endselect

        endselect

    endselect

    return(result)
}

| Process all Micro reagents.
| The physical quantity is txwip021.mult (ML), NOT txwip028.mult.
| Derived reagents are expanded to stockable inventory components.
function extern long process_micro_reagents(
    domain tccwar cwar,
    domain whloca loca,
    domain tcorno apno,
    domain tcpono apsq,
    domain tcpdno pdno
){
    long result
    domain tcitem formatted.item
    domain tcmcs.str50 reagent.code
    domain tcqiv1 reagent.quantity

    result = 1
    formatted.item = "         " &amp; trim$(inspected.item)

    select txwip037.code
    from txwip037
    where txwip037.item = :formatted.item
        and txwip037.cwar = :cwar
    selectdo

        select txwip024.anly
        from txwip024
        where txwip024.anly = :txwip037.code
            and txwip024.freq = 2
        selectdo

            select txwip025.mtid
            from txwip025
            where txwip025.anly = :txwip024.anly
            selectdo

                select txwip028.rgnt
                from txwip028
                where txwip028.mtid = :txwip025.mtid
                selectdo

                    reagent.code = trim$(txwip028.rgnt)

                    if reagent.code &lt;&gt; "" then

                        reagent.quantity = 0

                        select txwip021.mult
                        from txwip021
                        where txwip021.rgnt = :reagent.code
                            and txwip021.cwar = :cwar
                        as set with 1 rows
                        selectdo
                            reagent.quantity = txwip021.mult
                        selectempty
                            message(
                                "Reagent master not found: " &amp;
                                trim$(reagent.code)
                            )
                            return(0)
                        endselect

                        if reagent.quantity &lt;= 0 then
                            message(
                                "Invalid reagent consumption quantity: " &amp;
                                trim$(reagent.code)
                            )
                            return(0)
                        endif

                        result = process_reagent_formula(
                            reagent.code,
                            reagent.quantity,
                            "ML",
                            cwar,
                            loca,
                            apno,
                            apsq,
                            pdno,
                            0,
                            0
                        )

                        if result = 0 then
                            return(0)
                        endif

                    endif

                endselect

            endselect

        endselect

    endselect

    return(1)
}

| Process all Pychem standard-item materials.
function extern long process_pychem_materials(
    domain tccwar cwar,
    domain whloca loca,
    domain tcorno apno,
    domain tcpono apsq,
    domain tcpdno pdno
){
    long result
    domain tcitem formatted.item

    result = 1
    formatted.item = "         " &amp; trim$(inspected.item)

    select txwip037.code
    from txwip037
    where txwip037.item = :formatted.item
        and txwip037.cwar = :cwar
    selectdo

        select txwip030.ptid
        from txwip030
        where txwip030.ptid = :txwip037.code
        selectdo

            select txwip031.mtrl,
                   txwip031.aqsm
            from txwip031
            where txwip031.ptid = :txwip030.ptid
                and txwip031.mttp = 1
            selectdo

                if trim$(txwip031.mtrl)&lt;&gt; "" and
                    txwip031.aqsm &gt; 0 then

                    result = process_inventory_material(
                        ltoe(1),
                        txwip031.mtrl,
                        txwip031.aqsm,
                        "ML",
                        cwar,
                        loca,
                        apno,
                        apsq,
                        pdno
                    )

                    if result = 0 then
                        return(0)
                    endif

                endif

            endselect

        endselect

    endselect

    return(result)
}

| Process all Pychem reagents.
|
| txwip031.aqsm is the reagent quantity in ML when mttp = 2.
function extern long process_pychem_reagents(
    domain tccwar cwar,
    domain whloca loca,
    domain tcorno apno,
    domain tcpono apsq,
    domain tcpdno pdno
){
    long result

    domain tcitem formatted.item
    domain tcmcs.str50 reagent.code
    domain tcqiv1 reagent.quantity

    result = 1
    formatted.item = "         " &amp; trim$(inspected.item)

    select txwip037.code
    from txwip037
    where txwip037.item = :formatted.item
        and txwip037.cwar = :cwar
    selectdo

        select txwip030.ptid
        from txwip030
        where txwip030.ptid = :txwip037.code
        selectdo

            select txwip031.mtrl,
                   txwip031.aqsm
            from txwip031
            where txwip031.ptid = :txwip030.ptid
                and txwip031.mttp = 2
            selectdo

                reagent.code = trim$(txwip031.mtrl)
                reagent.quantity = txwip031.aqsm

                if reagent.code &lt;&gt; "" and
                    reagent.quantity &gt; 0 then

                    result = process_reagent_formula(
                        reagent.code,
                        reagent.quantity,
                        "ML",
                        cwar,
                        loca,
                        apno,
                        apsq,
                        pdno,
                        0,
                        0
                    )

                    if result = 0 then
                        return(0)
                    endif

                endif

            endselect

        endselect

    endselect

    return(result)
}

function extern long load_inventory_inspection_context(){

    inspection.number = whinh211.apno
    inspection.sequence = whinh211.apsq
    production.order = whinh211.orno
    inspected.item = trim$(whinh211.item)

    if trim$(inspection.number) = "" then
        message("Warehouse inspection number is missing.")
        return(0)
    endif

    if trim$(production.order) = "" then
        message("Production order is missing from the warehouse inspection.")
        return(0)
    endif

    if trim$(inspected.item) = "" then
        message("Inspected item is missing from the warehouse inspection.")
        return(0)
    endif

    qc.warehouse = get_equivalent_cwar(whinh211.cwar)

    if trim$(qc.warehouse) = "" then
        message("Unable to resolve QC warehouse for main warehouse: " &amp; trim$(whinh211.cwar))
        return(0)
    endif

    qc.location = get_location(qc.warehouse)

    if trim$(qc.location) = "" then
        message("Unable to resolve QC inventory location for warehouse: " &amp; trim$(qc.warehouse))
        return(0)
    endif

    return(1)
}

function extern long is_inventory_consumption_processed(){
    long already.processed

    already.processed = 0

    select txwip052.inid
    from txwip052
    where txwip052.apno = :inspection.number
        and txwip052.apsq = :inspection.sequence
        and txwip052.pdno = :production.order
        and txwip052.trtp = 2
    as set with 1 rows
    selectdo
        already.processed = 1
    endselect

    return(already.processed)
}

| Validate all applicable materials and reagents before approval.
function extern long validate_inspection_inventory(){
    domain tcitem formatted.item
    domain tcmcs.str50 reagent.code

    long validation.result

    formatted.item = "         " &amp; trim$(inspected.item)

    |===============================================================
    | MICRO STANDARD-ITEM MATERIALS
    |===============================================================

    select txwip037.code
    from txwip037
    where txwip037.item = :formatted.item
        and txwip037.cwar = :qc.warehouse
    selectdo

        select txwip024.anly
        from txwip024
        where txwip024.anly = :txwip037.code
            and txwip024.freq = 2
        selectdo

            select txwip025.mtid
            from txwip025
            where txwip025.anly = :txwip024.anly
            selectdo

                select txwip027.item
                from txwip027
                where txwip027.mtid = :txwip025.mtid
                selectdo

                    if trim$(txwip027.item) &lt;&gt; "" then

                        validation.result =
                            validate_inventory_item(
                                ltoe(1),
                                txwip027.item,
                                qc.warehouse,
                                qc.location
                            )

                        if validation.result = 0 then
                            return(0)
                        endif

                    endif

                endselect

            endselect

        endselect

    endselect

    |===============================================================
    | MICRO REAGENTS
    |===============================================================

    select txwip037.code
    from txwip037
    where txwip037.item = :formatted.item
        and txwip037.cwar = :qc.warehouse
    selectdo

        select txwip024.anly
        from txwip024
        where txwip024.anly = :txwip037.code
            and txwip024.freq = 2
        selectdo

            select txwip025.mtid
            from txwip025
            where txwip025.anly = :txwip024.anly
            selectdo

                select txwip028.rgnt
                from txwip028
                where txwip028.mtid = :txwip025.mtid
                selectdo

                    reagent.code = trim$(txwip028.rgnt)

                    if reagent.code &lt;&gt; "" then

                        select txwip021.mult
                        from txwip021
                        where txwip021.rgnt = :reagent.code
                            and txwip021.cwar = :qc.warehouse
                        as set with 1 rows
                        selectdo

                            if txwip021.mult &lt;= 0 then
                                message(
                                    "Invalid reagent multiplier: " &amp;
                                    trim$(reagent.code)
                                )
                                return(0)
                            endif

                            validation.result =
                                validate_reagent_formula(
                                    reagent.code,
                                    qc.warehouse,
                                    qc.location,
                                    0
                                )

                            if validation.result = 0 then
                                return(0)
                            endif

                        selectempty

                            message(
                                "Reagent master record not found: " &amp;
                                trim$(reagent.code)
                            )
                            return(0)

                        endselect

                    endif

                endselect

            endselect

        endselect

    endselect

    |===============================================================
    | PYCHEM STANDARD-ITEM MATERIALS
    |===============================================================

    select txwip037.code
    from txwip037
    where txwip037.item = :formatted.item
        and txwip037.cwar = :qc.warehouse
    selectdo

        select txwip030.ptid
        from txwip030
        where txwip030.ptid = :txwip037.code
        selectdo

            select txwip031.mtrl
            from txwip031
            where txwip031.ptid = :txwip030.ptid
                and txwip031.mttp = 1
            selectdo

                if trim$(txwip031.mtrl) &lt;&gt; "" then

                    validation.result =
                        validate_inventory_item(
                            ltoe(1),
                            txwip031.mtrl,
                            qc.warehouse,
                            qc.location
                        )

                    if validation.result = 0 then
                        return(0)
                    endif

                endif

            endselect

        endselect

    endselect

    |===============================================================
    | PYCHEM REAGENTS
    |===============================================================

    select txwip037.code
    from txwip037
    where txwip037.item = :formatted.item
        and txwip037.cwar = :qc.warehouse
    selectdo

        select txwip030.ptid
        from txwip030
        where txwip030.ptid = :txwip037.code
        selectdo

            select txwip031.mtrl,
                   txwip031.aqsm
            from txwip031
            where txwip031.ptid = :txwip030.ptid
                and txwip031.mttp = 2
            selectdo

                reagent.code = trim$(txwip031.mtrl)

                if reagent.code &lt;&gt; "" and
                    txwip031.aqsm &gt; 0 then

                    validation.result =
                        validate_reagent_formula(
                            reagent.code,
                            qc.warehouse,
                            qc.location,
                            0
                        )

                    if validation.result = 0 then
                        return(0)
                    endif

                endif

            endselect

        endselect

    endselect

    return(1)
}
#context_off

function extern boolean ext.is.cdfs.of.ref.tables.selected()
{
	FunctionUsage
		Get the value of the "include.cdfs.of.ref.tables" property of the session extension.
	EndFunctionUsage

	return(true)
}

| Hook function.approve.and.process.before.command
#context_on "function.approve.and.process.before.command"
function extern void function.approve.and.process.before.command()
{
    long already.processed

    | Only production warehouse inspections consume QC inventory.
    if whinh211.oorg &lt;&gt; ltoe(50) then
        return
    endif

    | Load warehouse inspection and QC inventory context.
    if load_inventory_inspection_context() = 0 then
        choice.again()
        return
    endif

    | Prevent duplicate consumption.
    already.processed = is_inventory_consumption_processed()

    if already.processed = 1 then
        return
    endif

    | Validate all Micro and Pychem materials and reagents.
    if validate_inspection_inventory() = 0 then

        message(
            "QC inventory validation failed. Approval cancelled for inspection: " &amp;
            trim$(inspection.number)
        )

        choice.again()
        return

    endif

    | Inventory deduction is performed by the After Command hook.
}
#context_off

| Hook function.approve.and.process.after.command
#context_on "function.approve.and.process.after.command"
function extern void function.approve.and.process.after.command()
{
    long already.processed

    | Only production warehouse inspections consume QC inventory.
    if whinh211.oorg &lt;&gt; ltoe(50) then
        return
    endif

    | Reload inspection context.
    if load_inventory_inspection_context() = 0 then
        return
    endif

    | Prevent duplicate consumption.
    already.processed = is_inventory_consumption_processed()

    if already.processed = 1 then
        return
    endif

    | Revalidate stock before deduction.
    | This protects against inventory changes between the
    | Before Command and After Command hooks.
    if validate_inspection_inventory() = 0 then

        message(
            "QC inventory changed before consumption could be posted. " &amp;
            "Inspection: " &amp; trim$(inspection.number)
        )

        abort.transaction()
        return

    endif

    |---------------------------------------------------------------------------
    | MICRO STANDARD-ITEM MATERIALS
    |---------------------------------------------------------------------------

    process.result = process_micro_materials(
        qc.warehouse,
        qc.location,
        inspection.number,
        inspection.sequence,
        production.order
    )

    if process.result = 0 then

        message(
            "Error processing Micro QC inventory materials for inspection: " &amp;
            trim$(inspection.number)
        )

        abort.transaction()
        return

    endif

    |---------------------------------------------------------------------------
    | MICRO REAGENTS
    |---------------------------------------------------------------------------

    process.result = process_micro_reagents(
        qc.warehouse,
        qc.location,
        inspection.number,
        inspection.sequence,
        production.order
    )

    if process.result = 0 then

        message(
            "Error processing Micro QC inventory reagents for inspection: " &amp;
            trim$(inspection.number)
        )

        abort.transaction()
        return

    endif

    |---------------------------------------------------------------------------
    | PYCHEM STANDARD-ITEM MATERIALS
    |---------------------------------------------------------------------------

    process.result = process_pychem_materials(
        qc.warehouse,
        qc.location,
        inspection.number,
        inspection.sequence,
        production.order
    )

    if process.result = 0 then

        message(
            "Error processing Pychem QC inventory materials for inspection: " &amp;
            trim$(inspection.number)
        )

        abort.transaction()
        return

    endif

    |---------------------------------------------------------------------------
    | PYCHEM REAGENTS
    |---------------------------------------------------------------------------

    process.result = process_pychem_reagents(
        qc.warehouse,
        qc.location,
        inspection.number,
        inspection.sequence,
        production.order
    )

    if process.result = 0 then

        message(
            "Error processing Pychem QC inventory reagents for inspection: " &amp;
            trim$(inspection.number)
        )

        abort.transaction()
        return

    endif

    |---------------------------------------------------------------------------
    | COMMIT SUCCESSFUL INVENTORY CONSUMPTION
    |---------------------------------------------------------------------------

    commit.transaction()

    message(
        "QC inventory consumption completed for inspection: " &amp;
        trim$(inspection.number)
    )
}
#context_off

