function extern long ext.get.command.extensions()
{
	FunctionUsage
		Get the modeled standard command and form command extensions 
		from the session extension.
	EndFunctionUsage

	domain	ttxmlnode	commands
	domain	ttxmlnode	command
	long	ret

	ret = 0
	command = 0
	commands = xmlNewNode("COMMANDS")

	command = xmlNewNode("COMMAND", XML_ELEMENT, commands)
	ret = xmlSetAttribute(command, "NAME", "approve.and.process")
	ret = xmlSetAttribute(command, "TYPE", "FORM")
	ret = xmlSetAttribute(command, "BEFOREHOOK", "function.approve.and.process.before.command")
	ret = xmlSetAttribute(command, "AFTERHOOK", "function.approve.and.process.after.command")

	return(commands)
}

