function r.xml.header.main.attributes()#
{#
        domain ttcdes report.description#
#
#if ES_TIV_LEVEL >= 1700#
        report.description = tt.report.desc("rtxwip0500ejm01")#
        report.description = str.replace$(report.description, "&", "&amp;")#
        report.description = str.replace$(report.description, """", "&quot;")#
        report.description = str.replace$(report.description, "<", "&lt;")#
#else#
        report.description = "QC Cost Breakdown"#
#endif#
#
        spool.pr.line = "<?xml version=""1.0""?>"#
        r_spool_line_xml#
        spool.pr.line = "<report id=""2txB61Oa ext wip0500ejm01"""#
        r_spool_line_xml#
        spool.pr.line = "	repc=""txwip0500ejm01"""#
        r_spool_line_xml#
        spool.pr.line = "	user=""ict004"""#
        r_spool_line_xml#
        spool.pr.line = "	date=""1789694347"""#
        r_spool_line_xml#
        spool.pr.line = "	lang=""" & language$ & """"#
        r_spool_line_xml#
        spool.pr.line = "	desc=""" & report.description & """"#
        r_spool_line_xml#
        spool.pr.line = "	exp=""No"""#
        r_spool_line_xml#
        spool.pr.line = "	langlinked="" """#
        r_spool_line_xml#
        spool.pr.line = "	lmargin=""1"""#
        r_spool_line_xml#
        spool.pr.line = "	tmargin=""2"""#
        r_spool_line_xml#
        spool.pr.line = "	bmargin=""3"""#
        r_spool_line_xml#
        spool.pr.line = "	fmargin=""-1"""#
        r_spool_line_xml#
        spool.pr.line = "	plen=""-1"""#
        r_spool_line_xml#
        spool.pr.line = "	actual_plen=""" & str$(spool.pg.length) & """"#
        r_spool_line_xml#
        spool.pr.line = "	pwidth=""132"""#
        r_spool_line_xml#
        spool.pr.line = "	font=""Italic"""#
        r_spool_line_xml#
        spool.pr.line = "	monospace=""" & r_get_monospace_attribute() & """"#
        r_spool_line_xml#
        spool.pr.line = "	cols=""0"""#
        r_spool_line_xml#
        spool.pr.line = "	fontfixed=""No"""#
        r_spool_line_xml#
        spool.pr.line = "	repexp=""1"""#
        r_spool_line_xml#
        spool.pr.line = "	helptxt="""""#
        r_spool_line_xml#
        spool.pr.line = "	excelOutputSheetName="""""#
        r_spool_line_xml#
        spool.pr.line = " >"#
        r_spool_line_xml#
        spool.pr.line = "<head>"#
        r_spool_line_xml#
}#
