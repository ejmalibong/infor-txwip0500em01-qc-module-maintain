function extern r.1.s.header()#
{#
	static long pers.func.id#
#
	long dummy.ret.pers.func.id#
#
	if g.pers.obj.id > 0 and pers.func.id = 0 then#
		pers.func.id = get_function(g.pers.obj.id, "r.1.s.header")#
		pers.func.id = (pers.func.id <> 0) ? pers.func.id : -1#
	endif#
	static long pers.func.id.cond#
#
	long dummy.ret.pers.func.id.cond#
#
	if g.pers.obj.id > 0 and pers.func.id.cond = 0 then#
		pers.func.id.cond = get_function(g.pers.obj.id, "r.1.s.header.oc")#
		pers.func.id.cond = (pers.func.id.cond <> 0) ? pers.func.id.cond : -1#
	endif#
	lattr.layout.id$	= "header.1"#
	r.push(lattr.print)#
	#
header.1:#
	lattr.multicol.repeat = true#
	lattr.multicol	= 0#
	#context_on "Output Condition for Header rseq   1 pseq   0 tseq   0, line 9, column 4: '1'"#
	lattr.print	= 1#
	#context_off#
	if pers.func.id.cond > 0 then#
		exec_function(g.pers.obj.id, pers.func.id.cond, dummy.ret.pers.func.id.cond, lattr.print )#
	endif#
	if ( lattr.print ) then | Standard report Script condition#
		r.s.header.1.bef.lay()#
	endif#
	if pers.func.id > 0 then#
		exec_function(g.pers.obj.id, pers.func.id)#
	else#
		if ( lattr.print ) then#
			if ( lattr.multicol ) then#
				r_init_multicol(2,"                 ",0,132)#
			else#
				flush_multicol()#
			endif#
			r_multicol_check_for_flush()#
			lattr.multicol = 0#
		endif#
	endif#
	if ( lattr.print ) then#
		r.layout.again = 0#
		r.s.header.1.aft.lay()#
		if ( r.layout.again ) then#
			r.foot.control()#
			goto header.1#
		endif#
	endif#
	r.pop(lattr.print)#
}#
