	r.get.sym.names(1,2) = "txwip020.atst"#
	r.get.sym.names(1,3) = "txwip020.bpid"#
	r.get.sym.names(1,4) = "txwip020.btsz"#
	r.get.sym.names(1,5) = "txwip020.clot"#
	r.get.sym.names(1,6) = "txwip020.cwar"#
