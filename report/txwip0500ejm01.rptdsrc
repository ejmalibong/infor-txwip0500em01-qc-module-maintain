function extern string r_sf_formatter(const string pr.expr, const string domain_name, ref long r_sf_init,ref string r_sf_format(), ref long r_sf_offset())#
{#
	if r_repdll_tiv>=1014 then#
		if r_sf_init=0 then#
			exec_dll_function("ottstprepdll", "r_sf_gen_format", r_sf_init, domain_name, r_sf_format, r_sf_offset)#
		endif#
		if r_sf_init>1 then #
			return(sprintf$(r_sf_format, 				pr.expr(r_sf_offset(1)),#
				pr.expr(r_sf_offset(2)),#
				pr.expr(r_sf_offset(3)),#
				pr.expr(r_sf_offset(4)),#
				pr.expr(r_sf_offset(5)),#
				pr.expr(r_sf_offset(6)),#
				pr.expr(r_sf_offset(7)),#
				pr.expr(r_sf_offset(8)),#
			pr.expr(r_sf_offset(9) ) ) )#
		endif#
	endif#
	return(pr.expr)#
}#
#
function extern long r_repdll_tiv_check()#
{#
	if (r_repdll_tiv >= 1055 and r_repdll_tiv < 1075) or (r_repdll_tiv>=1077) then #
		return(true)#
