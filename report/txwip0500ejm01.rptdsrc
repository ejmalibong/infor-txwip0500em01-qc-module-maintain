}#
#
function extern long r.xml.header()#
{#
        long      pers.xml.header.func.id#
        long      pers.xml.header.without.input.fields.func.id#
        long      pers.func.id#
#
        if r.xml.minimal() then#
                r.xml.header.main.attributes()#
                r.xml.header.properties()#
                spool.pr.line = "</head>"#
                r_spool_line_xml#
                return(0)#
        endif#
        if g.pers.obj.id > 0 then#
                pers.xml.header.without.input.fields.func.id = get_function(g.pers.obj.id, "r.xml.header.without.input.fields")#
                if pers.xml.header.without.input.fields.func.id = 0 then#
                        pers.xml.header.func.id = get_function(g.pers.obj.id, "r.xml.header")#
                endif#
        endif#
#
        if pers.xml.header.without.input.fields.func.id > 0 then#
                exec_function(g.pers.obj.id, pers.xml.header.without.input.fields.func.id)#
                r.xml.header.input.fields()#
        else if pers.xml.header.func.id > 0 then#
                exec_function(g.pers.obj.id, pers.xml.header.func.id)#
        else#
                r.xml.header.main.attributes()#
                r.xml.header.properties()#
                r.xml.header.input.fields()#
        endif endif#
#
        r.xml.header.layout.sensitivity.1()#
        r.xml.header.layout.header.1()#
        r.xml.header.layout.detail.1()#
#
        if g.pers.obj.id > 0 then#
                pers.func.id = get_function(g.pers.obj.id, "r.xml.header.pers")#
                if pers.func.id > 0 then#
                        exec_function(g.pers.obj.id, pers.func.id)#
                endif#
        endif#
        spool.pr.line = "</head>"#
        r_spool_line_xml#
        return(0)#
}#
