	r_repgen_tiv = 2600#
	if r_repdll_tiv_check() = true then#
		exec_dll_function("ottstprepdll", "r_set_repgen_tiv", dummy, r_repgen_tiv)#
	endif#
	if (r_repdll_tiv >= 2140) then#
		exec_dll_function("ottstprepdll", "r_get_personalization_object", g.pers.obj.path, prog.name$)#
		g.pers.obj.id = load_dll(g.pers.obj.path, DLL_SILENT_ERR)#
		if (g.pers.obj.id > 0) then#
			long func.id#
			func.id = get_function(g.pers.obj.id, "r_general_initialisations")#
			if (func.id > 0) then#
				exec_function(g.pers.obj.id, func.id)#
			endif#
		endif#
	endif#
	r.label.init()#
	if spool.xml then#
		r.xml.header()#
	endif#
	r_rdi_domain_init()#
	r_before_body()#
	r.s.before.program()#
	r.main()#
	r.s.after.program()#
	r_after_body()#
	r_after_report()#
}#
