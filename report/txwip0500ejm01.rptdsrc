function [long] r.get.imp.sim.var(const string i.var.src, const string i.var.dest, ...)#
{#
	static	boolean  has.sim.var, sim.var.checked#
		long	ret, var.long.value#
		double	var.double.value#
		string	var.string.value(5000)#
		string	var.mb.value(5000) mb#
	if not sim.var.checked then#
		has.sim.var = (exec_dll_function("ottstprepdll", "r.get.sim.var", ret, "", "") = 0)#
		sim.var.checked = true#
	endif#
	if has.sim.var then#
		on case get.arg.type(3)#
		case DB.LONG:#
			exec_dll_function("ottstprepdll", "r.get.sim.var", ret, i.var.src, i.var.dest, var.long.value)#
			break#
		case DB.DOUBLE:#
			exec_dll_function("ottstprepdll", "r.get.sim.var", ret, i.var.src, i.var.dest, var.double.value)#
			break#
		case DB.STRING:#
			exec_dll_function("ottstprepdll", "r.get.sim.var", ret, i.var.src, i.var.dest, var.string.value)#
			break#
		case DB.MULTIBYTE:#
			exec_dll_function("ottstprepdll", "r.get.sim.var", ret, i.var.src, i.var.dest, var.mb.value)#
			break#
		endcase#
	else#
		on case get.arg.type(3)#
		case DB.LONG:#
			ret = get.var(parent, i.var.src, var.long.value)#
			break#
		case DB.DOUBLE:#
			ret = get.var(parent, i.var.src, var.double.value)#
			break#
		case DB.STRING:#
			ret = get.var(parent, i.var.src, var.string.value)#
			break#
		case DB.MULTIBYTE:#
			ret = get.var(parent, i.var.src, var.mb.value)#
			break#
		endcase#
	endif#
	if ret = 1 then#
		on case get.arg.type(3)#
		case DB.LONG:#
			put.long.arg(3, var.long.value)#
			break#
		case DB.DOUBLE:#
			put.double.arg(3, var.double.value)#
			break#
		case DB.STRING:#
			put.string.arg(3, var.string.value)#
			break#
		case DB.MULTIBYTE:#
			put.string.arg(3, var.mb.value)#
			break#
		endcase#
	endif#
